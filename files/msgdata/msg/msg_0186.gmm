<?xml version="1.0"?>
<body language="English">
	<row id="msg_0186_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue à Géonet,\nle globe high-tech!\r</language>
	</row>
	<row id="msg_0186_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Que voulez-vous faire?</language>
	</row>
	<row id="msg_0186_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous pouvez enregistrer ici l’endroit\noù vous vivez.\rCette information peut être vue par vos\namis ou des inconnus via la\rcommunication sans fil DS ou via la\nCWF Nintendo.\rVoulez-vous enregistrer l’endroit où\nvous vivez?</language>
	</row>
	<row id="msg_0186_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Veuillez sélectionner l’endroit où\nvous vivez.</language>
	</row>
	<row id="msg_0186_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Veuillez sélectionner la zone dans\nlaquelle vous vivez.</language>
	</row>
	<row id="msg_0186_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une fois l’enregistrement terminé, vous\nne pourrez pas changer ces données.\rVoulez-vous enregistrer ces données?</language>
	</row>
	<row id="msg_0186_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 36, 0, 0}</language>
	</row>
	<row id="msg_0186_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 37, 0, 0}</language>
	</row>
	<row id="msg_0186_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OUI</language>
	</row>
	<row id="msg_0186_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">NON</language>
	</row>
	<row id="msg_0186_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">VOIR LIEUX</language>
	</row>
	<row id="msg_0186_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ENREGISTRER</language>
	</row>
	<row id="msg_0186_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">RETOUR</language>
	</row>
	<row id="msg_0186_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}VOIR</language>
	</row>
	<row id="msg_0186_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lieu enregistré:\n{STRVAR_1 36, 0, 0}\n{STRVAR_1 37, 1, 0}</language>
	</row>
	<row id="msg_0186_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour afficher un lieu enregistré, placez\nle curseur et appuyez sur le bouton X.</language>
	</row>
	<row id="msg_0186_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}RETOUR</language>
	</row>
</body>
