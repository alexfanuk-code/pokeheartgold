<?xml version="1.0"?>
<body language="English">
	<row id="msg_0046_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue au Colisée du Club Link\nPokémon.\rVous pouvez affronter vos amis ici.\r</language>
	</row>
	<row id="msg_0046_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quel mode de combat\nchoisissez-vous? {YESNO 0}</language>
	</row>
	<row id="msg_0046_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Combien de participants\npour ce défi? {YESNO 0}</language>
	</row>
	<row id="msg_0046_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Faire un Combat Multi à 4? {YESNO 0}</language>
	</row>
	<row id="msg_0046_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Faire un Combat Multi</language>
	</row>
	<row id="msg_0046_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">RETOUR</language>
	</row>
	<row id="msg_0046_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il existe cinq modes de combat.\rLes Combats Solo sont pour deux\nDresseurs et un ou plusieurs\fPokémon chacun.\rChaque Dresseur n’a qu’un seul\nPokémon au combat à la fois.\rLes Combats Duo sont pour deux\nDresseurs et deux Pokémon ou\fplus chacun.\rChaque Dresseur a deux Pokémon\nau combat en même temps.\rLes Combats Mixtes sont pour deux\nDresseurs et trois Pokémon chacun.\rChaque Dresseur choisit un des\nPokémon de l’adversaire, le met dans\fson équipe, puis combat.\rLes Combats 50 réduisent le niveau des\nPokémon à 50 au maximum.\rLes Combats Multi sont pour quatre\nDresseurs et trois Pokémon ou plus\fchacun.\rChaque Dresseur n’a qu’un seul\nPokémon au combat à la fois.\r</language>
	</row>
	<row id="msg_0046_00007" index="7">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0046_00008" index="8">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0046_00009" index="9">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0046_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour un Combat Duo, vous devez avoir\nau minimum deux Pokémon.</language>
	</row>
