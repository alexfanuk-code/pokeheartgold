	<row id="msg_0046_00136" index="136">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il est impossible de former une équipe\nde Pokémon conformes aux règles de la\rCoupe {STRVAR_1 26, 0, 0} avec un\nniveau total maximum de {STRVAR_1 52, 1, 0}.</language>
	</row>
