<?xml version="1.0"?>
<body language="English">
	<row id="msg_0398_R39R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Meumeu est malade...\nSi seulement j’avais plein de\fBaies Oran à lui donner...\r</language>
	</row>
	<row id="msg_0398_R39R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci!\nMeumeu va beaucoup mieux!\rTiens, pour te remercier,\nprends ces Sceaux!\r</language>
	</row>
	<row id="msg_0398_R39R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gloups!\nJe voulais te donner des Sceaux, mais\ftu n’as pas de Boîte pour les ranger!\rMais pas de problème!\nMa sœur va t’en donner une!\r</language>
	</row>
	<row id="msg_0398_R39R0201_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh!\nMais tu as trop de Sceaux!\r</language>
	</row>
	<row id="msg_0398_R39R0201_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Meumeu va beaucoup mieux!\r</language>
	</row>
	<row id="msg_0398_R39R0201_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Meumeu est malade...\nSi seulement j’avais plein de\fBaies Oran à lui donner...\r</language>
	</row>
	<row id="msg_0398_R39R0201_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci!\nMeumeu va beaucoup mieux!\rTiens, pour te remercier,\nprends cette Boîte Sceaux!\r</language>
	</row>
	<row id="msg_0398_R39R0201_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu peux personnaliser tes Poké Balls\nen y appliquant des Sceaux.\rD’abord, choisis “Capsule Ball” dans\nle menu de ton PC, et colle les Sceaux\fque tu as sur la Poké Ball de ton choix.\rAprès, c’est à toi de faire des essais!\nMa sœur te donnera les Sceaux!\r</language>
	</row>
	<row id="msg_0398_R39R0201_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chez nous, on vend du Lait Meumeu,\nalors si tu en veux, n’hésite pas!\r</language>
	</row>
	<row id="msg_0398_R39R0201_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ECREMEUH: ... Meuh...\r</language>
	</row>
	<row id="msg_0398_R39R0201_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ECREMEUH gémit faiblement...</language>
	</row>
	<row id="msg_0398_R39R0201_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ECREMEUH: Crémeuh!\r</language>
	</row>
	<row id="msg_0398_R39R0201_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ECREMEUH est plein de vie!</language>
	</row>
	<row id="msg_0398_R39R0201_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous donner une Baie Oran\nà l’ECREMEUH? {YESNO 0}</language>
	</row>
	<row id="msg_0398_R39R0201_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} a donné\nune Baie Oran!</language>
	</row>
	<row id="msg_0398_R39R0201_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ECREMEUH va un peu mieux!</language>
	</row>
	<row id="msg_0398_R39R0201_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ECREMEUH va de mieux en mieux!</language>
	</row>
	<row id="msg_0398_R39R0201_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ECREMEUH a l’air guéri!</language>
	</row>
	<row id="msg_0398_R39R0201_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} n’a pas de Baie Oran\nà donner.</language>
	</row>
	<row id="msg_0398_R39R0201_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} refuse de donner une\nBaie Oran...\rECREMEUH lui lance un regard triste...</language>
	</row>
	<row id="msg_0398_R39R0201_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les exemplaires du {STRVAR_1 10, 0, 0}\nont été rangés dans la Boîte Sceaux!</language>
	</row>
</body>
