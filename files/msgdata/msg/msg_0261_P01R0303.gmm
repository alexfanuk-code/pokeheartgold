<?xml version="1.0"?>
<body language="English">
	<row id="msg_0261_P01R0303_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un lit douillet!\nLe sommeil vous gagne...\r</language>
	</row>
	<row id="msg_0261_P01R0303_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous débordez d’énergie!\r</language>
	</row>
	<row id="msg_0261_P01R0303_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Bateau Express Aquaria est\narrivé au port d’Oliville!</language>
	</row>
	<row id="msg_0261_P01R0303_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Bateau Express Aquaria est\narrivé au port de Carmin sur Mer.</language>
	</row>
	<row id="msg_0261_P01R0303_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zzzz... Zzzz...\rGnqwaah?\nPaaas d’problème, j’dors paaaas...\rZzzz... Zzzz...</language>
	</row>
	<row id="msg_0261_P01R0303_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quoi?! Comment ça, je dormais?!\nÇa va pas de dire des choses pareilles?!\rComme si un marin en service pouvait\nprendre une pause non autorisée pour\fpiquer un bon petit roupillon!!\rJe vais t’apprendre!\nCombat de Pokémon!\r</language>
	</row>
	<row id="msg_0261_P01R0303_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cette défaite m’a ouvert les yeux!\rJe vais devenir sérieux, je travaillerai\ncomme il faut, promis! Alors, ne répète\fpas au Capitaine que je dormais, OK?\r</language>
	</row>
</body>
