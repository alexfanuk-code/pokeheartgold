<?xml version="1.0"?>
<body language="English">
	<row id="msg_0312_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue au Pokéathlon!\rVoulez-vous inscrire vos Pokémon? {YESNO 0}</language>
	</row>
	<row id="msg_0312_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue à la Coupe des Cracks!\rIl s’agit d’une compétition réservée à\nla crème des Poké Athlètes!\fSouhaitez-vous essayer? {YESNO 0}</language>
	</row>
	<row id="msg_0312_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Désireriez-vous autre chose? {YESNO 0}</language>
	</row>
	<row id="msg_0312_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A quel parcours voulez-vous vous\ninscrire? {YESNO 0}</language>
	</row>
	<row id="msg_0312_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le {STRVAR_4 1, 3, 0},\nc’est bien cela? {YESNO 0}</language>
	</row>
	<row id="msg_0312_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Par ici, s’il vous plaît!\r</language>
	</row>
	<row id="msg_0312_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La compétition va commencer sans\ntarder. Votre équipe sera en rouge.\rBonne chance!\r</language>
	</row>
	<row id="msg_0312_00007" index="7">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0312_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} enfile son jogging!</language>
	</row>
	<row id="msg_0312_00009" index="9">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0312_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nous espérons vous compter parmi nos\nparticipants une prochaine fois!</language>
	</row>
	<row id="msg_0312_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Que souhaitez-vous savoir? {YESNO 0}</language>
	</row>
	<row id="msg_0312_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Pokéathlon est une compétition où\nles Pokémon s’affrontent par groupes\fde 3 dans 3 épreuves distinctes.\rLes épreuves des parcours sont\nadaptées aux différentes particularités\fdes Pokémon.\rN’hésitez pas à participer au\nPokéathlon avec 3 de vos Pokémon!\r</language>
	</row>
	<row id="msg_0312_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La Coupe des Cracks est un parcours où\ns’affrontent quelques-uns des\fmeilleurs Poké Athlètes de chaque\frégion.\rUne victoire à cette Coupe vous\nrapporte beaucoup plus de points!\fEssayez donc d’y participer avec vos\fmeilleurs Pokémon!\r</language>
	</row>
	<row id="msg_0312_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Parcours Vitesse est constitué de 3\népreuves basées sur la rapidité.\rCours’Obstacles:\nSautez les haies pour finir en premier!\rCapture Drapeau:\nVite, ramassez les drapeaux!\rCourse de Relais:\nUn travail d’équipe est indispensable!\rSi vous gagnez, vous décrocherez\nla Médaille Vitesse!\rN’hésitez pas à participer avec 3\nPokémon rapides!\r</language>
	</row>
	<row id="msg_0312_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Parcours Force est constitué de 3\népreuves basées sur la puissance.\rCasse Roc:\nBrisez les rochers empilés!\rCercle Musical:\nPoussez pour entrer dans les cercles!\rBalle au But:\nDispersez l’ennemi et tirez au but!\rSi vous gagnez, vous décrocherez\nla Médaille Force!\rN’hésitez pas à participer avec 3\nPokémon puissants!\r</language>
	</row>
	<row id="msg_0312_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Parcours Endurance est constitué de\n3 épreuves basées sur la résistance.\rCombat Ring-Out:\nEnvoyez voler vos ennemis hors du ring!\rCourse de Relais:\nCombinez les efforts de vos 3 Pokémon!\rCasse Roc:\nBrisez tout jusqu’à l’épuisement!\rSi vous gagnez, vous décrocherez\nla Médaille Endurance!\rN’hésitez pas à participer avec 3\nPokémon résistants!\r</language>
	</row>
	<row id="msg_0312_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Parcours Saut est constitué de 3\népreuves basées sur la détente.\rSaute-Lumière:\nVoltigez et touchez les lumières!\rAttrap’Disques:\nSautez pour attraper les frisbees!\rCours’Obstacles:\nFranchissez les haies avec élégance!\rSi vous gagnez, vous décrocherez\nla Médaille Saut!\rN’hésitez pas à participer avec 3\nPokémon qui ont de la détente!\r</language>
	</row>
	<row id="msg_0312_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Parcours Habileté est constitué de 3\népreuves basées sur l’adresse.\rBataille Neige:\nVisez bien avec les boules de neige!\rBalle au But:\nTirez droit au but!\rCapture Drapeau:\nVolez les drapeaux rapidement!\rSi vous gagnez, vous décrocherez\nla Médaille Habileté!\rN’hésitez pas à participer avec 3\nPokémon adroits!\r</language>
	</row>
	<row id="msg_0312_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci d’avoir participé!\rJe convertis votre score en\nPoints Athlète.\r</language>
	</row>
	<row id="msg_0312_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} obtient {STRVAR_1 53, 2, 0} points!</language>
	</row>
	<row id="msg_0312_00021" index="21">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0312_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et en récompense de votre victoire,\nvoici {STRVAR_1 52, 2, 0} points bonus!\r</language>
	</row>
	<row id="msg_0312_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Félicitations!\nEn récompense de ses résultats\fexceptionnels, le Poké Athlète\f{STRVAR_1 3, 0, 0} peut accéder\fà la salle Confiance du musée.\r</language>
	</row>
	<row id="msg_0312_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Félicitations!\nEn récompense de ses résultats\fexceptionnels, le Poké Athlète\f{STRVAR_1 3, 0, 0} peut accéder\fà la salle Potentiel du musée.\r</language>
	</row>
	<row id="msg_0312_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Félicitations!\nEn récompense de ses résultats\fexceptionnels, le Poké Athlète\f{STRVAR_1 3, 0, 0} peut accéder\fà la salle Amitié du musée.\r</language>
	</row>
	<row id="msg_0312_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue au Pokéathlon Link!\rVous pouvez vous joindre à des amis\npour faire s’affronter vos Pokémon\fsur le même parcours.\rVoulez-vous participer\nau Pokéathlon Link? {YESNO 0}</language>
	</row>
	<row id="msg_0312_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Veuillez choisir lequel d’entre vous\nsera le meneur du groupe.\rLes autres joueurs devront choisir\n“JOINDRE”. {YESNO 0}</language>
	</row>
	<row id="msg_0312_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La communication sans fil DS\nva démarrer. {YESNO 0}</language>
	</row>
	<row id="msg_0312_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erreur de communication.\rVeuillez recommencer l’enregistrement\ndepuis le début.</language>
	</row>
	<row id="msg_0312_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Participer à {STRVAR_4 1, 3, 0}.\nVotre équipe sera en rouge.</language>
	</row>
	<row id="msg_0312_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Participer à {STRVAR_4 1, 3, 0}.\nVotre équipe sera en bleu.</language>
	</row>
	<row id="msg_0312_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Participer à {STRVAR_4 1, 3, 0}.\nVotre équipe sera en vert.</language>
	</row>
	<row id="msg_0312_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Participer à {STRVAR_4 1, 3, 0}.\nVotre équipe sera en jaune.</language>
	</row>
	<row id="msg_0312_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour vous récompenser d’avoir fini\ndeuxième, voici {STRVAR_1 52, 2, 0} points bonus!\r</language>
	</row>
	<row id="msg_0312_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} enfile son jogging!</language>
	</row>
	<row id="msg_0312_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Par ici, s’il vous plaît!</language>
	</row>
	<row id="msg_0312_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, un instant! Vous n’avez pas assez\nde Pokémon pour participer.\rIl faut au moins 3 Pokémon pour\npouvoir s’inscrire au Pokéathlon.\rLe Pokéathlon est encore plus amusant\nquand on a plein de Pokémon!\rEssayez d’en attraper le plus possible!\n</language>
	</row>
	<row id="msg_0312_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue au Pokéathlon Link!\rMais...!\nC’est votre première fois?\rDans ce cas, rendez-vous à la\nréception pour les inscriptions solo.\rLe bureau de la réception est celui\ndu milieu sur votre droite.\rVous pourrez y recevoir toutes les\nexplications nécessaires sur le\fPokéathlon.</language>
	</row>
	<row id="msg_0312_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Pokéathlon Link est une compétition\noù les Pokémon s’affrontent par\fgroupes de 3 au cours de 4 épreuves.\rVos amis peuvent vous affronter\nsur le même parcours que vous.\rLes épreuves des parcours sont\nadaptées aux différentes particularités\fdes Pokémon.\rN’hésitez pas à participer\nau Pokéathlon Link avec vos amis!\r</language>
	</row>
	<row id="msg_0312_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Parcours Vitesse&amp;Saut est\nconstitué de 4 épreuves basées sur\fla rapidité et la détente.\rCours’Obstacles:\nSautez les haies pour finir en premier!\rSaute-Lumière:\nSautez pour toucher les lumières!\rAttrap’Disques:\nVite, attrapez les frisbees!\rCourse de Relais:\nVitesse est le maître-mot!\rSi vous gagnez, vous décrocherez\nla Médaille Vitesse et la Médaille Saut!\rN’hésitez pas à participer avec 3\nPokémon rapides ayant\fde la détente!\r</language>
	</row>
	<row id="msg_0312_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Parcours Saut&amp;Habileté est\nconstitué de 4 épreuves basées\fsur la détente et l’adresse.\rSaute-Lumière:\nSautez pour toucher les lumières!\rAttrap’Disques:\nSautez pour attraper les frisbees!\rCapture Drapeau:\nVolez les drapeaux avec adresse!\rBataille Neige:\nVisez bien et tirez!\rSi vous gagnez, vous décrocherez\nla Médaille Saut et la Médaille Habileté!\rN’hésitez pas à participer avec 3\nPokémon adroits ayant\fde la détente!\r</language>
	</row>
	<row id="msg_0312_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Parcours Habileté&amp;Force est\nconstitué de 4 épreuves basées\fsur l’adresse et la puissance.\rBalle au But:\nShootez de toutes vos forces!\rBataille Neige:\nA vos marques, prêts, lancez!\rCapture Drapeau:\nVolez les drapeaux avec adresse!\rCasse Roc:\nSus aux rocs!\rSi vous gagnez, vous décrocherez\nla Médaille Habileté et\fla Médaille Force!\rN’hésitez pas à participer avec 3\nPokémon adroits et puissants!\r</language>
	</row>
	<row id="msg_0312_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Parcours Force&amp;Endurance est\nconstitué de 4 épreuves basées\fsur la puissance et la résistance.\rCasse Roc:\nSus aux rocs!\rCercle Musical:\nPoussez pour entrer dans les cercles!\rBalle au But:\nTirez au but de toutes vos forces!\rCombat Ring-Out:\nRestez sur le ring et virez les autres!\rSi vous gagnez, vous décrocherez\nla Médaille Force et\fla Médaille Endurance!\rN’hésitez pas à participer avec 3\nPokémon puissants et résistants!\r</language>
	</row>
	<row id="msg_0312_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Parcours Endurance&amp;Vitesse est\nconstitué de 4 épreuves basées\fsur la résistance et la rapidité.\rCourse de Relais:\nIl faut vitesse et endurance!\rCombat Ring-Out:\nRestez sur le ring et virez les autres!\rCours’Obstacles:\nSautez les haies pour finir en premier!\rCercle Musical:\nPoussez pour entrer dans les cercles!\rSi vous gagnez, vous décrocherez\nla Médaille Endurance et\fla Médaille Vitesse!\rN’hésitez pas à participer avec 3\nPokémon résistants et rapides!\r</language>
	</row>
	<row id="msg_0312_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Parcours Master est constitué\nde différentes épreuves qui\fchangent à chaque fois.\rRéfléchissez bien à quelle équipe pourra\nen venir à bout!\rVous ne décrocherez pas de Médailles.\nPar contre, vous gagnerez le double de\fPoints Athlète!\rRéunissez-vous avec des amis et\nessayez donc ce parcours!\r</language>
	</row>
	<row id="msg_0312_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le score de {STRVAR_1 3, 0, 0} est de\n{STRVAR_1 52, 1, 0} points.\fCela fait {STRVAR_1 53, 2, 0} Points Athlète!\r</language>
	</row>
	<row id="msg_0312_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le score de {STRVAR_1 3, 0, 0} est de\n{STRVAR_1 52, 1, 0} points.\rVos points sont doublés dans le\nParcours Master, ce qui fait\f{STRVAR_1 53, 2, 0} Points Athlète!\r</language>
	</row>
