<?xml version="1.0"?>
<body language="English">
	<row id="msg_0246_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ding dong! Temps écoulé!\nLe Concours est terminé.\r</language>
	</row>
	<row id="msg_0246_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ding dong! Vous n’avez plus de\nCompét’Balls. Le Concours est terminé.\r</language>
	</row>
	<row id="msg_0246_00002" index="2">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0246_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il vous reste {STRVAR_1 51, 0, 0} minute(s).\nDésirez-vous arrêter? {YESNO 0}</language>
	</row>
	<row id="msg_0246_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nous sommes mardi!\nC’est le jour du Concours\fde Capture d’insecte!\rLes règles sont simples.\rAvec un Pokémon de votre équipe, il\nfaut attraper un Pokémon Insecte qui\fsera ensuite comparé aux autres.\rAlors? Tentez-vous votre chance? {YESNO 0}</language>
	</row>
	<row id="msg_0246_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nous sommes jeudi!\nC’est le jour du Concours\fde Capture d’insecte!\rLes règles sont simples.\rAvec un Pokémon de votre équipe, il\nfaut attraper un Pokémon Insecte qui\fsera ensuite comparé aux autres.\rAlors? Tentez-vous votre chance? {YESNO 0}</language>
	</row>
	<row id="msg_0246_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nous sommes samedi!\nC’est le jour du Concours\fde Capture d’insecte!\rLes règles sont simples.\rAvec un Pokémon de votre équipe, il\nfaut attraper un Pokémon Insecte qui\fsera ensuite comparé aux autres.\rAlors? Tentez-vous votre chance? {YESNO 0}</language>
	</row>
	<row id="msg_0246_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Concours de Capture se déroule\nle mardi, le jeudi et le samedi.\rOn peut y gagner un prix rien qu’en\nparticipant, mais on garde aussi le\fPokémon Insecte capturé!</language>
	</row>
	<row id="msg_0246_00008" index="8">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0246_00009" index="9">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0246_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh oh...\nVous avez plus d’un Pokémon\fdans votre équipe!\rVous devrez utiliser {STRVAR_1 1, 0, 0}.\rEtes-vous d’accord? {YESNO 0}</language>
	</row>
	<row id="msg_0246_00011" index="11">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0246_00012" index="12">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0246_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} confie ses Pokémon au\nRéceptionniste.\rParfait. Je vais garder les autres\nPokémon pendant le concours.\r</language>
	</row>
	<row id="msg_0246_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voici des Compét’Balls pour le\nconcours.\r{STRVAR_1 3, 0, 0} reçoit 20 Compét’Balls.\r</language>
	</row>
	<row id="msg_0246_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La personne qui capture le Pokémon\nInsecte le plus puissant est désignée\fvainqueur.\rLa partie dure 20 minutes.\rSi vous tombez à court de\nCompét’Balls, c’est fini!\rLe dernier Pokémon attrapé peut être\ngardé.\rJe déclare la chasse aux Pokémon\nInsecte ouverte!\r</language>
	</row>
	<row id="msg_0246_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Toutes mes excuses, vous n’avez plus\nla place de capturer des Pokémon.</language>
	</row>
	<row id="msg_0246_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vraiment?\nA une prochaine fois dans ce cas.</language>
	</row>
	<row id="msg_0246_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le concours d’aujourd’hui est terminé.\nRevenez une autre fois.</language>
	</row>
	<row id="msg_0246_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Certains Pokémon n’apparaissent que\ndans le parc.</language>
	</row>
	<row id="msg_0246_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}?\rVoilà votre prix.\nNous l’avons gardé pour vous.\r</language>
	</row>
	<row id="msg_0246_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh oh... Votre Sac est plein.\rNous allons garder votre prix.\rFaites de la place et revenez me voir.</language>
	</row>
	<row id="msg_0246_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’espère que vous participerez au\nprochain Concours de Capture!</language>
	</row>
	<row id="msg_0246_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous avez encore {STRVAR_1 51, 0, 0} minute(s).\rVoulez-vous vous arrêter\nmaintenant? {YESNO 0}</language>
	</row>
	<row id="msg_0246_00024" index="24">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0246_00025" index="25">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0246_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vraiment? Alors faites de votre mieux\net revenez me voir plus tard!\r</language>
	</row>
	<row id="msg_0246_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vraiment?\nAlors attendez ici pour connaître\fle nom des vainqueurs.\r</language>
	</row>
	<row id="msg_0246_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Revenez après avoir réordonné\nvotre équipe!</language>
	</row>
	<row id="msg_0246_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nous allons maintenant juger vos\nPokémon capturés.\r...\n...\rNous avons choisi les vainqueurs!\rEtes-vous prêts?\r</language>
	</row>
	<row id="msg_0246_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En troisième position:\n{STRVAR_1 3, 0, 0}, qui a capturé\fun {STRVAR_1 0, 1, 0}!\r</language>
	</row>
	<row id="msg_0246_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En troisième position:\n{STRVAR_1 3, 0, 0}, {STRVAR_1 14, 2, 0},\fqui a capturé un {STRVAR_1 0, 1, 0}!\r</language>
	</row>
	<row id="msg_0246_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le score est de {STRVAR_1 52, 3, 0} points!\r</language>
	</row>
	<row id="msg_0246_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En deuxième position:\n{STRVAR_1 3, 0, 0}, qui a capturé\fun {STRVAR_1 0, 1, 0}!\r</language>
	</row>
	<row id="msg_0246_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En deuxième position:\n{STRVAR_1 3, 0, 0}, {STRVAR_1 14, 2, 0},\fqui a capturé un {STRVAR_1 0, 1, 0}!\r</language>
	</row>
	<row id="msg_0246_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et la première place du Concours de\nCapture d’insecte revient à...\r{STRVAR_1 3, 0, 0}, qui a capturé un\n{STRVAR_1 0, 1, 0}!\r</language>
	</row>
	<row id="msg_0246_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et la première place du Concours de\nCapture d’insecte revient à...\r{STRVAR_1 3, 0, 0}, {STRVAR_1 14, 2, 0},\nqui a capturé un {STRVAR_1 0, 1, 0}!\r</language>
	</row>
	<row id="msg_0246_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et voici l’objet {STRVAR_1 8, 3, 0} pour\nrécompenser la victoire\fde {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0246_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et voici l’objet {STRVAR_1 8, 3, 0} pour\nrécompenser la deuxième place\fde {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0246_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et voici l’objet {STRVAR_1 8, 3, 0} pour\nrécompenser la troisième place\fde {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0246_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 8, 3, 0} pour tous\nen lot de consolation!\r</language>
	</row>
	<row id="msg_0246_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh oh... Votre Sac est plein.\rNous allons garder votre prix.\rFaites de la place et revenez me voir.\r</language>
	</row>
	<row id="msg_0246_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’espère que vous participerez au\nprochain Concours de Capture!\r</language>
	</row>
	<row id="msg_0246_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Donner un surnom\nau {STRVAR_1 0, 1, 0}? {YESNO 0}</language>
	</row>
	<row id="msg_0246_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}?\rVoilà votre prix.\nNous l’avons gardé pour vous.\r</language>
	</row>
	<row id="msg_0246_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh oh... Votre Sac est plein.\rNous allons garder votre prix.\rFaites de la place et revenez me voir.\r</language>
	</row>
	<row id="msg_0246_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’équipe est au complet!\nLe {STRVAR_1 1, 5, 0} est envoyé dans\fune Boîte PC.\r</language>
	</row>
	<row id="msg_0246_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voici les Pokémon que nous gardions\npour vous. Merci bien!\r</language>
	</row>
	<row id="msg_0246_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jean-Raoul: Je vais gagner!\nNe viens pas m’embêter!</language>
	</row>
	<row id="msg_0246_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jean-Raoul: Ça dépend entièrement de\nta chance qu’un bon Pokémon apparaisse\fou non...</language>
	</row>
	<row id="msg_0246_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jean-Raoul: T’as gagné?\rOuah, la chance!\nJ’suis trop jaloux!</language>
	</row>
	<row id="msg_0246_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odilon: Mon PARASECT endort\navec Spore.</language>
	</row>
	<row id="msg_0246_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odilon: Impossible de gagner si on\nne présente pas un Pokémon en\fpleine forme.</language>
	</row>
	<row id="msg_0246_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odilon: T’as trop de bol. Et moi,\nj’suis maudit.</language>
	</row>
	<row id="msg_0246_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Samia: J’entraîne un super Pokémon\npour ce Concours.</language>
	</row>
	<row id="msg_0246_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Samia: On m’a dit que les Pokémon avec\nde jolies couleurs avaient plus de\fchances de gagner... C’est vrai?</language>
	</row>
	<row id="msg_0246_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Samia: Tu es tout simplement formidable!</language>
	</row>
	<row id="msg_0246_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Marcel: Gagner m’intéresse moins\nque trouver des Pokémon rares.</language>
	</row>
	<row id="msg_0246_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Marcel: Quelle joie d’avoir trouvé\nle Pokémon que je voulais!</language>
	</row>
	<row id="msg_0246_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Marcel: Tu as gagné?\nQu’as-tu attrapé? Montre!</language>
	</row>
	<row id="msg_0246_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Foulque: ...\n... Chut!\rTu vas faire fuir INSECATEUR.\nParle-moi plus tard.</language>
	</row>
	<row id="msg_0246_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Foulque: La dernière fois, j’ai attrapé\nun INSECATEUR et pourtant j’ai perdu!</language>
	</row>
	<row id="msg_0246_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Foulque: Je suis uniquement venu en\nrepérage aujourd’hui.\rLa prochaine fois, pas de quartier!</language>
	</row>
	<row id="msg_0246_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">René: Il faut d’abord affaiblir un\nPokémon Insecte avant de lancer\fune Poké Ball.</language>
	</row>
	<row id="msg_0246_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">René: Les Pokémon de niveau élevé ont\nplus de chances de gagner...\fMais ce n’est pas le seul facteur.</language>
	</row>
	<row id="msg_0246_00065" index="65">
		<attribute name="window_context_name">used</attribute>
		<language name="English">René: Le Pokémon que tu as capturé...\nIl est super!</language>
	</row>
	<row id="msg_0246_00066" index="66">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sandy: J’adore les Pokémon Insecte!</language>
	</row>
	<row id="msg_0246_00067" index="67">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sandy: J’adore les Pokémon Insecte.\rJe te l’ai déjà dit?</language>
	</row>
	<row id="msg_0246_00068" index="68">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sandy: Bravo pour ta victoire!\rAu fait, tu sais quoi?\nJ’adore les Pokémon Insecte.</language>
	</row>
	<row id="msg_0246_00069" index="69">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arnaud: Je collectionne les Pokémon\nInsecte depuis ma plus tendre enfance.\rJe ne peux pas perdre!</language>
	</row>
	<row id="msg_0246_00070" index="70">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arnaud: Il paraît que quelqu’un a déjà\ngagné avec un CHENIPAN!</language>
	</row>
	<row id="msg_0246_00071" index="71">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arnaud: Au Concours de Capture\nd’insecte, on ne capture pas des\fPokémon Oiseaux, mais des Pokémon\fInsecte.\rTu dois le savoir, puisque tu as gagné?</language>
	</row>
	<row id="msg_0246_00072" index="72">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gontran: Plutôt que de parler, tu\ndevrais chercher des Pokémon.</language>
	</row>
	<row id="msg_0246_00073" index="73">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gontran: Zut! Je pensais vraiment\navoir plus de points.</language>
	</row>
	<row id="msg_0246_00074" index="74">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gontran: Déception...\nDéception... qui me servira de leçon...</language>
	</row>
	<row id="msg_0246_00075" index="75">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cyril: J’ai étudié les Pokémon Insecte\nà fond. Je vais gagner...\rC’est sûr!</language>
	</row>
	<row id="msg_0246_00076" index="76">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cyril: Il ne suffit pas d’étudier pour\ngagner...</language>
	</row>
	<row id="msg_0246_00077" index="77">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cyril: Tu veux bien me donner\ndes conseils?\rMoi aussi, je veux gagner!</language>
	</row>
