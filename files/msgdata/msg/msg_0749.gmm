	<row id="msg_0749_00287" index="287">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur se\nrepose pour guérir\nd’un empoisonnement,\nd’une brûlure ou\nd’une paralysie.</language>
