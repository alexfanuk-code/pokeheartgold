	</row>
	<row id="msg_0749_00291" index="291">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une attaque en 2\ntours. Le lanceur\nplonge sous l’eau au\n1¹ tour et frappe\nau 2⁴.</language>
