<?xml version="1.0"?>
<body language="English">
	<row id="msg_0749_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">\n\n\n\n</language>
	</row>
	<row id="msg_0749_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ecrase l’ennemi\navec les pattes\navant, la queue, etc.</language>
	</row>
	<row id="msg_0749_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’ennemi est tranché\nviolemment. Taux de\ncritiques élevé.</language>
	</row>
	<row id="msg_0749_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gifle rapidement\nl’ennemi de 2 à 5 fois\nd’affilée.</language>
	</row>
	<row id="msg_0749_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une tornade de coups\nde poing qui frappe de\n2 à 5 fois d’affilée.</language>
	</row>
	<row id="msg_0749_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’ennemi reçoit un\ncoup de poing d’une\npuissance incroyable.</language>
	</row>
	<row id="msg_0749_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Des pièces sont\nlancées sur l’ennemi.\nPermet d’obtenir de\nl’argent à la fin du\ncombat.</language>
	</row>
	<row id="msg_0749_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un coup de poing\nenflammé vient\nfrapper l’ennemi. Peut\nle brûler.</language>
	</row>
	<row id="msg_0749_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un coup de poing glacé\nvient frapper\nl’ennemi. Peut le\ngeler.</language>
	</row>
	<row id="msg_0749_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un coup de poing\nélectrique vient\nfrapper l’ennemi. Peut\nle paralyser.</language>
	</row>
	<row id="msg_0749_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lacère l’ennemi avec\ndes griffes acérées\npour lui infliger des\ndégâts.</language>
	</row>
	<row id="msg_0749_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">De gigantesques\nbarres se saisissent\nde l’ennemi pour\nl’écraser.</language>
	</row>
	<row id="msg_0749_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">De méchantes pinces\nlacèrent l’ennemi, le\nmettant K.O. sur le\ncoup s’il est touché.</language>
	</row>
	<row id="msg_0749_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Attaque en 2 tours.\nDes lames de vent\nfrappent l’ennemi au\n2⁴ tour. Taux de\ncritiques élevé.</language>
	</row>
	<row id="msg_0749_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Danse frénétique qui\nexalte l’esprit\ncombatif. Augmente\nconsidérablement\nl’Attaque du lanceur.</language>
	</row>
	<row id="msg_0749_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Coupe l’ennemi avec\ndes lames ou des\ngriffes. Hors combat,\npermet de couper des\narbres fins.</language>
	</row>
	<row id="msg_0749_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur bat des\nailes pour générer\nune bourrasque qui\nblesse l’ennemi.</language>
	</row>
	<row id="msg_0749_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’ennemi est frappé\npar de larges ailes\ndéployées pour\ninfliger des dégâts.</language>
	</row>
	<row id="msg_0749_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ejecte le Pokémon\nennemi et le remplace\npar un autre. Dans la\nnature, met fin au\ncombat.</language>
	</row>
	<row id="msg_0749_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur s’envole\nau 1¹ tour et frappe\nau 2⁴. Permet aussi\nd’être porté dans une\nville connue.</language>
	</row>
	<row id="msg_0749_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ligote l’ennemi avec\nles tentacules ou le\ncorps pour l’écraser\ndurant 2 à 5 tours.</language>
	</row>
	<row id="msg_0749_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fouette l’ennemi\navec la queue, une\nliane, etc. pour\ninfliger des dégâts.</language>
	</row>
	<row id="msg_0749_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fouette l’ennemi avec\nde fines lianes pour\ninfliger des dégâts.</language>
	</row>
	<row id="msg_0749_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ecrase l’ennemi avec\nun énorme pied. Peut\naussi l’apeurer.</language>
	</row>
	<row id="msg_0749_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Deux coups de pied\nqui frappent l’ennemi\ndeux fois d’affilée.</language>
	</row>
	<row id="msg_0749_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un coup de pied\nsuperpuissant et\nintense qui frappe\nl’ennemi.</language>
	</row>
	<row id="msg_0749_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur s’envole\npour décocher un\ncoup de pied sauté.\nS’il échoue, le\nlanceur se blesse.</language>
	</row>
	<row id="msg_0749_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur effectue\nun coup de pied\ntournoyant et\nextrêmement rapide.</language>
	</row>
	<row id="msg_0749_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lance du sable au\nvisage de l’ennemi\npour baisser sa\nprécision.</language>
	</row>
	<row id="msg_0749_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur donne un\ncoup de tête. Peut\napeurer l’ennemi.\nPeut faire tomber des\nPokémon des arbres.</language>
	</row>
	<row id="msg_0749_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Frappe l’ennemi d’un\ncoup de corne pointue\npour infliger des\ndégâts.</language>
	</row>
	<row id="msg_0749_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Frappe l’ennemi 2 à 5\nfois d’affilée avec un\nbec ou une corne.</language>
	</row>
	<row id="msg_0749_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un coup de corne en\nvrille qui empale\nl’ennemi, le mettant\nK.O. sur le coup s’il\nest touché.</language>
	</row>
	<row id="msg_0749_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur charge\nl’ennemi et le percute\nde tout son corps.</language>
	</row>
	<row id="msg_0749_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur se laisse\ntomber sur l’ennemi\nde tout son poids.\nPeut le paralyser.</language>
	</row>
	<row id="msg_0749_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur ligote\nl’ennemi avec des\nlianes ou son corps\npour l’écraser durant\n2 à 5 tours.</language>
	</row>
	<row id="msg_0749_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une charge violente\nqui blesse aussi\nlégèrement le\nlanceur.</language>
	</row>
	<row id="msg_0749_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une attaque furieuse\nqui dure de 2 à 3\ntours. Le lanceur\ndevient confus.</language>
	</row>
	<row id="msg_0749_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une dangereuse\ncharge. Inflige aussi\ndes dégâts assez\nimportants au\nlanceur.</language>
	</row>
	<row id="msg_0749_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur remue son\nadorable queue pour\ntromper la vigilance\nde l’ennemi et baisser\nsa Défense.</language>
	</row>
	<row id="msg_0749_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un dard toxique qui\ntransperce l’ennemi.\nPeut aussi\nl’empoisonner.</language>
	</row>
	<row id="msg_0749_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un double coup de\ndards qui transperce\nl’ennemi. Peut aussi\nl’empoisonner.</language>
	</row>
	<row id="msg_0749_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Envoie une rafale de\ndards. Peut toucher\nde 2 à 5 fois.</language>
	</row>
	<row id="msg_0749_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur fait les\ngros yeux à l’ennemi\npour l’intimider et\nbaisser sa Défense.</language>
	</row>
	<row id="msg_0749_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’ennemi est mordu\npar de tranchantes\ncanines. Peut\nl’apeurer.</language>
	</row>
	<row id="msg_0749_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur pousse un\ncri tout mimi pour\ntromper la vigilance\nde l’ennemi et baisser\nson Attaque.</language>
	</row>
	<row id="msg_0749_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Effraie le Pokémon\nennemi et le remplace\npar un autre. Dans la\nnature, met fin au\ncombat.</language>
	</row>
	<row id="msg_0749_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une berceuse plonge\nl’ennemi dans un\nprofond sommeil.</language>
	</row>
	<row id="msg_0749_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur produit\nd’étranges ondes\nsonores qui\nrendent confus.</language>
	</row>
	<row id="msg_0749_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une onde de choc\ndestructrice qui\ninflige toujours 20 PV\nde dégâts.</language>
	</row>
	<row id="msg_0749_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Empêche l’ennemi\nd’employer à nouveau\nsa dernière attaque.\nDure plusieurs tours.</language>
	</row>
	<row id="msg_0749_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur attaque\nl’ennemi avec un jet\nd’acide corrosif. Peut\naussi baisser la Déf.\nSpé. de l’ennemi.</language>
	</row>
	<row id="msg_0749_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’ennemi est attaqué\npar de faibles\nflammes. Peut aussi le\nbrûler.</language>
	</row>
	<row id="msg_0749_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’ennemi reçoit un\ntorrent de flammes.\nPeut aussi le brûler.</language>
	</row>
	<row id="msg_0749_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une brume blanche\nenveloppe l’équipe du\nlanceur et empêche la\nréduction des stats\npour 5 tours.</language>
	</row>
	<row id="msg_0749_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">De l’eau est projetée\nsur l’ennemi en arc de\ncercle.</language>
	</row>
	<row id="msg_0749_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un puissant jet d’eau\nest dirigé sur\nl’ennemi.</language>
	</row>
	<row id="msg_0749_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une énorme vague\ns’abat sur le champ\nde bataille. Permet\naussi de voyager sur\nl’eau.</language>
	</row>
	<row id="msg_0749_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un rayon de glace\nfrappe l’ennemi. Peut\naussi le geler.</language>
	</row>
	<row id="msg_0749_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une violente tempête\nde neige est\ndéclenchée sur\nl’ennemi. Peut aussi\nle geler.</language>
	</row>
	<row id="msg_0749_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un étrange rayon\nfrappe l’ennemi. Peut\naussi le rendre\nconfus.</language>
	</row>
	<row id="msg_0749_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Des bulles sont\nenvoyées avec\npuissance sur\nl’ennemi. Peut aussi\nbaisser sa Vitesse.</language>
	</row>
	<row id="msg_0749_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Envoie un rayon\narc-en-ciel sur\nl’ennemi. Peut aussi\nbaisser son Attaque.</language>
	</row>
	<row id="msg_0749_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Projette un puissant\nrayon sur l’ennemi. Le\nlanceur doit se\nreposer au tour\nsuivant.</language>
	</row>
	<row id="msg_0749_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Frappe l’ennemi d’un\nbec pointu ou d’une\ncorne pour infliger\ndes dégâts.</language>
	</row>
	<row id="msg_0749_00065" index="65">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une attaque utilisant\nle bec comme une\nperceuse.</language>
	</row>
	<row id="msg_0749_00066" index="66">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur agrippe\nl’ennemi et l’écrase\nau sol. Blesse aussi\nlégèrement le\nlanceur.</language>
	</row>
	<row id="msg_0749_00067" index="67">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un puissant coup de\npied bas qui fauche\nl’ennemi. Il est plus\nefficace contre les\nennemis lourds.</language>
	</row>
	<row id="msg_0749_00068" index="68">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une riposte qui\ncontre toute attaque\nphysique en infligeant\nle double de dégâts.</language>
	</row>
	<row id="msg_0749_00069" index="69">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’ennemi est projeté\ngrâce au pouvoir de\nla gravité. Inflige des\ndégâts équivalents au\nniveau du lanceur.</language>
	</row>
	<row id="msg_0749_00070" index="70">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur cogne\nl’ennemi de toute sa\nforce. Permet aussi\nde déplacer des\nrochers.</language>
	</row>
	<row id="msg_0749_00071" index="71">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une attaque\nqui convertit la\nmoitié des dégâts\ninfligés en PV.</language>
	</row>
	<row id="msg_0749_00072" index="72">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une attaque\nqui convertit la\nmoitié des dégâts\ninfligés en PV.</language>
	</row>
	<row id="msg_0749_00073" index="73">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une graine est semée\nsur l’ennemi. A chaque\ntour, elle lui dérobe\ndes PV que le lanceur\nrécupère.</language>
	</row>
	<row id="msg_0749_00074" index="74">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le corps du lanceur\nse développe.\nAugmente l’Atq. Spé.</language>
	</row>
	<row id="msg_0749_00075" index="75">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Des feuilles aiguisées\ncomme des rasoirs\nentaillent l’ennemi.\nTaux de critiques\nélevé.</language>
	</row>
	<row id="msg_0749_00076" index="76">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Absorbe la lumière\nau premier tour et\nenvoie un rayon\npuissant au tour\nsuivant.</language>
	</row>
	<row id="msg_0749_00077" index="77">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une poudre toxique\nest lâchée sur\nl’ennemi. Peut\nl’empoisonner.</language>
	</row>
	<row id="msg_0749_00078" index="78">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur répand\nsur l’ennemi une\npoudre qui peut le\nparalyser.</language>
	</row>
	<row id="msg_0749_00079" index="79">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur répand une\npoudre soporifique\nsur l’ennemi. Peut\nl’endormir.</language>
	</row>
	<row id="msg_0749_00080" index="80">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur attaque en\nprojetant des pétales\npendant 2 à 3 tours\navant de céder à\nla confusion.</language>
	</row>
	<row id="msg_0749_00081" index="81">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur crache de\nla soie pour ligoter\nl’ennemi. Peut baisser\nla Vitesse de l’ennemi.</language>
	</row>
	<row id="msg_0749_00082" index="82">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une onde de choc\ndestructrice qui\ninflige toujours 40 PV\nde dégâts.</language>
	</row>
	<row id="msg_0749_00083" index="83">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un tourbillon de\nflammes emprisonne\nl’ennemi pendant 2 à 5\ntours.</language>
	</row>
	<row id="msg_0749_00084" index="84">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une décharge\nélectrique tombe sur\nl’ennemi. Peut aussi le\nparalyser.</language>
	</row>
	<row id="msg_0749_00085" index="85">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une grosse décharge\nélectrique tombe sur\nl’ennemi. Peut aussi le\nparalyser.</language>
	</row>
	<row id="msg_0749_00086" index="86">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un faible choc\nélectrique frappe\nl’ennemi. Si l’attaque\ntouche, l’ennemi est\nparalysé.</language>
	</row>
	<row id="msg_0749_00087" index="87">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La foudre tombe sur\nl’ennemi pour lui\ninfliger des dégâts.\nPeut aussi le\nparalyser.</language>
	</row>
	<row id="msg_0749_00088" index="88">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur lâche une\npierre sur l’ennemi.</language>
	</row>
	<row id="msg_0749_00089" index="89">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur provoque\nun tremblement de\nterre touchant tous\nles autres Pokémon\nau combat.</language>
	</row>
	<row id="msg_0749_00090" index="90">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur fait tomber\nl’ennemi dans une\ncrevasse. Si cette\nattaque réussit, elle\nmet K.O. sur le coup.</language>
	</row>
	<row id="msg_0749_00091" index="91">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur creuse au\n1¹ tour et frappe au\n2⁴. Permet aussi de\ns’échapper d’un\ndonjon.</language>
	</row>
	<row id="msg_0749_00092" index="92">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Empoisonne gravement\nl’ennemi. Les dégâts\ndus au poison\naugmentent à chaque\ntour.</language>
	</row>
	<row id="msg_0749_00093" index="93">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une faible vague\ntélékinésique frappe\nl’ennemi. Peut aussi\nle plonger dans la\nconfusion.</language>
	</row>
	<row id="msg_0749_00094" index="94">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une puissante force\ntélékinésique frappe\nl’ennemi. Peut aussi\nfaire baisser sa Déf.\nSpé.</language>
	</row>
	<row id="msg_0749_00095" index="95">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur hypnotise\nl’ennemi pour le\nplonger dans un\nprofond sommeil.</language>
	</row>
	<row id="msg_0749_00096" index="96">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur médite\npour éveiller son\npouvoir latent et\naugmenter son\nAttaque.</language>
	</row>
	<row id="msg_0749_00097" index="97">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur se relaxe\net allège son corps\npour augmenter\nconsidérablement sa\nVitesse.</language>
	</row>
	<row id="msg_0749_00098" index="98">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur fonce sur\nl’ennemi si rapidement\nqu’on parvient à peine\nà le discerner. Frappe\nen premier.</language>
	</row>
	<row id="msg_0749_00099" index="99">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une fois activée,\ncette capacité gagne\nen efficacité à mesure\nque le lanceur subit\ndes dégâts.</language>
	</row>
	<row id="msg_0749_00100" index="100">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Permet de fuir un\nPokémon sauvage.\nPermet aussi de\nrevenir au dernier\nCentre Pokémon.</language>
	</row>
	<row id="msg_0749_00101" index="101">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur invoque\nun mirage. Inflige des\ndégâts équivalents\nau niveau du lanceur.</language>
	</row>
	<row id="msg_0749_00102" index="102">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur imite la\ndernière capacité\nutilisée par l’ennemi,\npeut l’utiliser pour\nle reste du combat.</language>
	</row>
	<row id="msg_0749_00103" index="103">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cri strident qui baisse\nbeaucoup la Défense\nennemie.</language>
	</row>
	<row id="msg_0749_00104" index="104">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur se déplace\nsi vite qu’il crée des\ncopies illusoires de\nlui, augmentant\nson esquive.</language>
	</row>
	<row id="msg_0749_00105" index="105">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un soin qui permet au\nlanceur de récupérer\njusqu’à la moitié de\nses PV max.</language>
	</row>
	<row id="msg_0749_00106" index="106">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur contracte\ntous ses muscles pour\naugmenter sa\nDéfense.</language>
	</row>
	<row id="msg_0749_00107" index="107">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur comprime\nson corps pour se\nfaire tout petit et\naugmenter son\nesquive.</language>
	</row>
	<row id="msg_0749_00108" index="108">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur disperse\nun nuage d’encre ou\nde fumée. Réduit la\nprécision de l’ennemi.</language>
	</row>
	<row id="msg_0749_00109" index="109">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un rayon sinistre\nqui plonge l’ennemi\ndans un état de\nconfusion.</language>
	</row>
	<row id="msg_0749_00110" index="110">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur se\nrecroqueville dans sa\ncarapace, ce qui\naugmente sa Défense.</language>
	</row>
	<row id="msg_0749_00111" index="111">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur s’enroule\npour cacher ses\npoints faibles, ce qui\naugmente sa Défense.</language>
	</row>
	<row id="msg_0749_00112" index="112">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur érige un\nmur solide qui\naugmente fortement\nsa Défense.</language>
	</row>
	<row id="msg_0749_00113" index="113">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un fabuleux mur de\nlumière qui réduit les\ndégâts causés par les\nattaques spéciales\ndurant 5 tours.</language>
	</row>
	<row id="msg_0749_00114" index="114">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un brouillard qui\nannule les \nchangements\nde stats de tous les\nPokémon au combat.</language>
	</row>
	<row id="msg_0749_00115" index="115">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un fabuleux mur de\nlumière qui réduit les\ndégâts causés par les\nattaques physiques\ndurant 5 tours.</language>
	</row>
	<row id="msg_0749_00116" index="116">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur prend une\nprofonde respiration\net se concentre pour\naugmenter son taux\nde critiques.</language>
	</row>
	<row id="msg_0749_00117" index="117">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur encaisse\nles coups durant 2\ntours et réplique en\ninfligeant le double\ndes dégâts subis.</language>
	</row>
	<row id="msg_0749_00118" index="118">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Agite un doigt et\nstimule le cerveau\npour utiliser presque\nn’importe quelle\ncapacité au hasard.</language>
	</row>
	<row id="msg_0749_00119" index="119">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur contre\nl’attaque de l’ennemi\navec la même\nattaque.</language>
	</row>
	<row id="msg_0749_00120" index="120">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur explose\nen blessant tous les\nautres Pokémon au\ncombat. Le lanceur\ntombe K.O.</language>
	</row>
	<row id="msg_0749_00121" index="121">
		<attribute name="window_context_name">used</attribute>
		<language name="English">De toutes ses forces,\nle lanceur jette un\ngros œuf sur l’ennemi\npour lui infliger des\ndégâts.</language>
	</row>
	<row id="msg_0749_00122" index="122">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un grand coup de\nlangue qui inflige des\ndégâts à l’ennemi.\nPeut aussi le\nparalyser.</language>
	</row>
	<row id="msg_0749_00123" index="123">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur attaque à\nl’aide d’une éruption\nde gaz répugnants.\nPeut aussi\nempoisonner l’ennemi.</language>
	</row>
	<row id="msg_0749_00124" index="124">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Des détritus toxiques\nsont projetés sur\nl’ennemi. Peut aussi\nl’empoisonner.</language>
	</row>
	<row id="msg_0749_00125" index="125">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur frappe\nl’ennemi à grands\ncoups d’os. Peut\naussi apeurer\nl’ennemi.</language>
	</row>
	<row id="msg_0749_00126" index="126">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un déluge de flammes\nardentes submerge\nl’ennemi. Peut aussi le\nbrûler.</language>
	</row>
	<row id="msg_0749_00127" index="127">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur charge\nl’ennemi à une vitesse\nremarquable. Permet\naussi de franchir une\ncascade.</language>
	</row>
	<row id="msg_0749_00128" index="128">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur piège\nl’ennemi dans sa dure\ncoquille et l’écrase\npendant 2 à 5 tours.</language>
	</row>
	<row id="msg_0749_00129" index="129">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur envoie des\nrayons d’étoiles.\nTouche toujours\nl’ennemi.</language>
	</row>
	<row id="msg_0749_00130" index="130">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur baisse la\ntête pour augmenter\nsa Défense au 1¹\ntour et percuter\nl’ennemi au 2⁴.</language>
	</row>
	<row id="msg_0749_00131" index="131">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une rafale de pointes\naiguisées s’abat sur\nl’ennemi. Inflige de 2\nà 5 coups.</language>
	</row>
	<row id="msg_0749_00132" index="132">
		<attribute name="window_context_name">used</attribute>
		<language name="English">De longs tentacules\nou lianes attaquent\nl’ennemi. Peut aussi\nbaisser sa Vitesse.</language>
	</row>
	<row id="msg_0749_00133" index="133">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur fait le vide\ndans son esprit pour\noublier ses soucis.\nAugmente fortement\nsa Déf. Spé.</language>
	</row>
	<row id="msg_0749_00134" index="134">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur distrait\nl’ennemi en pliant\nune cuillère. Peut\nbaisser la précision\nde l’ennemi.</language>
	</row>
	<row id="msg_0749_00135" index="135">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur récupère\njusqu’à la moitié de\nses PV max. En\ndehors des combats,\nrestaure des PV.</language>
	</row>
	<row id="msg_0749_00136" index="136">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur s’élance\npour effectuer un\ncoup de genou sauté.\nS’il échoue, le\nlanceur se blesse.</language>
	</row>
	<row id="msg_0749_00137" index="137">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur intimide\nl’ennemi grâce à son\nregard terrifiant\npour le paralyser.</language>
	</row>
	<row id="msg_0749_00138" index="138">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Attaque réservée aux\nennemis endormis. Le\nlanceur récupère en\nPV la moitié des\ndégâts infligés.</language>
	</row>
	<row id="msg_0749_00139" index="139">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un nuage de gaz\ntoxique est projeté\nau visage de l’ennemi.\nPeut l’empoisonner.</language>
	</row>
	<row id="msg_0749_00140" index="140">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Projette de 2 à 5\ngrosses boules sur\nl’ennemi.</language>
	</row>
	<row id="msg_0749_00141" index="141">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une attaque qui aspire\nle sang de l’ennemi.\nLa moitié des dégâts\nsont convertis en\nPV pour le lanceur.</language>
	</row>
	<row id="msg_0749_00142" index="142">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur fait un\nbisou à l’ennemi en\nprenant une mine\neffrayante. Peut\nendormir l’ennemi.</language>
	</row>
	<row id="msg_0749_00143" index="143">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une attaque en 2\ntours au taux de\ncritiques élevé. Peut\naussi apeurer\nl’ennemi.</language>
	</row>
	<row id="msg_0749_00144" index="144">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur devient\nune copie de l’ennemi\net obtient la même\npalette de capacités.</language>
	</row>
	<row id="msg_0749_00145" index="145">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Des bulles frappent\nl’ennemi. Peut réduire\nsa Vitesse.</language>
	</row>
	<row id="msg_0749_00146" index="146">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un enchaînement de\ncoups de poing\ncadencés. Peut\naussi rendre confus.</language>
	</row>
	<row id="msg_0749_00147" index="147">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur répand un\nnuage de spores qui\nendort.</language>
	</row>
	<row id="msg_0749_00148" index="148">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Explosion lumineuse\nqui fait baisser la\nprécision de l’ennemi.\nPermet aussi d’éclai-\nrer les grottes.</language>
	</row>
	<row id="msg_0749_00149" index="149">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une étrange onde\nd’énergie chaude\nfrappe l’ennemi.\nCette attaque est\nd’intensité variable.</language>
	</row>
	<row id="msg_0749_00150" index="150">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur barbote\net éclabousse les\nenvirons. Cette\ncapacité n’a aucun\neffet.</language>
	</row>
	<row id="msg_0749_00151" index="151">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur modifie sa\nstructure moléculaire\npour se liquéfier et\naugmenter fortement\nsa Défense.</language>
	</row>
	<row id="msg_0749_00152" index="152">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une grande pince\nmartèle l’ennemi.\nCette capacité a un\ntaux de critiques\nélevé.</language>
	</row>
	<row id="msg_0749_00153" index="153">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur explose et\ninflige des dégâts à\ntous les autres\nPokémon au combat.\nMet K.O. le lanceur.</language>
	</row>
	<row id="msg_0749_00154" index="154">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’ennemi est lacéré\npar des faux ou des\ngriffes de 2 à 5\nfois.</language>
	</row>
	<row id="msg_0749_00155" index="155">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur projette\nson os comme un\nboomerang. Cette\nattaque frappe à\nl’aller et au retour.</language>
	</row>
	<row id="msg_0749_00156" index="156">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur dort\npendant 2 tours. Il\nregagne tous ses PV\net n’a plus de\nproblèmes de statut.</language>
	</row>
	<row id="msg_0749_00157" index="157">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Envoie de gros\nrochers sur l’ennemi\npour infliger des\ndégâts. Peut aussi\nl’apeurer.</language>
	</row>
	<row id="msg_0749_00158" index="158">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur mord\nl’ennemi à l’aide de\nses incisives\naiguisées. Peut aussi\napeurer l’ennemi.</language>
	</row>
	<row id="msg_0749_00159" index="159">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur réduit son\nnombre de polygones\npour accentuer ses\nangles et augmenter\nson Attaque.</language>
	</row>
	<row id="msg_0749_00160" index="160">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur change\nde type pour prendre\ncelui de l’une de\nses capacités.</language>
	</row>
	<row id="msg_0749_00161" index="161">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur envoie\ntrois boules d’énergie\nsimultanément. Peut\naussi paralyser, brû-\nler ou geler l’ennemi.</language>
	</row>
	<row id="msg_0749_00162" index="162">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une vilaine morsure\nd’incisives qui réduit\nde moitié les PV de\nl’ennemi.</language>
	</row>
	<row id="msg_0749_00163" index="163">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un coup de griffe ou\nautre tranche\nl’ennemi. Taux de\ncritiques élevé.</language>
	</row>
	<row id="msg_0749_00164" index="164">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur fait une\ncopie de lui-même en\nsacrifiant quelques\nPV. La copie sert de\nleurre.</language>
	</row>
	<row id="msg_0749_00165" index="165">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une attaque \ndésespérée, lancée\nquand le lanceur n’a\nplus de PP. Le blesse\naussi légèrement.</language>
	</row>
	<row id="msg_0749_00166" index="166">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur apprend\nle dernier coup\nutilisé par l’ennemi.\nGribouille disparaît\naprès utilisation.</language>
	</row>
	<row id="msg_0749_00167" index="167">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une salve de 1 à 3\ncoups de pied dont\nla puissance augmente\nà chaque coup porté.</language>
	</row>
	<row id="msg_0749_00168" index="168">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur attaque\nl’ennemi et vole son\nobjet. Le lanceur ne\npeut rien voler s’il\ntient déjà un objet.</language>
	</row>
	<row id="msg_0749_00169" index="169">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur enserre\nl’ennemi à l’aide d’une\nfine soie gluante pour\nl’empêcher de fuir le\ncombat.</language>
	</row>
	<row id="msg_0749_00170" index="170">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur analyse les\nmouvements de\nl’ennemi pour être\nplus sûr de toucher\nau coup suivant.</language>
	</row>
	<row id="msg_0749_00171" index="171">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un cauchemar qui\ninflige des dégâts à\nchaque tour à un\nennemi endormi.</language>
	</row>
	<row id="msg_0749_00172" index="172">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur s’entoure\nde feu et charge\nl’ennemi. Peut aussi\nbrûler l’ennemi.</language>
	</row>
	<row id="msg_0749_00173" index="173">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une attaque qui ne\nfonctionne que si le\nlanceur est endormi.\nLe boucan peut aussi\napeurer l’ennemi.</language>
	</row>
	<row id="msg_0749_00174" index="174">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une capacité qui\nfonctionne\ndifféremment pour\nles Pokémon Spectre.</language>
	</row>
	<row id="msg_0749_00175" index="175">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur fait\ntournoyer son fléau.\nPlus ses PV sont bas,\nplus l’attaque est\npuissante.</language>
	</row>
	<row id="msg_0749_00176" index="176">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur change\nde type pour être\nrésistant au type de\nla dernière attaque\nqui l’a touché.</language>
	</row>
	<row id="msg_0749_00177" index="177">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur projette\nune tornade sur\nl’ennemi pour infliger\ndes dégâts. Taux de\ncritiques élevé.</language>
	</row>
	<row id="msg_0749_00178" index="178">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur libère des\nspores cotonneuses\nqui collent à l’ennemi\net baissent fortement\nsa Vitesse.</language>
	</row>
	<row id="msg_0749_00179" index="179">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur ne retient\nplus ses coups. Plus\nses PV sont bas et\nplus l’attaque est\npuissante.</language>
	</row>
	<row id="msg_0749_00180" index="180">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur exprime\nson ressentiment\nen retirant 4 PP de\nla dernière attaque\nde l’ennemi.</language>
	</row>
	<row id="msg_0749_00181" index="181">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur projette\nde la neige poudreuse.\nPeut aussi geler\nl’ennemi.</language>
	</row>
	<row id="msg_0749_00182" index="182">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur esquive les\nattaques. Plus la\ncapacité est utilisée\nd’affilée, plus elle\nrisque d’échouer.</language>
	</row>
	<row id="msg_0749_00183" index="183">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Coup de poing\nfulgurant. Frappe en\npremier.</language>
	</row>
	<row id="msg_0749_00184" index="184">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une grimace qui\neffraie l’ennemi et\nréduit fortement\nsa Vitesse.</language>
	</row>
	<row id="msg_0749_00185" index="185">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur s’approche\nl’air de rien avant de\nfrapper par surprise.\nN’échoue jamais.</language>
	</row>
	<row id="msg_0749_00186" index="186">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur envoie\nun bisou si mignon\net désarmant qu’il\nplonge l’ennemi dans\nla confusion.</language>
	</row>
	<row id="msg_0749_00187" index="187">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Améliore l’Attaque\nau maximum en\nsacrifiant la moitié\ndes PV max.</language>
	</row>
	<row id="msg_0749_00188" index="188">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Envoie des détritus\nsur l’ennemi. Peut\naussi l’empoisonner.</language>
	</row>
	<row id="msg_0749_00189" index="189">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur envoie de\nla boue au visage de\nl’ennemi pour infliger\ndes dégâts et baisser\nsa précision.</language>
	</row>
	<row id="msg_0749_00190" index="190">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur attaque en\nprojetant de l’encre \nau visage de l’ennemi.\nPeut aussi baisser la\nprécision de l’ennemi.</language>
	</row>
	<row id="msg_0749_00191" index="191">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur disperse\ndes piquants sur le\nsol pour blesser les\nPokémon qui entrent\nau combat.</language>
	</row>
	<row id="msg_0749_00192" index="192">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un boulet de canon\nélectrifié qui inflige\ndes dégâts et peut\nparalyser l’ennemi.</language>
	</row>
	<row id="msg_0749_00193" index="193">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Permet de toucher un\nPokémon Spectre avec\nn’importe quelle capa-\ncité et de toucher un\nennemi insaisissable.</language>
	</row>
	<row id="msg_0749_00194" index="194">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quand cette capacité\nest activée, elle met\nK.O. un ennemi qui\nporte un coup fatal\nau lanceur.</language>
	</row>
	<row id="msg_0749_00195" index="195">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un Pokémon qui\nentend ce requiem est\nK.O. dans 3 tours à\nmoins qu’il ne quitte\nle combat.</language>
	</row>
	<row id="msg_0749_00196" index="196">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une bourrasque de\nvent froid blesse\nl’ennemi. Réduit aussi\nsa Vitesse.</language>
	</row>
	<row id="msg_0749_00197" index="197">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Permet d’esquiver\ntoutes les attaques.\nPlus on l’utilise\nd’affilée, plus elle a\nde chances d’échouer.</language>
	</row>
	<row id="msg_0749_00198" index="198">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur frappe\nl’ennemi 2 à 5 fois\navec un os.</language>
	</row>
	<row id="msg_0749_00199" index="199">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Verrouille l’ennemi\npour ne pas le rater\nau tour suivant.</language>
	</row>
	<row id="msg_0749_00200" index="200">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur laisse\néclater sa rage et\nattaque pendant 2 à\n3 tours avant de\ncéder à la confusion.</language>
	</row>
	<row id="msg_0749_00201" index="201">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une tempête de sable\nde 5 tours qui blesse\ntous les Pokémon sauf\nles types Roche, Sol\net Acier.</language>
	</row>
	<row id="msg_0749_00202" index="202">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une attaque qui\nconvertit la moitié\ndes dégâts infligés\nen PV.</language>
	</row>
	<row id="msg_0749_00203" index="203">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur résiste\naux attaques avec\n1 PV. Peut échouer\nsi utilisé plusieurs\nfois de suite.</language>
	</row>
	<row id="msg_0749_00204" index="204">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur fait les\nyeux doux pour berner\nl’ennemi et réduire\nconsidérablement\nson Attaque.</language>
	</row>
	<row id="msg_0749_00205" index="205">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un rocher roule sur\nl’ennemi pendant 5\ntours. L’attaque \ngagne en puissance\nà chaque coup.</language>
	</row>
	<row id="msg_0749_00206" index="206">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur retient\nses coups pour que\nl’ennemi garde au\nmoins 1 PV et ne\ntombe pas K.O.</language>
	</row>
	<row id="msg_0749_00207" index="207">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fait enrager l’ennemi\net le plonge dans la\nconfusion, mais\naugmente fortement\nson Attaque.</language>
	</row>
	<row id="msg_0749_00208" index="208">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Restaure jusqu’à la\nmoitié des PV max du\nlanceur. En dehors\ndes combats,\nrestaure des PV.</language>
	</row>
	<row id="msg_0749_00209" index="209">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lance une charge\nélectrique sur\nl’ennemi. Peut aussi\nle paralyser.</language>
	</row>
	<row id="msg_0749_00210" index="210">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un coup de faux ou de\ngriffe dont la force\naugmente quand il\ntouche plusieurs fois\nd’affilée.</language>
	</row>
	<row id="msg_0749_00211" index="211">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur frappe\nl’ennemi avec des\nailes d’acier. Peut\naussi augmenter la\nDéfense du lanceur.</language>
	</row>
	<row id="msg_0749_00212" index="212">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur pétrifie\nl’ennemi en lui lançant\nun regard noir. Il\ndevient incapable de\ns’enfuir.</language>
	</row>
	<row id="msg_0749_00213" index="213">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si l’ennemi est du\nsexe opposé, il tombe\namoureux et rechigne\nalors à attaquer.</language>
	</row>
	<row id="msg_0749_00214" index="214">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur utilise un\nde ses coup au hasard\nen dormant.</language>
	</row>
	<row id="msg_0749_00215" index="215">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Carillon apaisant qui\nsoigne les problèmes\nde statut de tous les\nPokémon de l’équipe.</language>
	</row>
	<row id="msg_0749_00216" index="216">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une attaque furieuse\ndont la puissance\naugmente quand le\nPokémon apprécie\nson Dresseur.</language>
	</row>
	<row id="msg_0749_00217" index="217">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur attaque en\noffrant un cadeau\npiégé à l’ennemi. Peut\nà l’inverse restaurer\ncertains de ses PV.</language>
	</row>
	<row id="msg_0749_00218" index="218">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moins le Pokémon aime\nson Dresseur, plus\ncette attaque est\npuissante.</language>
	</row>
	<row id="msg_0749_00219" index="219">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Champ protecteur\nempêchant tous les\nproblèmes de statut\npendant 5 tours.</language>
	</row>
	<row id="msg_0749_00220" index="220">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur ajoute\nses PV à ceux d’un\nautre Pokémon\net les répartit\néquitablement.</language>
	</row>
	<row id="msg_0749_00221" index="221">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un feu mystique\nd’une intensité\nredoutable attaque\nl’ennemi. Peut aussi\nle brûler.</language>
	</row>
	<row id="msg_0749_00222" index="222">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un tremblement\nde terre d’intensité\nvariable qui affecte\ntous les autres\nPokémon au combat.</language>
	</row>
	<row id="msg_0749_00223" index="223">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur rassemble\nses forces et envoie\nun coup de poing à\nl’ennemi. S’il est\ntouché, il est confus.</language>
	</row>
	<row id="msg_0749_00224" index="224">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur utilise ses\ngigantesques cornes\npour charger\nl’ennemi.</language>
	</row>
	<row id="msg_0749_00225" index="225">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur souffle\nfort sur l’ennemi pour\ninfliger des dégâts.\nPeut aussi le\nparalyser.</language>
	</row>
	<row id="msg_0749_00226" index="226">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur échange\nsa place et tout\nchangement de stat\navec un Pokémon de\nl’équipe.</language>
	</row>
	<row id="msg_0749_00227" index="227">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oblige l’ennemi à\nrépéter sa dernière\ncapacité durant 3 à 7\ntours.</language>
	</row>
	<row id="msg_0749_00228" index="228">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une attaque qui inflige\ndeux fois plus de\ndégâts à un ennemi qui\nquitte le combat.</language>
	</row>
	<row id="msg_0749_00229" index="229">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une attaque\ntournoyante pouvant\naussi annuler par ex.\nEtreinte, Ligotage,\nVampigraine ou Picots.</language>
	</row>
	<row id="msg_0749_00230" index="230">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un doux parfum qui\nréduit l’esquive de\nl’ennemi. Attire aussi\nles Pokémon sauvages.</language>
	</row>
	<row id="msg_0749_00231" index="231">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Attaque l’ennemi avec\nune queue de fer.\nPeut aussi baisser la\nDéfense de l’ennemi.</language>
	</row>
	<row id="msg_0749_00232" index="232">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Attaque avec des\ngriffes d’acier. Peut\naussi augmenter\nl’Attaque du lanceur.</language>
	</row>
	<row id="msg_0749_00233" index="233">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur laisse\nl’ennemi porter le\n1¹ coup. En échange,\ncette capacité\nn’échoue jamais.</language>
	</row>
	<row id="msg_0749_00234" index="234">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un soin qui restaure\ndes PV au lanceur.\nSon efficacité varie\nen fonction de la\nmétéo.</language>
	</row>
	<row id="msg_0749_00235" index="235">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un soin qui restaure\ndes PV au lanceur.\nSon efficacité varie\nen fonction de la\nmétéo.</language>
	</row>
	<row id="msg_0749_00236" index="236">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un soin qui restaure\ndes PV au lanceur.\nSon efficacité varie\nen fonction de la\nmétéo.</language>
	</row>
	<row id="msg_0749_00237" index="237">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Attaque dont la\npuissance et le type\ndépendent du Pokémon\nqui l’utilise.</language>
	</row>
	<row id="msg_0749_00238" index="238">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur délivre un\ncoup double en\ncroisant les\navant-bras. Taux de\ncritiques élevé.</language>
	</row>
	<row id="msg_0749_00239" index="239">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Déclenche un terrible\nouragan sur l’ennemi.\nPeut aussi l’apeurer.</language>
	</row>
	<row id="msg_0749_00240" index="240">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Invoque de fortes\npluies qui durent 5\ntours et améliorent\nles capacités de type\nEau.</language>
	</row>
	<row id="msg_0749_00241" index="241">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fait briller le soleil\npendant 5 tours et\naméliore les capacités\nde type Feu.</language>
	</row>
	<row id="msg_0749_00242" index="242">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur mord\nl’ennemi de ses crocs\npointus. Peut aussi\nbaisser la Défense de\nl’ennemi.</language>
	</row>
	<row id="msg_0749_00243" index="243">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une riposte qui contre\nn’importe quelle\nattaque spéciale en\ninfligeant le double\ndes dégâts subis.</language>
	</row>
	<row id="msg_0749_00244" index="244">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une autohypnose qui\npermet au lanceur de\ncopier les\nchangements de\nstats de l’ennemi.</language>
	</row>
	<row id="msg_0749_00245" index="245">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur charge\nà une vitesse\nrenversante.\nCette attaque a\nl’initiative.</language>
	</row>
	<row id="msg_0749_00246" index="246">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une attaque\npréhistorique qui peut\naugmenter toutes\nles stats du lanceur\nd’un seul coup.</language>
	</row>
	<row id="msg_0749_00247" index="247">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Projette une grande\nombre sur l’ennemi.\nPeut aussi faire\nbaisser sa Déf. Spé.</language>
	</row>
	<row id="msg_0749_00248" index="248">
		<attribute name="window_context_name">used</attribute>
		<language name="English">De l’énergie psychique\nvient frapper l’ennemi\n2 tours après\nl’utilisation de cette\ncapacité.</language>
	</row>
	<row id="msg_0749_00249" index="249">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur porte un\ncoup dévastateur à\nl’ennemi. Permet aussi\nde briser des rochers\nfissurés.</language>
	</row>
	<row id="msg_0749_00250" index="250">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Piège l’ennemi dans\nune trombe d’eau\npendant 2 à 5 tours.\nPermet de franchir\nles tourbillons.</language>
	</row>
	<row id="msg_0749_00251" index="251">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur appelle les\nPokémon de l’équipe\nà attaquer. Plus ils\nsont nombreux, plus\nil y a de dégâts.</language>
	</row>
	<row id="msg_0749_00252" index="252">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Permet de frapper en\npremier et apeure\nl’ennemi. Elle ne\nfonctionne qu’au\npremier tour.</language>
	</row>
	<row id="msg_0749_00253" index="253">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur attaque\nen rugissant durant\n2 à 5 tours. Pendant\nce temps, personne\nne peut s’endormir.</language>
	</row>
	<row id="msg_0749_00254" index="254">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur accumule\nde la puissance et\naugmente sa Défense\net sa Déf. Spé. Peut\nêtre utilisé 3 fois.</language>
	</row>
	<row id="msg_0749_00255" index="255">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Libère dans une\nattaque la puissance\nprécédemment\naccumulée avec\nStockage.</language>
	</row>
	<row id="msg_0749_00256" index="256">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur absorbe la\npuissance accumulée\navec Stockage pour\nrestaurer ses PV.</language>
	</row>
	<row id="msg_0749_00257" index="257">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur provoque\nune vague de\nchaleur. Peut aussi\nbrûler l’ennemi.</language>
	</row>
	<row id="msg_0749_00258" index="258">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Invoque une tempête\nde grêle qui dure 5\ntours. Ne blesse pas\nles Pokémon de type\nGlace.</language>
	</row>
	<row id="msg_0749_00259" index="259">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur irrite\nl’ennemi pour\nl’empêcher d’utiliser\nla même capacité\n2 fois de suite.</language>
	</row>
	<row id="msg_0749_00260" index="260">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rend l’ennemi\nconfus, mais\naugmente son\nAtq. Spé.</language>
	</row>
	<row id="msg_0749_00261" index="261">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lance une sinistre\nflamme violette à\nl’ennemi pour lui\ninfliger une brûlure.</language>
	</row>
	<row id="msg_0749_00262" index="262">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur est mis\nK.O., mais l’Attaque\net l’Atq. Spé. de\nl’ennemi baissent\nbeaucoup.</language>
	</row>
	<row id="msg_0749_00263" index="263">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une attaque dont la\npuissance double\nlorsque le lanceur\nest empoisonné,\nparalysé ou brûlé.</language>
	</row>
	<row id="msg_0749_00264" index="264">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur se\nconcentre avant\nd’attaquer. Echoue\ns’il est touché avant\nd’avoir frappé.</language>
	</row>
	<row id="msg_0749_00265" index="265">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cette attaque est\ndoublement efficace\nsur les ennemis\nparalysés, mais elle\nsoigne leur paralysie.</language>
	</row>
	<row id="msg_0749_00266" index="266">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Attire l’attention.\nLes ennemis\nn’attaquent que le\nlanceur.</language>
	</row>
	<row id="msg_0749_00267" index="267">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une attaque qui tire\nsa force de la nature.\nSon type varie selon\nle terrain.</language>
	</row>
	<row id="msg_0749_00268" index="268">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur concentre\nsa puissance pour\nsa prochaine attaque\nElectrik. Augmente sa\nDéf. Spé.</language>
	</row>
	<row id="msg_0749_00269" index="269">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Provoque l’ennemi.\nL’oblige à n’utiliser\nque des attaques\npendant 2 à 4 tours.</language>
	</row>
	<row id="msg_0749_00270" index="270">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une capacité qui\naugmente la puissance\nd’attaque de l’allié\ndurant un Combat Duo.</language>
	</row>
	<row id="msg_0749_00271" index="271">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur prend\nl’ennemi au dépourvu\net l’oblige à échanger\nson objet contre\nle sien.</language>
	</row>
	<row id="msg_0749_00272" index="272">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Imite l’ennemi et\ncopie sa capacité\nspéciale.</language>
	</row>
	<row id="msg_0749_00273" index="273">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un vœu qui permet\nde récupérer jusqu’à\nla moitié de ses PV\nmax au tour suivant.</language>
	</row>
	<row id="msg_0749_00274" index="274">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur se dépêche\nd’utiliser une\ncapacité au hasard\nparmi celles des\nPokémon de l’équipe.</language>
	</row>
	<row id="msg_0749_00275" index="275">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur plante ses\nracines et récupère\ndes PV à chaque tour.\nUne fois enraciné, il\nne peut plus fuir.</language>
	</row>
	<row id="msg_0749_00276" index="276">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une attaque puissante\nmais qui baisse\nl’Attaque et la\nDéfense du lanceur.</language>
	</row>
	<row id="msg_0749_00277" index="277">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une barrière qui \nrenvoie les capacités\ncomme Vampigraine et\ncelles affectant le\nstatut et les stats.</language>
