	<row id="msg_0749_00354" index="354">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur attaque\nà pleine puissance.\nLe contrecoup réduit\nconsidérablement\nson Atq. Spé.</language>
