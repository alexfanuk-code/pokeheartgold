	<row id="msg_0749_00351" index="351">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur envoie un\nchoc électrique rapide\nà l’ennemi. Impossible\nà esquiver.</language>
	</row>
	<row id="msg_0749_00352" index="352">
