		<language name="English">Perdu! 0 Jeton!</language>
	</row>
	<row id="msg_0039_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}Jetons accumulés\n{ALN_CENTER}par {STRVAR_1 3, 0, 0}</language>
	</row>
