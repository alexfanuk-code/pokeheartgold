	</row>
	<row id="msg_0039_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}Il suffit de retourner pour gagner!</language>
	</row>
	<row id="msg_0039_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">... x1!   ... x2!   ... x3!</language>
	</row>
