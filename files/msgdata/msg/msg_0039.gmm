	</row>
	<row id="msg_0039_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le jeu est monté au niveau {STRVAR_1 50, 0, 0}!\r</language>
	</row>
	<row id="msg_0039_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Félicitations!\rLes possibilités de gain de la partie\nont augmenté!\r</language>
	</row>
