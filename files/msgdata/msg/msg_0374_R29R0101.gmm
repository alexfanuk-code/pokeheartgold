<?xml version="1.0"?>
<body language="English">
	<row id="msg_0374_R29R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On ne peut pas escalader les bords.\rMais on peut sauter par-dessus quand\non descend pour aller plus vite!</language>
	</row>
	<row id="msg_0374_R29R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Pokémon qui apparaissent là-bas\nsont un peu différents.\rSi tu veux tous les attraper, il\nfaut chercher un peu partout!</language>
	</row>
</body>
