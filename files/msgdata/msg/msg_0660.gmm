	<row id="msg_0660_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô?\nC’est bien {STRVAR_1 3, 0, 0}?\rC’est pour quoi?\nTu ne préfères pas passer me voir\fdirectement?</language>
	</row>
	<row id="msg_0660_00002" index="2">
