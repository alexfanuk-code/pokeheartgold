	<row id="msg_0660_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô?\nC’est bien {STRVAR_1 3, 0, 0}?\r</language>
	</row>
	<row id="msg_0660_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, c’est toi! Ravie de t’avoir.\nA propos...\r</language>
	</row>
	<row id="msg_0660_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ton {STRVAR_1 0, 10, 0} est monté\nde {STRVAR_1 52, 11, 0} niveau(x).\r</language>
	</row>
	<row id="msg_0660_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ton {STRVAR_1 0, 12, 0} est monté\nde {STRVAR_1 52, 13, 0} niveau(x).\r</language>
	</row>
	<row id="msg_0660_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nous pouvons élever deux Pokémon.\nTu veux qu’on en élève un autre?</language>
	</row>
	<row id="msg_0660_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu peux passer quand tu veux pour\nvoir ton Pokémon!</language>
	</row>
	<row id="msg_0660_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu peux passer quand tu veux pour\nnous confier des Pokémon!</language>
