<?xml version="1.0"?>
<body language="English">
	<row id="msg_0724_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et c’est parti!</language>
	</row>
	<row id="msg_0724_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gagné! Youpi!\r</language>
	</row>
	<row id="msg_0724_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais le dire!\r</language>
	</row>
	<row id="msg_0724_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis le meilleur Dresseur\nde Pokémon du monde! Juré!</language>
	</row>
	<row id="msg_0724_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yes! Encore une victoire\npleine de style!\r</language>
	</row>
	<row id="msg_0724_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non! Je n’ai pas réussi...\r</language>
	</row>
	<row id="msg_0724_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’aime les shorts, mais je\nsuis balèze en combat!</language>
	</row>
	<row id="msg_0724_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouais! Vive les shorts!\r</language>
	</row>
	<row id="msg_0724_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh non! Je croyais que le pouvoir\ndu short était avec moi!\r</language>
	</row>
	<row id="msg_0724_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est trop dur!\nJe veux rentrer chez moi!</language>
	</row>
	<row id="msg_0724_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé! J’ai réussi!\nJ’ai gagné! Hi, hi!\r</language>
	</row>
	<row id="msg_0724_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cette fois, c’est décidé. Je\nrentre chez moi!\r</language>
	</row>
	<row id="msg_0724_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne suis pas très douée, mais tu ne\ndois pas retenir tes coups pour autant.</language>
	</row>
	<row id="msg_0724_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh! Mais je t’avais dit de ne pas\nretenir tes coups!\r</language>
	</row>
	<row id="msg_0724_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh! J’aurais aimé que tu retiennes un\npetit peu tes coups quand même!\r</language>
	</row>
	<row id="msg_0724_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En amour comme en Pokémon, les filles\nméritent toujours d’être respectées!</language>
	</row>
	<row id="msg_0724_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu comprends pourquoi on mérite\nle respect?\r</language>
	</row>
	<row id="msg_0724_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est comme ça que tu me respectes?\r</language>
	</row>
	<row id="msg_0724_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je me demande pourquoi les gens\naiment tant combattre...</language>
	</row>
	<row id="msg_0724_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pourquoi les gens sont-ils toujours\naussi contents de gagner?\r</language>
	</row>
	<row id="msg_0724_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pourquoi les défaites sont-elles\ntoujours si dures à accepter?\r</language>
	</row>
	<row id="msg_0724_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je fais toujours mes devoirs avant\nd’entraîner mes Pokémon.</language>
	</row>
	<row id="msg_0724_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Comme quoi, on peut bien travailler à\nl’école et être doué pour les combats!\r</language>
	</row>
	<row id="msg_0724_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai perdu? Mais... je suis le\npremier de la classe pourtant!\r</language>
	</row>
	<row id="msg_0724_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai passé des heures à étudier la\nthéorie du combat. Je ne perdrai pas!</language>
	</row>
	<row id="msg_0724_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Comme prévu, je remporte la victoire!\nJ’ai bien fait de travailler si dur.\r</language>
	</row>
	<row id="msg_0724_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On dirait que j’ai encore besoin\nd’étudier.\r</language>
	</row>
	<row id="msg_0724_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Pokémon sont nos amis!\nObserve le pouvoir de l’amitié!</language>
	</row>
	<row id="msg_0724_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vois? C’est le pouvoir de l’amitié!\r</language>
	</row>
	<row id="msg_0724_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vois? Le pouvoir de l’amitié\nrend la défaite supportable!\r</language>
	</row>
	<row id="msg_0724_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne perds jamais.\nC’est un principe.</language>
	</row>
	<row id="msg_0724_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci. Grâce à toi, j’honore\nmes principes.\r</language>
	</row>
	<row id="msg_0724_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je n’aurais pas dû perdre.\r</language>
	</row>
	<row id="msg_0724_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je peux le faire...\nJe peux être la meilleure!</language>
	</row>
	<row id="msg_0724_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Super! J’ai gagné!\nJe vais finir par être une star!\r</language>
	</row>
	<row id="msg_0724_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un jour, je serai la plus grande\nstar que le monde ait connue!\r</language>
	</row>
	<row id="msg_0724_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ne sois pas timide.\nDonne tout ce que tu as!</language>
	</row>
	<row id="msg_0724_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé, hé. Je le savais.\r</language>
	</row>
	<row id="msg_0724_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je t’ai laissé gagner pour te prouver\nque je sais être clément. Voilà.\r</language>
	</row>
	<row id="msg_0724_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon père est super riche.\nIl m’achète tout ce que je veux.</language>
	</row>
	<row id="msg_0724_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon père m’a acheté mon tout\npremier Pokémon.\r</language>
	</row>
	<row id="msg_0724_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’argent ne peut pas tout acheter,\nmalheureusement...\r</language>
	</row>
	<row id="msg_0724_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On y va? Le temps, c’est de l’argent.\nLe compteur tourne!</language>
	</row>
	<row id="msg_0724_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bien, il est temps pour moi de partir.\nJ’ai une réservation au restaurant.\r</language>
	</row>
	<row id="msg_0724_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai échoué? Peu importe, on m’attend\npour le dîner, et je dois partir.\r</language>
	</row>
	<row id="msg_0724_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Courtoisie, politesse et élégance en\ntoutes circonstances. Voilà ma devise.</language>
	</row>
	<row id="msg_0724_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Encore une fois, la classe et\nl’élégance triomphent.\r</language>
	</row>
	<row id="msg_0724_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Etre toujours polie et élégante, c’est\nbien beau, mais c’est épuisant...\r</language>
	</row>
	<row id="msg_0724_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si nous étions des objets, je serais du\nMiel et tu serais du Repousse.</language>
	</row>
	<row id="msg_0724_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et voilà. C’est toute la différence\nentre toi et moi.\r</language>
	</row>
	<row id="msg_0724_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Comment oses-tu?!\nJe n’oublierai pas cet affront!\r</language>
	</row>
	<row id="msg_0724_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chérichou, j’en ai assez de tous ces\ndîners, galas et autres réceptions...</language>
	</row>
	<row id="msg_0724_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma vie est si monotone...\nQui réussira à me divertir?\r</language>
	</row>
	<row id="msg_0724_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Seuls les combats de Pokémon apportent\nun peu de piment à ma vie...\r</language>
	</row>
	<row id="msg_0724_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis ravi de te rencontrer!\nJ’attends beaucoup de notre combat!</language>
	</row>
	<row id="msg_0724_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci beaucoup!\nMerci beaucoup, beaucoup!\r</language>
	</row>
	<row id="msg_0724_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci beaucoup...\nEnfin je crois...\r</language>
	</row>
	<row id="msg_0724_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis le Dresseur de Pokémon le plus\nproche de la nature... Si, si!</language>
	</row>
	<row id="msg_0724_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On ne peut aller contre la nature!\r</language>
	</row>
	<row id="msg_0724_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’imagine que c’est ce que\nvoulait la nature.\r</language>
	</row>
	<row id="msg_0724_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé! Tu es jeune!\nCool! J’ai toutes mes chances!</language>
	</row>
	<row id="msg_0724_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je n’aime pas me battre contre\nles adultes. Ils me font peur!\r</language>
	</row>
	<row id="msg_0724_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quand j’affronte des adultes, je suis\nencore plus nerveux!\r</language>
	</row>
	<row id="msg_0724_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Obtenir des victoires en série n’est\npas facile, mais c’est amusant!</language>
	</row>
	<row id="msg_0724_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eh oui! Gagner, c’est amusant!\r</language>
	</row>
	<row id="msg_0724_00065" index="65">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Perdre, c’est amusant aussi.\nUn peu.\r</language>
	</row>
	<row id="msg_0724_00066" index="66">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon père est un montagnard, donc ma\nmère est une montagnarde... Non?</language>
	</row>
	<row id="msg_0724_00067" index="67">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moi, je n’ai jamais voulu être une\nmontagnarde, tu sais!\r</language>
	</row>
	<row id="msg_0724_00068" index="68">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis leur fille. Cela veut dire que moi\naussi, je finirai montagnarde?\r</language>
	</row>
	<row id="msg_0724_00069" index="69">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai avec moi tout ce qu’il faut pour le\ndéjeuner, plus quelques extras.</language>
	</row>
	<row id="msg_0724_00070" index="70">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Que la victoire est douce!\r</language>
	</row>
	<row id="msg_0724_00071" index="71">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh non! J’aurais dû emmener mon\nPokémon préféré!\r</language>
	</row>
	<row id="msg_0724_00072" index="72">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’adore jouer avec les Pokémon Eau\nà la piscine.</language>
	</row>
	<row id="msg_0724_00073" index="73">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis content d’avoir gagné.\r</language>
	</row>
	<row id="msg_0724_00074" index="74">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon rêve, c’est de nager dans une\npiscine remplie de Pokémon Eau.\r</language>
	</row>
	<row id="msg_0724_00075" index="75">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai promis à ma maman que si je perdais,\nj’apprendrais à nager.</language>
	</row>
	<row id="msg_0724_00076" index="76">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Super! Je n’ai pas besoin d’apprendre\nà nager finalement!\r</language>
	</row>
	<row id="msg_0724_00077" index="77">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oooh, perdu! Je crois que je\nn’échapperai pas au cours de natation!\r</language>
	</row>
	<row id="msg_0724_00078" index="78">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon papa m’aide souvent à\ncapturer des Pokémon!</language>
	</row>
	<row id="msg_0724_00079" index="79">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé, papa! J’ai gagné! J’ai gagné!\nMerci mon papa!\r</language>
	</row>
	<row id="msg_0724_00080" index="80">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais demander à mon papa de\nm’aider à devenir plus fort.\r</language>
	</row>
	<row id="msg_0724_00081" index="81">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je reviens de la piscine. On peut\nse battre, si tu veux.</language>
	</row>
	<row id="msg_0724_00082" index="82">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais rentrer à la maison.\nJ’ai besoin de me changer!\r</language>
	</row>
	<row id="msg_0724_00083" index="83">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A... A... Atchoum! Ooh...\nAtchoum! Perdu...\r</language>
	</row>
	<row id="msg_0724_00084" index="84">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Holà, moussaillon! J’ai jeté l’ancre,\nprofitons-en pour combattre!</language>
	</row>
	<row id="msg_0724_00085" index="85">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A l’abordage! Pas de quartier!\nNotre victoire est absolue!\r</language>
	</row>
	<row id="msg_0724_00086" index="86">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Comment oses-tu saborder mon navire!\r</language>
	</row>
	<row id="msg_0724_00087" index="87">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je reviens tout juste de vacances.\n</language>
	</row>
	<row id="msg_0724_00088" index="88">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’adore frimer sur la plage.\r</language>
	</row>
	<row id="msg_0724_00089" index="89">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aïe, mes coups de soleil me font mal.\r</language>
	</row>
	<row id="msg_0724_00090" index="90">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Comment? Un combat?\nPourquoi pas...</language>
	</row>
	<row id="msg_0724_00091" index="91">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé, tu es un sacré phénomène!\r</language>
	</row>
	<row id="msg_0724_00092" index="92">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK... Ça, c’est fait.\r</language>
	</row>
	<row id="msg_0724_00093" index="93">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je dédie ce combat à toutes mes fans.\nLes filles, je vais gagner pour vous!</language>
	</row>
	<row id="msg_0724_00094" index="94">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et voilà les filles, j’ai gagné.\nTout ça, c’est grâce à votre amour!\r</language>
	</row>
	<row id="msg_0724_00095" index="95">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai peut-être perdu, mais j’ai le\nsoutien de toutes mes fans!\r</language>
	</row>
	<row id="msg_0724_00096" index="96">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non, ce n’est pas une guitare. C’est un\ninstrument traditionnel japonais.</language>
	</row>
	<row id="msg_0724_00097" index="97">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est un instrument à trois cordes,\ntu sais comment ça s’appelle?\r</language>
	</row>
	<row id="msg_0724_00098" index="98">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon instrument, c’est un shamisen.\r</language>
	</row>
	<row id="msg_0724_00099" index="99">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nous autres les Stars, nous avons\nun code de conduite très strict.</language>
	</row>
	<row id="msg_0724_00100" index="100">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Par exemple, si une Star gagne, elle\ndoit hurler de joie et sauter partout.\r</language>
	</row>
	<row id="msg_0724_00101" index="101">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si une Star perd un combat, elle ne doit\npas pleurer. Surtout pas pleurer.\r</language>
	</row>
	<row id="msg_0724_00102" index="102">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Poing Météor, tout le monde dehors!\nQu’est-ce que tu penses de mon entrée?</language>
	</row>
	<row id="msg_0724_00103" index="103">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis la Star du Poing Météor!\nPersonne ne peut me vaincre!\r</language>
	</row>
	<row id="msg_0724_00104" index="104">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Stars doivent toujours soigner\nleur entrée, c’est impératif.\r</language>
	</row>
	<row id="msg_0724_00105" index="105">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu te rends compte de la chance que tu\nas de te battre contre moi?</language>
	</row>
	<row id="msg_0724_00106" index="106">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as vraiment de la chance de m’avoir\napprochée d’aussi près, tu sais.\r</language>
	</row>
	<row id="msg_0724_00107" index="107">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Comment? Comment? On va la refaire!\nCe n’est pas ce qui était prévu!\r</language>
	</row>
	<row id="msg_0724_00108" index="108">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pourquoi dit-on vainqueur\nalors qu’il n’y en a qu’un?</language>
	</row>
	<row id="msg_0724_00109" index="109">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est ce jeu de mots extraordinaire\nqui t’a fait perdre tes moyens?\r</language>
	</row>
	<row id="msg_0724_00110" index="110">
		<attribute name="window_context_name">used</attribute>
		<language name="English">D’ailleurs, pourquoi dire “une défaite”?\nC’est “une fête” ou “des fêtes”, non?\r</language>
	</row>
	<row id="msg_0724_00111" index="111">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je craque toujours pour les Pokémon\ntout mignons.</language>
	</row>
	<row id="msg_0724_00112" index="112">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Excellent! Il ne faut jamais\nsous-estimer son adversaire!\r</language>
	</row>
	<row id="msg_0724_00113" index="113">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé! Tu devrais y aller plus doucement!\nLes Pokémon sont des êtres fragiles!\r</language>
	</row>
	<row id="msg_0724_00114" index="114">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis membre du Fan Club Pokémon!\nEn garde!</language>
	</row>
	<row id="msg_0724_00115" index="115">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vive le Fan Club Pokémon!\r</language>
	</row>
	<row id="msg_0724_00116" index="116">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ne va pas croire que tous les membres\ndu Fan Club Pokémon sont faibles...\r</language>
	</row>
	<row id="msg_0724_00117" index="117">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis la sous-secrétaire adjointe du\nFan Club Pokémon. J’accepte ton défi!</language>
	</row>
	<row id="msg_0724_00118" index="118">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé, hé, hé! Personne ne peut battre\nle Fan Club Pokémon!\r</language>
	</row>
	<row id="msg_0724_00119" index="119">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non! Le secrétaire adjoint me\nvengera, c’est sûr!\r</language>
	</row>
	<row id="msg_0724_00120" index="120">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Pokémon ont besoin d’amour, mais il\nne faut pas les étouffer!</language>
	</row>
	<row id="msg_0724_00121" index="121">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh! J’ai réussi! Bravo!\r</language>
	</row>
	<row id="msg_0724_00122" index="122">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quelle brutalité! Tu pourrais faire\npreuve d’un peu de délicatesse.\r</language>
	</row>
	<row id="msg_0724_00123" index="123">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis là pour représenter\nmon village!</language>
	</row>
	<row id="msg_0724_00124" index="124">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oui! Tout le monde au village sera\nfier de moi!\r</language>
	</row>
	<row id="msg_0724_00125" index="125">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh non! Les gens du village vont\nêtre tellement déçus...\r</language>
	</row>
	<row id="msg_0724_00126" index="126">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci d’avoir patienté.\nVoici le combat que tu as commandé.</language>
	</row>
	<row id="msg_0724_00127" index="127">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’espère que ce combat t’a donné\nsatisfaction. Euh... et mon pourboire?\r</language>
	</row>
	<row id="msg_0724_00128" index="128">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’espère que ce combat t’a donné\nsatisfaction. Je vais me retirer.\r</language>
	</row>
	<row id="msg_0724_00129" index="129">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’adore mon travail et j’adore les\nPokémon. La vie est belle!</language>
	</row>
	<row id="msg_0724_00130" index="130">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tout va pour le mieux!\nJ’ai vraiment beaucoup de chance.\r</language>
	</row>
	<row id="msg_0724_00131" index="131">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh! Tu as gagné? Pff!\nMa bonne humeur s’est envolée!\r</language>
	</row>
	<row id="msg_0724_00132" index="132">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai l’air cool, non? Normal, j’ai été élu\nemployé du mois douze fois cette année!</language>
	</row>
	<row id="msg_0724_00133" index="133">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je serai peut-être aussi élu\nDresseur du mois maintenant!\r</language>
	</row>
	<row id="msg_0724_00134" index="134">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non! Je ne serai jamais élu Dresseur du\nmois si je perds comme ça!\r</language>
	</row>
	<row id="msg_0724_00135" index="135">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dans mon restaurant comme au combat,\nla note peut être très salée!</language>
	</row>
	<row id="msg_0724_00136" index="136">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu devrais faire plus d’efforts\nlorsque tu te bats.\r</language>
	</row>
	<row id="msg_0724_00137" index="137">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis toujours sérieuse, au travail\ncomme au combat.\r</language>
	</row>
	<row id="msg_0724_00138" index="138">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je te recommande le plat du jour.\nOups! Déformation professionnelle!</language>
	</row>
	<row id="msg_0724_00139" index="139">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci, bonne journée!\nMais qu’est-ce que je dis, moi?\r</language>
	</row>
	<row id="msg_0724_00140" index="140">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nous espérons te revoir bientôt!\nEuh... Est-ce que j’ai vraiment dit ça?\r</language>
	</row>
	<row id="msg_0724_00141" index="141">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu m’impressionnes un peu.\nEst-ce que je vais être à la hauteur?</language>
	</row>
	<row id="msg_0724_00142" index="142">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh? Tu as décidé de ne pas utiliser\nton Pokémon préféré?\r</language>
	</row>
	<row id="msg_0724_00143" index="143">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aïe, aïe, aïe! C’est dur! Je savais bien\nque je n’étais pas à la hauteur.\r</language>
	</row>
	<row id="msg_0724_00144" index="144">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce que j’aime le plus: les Pokémon de\ntype Insecte et mon filet à papillons!</language>
	</row>
	<row id="msg_0724_00145" index="145">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai attrapé beaucoup de Pokémon grâce\nà mon cher filet à papillons.\r</language>
	</row>
	<row id="msg_0724_00146" index="146">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le top du top, ce serait un Pokémon\nqui ressemble à un filet à papillons.\r</language>
	</row>
	<row id="msg_0724_00147" index="147">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je peux commander aux insectes, et\nje viens d’ordonner ta défaite!</language>
	</row>
	<row id="msg_0724_00148" index="148">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hahahaha!\nIncline-toi devant ma puissance!\r</language>
	</row>
	<row id="msg_0724_00149" index="149">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non! Ça t’amuse tant que ça d’écraser\ndes insectes innocents?\r</language>
	</row>
	<row id="msg_0724_00150" index="150">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je crois que je vais bientôt muer.\nJe suis prêt, en tout cas.</language>
	</row>
	<row id="msg_0724_00151" index="151">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vois? Je suis en train\nd’évoluer, je le sens.\r</language>
	</row>
	<row id="msg_0724_00152" index="152">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Alors c’est trop tôt?\nJe ne vais pas muer finalement?\r</language>
	</row>
	<row id="msg_0724_00153" index="153">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halte-là, vermine!</language>
	</row>
	<row id="msg_0724_00154" index="154">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’étais concentré sur la victoire!\r</language>
	</row>
	<row id="msg_0724_00155" index="155">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non! Tu as couvert mon nom de\ndéshonneur!\r</language>
	</row>
	<row id="msg_0724_00156" index="156">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé! Regarde là-bas!\nC’est... un Pokémon légendaire!</language>
	</row>
	<row id="msg_0724_00157" index="157">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gné, hé, hé... J’ai réussi à te\ndéstabiliser pour arracher la victoire!\r</language>
	</row>
	<row id="msg_0724_00158" index="158">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je n’ai pas réussi à te déstabiliser!\nTant pis! Disparition ninja!\r</language>
	</row>
	<row id="msg_0724_00159" index="159">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis plus rapide que le vent,\ntu vas voir!</language>
	</row>
	<row id="msg_0724_00160" index="160">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tes mouvements... On dirait que tu\nbouges au ralenti.\r</language>
	</row>
	<row id="msg_0724_00161" index="161">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai peut-être confondu vitesse\net précipitation...\r</language>
	</row>
	<row id="msg_0724_00162" index="162">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je porte les mêmes vêtements depuis\nsix semaines. Et j’ai horreur des bains.</language>
	</row>
	<row id="msg_0724_00163" index="163">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis trop fainéante pour me changer.\nEt je n’ai aucune envie de me laver!\r</language>
	</row>
	<row id="msg_0724_00164" index="164">
		<attribute name="window_context_name">used</attribute>
		<language name="English">N’insiste pas! Défaite ou pas, je\nne veux pas prendre de bain!\r</language>
	</row>
	<row id="msg_0724_00165" index="165">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’aime ma maman et PIKACHU.\nEt j’aime mon papa aussi.</language>
	</row>
	<row id="msg_0724_00166" index="166">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un Dresseur nul, c’est nul.\nJe t’aime pas.\r</language>
	</row>
	<row id="msg_0724_00167" index="167">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un Dresseur qui perd pas, c’est cool.\nJe t’aime bien.\r</language>
	</row>
	<row id="msg_0724_00168" index="168">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pikapika pikaa!\nPikaaa! Pikachuuu!</language>
	</row>
	<row id="msg_0724_00169" index="169">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Piika pikapika!\nPika pikachuuuuu!\r</language>
	</row>
	<row id="msg_0724_00170" index="170">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pika pika piiika...\r</language>
	</row>
	<row id="msg_0724_00171" index="171">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chaque fois que je combats, je\npense à l’immensité des océans.</language>
	</row>
	<row id="msg_0724_00172" index="172">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quand je pense aux océans, si\nmajestueux, je ne peux pas perdre.\r</language>
	</row>
	<row id="msg_0724_00173" index="173">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quand je pense aux océans, si\nmajestueux, la défaite importe peu.\r</language>
	</row>
	<row id="msg_0724_00174" index="174">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En combat comme en amour, il\nfaut savoir prendre du recul.</language>
	</row>
	<row id="msg_0724_00175" index="175">
		<attribute name="window_context_name">used</attribute>
		<language name="English">N’oublie pas, c’est important de se\ndonner le temps de la réflexion.\r</language>
	</row>
	<row id="msg_0724_00176" index="176">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai peut-être perdu, mais n’oublie pas\nle conseil que je t’ai donné.\r</language>
	</row>
	<row id="msg_0724_00177" index="177">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je crois que je suis victime d’une\nancienne malédiction!</language>
	</row>
	<row id="msg_0724_00178" index="178">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Malgré cette malédiction, j’ai réussi à\ngagner! Ouah!\r</language>
	</row>
	<row id="msg_0724_00179" index="179">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis peut-être maudit, mais je\nme suis bien amusé. Bien... amusé...\r</language>
	</row>
	<row id="msg_0724_00180" index="180">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Etudier les vestiges des civilisations\ndisparues me passionne!</language>
	</row>
	<row id="msg_0724_00181" index="181">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un Ruinemaniac s’intéresse toujours\nà l’histoire.</language>
	</row>
	<row id="msg_0724_00182" index="182">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On a toujours des choses à apprendre.\nEt c’est à la portée de tout le monde.</language>
	</row>
	<row id="msg_0724_00183" index="183">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai monté un groupe de recherche\nPokémon avec des amis sur Internet!</language>
	</row>
	<row id="msg_0724_00184" index="184">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gagné! Et j’ai récolté plein d’infos\nutiles pour mon groupe de recherche!\r</language>
	</row>
	<row id="msg_0724_00185" index="185">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Argh! Perdu! Je vais devoir annoncer\nça aux membres de mon groupe...\r</language>
	</row>
	<row id="msg_0724_00186" index="186">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis le héros de cet épisode.\nJe ne peux pas perdre.</language>
	</row>
	<row id="msg_0724_00187" index="187">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pas mal! Pas encore suffisant pour me\nfaire de l’ombre, mais tu as du talent.\r</language>
	</row>
	<row id="msg_0724_00188" index="188">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Evidemment, le public aime voir le héros\nsouffrir. Ça le rend plus humain.\r</language>
	</row>
	<row id="msg_0724_00189" index="189">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les gens disent que je suis frivole.\nJe change souvent de passion.</language>
	</row>
	<row id="msg_0724_00190" index="190">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai gagné! Ça me suffit, je vais aller\nau Square Wi-Fi maintenant.\r</language>
	</row>
	<row id="msg_0724_00191" index="191">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai perdu, ça me suffit. Je vais aller\nme balader au Parc Safari.\r</language>
	</row>
	<row id="msg_0724_00192" index="192">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai beaucoup plus d’expérience que\ntoi. Ça t’impressionne?</language>
	</row>
	<row id="msg_0724_00193" index="193">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pas mal, mais tu vas devoir mûrir\nencore un peu.\r</language>
	</row>
	<row id="msg_0724_00194" index="194">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’expérience ne suffit pas toujours\npour gagner, apparemment.\r</language>
	</row>
	<row id="msg_0724_00195" index="195">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il y a beaucoup de points communs entre\nles combats de Pokémon et la météo.</language>
	</row>
	<row id="msg_0724_00196" index="196">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La victoire est douce comme la caresse\ndu soleil un soir d’été.\r</language>
	</row>
	<row id="msg_0724_00197" index="197">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La défaite est triste comme la pluie\nmonotone d’un jour d’hiver.\r</language>
	</row>
	<row id="msg_0724_00198" index="198">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je me suis couchée tard hier soir... Je\nne me sens pas très bien aujourd’hui...</language>
	</row>
	<row id="msg_0724_00199" index="199">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai gagné, mais je ne devrais\npas sortir autant...\r</language>
	</row>
	<row id="msg_0724_00200" index="200">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Burp!\nPardon!\r</language>
	</row>
	<row id="msg_0724_00201" index="201">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh! Tu es vraiment chou!</language>
	</row>
	<row id="msg_0724_00202" index="202">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu es chou mais moi, j’ai gagné!\r</language>
	</row>
	<row id="msg_0724_00203" index="203">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sur ce, on va se dire au revoir!\r</language>
	</row>
	<row id="msg_0724_00204" index="204">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salut! Oh, un instant.\nJe dois prendre cet appel.</language>
	</row>
	<row id="msg_0724_00205" index="205">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kikoo... Hihi... Ouais... Nan...\nCombat... Gagné... Grave... PTDR!\r</language>
	</row>
	<row id="msg_0724_00206" index="206">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kikoo... Lol... Ouais... Nan...\nCombat... Perdu... La misère!\r</language>
	</row>
	<row id="msg_0724_00207" index="207">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis balade. J’ai le rhube des\nfoins, et j’en ai barre...</language>
	</row>
	<row id="msg_0724_00208" index="208">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Snif! J’ai gagné, c’est suber, bais ça\nb’aide bas à soigner bon rhube!\r</language>
	</row>
	<row id="msg_0724_00209" index="209">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Snif! Bais non, je bleure bas barce que\nje suis driste! Je suis balade, j’ai dit!\r</language>
	</row>
	<row id="msg_0724_00210" index="210">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En respirant le parfum d’un Dresseur,\nje sais tout de suite à qui j’ai affaire.</language>
	</row>
	<row id="msg_0724_00211" index="211">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ne te décourage pas, je flaire un\ngrand potentiel en toi.\r</language>
	</row>
	<row id="msg_0724_00212" index="212">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je sens que tu as beaucoup travaillé\npour en arriver là.\r</language>
	</row>
	<row id="msg_0724_00213" index="213">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé, hé! Je sens que notre combat\nsera épique!</language>
	</row>
	<row id="msg_0724_00214" index="214">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’aime le doux parfum de la victoire!\r</language>
	</row>
	<row id="msg_0724_00215" index="215">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’odeur de la défaite me rappelle celle\nde MOUFOUETTE!\r</language>
	</row>
	<row id="msg_0724_00216" index="216">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dans mes compos et dans mes combats,\nje mets du rythme et puis voilà!</language>
	</row>
	<row id="msg_0724_00217" index="217">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh yeah! Le rythme a triomphé!\r</language>
	</row>
	<row id="msg_0724_00218" index="218">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est une vraie cacophonie!\nTu n’as aucun sens du rythme!\r</language>
	</row>
	<row id="msg_0724_00219" index="219">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A compter de ce moment, je n’utiliserai\nplus de mots pour m’exprimer.</language>
	</row>
	<row id="msg_0724_00220" index="220">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tadaaaa! Ta ta ta ta! TA DAAA!\nBada bada chabadam!\r</language>
	</row>
	<row id="msg_0724_00221" index="221">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bip bip... Bip bip bip bip... Biiiiiiiiiiiiiiiip!\r</language>
	</row>
	<row id="msg_0724_00222" index="222">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un instant, je te prie... J’écoute...\nle murmure du vent...</language>
	</row>
	<row id="msg_0724_00223" index="223">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le vent...\nLe vent est heureux...\r</language>
	</row>
	<row id="msg_0724_00224" index="224">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le vent...\nLe vent est affligé...\r</language>
	</row>
	<row id="msg_0724_00225" index="225">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne peux pas voler...\nMais je peux te battre...</language>
	</row>
	<row id="msg_0724_00226" index="226">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon corps reste au sol, mais\nmon esprit s’élève... Merci...\r</language>
	</row>
	<row id="msg_0724_00227" index="227">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu m’as coupé les ailes...\nJe ne te le pardonnerai jamais...\r</language>
	</row>
	<row id="msg_0724_00228" index="228">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis une sorte d’oiseau migrateur,\nmais je n’arrive pas à décider où aller.</language>
	</row>
	<row id="msg_0724_00229" index="229">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai beaucoup voyagé, j’ai donc\nbeaucoup appris.\r</language>
	</row>
	<row id="msg_0724_00230" index="230">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’aimerais vivre dans un lieu où les\nDresseurs sont tous aussi talentueux.\r</language>
	</row>
	<row id="msg_0724_00231" index="231">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis né des flots, la mer\nnourricière a bercé mon enfance.</language>
	</row>
	<row id="msg_0724_00232" index="232">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Né de la mer, je ne vis que pour elle. Ce\nque je suis aujourd’hui, je le lui dois.\r</language>
	</row>
	<row id="msg_0724_00233" index="233">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai perdu, n’est-ce pas? Je suis\ntrop loin de la mer pour gagner.</language>
	</row>
	<row id="msg_0724_00234" index="234">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les jeunes d’aujourd’hui veulent\ntous conquérir le monde...</language>
	</row>
	<row id="msg_0724_00235" index="235">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis sûr qu’il y a de très bons\nDresseurs partout dans le monde.\r</language>
	</row>
	<row id="msg_0724_00236" index="236">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Poursuis ta route, jeune pirate! Le\nmonde est à ta portée! On se reverra!\r</language>
	</row>
	<row id="msg_0724_00237" index="237">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je sens la poussière, non?\nTu vas vite comprendre pourquoi.</language>
	</row>
	<row id="msg_0724_00238" index="238">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La poussière que tu sentais...\nc’est celle que je t’ai fait mordre!\r</language>
	</row>
	<row id="msg_0724_00239" index="239">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Euh... C’est moi qui devais te faire\nmordre la poussière...\r</language>
	</row>
	<row id="msg_0724_00240" index="240">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Désolé d’arriver dans cette tenue.\nLa route a été difficile.</language>
	</row>
	<row id="msg_0724_00241" index="241">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si tu veux savoir, je me suis perdu. J’ai\npassé des heures à tourner en rond.\r</language>
	</row>
	<row id="msg_0724_00242" index="242">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Décidément, “perdue” est le mot\nidéal pour qualifier cette journée.\r</language>
	</row>
	<row id="msg_0724_00243" index="243">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne devrais pas être ici. Tu ne diras\nà personne que tu m’as vue, d’accord?</language>
	</row>
	<row id="msg_0724_00244" index="244">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A chaque combat, je risque d’attirer\nla presse. Ce n’est pas une vie facile.\r</language>
	</row>
	<row id="msg_0724_00245" index="245">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai beau être une star, je suis une\nfille comme les autres, tu sais!\r</language>
	</row>
	<row id="msg_0724_00246" index="246">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis super connue... dans ma famille!\nÇa te pose un problème?</language>
	</row>
	<row id="msg_0724_00247" index="247">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Etre une star, c’est avant tout une\nquestion d’attitude.\r</language>
	</row>
	<row id="msg_0724_00248" index="248">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les autres ne m’intéressent pas, mais\nje leur conseille de s’intéresser à moi.\r</language>
	</row>
	<row id="msg_0724_00249" index="249">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais bientôt prendre ma retraite...\nsans avoir connu le succès...</language>
	</row>
	<row id="msg_0724_00250" index="250">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’espère qu’on se souviendra au moins\nde mes victoires!\r</language>
	</row>
	<row id="msg_0724_00251" index="251">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est un peu dommage de finir sa\ncarrière sur une note aussi sombre.</language>
	</row>
	<row id="msg_0724_00252" index="252">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Courir un marathon demande beaucoup\nd’efforts. Dresser un Pokémon aussi.</language>
	</row>
	<row id="msg_0724_00253" index="253">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est important de s’entraîner\nun peu tous les jours.\r</language>
	</row>
	<row id="msg_0724_00254" index="254">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je n’ai pas assez bien géré mon effort.\r</language>
	</row>
	<row id="msg_0724_00255" index="255">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salut! Battons-nous pour\nla beauté du sport!</language>
	</row>
	<row id="msg_0724_00256" index="256">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Excellent! Je suis satisfait!\nC’était un vrai plaisir!\r</language>
	</row>
	<row id="msg_0724_00257" index="257">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, euh... Quelle déception... Disons\nque j’ai perdu... en beauté!\r</language>
	</row>
	<row id="msg_0724_00258" index="258">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nous autres, les Ouvriers, on fait\ntourner le monde!</language>
	</row>
	<row id="msg_0724_00259" index="259">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Parfois, on aimerait bien pouvoir se\nreposer un peu.\r</language>
	</row>
	<row id="msg_0724_00260" index="260">
		<attribute name="window_context_name">used</attribute>
		<language name="English">N’oublie jamais ce que nous autres,\nles Ouvriers, on fait pour toi.\r</language>
	</row>
	<row id="msg_0724_00261" index="261">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma femme et mon fils comptent sur moi!\nJe ne peux pas perdre!</language>
	</row>
	<row id="msg_0724_00262" index="262">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis désolé pour toi. Je devais\ngagner pour ma famille, tu comprends?\r</language>
	</row>
	<row id="msg_0724_00263" index="263">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non! Comment vais-je affronter le\nregard de ma femme et de mon fils?\r</language>
	</row>
	<row id="msg_0724_00264" index="264">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chaque Pokémon que j’élève a une place\nparticulière dans ma famille, tu sais.</language>
	</row>
	<row id="msg_0724_00265" index="265">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Super! Gagné! Allez, à la revoyure!\nMa famille m’attend.\r</language>
	</row>
	<row id="msg_0724_00266" index="266">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Argh! C’est cruel!\nMa famille sera déçue!\r</language>
	</row>
	<row id="msg_0724_00267" index="267">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il ne faut pas être trop souple avec\nles Pokémon. Ils sont parfois ingrats.</language>
	</row>
	<row id="msg_0724_00268" index="268">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé! Ça suffit! Le combat est\nterminé! On a gagné!\r</language>
	</row>
	<row id="msg_0724_00269" index="269">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé! Ça suffit! Le combat est\nterminé! On a perdu!\r</language>
	</row>
	<row id="msg_0724_00270" index="270">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Toi! Regarde-moi. Regarde-moi bien.\nConcentre-toi.</language>
	</row>
	<row id="msg_0724_00271" index="271">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non, tu manques encore de puissance.\nTu devrais t’entraîner avec moi.\r</language>
	</row>
	<row id="msg_0724_00272" index="272">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu es meilleur Dresseur que tu en as\nl’air. J’avais mal jugé ton talent.\r</language>
	</row>
	<row id="msg_0724_00273" index="273">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allez, c’est parti!\nQue le meilleur Dresseur gagne!</language>
	</row>
	<row id="msg_0724_00274" index="274">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, super! Je suis d’autant plus ravie\nque tout le monde a fait de son mieux!\r</language>
	</row>
	<row id="msg_0724_00275" index="275">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est dommage, mais je suis ravie que\ntout le monde ait fait de son mieux!\r</language>
	</row>
	<row id="msg_0724_00276" index="276">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le rêve de mon papounet...\nC’est à moi de le réaliser!</language>
	</row>
	<row id="msg_0724_00277" index="277">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Papounet, tu as vu ça?\nCette victoire est pour toi...\r</language>
	</row>
	<row id="msg_0724_00278" index="278">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Perdu...\nPardonne-moi, papounet...\r</language>
	</row>
	<row id="msg_0724_00279" index="279">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je voudrais faire une pause...\nTrop tard? Le combat commence?</language>
	</row>
	<row id="msg_0724_00280" index="280">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, tu vois? Tu aurais dû faire\ncette pause avant le combat.\r</language>
	</row>
	<row id="msg_0724_00281" index="281">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK, tu as du talent. Mais n’oublie pas\nde faire une pause de temps en temps.\r</language>
	</row>
	<row id="msg_0724_00282" index="282">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Très bien. Très, très bien.\nSouris à la caméra, s’il te plaît!</language>
	</row>
	<row id="msg_0724_00283" index="283">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fais un effort! Je t’ai demandé de\nsourire! Allez, quoi!\r</language>
	</row>
	<row id="msg_0724_00284" index="284">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, voilà un beau sourire!\nMaintenant, prends l’air sérieux.\r</language>
	</row>
	<row id="msg_0724_00285" index="285">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Toi, tu ne vois pas tout, mais moi, aucun\ndétail ne m’échappe.</language>
	</row>
	<row id="msg_0724_00286" index="286">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh oui. Je te vois très\nnettement. Tout est clair.\r</language>
	</row>
	<row id="msg_0724_00287" index="287">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai un peu trop zoomé sur toi. J’aurais\ndû garder un œil sur le combat.\r</language>
	</row>
	<row id="msg_0724_00288" index="288">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Durant le combat, j’essaierai de cadrer\nton meilleur profil.</language>
	</row>
	<row id="msg_0724_00289" index="289">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Là! Et là!\nC’était le tournant du match!\r</language>
	</row>
	<row id="msg_0724_00290" index="290">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Inacceptable. Je ne peux quand même\npas filmer ma défaite.\r</language>
	</row>
	<row id="msg_0724_00291" index="291">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je commenterai ce combat en direct\npour vous, chers téléspectateurs.</language>
	</row>
	<row id="msg_0724_00292" index="292">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Votre belle et courageuse Interviewer\ns’impose avec grâce! Bravo!\r</language>
	</row>
	<row id="msg_0724_00293" index="293">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Votre belle et courageuse Interviewer\ns’incline avec grâce! Dommage!\r</language>
	</row>
	<row id="msg_0724_00294" index="294">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne devrais pas le dire, mais je\nrêvais d’être une Star...</language>
	</row>
	<row id="msg_0724_00295" index="295">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai beaucoup travaillé. Je voulais être\nune Star, mais avec de la classe.\r</language>
	</row>
	<row id="msg_0724_00296" index="296">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quelle déception... Mes rêves\ns’effondrent les uns après les autres!\r</language>
	</row>
	<row id="msg_0724_00297" index="297">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est grâce à ce micro que je suis\ndevenue célèbre. J’y tiens beaucoup.</language>
	</row>
	<row id="msg_0724_00298" index="298">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Même en plein combat, je ne me sépare\njamais de ce micro.\r</language>
	</row>
	<row id="msg_0724_00299" index="299">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Boum! Bzzzz...\r</language>
	</row>
	<row id="msg_0724_00300" index="300">
		<attribute name="window_context_name">used</attribute>
		<language name="English">S’lut! Allez, ne perdons pas\nde temps! Hop, hop, hop!</language>
	</row>
	<row id="msg_0724_00301" index="301">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yeah! Maintenant, tu peux m’appeler\n“monsieur”.\r</language>
	</row>
	<row id="msg_0724_00302" index="302">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK, au moins, j’ai appris quelque\nchose aujourd’hui.\r</language>
	</row>
	<row id="msg_0724_00303" index="303">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce vélo est comme une partie\nde moi-même.</language>
	</row>
	<row id="msg_0724_00304" index="304">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si mon vélo s’abîme, je sens la douleur\ncomme si c’est moi qui étais blessé.\r</language>
	</row>
	<row id="msg_0724_00305" index="305">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’apprécierais que tu enlèves tes sales\npattes de mon vélo, merci.\r</language>
	</row>
	<row id="msg_0724_00306" index="306">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quand j’étais petite, je détestais faire\ndu vélo. Je tombais tout le temps.</language>
	</row>
	<row id="msg_0724_00307" index="307">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aujourd’hui, j’adore faire du vélo,\nsurtout avec mes amis.\r</language>
	</row>
	<row id="msg_0724_00308" index="308">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et toi, tu fais du vélo? C’est bon\npour la santé, tu sais.\r</language>
	</row>
	<row id="msg_0724_00309" index="309">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta présence m’inspire. Oui, on peut\nêtre à la fois cycliste et philosophe...</language>
	</row>
	<row id="msg_0724_00310" index="310">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Au fur et à mesure des kilomètres, le\nbut ultime se rapproche...\r</language>
	</row>
	<row id="msg_0724_00311" index="311">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Euh... Je vais me contenter d’être\ncycliste aujourd’hui...\r</language>
	</row>
	<row id="msg_0724_00312" index="312">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le rideau se lève sur un festival de\nmuscles et de Pokémon!</language>
	</row>
	<row id="msg_0724_00313" index="313">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Qu’est-ce que tu préfères, toi?\nLes muscles ou les Pokémon?\r</language>
	</row>
	<row id="msg_0724_00314" index="314">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oui, j’ai perdu, mais c’était un beau\ndéploiement de muscles et de Pokémon.\r</language>
	</row>
	<row id="msg_0724_00315" index="315">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On dit que j’ai des poings d’acier et\nle cœur d’un enfant.</language>
	</row>
	<row id="msg_0724_00316" index="316">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouais! Trop cool!\nJ’ai gagné, j’ai gagné!\r</language>
	</row>
	<row id="msg_0724_00317" index="317">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais, euh... Bouh! C’est nul!\nJe te parle plus!\r</language>
	</row>
	<row id="msg_0724_00318" index="318">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hayaaaa...\nHayaaaa...</language>
	</row>
	<row id="msg_0724_00319" index="319">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Haya... Tcha!\nYakata... Tcha tcha!\r</language>
	</row>
	<row id="msg_0724_00320" index="320">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Euh...\r</language>
	</row>
	<row id="msg_0724_00321" index="321">
		<attribute name="window_context_name">used</attribute>
		<language name="English">“Doucement” ne fait pas partie\nde mon vocabulaire.</language>
	</row>
	<row id="msg_0724_00322" index="322">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Donner tout ce qu’on a au combat\nprouve que l’on respecte l’adversaire.\r</language>
	</row>
	<row id="msg_0724_00323" index="323">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai tout donné et j’ai perdu.\nÇa fait mal...\r</language>
	</row>
	<row id="msg_0724_00324" index="324">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un maître des arts martiaux a un\ncontrôle absolu de son corps.</language>
	</row>
	<row id="msg_0724_00325" index="325">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un maître des arts martiaux est fort,\nmais il doit aussi se montrer sage.\r</language>
	</row>
	<row id="msg_0724_00326" index="326">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Argh! J’étais trop fatigué à cause de\nmon entraînement intensif...\r</language>
	</row>
	<row id="msg_0724_00327" index="327">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si je ferme les yeux, je te vois\nperdre contre moi.</language>
	</row>
	<row id="msg_0724_00328" index="328">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ne sois pas triste.\nC’était écrit.\r</language>
	</row>
	<row id="msg_0724_00329" index="329">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais... Et le destin?\r</language>
	</row>
	<row id="msg_0724_00330" index="330">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je déteste voyager. Je me suis\nentraîné grâce à Internet.</language>
	</row>
	<row id="msg_0724_00331" index="331">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé, hé! Une maîtrise absolue du karaté\net des Pokémon, tout ça sans effort!\r</language>
	</row>
	<row id="msg_0724_00332" index="332">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bah, je suis déçu. Et fatigué. Et j’ai\nfaim. Et je veux rentrer chez moi.\r</language>
	</row>
	<row id="msg_0724_00333" index="333">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour arriver à ce niveau, j’ai dû faire\ndes sacrifices. Beaucoup de sacrifices.</language>
	</row>
	<row id="msg_0724_00334" index="334">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne vis que pour des moments\ncomme celui-ci.\r</language>
	</row>
	<row id="msg_0724_00335" index="335">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Qu’est-ce que je peux sacrifier d’autre\npour te battre, hein?\r</language>
	</row>
	<row id="msg_0724_00336" index="336">
		<attribute name="window_context_name">used</attribute>
		<language name="English">D’abord, on se bat.\nEnsuite, on discute.</language>
	</row>
	<row id="msg_0724_00337" index="337">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as prouvé ta valeur malgré tout.\nJe te félicite.\r</language>
	</row>
	<row id="msg_0724_00338" index="338">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu es coriace, dis donc. Où est-ce que\ntu t’entraînes?\r</language>
	</row>
	<row id="msg_0724_00339" index="339">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salut, jeune Dresseur.\nPrépare-toi à affronter la défaite.</language>
	</row>
	<row id="msg_0724_00340" index="340">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta colère et ta frustration me\ncomblent de joie, jeune Dresseur!\r</language>
	</row>
	<row id="msg_0724_00341" index="341">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non mais qu’est-ce qui te prend?\nSache que j’ai horreur de perdre!\r</language>
	</row>
	<row id="msg_0724_00342" index="342">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais te remettre à ta place!</language>
	</row>
	<row id="msg_0724_00343" index="343">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je n’ai aucun point faible que tu\npuisses exploiter!\r</language>
	</row>
	<row id="msg_0724_00344" index="344">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non! J’aurais dû me préparer\ndavantage pour cette rencontre...\r</language>
	</row>
	<row id="msg_0724_00345" index="345">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le plus important, c’est de ne jamais\nbaisser les bras. Souviens-toi de ça!</language>
	</row>
	<row id="msg_0724_00346" index="346">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si tu baisses les bras, je n’ai\nplus rien à te dire.\r</language>
	</row>
	<row id="msg_0724_00347" index="347">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Excellent. Voilà ce que j’aime voir\nchez les jeunes Dresseurs.\r</language>
	</row>
	<row id="msg_0724_00348" index="348">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A ton regard, je vois que mon style\ninimitable te laisse sans voix!</language>
	</row>
	<row id="msg_0724_00349" index="349">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Difficile de ne pas se laisser hypnotiser\npar mon charme légendaire, non?\r</language>
	</row>
	<row id="msg_0724_00350" index="350">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Alors ce n’était que du mépris dans ton\nregard? Quel manque de classe!\r</language>
	</row>
	<row id="msg_0724_00351" index="351">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Te voilà, trésor. Tu veux vraiment te\nbattre contre moi?</language>
	</row>
	<row id="msg_0724_00352" index="352">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non, trésor, ne pleure pas.\nTu n’as aucune raison d’avoir honte.\r</language>
	</row>
	<row id="msg_0724_00353" index="353">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eh bien, tu as montré un certain\ntalent, bravo.\r</language>
	</row>
	<row id="msg_0724_00354" index="354">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dresseur, je te conseille de m’obéir.\nJ’ai horreur de me répéter.</language>
	</row>
	<row id="msg_0724_00355" index="355">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Excellent. Recommençons.\nImmédiatement.\r</language>
	</row>
	<row id="msg_0724_00356" index="356">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu oses me défier? Est-ce du courage\nou de l’inconscience?\r</language>
	</row>
	<row id="msg_0724_00357" index="357">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai rencontré bon nombre de Dresseurs\nau fil des années.</language>
	</row>
	<row id="msg_0724_00358" index="358">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Beaucoup sont d’excellents Dresseurs,\net des amis fidèles...\r</language>
	</row>
	<row id="msg_0724_00359" index="359">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Parmi toutes ces rencontres, la nôtre\naura toujours une place à part.\r</language>
	</row>
	<row id="msg_0724_00360" index="360">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça ne se voit pas, mais je suis médium.\nTu veux voir un vrai truc de médium?</language>
	</row>
	<row id="msg_0724_00361" index="361">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ne va pas croire que j’ai utilisé mes\npouvoirs pour gagner!\r</language>
	</row>
	<row id="msg_0724_00362" index="362">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as vu? J’étais en lévitation durant\ntout le combat.\r</language>
	</row>
	<row id="msg_0724_00363" index="363">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooooooooommmmmmm!\nAinsi soit-il, tu es ma prochaine victime.</language>
	</row>
	<row id="msg_0724_00364" index="364">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oooooooooooommmmmm!\nCe n’était pas trop douloureux?\r</language>
	</row>
	<row id="msg_0724_00365" index="365">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oooooooooommmmmm!\nÇa ira pour cette fois!</language>
	</row>
	<row id="msg_0724_00366" index="366">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai des pouvoirs psychiques, mais je\npréfère les tours de passe-passe.</language>
	</row>
	<row id="msg_0724_00367" index="367">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je préfère laisser les pouvoirs\npsychiques aux Pokémon...\r</language>
	</row>
	<row id="msg_0724_00368" index="368">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis un Kinésiste, mais je prends des\ncours dans une école de magie.\r</language>
	</row>
	<row id="msg_0724_00369" index="369">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dans quelques minutes, tu découvriras\nle vrai sens du mot “terreur”.</language>
	</row>
	<row id="msg_0724_00370" index="370">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu es faible! Si faible!\nC’était trop facile.\r</language>
	</row>
	<row id="msg_0724_00371" index="371">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Noooon!\nJe ne peux pas perdre!</language>
	</row>
	<row id="msg_0724_00372" index="372">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vois des choses... effrayantes.\nLà, derrière toi!</language>
	</row>
	<row id="msg_0724_00373" index="373">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh? Tu ne vois rien?\nTu as de la chance... Hé, hé, hé...\r</language>
	</row>
	<row id="msg_0724_00374" index="374">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ne me demande pas ce que j’ai vu.\nCrois-moi, tu ne veux pas savoir.\r</language>
	</row>
	<row id="msg_0724_00375" index="375">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Forces de l’ombre, donnez-moi la force!\nJ’ai besoin de votre aide!</language>
	</row>
	<row id="msg_0724_00376" index="376">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Forces de l’ombre...\nMerci de votre aide...\r</language>
	</row>
	<row id="msg_0724_00377" index="377">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Forces de l’ombre...\nPourquoi m’avoir abandonnée?\r</language>
	</row>
	<row id="msg_0724_00378" index="378">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pourquoi je suis devenu Eleveur?\nParce que les Pokémon existent!</language>
	</row>
	<row id="msg_0724_00379" index="379">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma réplique au début du combat était\nvraiment classe, non?\r</language>
	</row>
	<row id="msg_0724_00380" index="380">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce n’est pas une raison, tu dis?\nRéfléchis, tu comprendras...\r</language>
	</row>
	<row id="msg_0724_00381" index="381">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je prends grand soin de tous les\nPokémon que j’élève. Toujours.</language>
	</row>
	<row id="msg_0724_00382" index="382">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chaque Pokémon est unique, si on y\nregarde de près.\r</language>
	</row>
	<row id="msg_0724_00383" index="383">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai consacré ma vie aux Pokémon, et ils\nme le rendent bien.\r</language>
	</row>
	<row id="msg_0724_00384" index="384">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis prêt à t’éblouir!\nAttention les yeux!</language>
	</row>
	<row id="msg_0724_00385" index="385">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une victoire éclatante! Excellent!\r</language>
	</row>
	<row id="msg_0724_00386" index="386">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Argh! Quelle humiliation!\nJe retourne dans l’ombre.\r</language>
	</row>
	<row id="msg_0724_00387" index="387">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’adore élever des Pokémon.\nC’est toute ma vie!</language>
	</row>
	<row id="msg_0724_00388" index="388">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon métier m’apporte tellement de\nsatisfactions...\r</language>
	</row>
	<row id="msg_0724_00389" index="389">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé! Ne refais jamais ça!\r</language>
	</row>
	<row id="msg_0724_00390" index="390">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je réfléchis à un projet ambitieux de\nmanipulation génétique sur les Pokémon.</language>
	</row>
	<row id="msg_0724_00391" index="391">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Avec une approche scientifique, on peut\noptimiser l’élevage des Pokémon.\r</language>
	</row>
	<row id="msg_0724_00392" index="392">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon, il faudra que j’étudie un peu le\nsujet. Je n’y connais rien en génétique.\r</language>
	</row>
	<row id="msg_0724_00393" index="393">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Pokémon élevés avec amour sont\ntrès attachés à leur Dresseur.</language>
	</row>
	<row id="msg_0724_00394" index="394">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Même en combat, on peut montrer à un\nPokémon qu’on l’aime. La preuve.\r</language>
	</row>
	<row id="msg_0724_00395" index="395">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je crois que tu es du genre à élever\ntes Pokémon avec amour. Je me trompe?\r</language>
	</row>
	<row id="msg_0724_00396" index="396">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai décidé de me mettre dans la peau\nd’un nourrisson durant notre combat.</language>
	</row>
	<row id="msg_0724_00397" index="397">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Areuh, areuh! Gouzi, gouzi, gouzi!\r</language>
	</row>
	<row id="msg_0724_00398" index="398">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouiiiiiiiin! Ouiiiiiin!\nMa... ma... man...\r</language>
	</row>
	<row id="msg_0724_00399" index="399">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si tu gagnes, je te raconterai une\nanecdote du temps de ma jeunesse.</language>
	</row>
	<row id="msg_0724_00400" index="400">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Te voir me rappelle bien des souvenirs.\nOh oui... Bien des souvenirs...\r</language>
	</row>
	<row id="msg_0724_00401" index="401">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je... euh... je crois que j’ai oublié...\r</language>
	</row>
	<row id="msg_0724_00402" index="402">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour les humains comme pour les\nPokémon, l’âge ne veut rien dire!</language>
	</row>
	<row id="msg_0724_00403" index="403">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ciao! C’était marrant!\nProfite de ta jeunesse!\r</language>
	</row>
	<row id="msg_0724_00404" index="404">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai toujours gardé mon\nâme d’enfant.\r</language>
	</row>
	<row id="msg_0724_00405" index="405">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Père... mère... vous m’entendez?\nJ’ai besoin de votre soutien...</language>
	</row>
	<row id="msg_0724_00406" index="406">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Père... mère... vous avez vu?\nGrâce à vous, j’ai remporté la victoire!\r</language>
	</row>
	<row id="msg_0724_00407" index="407">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Père... mère...\nJ’ai échoué...\r</language>
	</row>
	<row id="msg_0724_00408" index="408">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aujourd’hui, mes années de recherches\nvont enfin me servir à quelque chose...</language>
	</row>
	<row id="msg_0724_00409" index="409">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Victoire! Je n’ai pas sacrifié toutes\nces années pour rien!\r</language>
	</row>
	<row id="msg_0724_00410" index="410">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non! Nooooon! Alors ce n’était qu’une\nimmense perte de temps?\r</language>
	</row>
	<row id="msg_0724_00411" index="411">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai mis au point une boisson Pokémon\nau goût unique! Goûte donc!</language>
	</row>
	<row id="msg_0724_00412" index="412">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Glou glou... Berk! Cette boisson te\nrendra balèze. Fais-en bon usage!\r</language>
	</row>
	<row id="msg_0724_00413" index="413">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma boisson Pokémon est naturelle.\nEt elle ne contient pas de Pokémon!\r</language>
	</row>
	<row id="msg_0724_00414" index="414">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On pourrait comparer l’art du combat\nà la vie d’un célibataire...</language>
	</row>
	<row id="msg_0724_00415" index="415">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu sais pourquoi?\nJ’en doute. Personne ne sait.\r</language>
	</row>
	<row id="msg_0724_00416" index="416">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vois le point commun?\nJ’en doute. Personne ne le voit.\r</language>
	</row>
	<row id="msg_0724_00417" index="417">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Toute ma vie, je l’ai passée\ndans un cirque.</language>
	</row>
	<row id="msg_0724_00418" index="418">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis né dans un cirque, et\nje ne vis que pour le cirque.\r</language>
	</row>
	<row id="msg_0724_00419" index="419">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je n’aurais pas dû quitter mon cirque...\nLe monde extérieur est bien trop cruel.</language>
	</row>
	<row id="msg_0724_00420" index="420">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé, toi! Oui, toi! Au travail!\nIl faut qu’on s’entraîne!</language>
	</row>
	<row id="msg_0724_00421" index="421">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quoi? Tu abandonnes déjà?\nInacceptable! Relève-toi!\r</language>
	</row>
	<row id="msg_0724_00422" index="422">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bien! Très bien, même!\nÇa suffit pour aujourd’hui!\r</language>
	</row>
	<row id="msg_0724_00423" index="423">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gné? Tu veux m’affronter?</language>
	</row>
	<row id="msg_0724_00424" index="424">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gné, hé, hé! J’ai gagné!\nBah, tu feras mieux la prochaine fois!\r</language>
	</row>
	<row id="msg_0724_00425" index="425">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gné? Tu as gagné?\nPour qui tu te prends?\r</language>
	</row>
	<row id="msg_0724_00426" index="426">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, j’en ai des frissons.\nJ’adore les combats!</language>
	</row>
	<row id="msg_0724_00427" index="427">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brr! Et voilà! La définition\nmême du talent...\r</language>
	</row>
	<row id="msg_0724_00428" index="428">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je n’imagine pas la vie sans combats\nde Pokémon. Ce serait horrible.\r</language>
	</row>
	<row id="msg_0724_00429" index="429">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK! Je peux le faire!\nJe vais te montrer ce que je vaux!</language>
	</row>
	<row id="msg_0724_00430" index="430">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pfiou...\r</language>
	</row>
	<row id="msg_0724_00431" index="431">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Plus jamais!\nC’est la dernière fois que je viens!\r</language>
	</row>
	<row id="msg_0724_00432" index="432">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il paraît que je suis très forte.\nJ’espère que tu seras de taille.</language>
	</row>
	<row id="msg_0724_00433" index="433">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je me doutais bien que j’étais trop\nforte pour toi. Désolée.\r</language>
	</row>
	<row id="msg_0724_00434" index="434">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Incroyable. Je ne pensais vraiment\npas que tu gagnerais.\r</language>
	</row>
	<row id="msg_0724_00435" index="435">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allez moi! Allez moi!\nOn va gagner! Ouais!</language>
	</row>
	<row id="msg_0724_00436" index="436">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bien joué, moi! Je suis géniale!\nVive moi! Ouais!\r</language>
	</row>
	<row id="msg_0724_00437" index="437">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allons, moi, ne pleurons pas.\nRetirons-nous en beauté! Ouais!\r</language>
	</row>
	<row id="msg_0724_00438" index="438">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tiens! Voilà un Dresseur à l’œil vif!\nVoyons ce que tu vaux!</language>
	</row>
	<row id="msg_0724_00439" index="439">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Victoire! Malgré tout, tu as de bons\nréflexes, Dresseur.\r</language>
	</row>
	<row id="msg_0724_00440" index="440">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Comment? Nooooon!\nTu es franchement coriace!\r</language>
	</row>
	<row id="msg_0724_00441" index="441">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Servir et protéger les Pokémon et la\nnature. Voilà ma mission!</language>
	</row>
	<row id="msg_0724_00442" index="442">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est en communiant avec la nature que\nj’ai pu devenir si fort.\r</language>
	</row>
	<row id="msg_0724_00443" index="443">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le devoir m’appelle.\nC’est le moment de se dire au revoir.\r</language>
	</row>
	<row id="msg_0724_00444" index="444">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Pokémon Rangers sont avant tout\nles gardiens de la paix.</language>
	</row>
	<row id="msg_0724_00445" index="445">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai gagné, au nom de la paix!\r</language>
	</row>
	<row id="msg_0724_00446" index="446">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Toi, tu m’as tout l’air d’être du genre\nfauteur de troubles, je me trompe?\r</language>
	</row>
	<row id="msg_0724_00447" index="447">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as vu des gamins jeter des ordures\ndans la nature?</language>
	</row>
	<row id="msg_0724_00448" index="448">
		<attribute name="window_context_name">used</attribute>
		<language name="English">N’oublie pas de toujours trier tes\ndéchets.</language>
	</row>
	<row id="msg_0724_00449" index="449">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Combattre des Pokémon, c’est bien.\nCombattre la pollution, c’est mieux.</language>
	</row>
	<row id="msg_0724_00450" index="450">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Regarde bien, mon chou!\nJe vais te vaincre en beauté!</language>
	</row>
	<row id="msg_0724_00451" index="451">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as vu ça, mon chou?\nTout en finesse et en élégance.\r</language>
	</row>
	<row id="msg_0724_00452" index="452">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est affreux, c’est horrible.\nQuelle image je vais donner?\r</language>
	</row>
	<row id="msg_0724_00453" index="453">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Donc, je commence par utiliser... ou...\nArgh! Quelle stratégie choisir?</language>
	</row>
	<row id="msg_0724_00454" index="454">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’imagine qu’il faut parfois faire\nconfiance à ses instincts.\r</language>
	</row>
	<row id="msg_0724_00455" index="455">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hééé! Tu aurais au moins pu\nattendre que je sois prête!\r</language>
	</row>
	<row id="msg_0724_00456" index="456">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Comment tu trouves ma cape?\nElle a été faite sur mesure!</language>
	</row>
	<row id="msg_0724_00457" index="457">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le tissu de ma cape?\nC’est un secret.\r</language>
	</row>
	<row id="msg_0724_00458" index="458">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé! C’est... une tache? Sur ma\nbelle cape? Nooooooooooon!\r</language>
	</row>
	<row id="msg_0724_00459" index="459">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as déjà connu cette sensation de\nterreur absolue? Moi, oui.</language>
	</row>
	<row id="msg_0724_00460" index="460">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aujourd’hui, tu as découvert le vrai\nsens du mot terreur.\r</language>
	</row>
	<row id="msg_0724_00461" index="461">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aïe! Ça suffit! Je demande un\npeu de compassion!\r</language>
	</row>
	<row id="msg_0724_00462" index="462">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ecoute! Regarde! Respire!\nTremble devant ma puissance!</language>
	</row>
	<row id="msg_0724_00463" index="463">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Utilise tous tes sens pour évaluer\nla puissance de ton adversaire.\r</language>
	</row>
	<row id="msg_0724_00464" index="464">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moi, je n’ai rien vu, rien entendu,\nmais j’ai tout perdu...\r</language>
	</row>
	<row id="msg_0724_00465" index="465">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Malheureusement, je suis obligé\nde te stopper dans ton élan.</language>
	</row>
	<row id="msg_0724_00466" index="466">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as perdu, mais tu tiens encore\ndebout. Tu mérites le respect.\r</language>
	</row>
	<row id="msg_0724_00467" index="467">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne crois pas, non. Je pense qu’il\ny a une erreur quelque part.\r</language>
	</row>
	<row id="msg_0724_00468" index="468">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai f-f-froid, mais je n-n-ne peux pas\nr-r-refuser un c-c-combat!</language>
	</row>
	<row id="msg_0724_00469" index="469">
		<attribute name="window_context_name">used</attribute>
		<language name="English">S-s-super! J’ai g-g-gagné!\r</language>
	</row>
	<row id="msg_0724_00470" index="470">
		<attribute name="window_context_name">used</attribute>
		<language name="English">F-f-froid! Mes p-p-paupières sont\nl-l-lourdes... Si f-f-froid...\r</language>
	</row>
	<row id="msg_0724_00471" index="471">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je préfère te dire au revoir tout de\nsuite. Avant de me mettre à pleurer.</language>
	</row>
	<row id="msg_0724_00472" index="472">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Snif! Snif!\nEt voilà, je pleure... de joie!\r</language>
	</row>
	<row id="msg_0724_00473" index="473">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Snif! Snif!\nEt voilà, je pleure... de désespoir!\r</language>
	</row>
	<row id="msg_0724_00474" index="474">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voilà qui est amusant. Tu n’as aucune\nchance, mais tu souhaites m’affronter?</language>
	</row>
	<row id="msg_0724_00475" index="475">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha, ha, ha, ha! C’était distrayant.\nA bientôt peut-être!\r</language>
	</row>
	<row id="msg_0724_00476" index="476">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Que s’est-il passé?\nJe ne comprends pas...\r</language>
	</row>
	<row id="msg_0724_00477" index="477">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Topdresseur je suis. Gagner sans\nl’ombre d’un doute je vais.</language>
	</row>
	<row id="msg_0724_00478" index="478">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dans les terres glacées du nord, pour\ndevenir la meilleure je m’entraîne.\r</language>
	</row>
	<row id="msg_0724_00479" index="479">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En traître tu as agi, mais la victoire tu\nas remporté. Bravo je te dis.\r</language>
	</row>
	<row id="msg_0724_00480" index="480">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je me demande combien de temps encore\nje vais pouvoir porter des shorts...</language>
	</row>
	<row id="msg_0724_00481" index="481">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Est-ce que les adultes peuvent aussi\nporter des shorts?\r</language>
	</row>
	<row id="msg_0724_00482" index="482">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quand je serai grand, tu crois que les\ngens m’appelleront “Monsieur Short”?\r</language>
	</row>
	<row id="msg_0724_00483" index="483">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est bien moi. Le légendaire Gamin en\nshort qui veille sur la ville.</language>
	</row>
	<row id="msg_0724_00484" index="484">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Même un Gamin en short peut devenir\nune légende, non?\r</language>
	</row>
	<row id="msg_0724_00485" index="485">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et voilà comment meurt une légende...\r</language>
	</row>
	<row id="msg_0724_00486" index="486">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh... Euh... S-s-salut...\nEnchantée... Je crois...</language>
	</row>
	<row id="msg_0724_00487" index="487">
		<attribute name="window_context_name">used</attribute>
		<language name="English">D-d-désolée.\nJe suis un peu n-n-nerveuse.\r</language>
	</row>
	<row id="msg_0724_00488" index="488">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh... Euh... Merci...\nC’était... s-s-sympa...\r</language>
	</row>
	<row id="msg_0724_00489" index="489">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cet endroit devient carrément ringard.\nIl me faut de nouveaux vêtements.</language>
	</row>
	<row id="msg_0724_00490" index="490">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’aime bien ton style. J’ai vraiment\nbesoin de nouveaux vêtements.\r</language>
	</row>
	<row id="msg_0724_00491" index="491">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je devrais peut-être acheter quelques\nAccessoires pour les Concours...\r</language>
	</row>
	<row id="msg_0724_00492" index="492">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Demain, j’ai un contrôle de maths,\nmais j’ai le temps de faire un combat.</language>
	</row>
	<row id="msg_0724_00493" index="493">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Au fait, ne dis pas à ma mère\nque tu m’as vu aujourd’hui...\r</language>
	</row>
	<row id="msg_0724_00494" index="494">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais devoir travailler plus dur,\npour mon contrôle et pour les combats.\r</language>
	</row>
	<row id="msg_0724_00495" index="495">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salut, Dresseur! Tu devrais porter\ndes lunettes, ça t’irait drôlement bien.</language>
	</row>
	<row id="msg_0724_00496" index="496">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne suis pas myope du tout. Je porte\ndes lunettes pour parfaire mon look.\r</language>
	</row>
	<row id="msg_0724_00497" index="497">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oups!\nJ’ai perdu mes lunettes!\r</language>
	</row>
	<row id="msg_0724_00498" index="498">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tout adversaire a un point faible. Je\nn’ai plus qu’à trouver le tien.</language>
	</row>
	<row id="msg_0724_00499" index="499">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Héhé. On dirait que j’ai trouvé\nton point faible.\r</language>
	</row>
	<row id="msg_0724_00500" index="500">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as réussi à trouver mon point faible?\r</language>
	</row>
	<row id="msg_0724_00501" index="501">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il y a longtemps que je n’ai pas\ncombattu.</language>
	</row>
	<row id="msg_0724_00502" index="502">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je devrais combattre plus souvent.\nC’est amusant, finalement.\r</language>
	</row>
	<row id="msg_0724_00503" index="503">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce n’est pas que je n’aime pas\ncombattre, mais bon...\r</language>
	</row>
	<row id="msg_0724_00504" index="504">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quand on est riche, on a une option\nsur la victoire. Regarde.</language>
	</row>
	<row id="msg_0724_00505" index="505">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as compris?\nTu vois qui domine?\r</language>
	</row>
	<row id="msg_0724_00506" index="506">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non! Qu’est-ce que tu as fait?\nJe suis perdu!\r</language>
	</row>
	<row id="msg_0724_00507" index="507">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est toi mon adversaire? Très bien...\nEssaye de ne pas trop me décevoir...</language>
	</row>
	<row id="msg_0724_00508" index="508">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Pokémon aussi aiment le luxe, tu\nsais. C’est un sentiment universel.\r</language>
	</row>
	<row id="msg_0724_00509" index="509">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pff! Tu crois que ça m’impressionne?\nJ’ai assez d’argent pour nager dedans!\r</language>
	</row>
	<row id="msg_0724_00510" index="510">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Toi là-bas! Oui, toi.\nJe m’ennuie.</language>
	</row>
	<row id="msg_0724_00511" index="511">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’était agréable le temps que ça a\nduré. Je te remercie.\r</language>
	</row>
	<row id="msg_0724_00512" index="512">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as du talent. Tu es un Dresseur\nremarquable, c’est certain.\r</language>
	</row>
	<row id="msg_0724_00513" index="513">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les gens comme toi, je les remets à\nleur place sans effort.</language>
	</row>
	<row id="msg_0724_00514" index="514">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je n’ai eu aucun effort à fournir pour\nremporter la victoire, comme prévu.\r</language>
	</row>
	<row id="msg_0724_00515" index="515">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est toi qui nous as vaincus\nsans effort!\r</language>
	</row>
	<row id="msg_0724_00516" index="516">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma chambre est toujours pleine\nd’insectes. Ma mère n’aime pas trop ça.</language>
	</row>
	<row id="msg_0724_00517" index="517">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je collectionne les Pokémon de type\nInsecte pour créer une réserve.\r</language>
	</row>
	<row id="msg_0724_00518" index="518">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé, je crois qu’un de mes\ninsectes vient de me piquer...\r</language>
	</row>
	<row id="msg_0724_00519" index="519">
		<attribute name="window_context_name">used</attribute>
		<language name="English">D’aucuns me trouvent mature pour mon\nâge. Je me demande bien pourquoi.</language>
	</row>
	<row id="msg_0724_00520" index="520">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cet affrontement fut proprement\ndélectable. Je t’en sais gré.\r</language>
	</row>
	<row id="msg_0724_00521" index="521">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Excellent! Quelle virtuosité!\nJe ne peux qu’admirer tes prouesses!\r</language>
	</row>
	<row id="msg_0724_00522" index="522">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne peux pas perdre.\nJe ne tomberai pas. Jamais.</language>
	</row>
	<row id="msg_0724_00523" index="523">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu ne crois pas assez en toi.\r</language>
	</row>
	<row id="msg_0724_00524" index="524">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bam...\r</language>
	</row>
	<row id="msg_0724_00525" index="525">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Alors comme ça, tu te demandes\nce qu’est un ninja.</language>
	</row>
	<row id="msg_0724_00526" index="526">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un ninja est un être puissant.\nC’est un bon début.\r</language>
	</row>
	<row id="msg_0724_00527" index="527">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un ninja... sait perdre avec panache?\r</language>
	</row>
	<row id="msg_0724_00528" index="528">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’autre jour, j’ai vu une dame qui\nportait le même costume que moi.</language>
	</row>
	<row id="msg_0724_00529" index="529">
		<attribute name="window_context_name">used</attribute>
		<language name="English">“J’adore ton style”, elle m’a dit.\r</language>
	</row>
	<row id="msg_0724_00530" index="530">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Elle m’a regardée et elle m’a dit:\n“C’est une blague, j’espère!”\r</language>
	</row>
	<row id="msg_0724_00531" index="531">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu sais, dissimulée dans ce costume se\ncache une belle jeune femme.</language>
	</row>
	<row id="msg_0724_00532" index="532">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je rêve de vivre comme un Pokémon!\nDe devenir un Pokémon!\r</language>
	</row>
	<row id="msg_0724_00533" index="533">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis une adulte, mais je veux devenir\nun Pokémon. Tu crois que je suis folle?\r</language>
	</row>
	<row id="msg_0724_00534" index="534">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis très populaire, et j’ai un\nemploi du temps extrêmement chargé!</language>
	</row>
	<row id="msg_0724_00535" index="535">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, non! Il est déjà si tard? Je suis en\nretard, non? Vite, mon agenda!\r</language>
	</row>
	<row id="msg_0724_00536" index="536">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’appelle mon agent! Je dois savoir si\nj’ai le temps pour une revanche.\r</language>
	</row>
	<row id="msg_0724_00537" index="537">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu fais partie de mon fan-club? Je te\ndonnerai un autographe si tu perds.</language>
	</row>
	<row id="msg_0724_00538" index="538">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voilà ton autographe! Prends-en soin.\nAh non, désolée. Pas de photo!\r</language>
	</row>
	<row id="msg_0724_00539" index="539">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pas très DELiCATTY de ta part.\nJe dirais même FANTOMINable.\r</language>
	</row>
	<row id="msg_0724_00540" index="540">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je dois perdre du poids. C’est pour ça\nque je me suis mis au jogging.</language>
	</row>
	<row id="msg_0724_00541" index="541">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon, je crois que je vais aller\ncourir par là-bas...\r</language>
	</row>
	<row id="msg_0724_00542" index="542">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aïe, c’est un coup dur. Je crois que\nj’ai perdu ma motivation.\r</language>
	</row>
	<row id="msg_0724_00543" index="543">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Pokémon de type Insecte sont des\nchampions de la course à pied!</language>
	</row>
	<row id="msg_0724_00544" index="544">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis toujours très admiratif quand je\nvois un Pokémon de type Insecte courir.\r</language>
	</row>
	<row id="msg_0724_00545" index="545">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Argh...\r</language>
	</row>
	<row id="msg_0724_00546" index="546">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dis, je suis épuisé. On pourrait\nfaire ça demain plutôt?</language>
	</row>
	<row id="msg_0724_00547" index="547">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voilà ce que tu as gagné avec\nton impatience!\r</language>
	</row>
	<row id="msg_0724_00548" index="548">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est exactement pour ça que je voulais\nfaire ça demain. Je veux dormir!\r</language>
	</row>
	<row id="msg_0724_00549" index="549">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si tu ne donnes pas à manger à tes\nPokémon, ils finiront par s’enfuir.</language>
	</row>
	<row id="msg_0724_00550" index="550">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si un Pokémon s’enfuit, tu ne le\nreverras plus jamais!\r</language>
	</row>
	<row id="msg_0724_00551" index="551">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce que je t’ai dit tout à l’heure, c’est\nune maxime pleine de sagesse.\r</language>
	</row>
	<row id="msg_0724_00552" index="552">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quand j’étais plus jeune, je suis parti\nen quête de bien des trésors oubliés.</language>
	</row>
	<row id="msg_0724_00553" index="553">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Evidemment, je n’ai rien trouvé. Mais\nl’important, c’est d’y croire.\r</language>
	</row>
	<row id="msg_0724_00554" index="554">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma dernière expédition fut très dure.\nSurtout pour mon compte en banque.\r</language>
	</row>
	<row id="msg_0724_00555" index="555">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Prépare-toi à faire face à une averse\nde capacités! Sors ton parapluie!</language>
	</row>
	<row id="msg_0724_00556" index="556">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dresseur, tu devrais étudier plus en\ndétail les effets des capacités.\r</language>
	</row>
	<row id="msg_0724_00557" index="557">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Argh! Je suis à court! J’ai grillé\ntoutes mes cartouches! Je suis fini!\r</language>
	</row>
	<row id="msg_0724_00558" index="558">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je collectionne et j’entraîne des\nPokémon pour frimer devant mes amis.</language>
	</row>
	<row id="msg_0724_00559" index="559">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gagner ou perdre... Cela n’a aucune\nimportance pour moi.\r</language>
	</row>
	<row id="msg_0724_00560" index="560">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as gagné le combat, mais pour ce qui\nest du style, je te domine largement.</language>
	</row>
	<row id="msg_0724_00561" index="561">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu te demandes quels sont mes Pokémon\npréférés? Voilà un indice...</language>
	</row>
	<row id="msg_0724_00562" index="562">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as compris? Mes Pokémon préférés\nont du talent et de la personnalité.\r</language>
	</row>
	<row id="msg_0724_00563" index="563">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je t’arrête tout de suite! Ce n’était\npas censé se passer comme ça!\r</language>
	</row>
	<row id="msg_0724_00564" index="564">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rock? Samba? Country? Je peux tout\njouer! Ouvre grand les oreilles!</language>
	</row>
	<row id="msg_0724_00565" index="565">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Musique et Pokémon jusqu’au bout de\nla nuit! Voilà la belle vie!\r</language>
	</row>
	<row id="msg_0724_00566" index="566">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bah, je n’ai plus la pêche. Je crois\nque je vais jouer du blues, plutôt.\r</language>
	</row>
	<row id="msg_0724_00567" index="567">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Connais-tu cette douce mélodie?\nC’est parti pour une valse Pokémon!</language>
	</row>
	<row id="msg_0724_00568" index="568">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cette douce mélodie...\nElle va droit au cœur, n’est-ce pas?\r</language>
	</row>
	<row id="msg_0724_00569" index="569">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé, cette mélodie aurait dû\nt’attendrir! Prends exemple sur moi!\r</language>
	</row>
	<row id="msg_0724_00570" index="570">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je crois que je pourrais voler. Toucher\nle ciel. J’y pense tous les jours...</language>
	</row>
	<row id="msg_0724_00571" index="571">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est pour cette raison que je\nsuis devenue Ornithologue.\r</language>
	</row>
	<row id="msg_0724_00572" index="572">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Comme beaucoup d’oiseaux, je ne vois\npas très bien la nuit.\r</language>
	</row>
	<row id="msg_0724_00573" index="573">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis un Dresseur, mais je suis aussi\nfragile qu’un oisillon. Sois sympa.</language>
	</row>
	<row id="msg_0724_00574" index="574">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Est-ce que tu crois que je suis prête à\nvoler de mes propres ailes?\r</language>
	</row>
	<row id="msg_0724_00575" index="575">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un jour, je te battrai à plate couture.\r</language>
	</row>
	<row id="msg_0724_00576" index="576">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis un homme, un vrai, un dur.\nJe te conseille de me respecter.</language>
	</row>
	<row id="msg_0724_00577" index="577">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et voilà!\nUn homme, un vrai, ne perd jamais!\r</language>
	</row>
	<row id="msg_0724_00578" index="578">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouiiiiin! Ouiiiin!\nJe veux ma môman!\r</language>
	</row>
	<row id="msg_0724_00579" index="579">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Après ce combat, je dois affronter un\nMontagnard. Tu seras donc mon apéritif.</language>
	</row>
	<row id="msg_0724_00580" index="580">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bien, tu m’as mis en appétit.\nJe suis prêt à dévorer ce Montagnard!\r</language>
	</row>
	<row id="msg_0724_00581" index="581">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nom d’un LEVIATOR! Je ne battrai jamais\nce Montagnard si ça continue!\r</language>
	</row>
	<row id="msg_0724_00582" index="582">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Après ce combat, j’affronte un Marin.\nJe vais tester ma stratégie sur toi.</language>
	</row>
	<row id="msg_0724_00583" index="583">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tout fonctionne à merveille.\nPrépare-toi, Marin!\r</language>
	</row>
	<row id="msg_0724_00584" index="584">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne battrai jamais ce Marin si je\nne peux même pas gagner contre toi...\r</language>
	</row>
	<row id="msg_0724_00585" index="585">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hoyo hoyo! Hoyo hoyo! Hoyo hoyo!\nCette danse tribale apporte la force.</language>
	</row>
	<row id="msg_0724_00586" index="586">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hoyo hoyo! Hoyo hoyo! Hoyo hoyo!\nEn plus, c’est très amusant!\r</language>
	</row>
	<row id="msg_0724_00587" index="587">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hoyo hoyo! Hoyo hoyo! Hoyo hoyo!\nJe danse pour oublier ma peine.\r</language>
	</row>
	<row id="msg_0724_00588" index="588">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne suis pas vraiment de la police.\nJe collectionne juste les uniformes.</language>
	</row>
	<row id="msg_0724_00589" index="589">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’était très amusant de combattre\ndéguisé en Agent de police.\r</language>
	</row>
	<row id="msg_0724_00590" index="590">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Très bien, j’ai compris.\nBonne continuation.\r</language>
	</row>
	<row id="msg_0724_00591" index="591">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis un Agent. J’ai l’air sérieux,\nmais seulement quand je suis en service.</language>
	</row>
	<row id="msg_0724_00592" index="592">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En tant qu’Agent, je passe beaucoup de\ntemps à poursuivre des malfaiteurs.\r</language>
	</row>
	<row id="msg_0724_00593" index="593">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Après le travail, je me change en\nNageur pour me détendre!\r</language>
	</row>
	<row id="msg_0724_00594" index="594">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A force de persévérance, on arrive\nà tout. Je te jure.</language>
	</row>
	<row id="msg_0724_00595" index="595">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lorsque ton adversaire te croit faible,\nla victoire n’en a que plus de saveur.\r</language>
	</row>
	<row id="msg_0724_00596" index="596">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Extraordinaire! Ce combat était\nfascinant! Merci.\r</language>
	</row>
	<row id="msg_0724_00597" index="597">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je le ferai, ou je ne le ferai\npas. Ce sera tout ou rien.</language>
	</row>
	<row id="msg_0724_00598" index="598">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je l’ai fait...\nLa chance était avec moi...\r</language>
	</row>
	<row id="msg_0724_00599" index="599">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne l’ai pas fait...\nQue dirais-tu d’une revanche?\r</language>
	</row>
	<row id="msg_0724_00600" index="600">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vis au milieu de la forêt.\nJe suis un joyeux Campeur.</language>
	</row>
	<row id="msg_0724_00601" index="601">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je fais tout ce que je peux pour rendre\nle camping plus confortable.\r</language>
	</row>
	<row id="msg_0724_00602" index="602">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En fait, j’en ai vraiment marre de vivre\ndans les bois...\r</language>
	</row>
	<row id="msg_0724_00603" index="603">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non! Je ne veux pas me battre!\nJ’ai horreur de ça!</language>
	</row>
	<row id="msg_0724_00604" index="604">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé! J’ai gagné? Euh, tu ne m’en\nveux pas, hein?\r</language>
	</row>
	<row id="msg_0724_00605" index="605">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vois? Qu’est-ce que je t’avais dit?\nLe combat, c’est vraiment pas mon truc.\r</language>
	</row>
	<row id="msg_0724_00606" index="606">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tiens, un Dresseur!\nJe vais te cuisiner aux petits oignons!</language>
	</row>
	<row id="msg_0724_00607" index="607">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un bon combat s’apprécie tout autant\nqu’un bon repas!\r</language>
	</row>
	<row id="msg_0724_00608" index="608">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Râpé!\r</language>
	</row>
	<row id="msg_0724_00609" index="609">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ffffuit! Fffuuuuiiiit!\nSiffler en combattant, j’adore ça!</language>
	</row>
	<row id="msg_0724_00610" index="610">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trop facile! Est-ce que mon\nsifflement a gêné ta concentration?\r</language>
	</row>
	<row id="msg_0724_00611" index="611">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ffffffffff... Fffff...\nJe n’ai plus la force de siffler...\r</language>
	</row>
	<row id="msg_0724_00612" index="612">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu les entends? Les cris déments de\nmes centaines de fans?</language>
	</row>
	<row id="msg_0724_00613" index="613">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci, merci à tous. Je dédie cette\nvictoire à tous mes fans!\r</language>
	</row>
	<row id="msg_0724_00614" index="614">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu maîtrises ton sujet!\nJe crois que je vais devenir fan de toi!\r</language>
	</row>
	<row id="msg_0724_00615" index="615">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais devenir le numéro un mondial.\nPour commencer...</language>
	</row>
	<row id="msg_0724_00616" index="616">
		<attribute name="window_context_name">used</attribute>
		<language name="English">“Numéro un mondial”, ça sonne vraiment\nbien, tu ne trouves pas?\r</language>
	</row>
	<row id="msg_0724_00617" index="617">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Numéro un mondial, d’accord, mais de\nquoi?\r</language>
	</row>
	<row id="msg_0724_00618" index="618">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne suis pas une Star de bas étage.\nJe suis comédienne avant tout!</language>
	</row>
	<row id="msg_0724_00619" index="619">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma carrière n’a rien à voir avec celle\nde ces Stars de pacotille!\r</language>
	</row>
	<row id="msg_0724_00620" index="620">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis comédienne...\nJ’aime les sonorités de cette phrase...\r</language>
	</row>
	<row id="msg_0724_00621" index="621">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On n’a pas beaucoup de temps, alors\nessayons de nous amuser au maximum!</language>
	</row>
	<row id="msg_0724_00622" index="622">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci! C’était très amusant!\nJ’espère qu’on se reverra.\r</language>
	</row>
	<row id="msg_0724_00623" index="623">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis triste de devoir partir\nsi tôt. J’espère qu’on se reverra.\r</language>
	</row>
	<row id="msg_0724_00624" index="624">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis le secrétaire adjoint du\nFan Club. A ton service...</language>
	</row>
	<row id="msg_0724_00625" index="625">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tremble devant le pouvoir du Fan Club!\r</language>
	</row>
	<row id="msg_0724_00626" index="626">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Argh! Mais j’ai fait de mon mieux.\nJe n’ai aucun regret.\r</language>
	</row>
	<row id="msg_0724_00627" index="627">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue, Dresseur.\nLaisse-moi te montrer ma puissance.</language>
	</row>
	<row id="msg_0724_00628" index="628">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dresseur, as-tu la moindre idée de\nl’étendue de ma puissance?\r</language>
	</row>
	<row id="msg_0724_00629" index="629">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu m’as terrassé. Tu es digne de\ndevenir un vrai Pokéfan.\r</language>
	</row>
	<row id="msg_0724_00630" index="630">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma voisine m’a offert une CT ce matin.\nVoyons ce que ça donne...</language>
	</row>
	<row id="msg_0724_00631" index="631">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis surprise. Pour une fois, ma\nvoisine m’a donné quelque chose d’utile!\r</language>
	</row>
	<row id="msg_0724_00632" index="632">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pff, j’aurais dû m’en douter. Ma voisine\nm’a refilé une CT sans intérêt!\r</language>
	</row>
	<row id="msg_0724_00633" index="633">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis assez âgée pour être ta mère,\nmais je suis restée jeune dans ma tête!</language>
	</row>
	<row id="msg_0724_00634" index="634">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai encore une peau de bébé, tu sais.\nDouce, ferme et parfaitement hydratée.\r</language>
	</row>
	<row id="msg_0724_00635" index="635">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai l’air âgée, mais j’ai su rester\njeune! Je te jure!\r</language>
	</row>
	<row id="msg_0724_00636" index="636">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je joue avec eux, je travaille avec eux:\nje passe mon temps avec les Pokémon.</language>
	</row>
	<row id="msg_0724_00637" index="637">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une vie sans Pokémon?\nJe n’y pense même pas.\r</language>
	</row>
	<row id="msg_0724_00638" index="638">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est comme si j’étais marié avec les\nPokémon. Sans être vraiment marié.\r</language>
	</row>
	<row id="msg_0724_00639" index="639">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour être le meilleur, il faut travailler\nplus dur que tout le monde.</language>
	</row>
	<row id="msg_0724_00640" index="640">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai travaillé très dur, je l’avoue.\r</language>
	</row>
	<row id="msg_0724_00641" index="641">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais continuer à m’entraîner,\nencore et encore. Et un jour...\r</language>
	</row>
	<row id="msg_0724_00642" index="642">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je dois devenir célèbre pour avoir\nles moyens de reconstruire la ferme.</language>
	</row>
	<row id="msg_0724_00643" index="643">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne peux pas perdre.\nJe me bats pour mes parents.\r</language>
	</row>
	<row id="msg_0724_00644" index="644">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si je deviens célèbre, les gens paieront\npour visiter ma ferme...\r</language>
	</row>
	<row id="msg_0724_00645" index="645">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Avant de dormir, j’aime lire à\nla lueur des bougies.</language>
	</row>
	<row id="msg_0724_00646" index="646">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ne va pas croire que je n’ai pas\nl’électricité à la maison, hein?\r</language>
	</row>
	<row id="msg_0724_00647" index="647">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les bougies ont un côté tellement\nromantique.\r</language>
	</row>
	<row id="msg_0724_00648" index="648">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vas assister à une superbe\ndémonstration de technique.</language>
	</row>
	<row id="msg_0724_00649" index="649">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et voilà. C’est pratiquement\ndigne d’un Maître Pokémon.\r</language>
	</row>
	<row id="msg_0724_00650" index="650">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Argh... Je ne me sens pas\ntrès bien, là...\r</language>
	</row>
	<row id="msg_0724_00651" index="651">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je n’ai pas la main verte avec les Baies,\nmais je suis doué avec les Pokémon!</language>
	</row>
	<row id="msg_0724_00652" index="652">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Viens me voir si tu as besoin de conseils\nsur la manière d’élever tes Pokémon.\r</language>
	</row>
	<row id="msg_0724_00653" index="653">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Elever un Pokémon demande énormément\nde soin...\r</language>
	</row>
	<row id="msg_0724_00654" index="654">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Pokémon sont des Pokémon, qu’ils\nsoient forts ou faibles, jolis ou laids.</language>
	</row>
	<row id="msg_0724_00655" index="655">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si tu élèves tes Pokémon avec amour, ils\nte le rendront bien.\r</language>
	</row>
	<row id="msg_0724_00656" index="656">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Euh... Je crois que je dois revoir\nma copie...\r</language>
	</row>
	<row id="msg_0724_00657" index="657">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Elever un Pokémon demande énormément\nde temps et d’argent.</language>
	</row>
	<row id="msg_0724_00658" index="658">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais voir s’épanouir un Pokémon, c’est\nla plus belle des récompenses.\r</language>
	</row>
	<row id="msg_0724_00659" index="659">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis prête à tout pour élever le\nPokémon parfait.\r</language>
	</row>
	<row id="msg_0724_00660" index="660">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as tout compris. Je suis fort. Je ne\nperdrai pas. Tu ne peux pas gagner.</language>
	</row>
	<row id="msg_0724_00661" index="661">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eh oui... Je suis si fort...\nHé, hé... Hé, hé, hé, hé, hé...\r</language>
	</row>
	<row id="msg_0724_00662" index="662">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai perdu? Mais pourquoi?\nQu’est-ce que je vais devenir?\r</language>
	</row>
	<row id="msg_0724_00663" index="663">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis un Topdresseur, j’ai donc\nparfaitement le droit de frimer.</language>
	</row>
	<row id="msg_0724_00664" index="664">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as bien combattu.\nSans rire, je le pense.\r</language>
	</row>
	<row id="msg_0724_00665" index="665">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Euh...\nJ’ai encore du chemin à faire...\r</language>
	</row>
	<row id="msg_0724_00666" index="666">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’attendais avec impatience l’occasion\nde t’affronter!</language>
	</row>
	<row id="msg_0724_00667" index="667">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’en étais sûre! Tu as du talent.\nTu devrais devenir Topdresseur.\r</language>
	</row>
	<row id="msg_0724_00668" index="668">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta réputation est fondée, on dirait.\nJ’espère qu’on s’affrontera à nouveau.\r</language>
	</row>
	<row id="msg_0724_00669" index="669">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Regarde-moi. Je suis ce que tu as\ntoujours rêvé d’être.</language>
	</row>
	<row id="msg_0724_00670" index="670">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu t’attendais à autre chose?\r</language>
	</row>
	<row id="msg_0724_00671" index="671">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta puissance dépasse déjà la mienne.\nMais tu devrais viser encore plus haut.\r</language>
	</row>
	<row id="msg_0724_00672" index="672">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est ma vie qui est en jeu dans ce\ncombat. Tu veux bien perdre pour moi?</language>
	</row>
	<row id="msg_0724_00673" index="673">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oui! J’ai gagné!\nJe me sens beaucoup mieux!\r</language>
	</row>
	<row id="msg_0724_00674" index="674">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non! Je n’aurais jamais dû\nperdre. Les conséquences...\r</language>
	</row>
	<row id="msg_0724_00675" index="675">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je crois que je suis malade.\nJe tenais à ce que tu le saches.</language>
	</row>
	<row id="msg_0724_00676" index="676">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hum... Ce mal de tête m’a inspiré\nde nouvelles stratégies.\r</language>
	</row>
	<row id="msg_0724_00677" index="677">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je te l’ai dit, je suis malade.\nJe suis meilleur, d’habitude.\r</language>
	</row>
	<row id="msg_0724_00678" index="678">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pendant le combat, fais très attention\nà mon manteau. Il coûte une fortune.</language>
	</row>
	<row id="msg_0724_00679" index="679">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hiii! Ton Pokémon a failli envoyer une\ngoutte de sueur sur mon manteau!\r</language>
	</row>
	<row id="msg_0724_00680" index="680">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bah, au moins, je n’ai pas sali mon\nmanteau. Le reste importe peu.\r</language>
	</row>
	<row id="msg_0724_00681" index="681">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu devrais partir.\nJe n’aimerais pas te voir perdre.</language>
	</row>
	<row id="msg_0724_00682" index="682">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je te l’avais pourtant dit...\nSi tu partais, maintenant?\r</language>
	</row>
	<row id="msg_0724_00683" index="683">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ecoute... la puissance, c’est bien,\nmais...\r</language>
	</row>
	<row id="msg_0724_00684" index="684">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Doucement, doucement! L’é-qui-libre!\nVoilà la clé!</language>
	</row>
	<row id="msg_0724_00685" index="685">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hooooolà! J’ai failli tomber, il faut\nque je sois plus prudent.\r</language>
	</row>
	<row id="msg_0724_00686" index="686">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aaaaaaah!\nBoum!\r</language>
	</row>
	<row id="msg_0724_00687" index="687">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ne t’inquiète de rien. Fais-moi\nconfiance, je m’occupe de tout.</language>
	</row>
	<row id="msg_0724_00688" index="688">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Alors? Pas mal, hein?\nJ’espère qu’on remettra ça.\r</language>
	</row>
	<row id="msg_0724_00689" index="689">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon, ben je vais y aller.\nTu es un sacré Dresseur, toi!\r</language>
	</row>
	<row id="msg_0724_00690" index="690">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais t’affronter. Et je vais\ncertainement gagner. Je suis douée.</language>
	</row>
	<row id="msg_0724_00691" index="691">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai gagné.\nEt j’ai envie de danser.\r</language>
	</row>
	<row id="msg_0724_00692" index="692">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et alors? Je n’ai pas pu\ngagner?\r</language>
	</row>
	<row id="msg_0724_00693" index="693">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’en appelle aux pouvoirs de\nla nature! A moi!</language>
	</row>
	<row id="msg_0724_00694" index="694">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je dédie cette victoire aux pouvoirs\ninfinis de la nature.\r</language>
	</row>
	<row id="msg_0724_00695" index="695">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non! La nature ne me pardonnera\npas cet échec!\r</language>
	</row>
	<row id="msg_0724_00696" index="696">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Peu importe l’adversaire ou les règles,\nun Dresseur ne refuse aucun combat!</language>
	</row>
	<row id="msg_0724_00697" index="697">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si un Dresseur fait de son mieux, on\nne peut pas lui faire de reproches.\r</language>
	</row>
	<row id="msg_0724_00698" index="698">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un bon Dresseur ne se vante pas de ses\nvictoires, mais médite sur son combat.\r</language>
	</row>
	<row id="msg_0724_00699" index="699">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Humm... Tu n’as pas l’air commode...\nOn ne va pas te laisser gagner!</language>
	</row>
	<row id="msg_0724_00700" index="700">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Super! Excellent!\rOn est les meilleurs!</language>
	</row>
	<row id="msg_0724_00701" index="701">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Comment oses-tu?\nTu nous as blessés, monstre!\r</language>
	</row>
	<row id="msg_0724_00702" index="702">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je passe ma vie à m’entraîner, mais je\nsuis très nerveux lors des combats...</language>
	</row>
	<row id="msg_0724_00703" index="703">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cette tension me rend malade!\nJe préfère retourner m’entraîner.\r</language>
	</row>
	<row id="msg_0724_00704" index="704">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si on était jugés sur l’entraînement,\nce serait moi le numéro un.\r</language>
	</row>
	<row id="msg_0724_00705" index="705">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Haa-yaa! Haa! Haa!\nEncore une fois! Haa! Haaaaa!</language>
	</row>
	<row id="msg_0724_00706" index="706">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bouh-ya!\r</language>
	</row>
	<row id="msg_0724_00707" index="707">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Haa-ya! Euh... attends un peu!\nNoooon!\r</language>
	</row>
	<row id="msg_0724_00708" index="708">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Alors?</language>
	</row>
	<row id="msg_0724_00709" index="709">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé, hé...\r</language>
	</row>
	<row id="msg_0724_00710" index="710">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu m’as battue?\nQui est ton senseï?\r</language>
	</row>
	<row id="msg_0724_00711" index="711">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vas-y! Allez viens, viens!\nAllez! Allez! Viens, je t’attends!</language>
	</row>
	<row id="msg_0724_00712" index="712">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouiiiiiiiii!\r</language>
	</row>
	<row id="msg_0724_00713" index="713">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Noooooooon!\r</language>
	</row>
	<row id="msg_0724_00714" index="714">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je peux sentir ta confiance en toi.\nCe combat promet d’être divertissant.</language>
	</row>
	<row id="msg_0724_00715" index="715">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Du fond du cœur, j’espère que l’on\npourra s’affronter à nouveau.\r</language>
	</row>
	<row id="msg_0724_00716" index="716">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’était effectivement un combat\ndivertissant. J’attends la revanche...\r</language>
	</row>
	<row id="msg_0724_00717" index="717">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Grâce à ce combat, tu apprendras que\nla sagesse vient avec l’expérience.</language>
	</row>
	<row id="msg_0724_00718" index="718">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il faudra plus qu’un enfant pour\nme terrasser!\r</language>
	</row>
	<row id="msg_0724_00719" index="719">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est pas juste! Je proteste!\nJ’exige une revanche!\r</language>
	</row>
	<row id="msg_0724_00720" index="720">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne me sens pas très bien.\nAide-moi à oublier ma migraine!</language>
	</row>
	<row id="msg_0724_00721" index="721">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pfiou... Rien de tel qu’un combat\npour évacuer le stress!\r</language>
	</row>
	<row id="msg_0724_00722" index="722">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Héééééé! Je ne me sens pas mieux\ndu tout, au contraire!\r</language>
	</row>
	<row id="msg_0724_00723" index="723">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Faites entrer la fanfare!\nCélébrons ma victoire!</language>
	</row>
	<row id="msg_0724_00724" index="724">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’adore combattre en musique.\nCela rend mon cœur plus léger.\r</language>
	</row>
	<row id="msg_0724_00725" index="725">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Très bien, ça suffit.\nOublions la fanfare.\r</language>
	</row>
	<row id="msg_0724_00726" index="726">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un Dresseur aussi expérimenté que moi\nen a vu des vertes et des pas mûres.</language>
	</row>
	<row id="msg_0724_00727" index="727">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce sont des choses qui arrivent.\nNe te décourage pas.\r</language>
	</row>
	<row id="msg_0724_00728" index="728">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les humains et les Pokémon sont\ndifférents, et c’est tant mieux.</language>
	</row>
	<row id="msg_0724_00729" index="729">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon grand frère m’a donné une\nastuce: trouver le point faible!</language>
	</row>
	<row id="msg_0724_00730" index="730">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai réussi, frérot!\r</language>
	</row>
	<row id="msg_0724_00731" index="731">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon grand frère va encore se moquer\nde moi!\r</language>
	</row>
	<row id="msg_0724_00732" index="732">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le grand esprit Pokémon me parle...\nIl me pousse à combattre...</language>
	</row>
	<row id="msg_0724_00733" index="733">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le grand esprit Pokémon me parle...\nIl espère t’affronter à nouveau...\r</language>
	</row>
	<row id="msg_0724_00734" index="734">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le grand esprit Pokémon me parle...\nIl se dit satisfait de ce combat...\r</language>
	</row>
	<row id="msg_0724_00735" index="735">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vois une lumière autour de toi.\nQu’est-ce que ça signifie?</language>
	</row>
	<row id="msg_0724_00736" index="736">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je croyais que c’était une aura\nd’invincibilité. Je me trompais.\r</language>
	</row>
	<row id="msg_0724_00737" index="737">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai compris...\nC’était l’éclat de la victoire...\r</language>
	</row>
	<row id="msg_0724_00738" index="738">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais te servir ta défaite\nsur un plateau d’argent.</language>
	</row>
	<row id="msg_0724_00739" index="739">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci d’avoir patienté!\r</language>
	</row>
	<row id="msg_0724_00740" index="740">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oups! La défaite a été servie\nau mauvais client!\r</language>
	</row>
	<row id="msg_0724_00741" index="741">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Génial, un autre Dresseur super balèze.\nC’est bien ma veine.</language>
	</row>
	<row id="msg_0724_00742" index="742">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mouais, c’était juste quand même.\nJe n’ai jamais de chance...\r</language>
	</row>
	<row id="msg_0724_00743" index="743">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vois? Je savais que je perdrais.\nSi cette attaque avait touché...\r</language>
	</row>
	<row id="msg_0724_00744" index="744">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les gens disent plein de choses sur les\nPokémon. Pour moi, ils sont juste cool!</language>
	</row>
	<row id="msg_0724_00745" index="745">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Euh, est-ce que ça va?\nTu manques peut-être de sommeil?\r</language>
	</row>
	<row id="msg_0724_00746" index="746">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Victoire, défaite... Si tu prends tout\nça trop au sérieux, ça finira mal...\r</language>
	</row>
	<row id="msg_0724_00747" index="747">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais faire de mon mieux pour toi!</language>
	</row>
	<row id="msg_0724_00748" index="748">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’espère que ce combat t’aura donné\nentière satisfaction!\r</language>
	</row>
	<row id="msg_0724_00749" index="749">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh attends! S’il te plaît!\nOn peut recommencer le combat?\r</language>
	</row>
	<row id="msg_0724_00750" index="750">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je prépare une chronique sur tous\nles Dresseurs qui se présentent ici.</language>
	</row>
	<row id="msg_0724_00751" index="751">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le monde est vaste, je me demande\ncombien de Dresseurs je vais affronter.\r</language>
	</row>
	<row id="msg_0724_00752" index="752">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Qui dit rencontre dit séparation. C’est\npour ça que je fais cette chronique.\r</language>
	</row>
	<row id="msg_0724_00753" index="753">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Toute ma vie, j’ai attendu quelqu’un\ncomme toi. Tu es à moi.</language>
	</row>
	<row id="msg_0724_00754" index="754">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Est-ce que cette réplique tirée d’un\nfilm d’amour a gêné ta concentration?\r</language>
	</row>
	<row id="msg_0724_00755" index="755">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et moi qui pensais te déconcentrer avec\nma réplique de film d’amour...\r</language>
	</row>
	<row id="msg_0724_00756" index="756">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu m’accorderas une interview\nsi tu gagnes?</language>
	</row>
	<row id="msg_0724_00757" index="757">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’était bien trop facile.\nTu devrais faire plus d’efforts.\r</language>
	</row>
	<row id="msg_0724_00758" index="758">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tes impressions en un mot?\nParle bien dans le micro!\r</language>
	</row>
	<row id="msg_0724_00759" index="759">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mince, je meurs de faim...</language>
	</row>
	<row id="msg_0724_00760" index="760">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis ravie, mais le bonheur, ça donne\nfaim. Je ne peux pas me le permettre!\r</language>
	</row>
	<row id="msg_0724_00761" index="761">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh...\nCe Pokémon a l’air délicieux...\r</language>
	</row>
	<row id="msg_0724_00762" index="762">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Que les choses soient claires, je suis\nbeaucoup trop fort pour toi!</language>
	</row>
	<row id="msg_0724_00763" index="763">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vois?\nJe n’exagérais pas!\r</language>
	</row>
	<row id="msg_0724_00764" index="764">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Euh... tu es qui déjà?\r</language>
	</row>
	<row id="msg_0724_00765" index="765">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dégagez la route! Faites place!\nEuh... une seconde! Je dois combattre!</language>
	</row>
	<row id="msg_0724_00766" index="766">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Alors? Tu as du mal à suivre?\nPasse à la vitesse supérieure!\r</language>
	</row>
	<row id="msg_0724_00767" index="767">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK, faites place! Laissez passer!\nLaissez sortir le perdant!\r</language>
	</row>
	<row id="msg_0724_00768" index="768">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Au combat ou à vélo, prudence\nest le maître mot.</language>
	</row>
	<row id="msg_0724_00769" index="769">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si tu fais preuve de patience au combat,\nau final, la victoire te sourira.\r</language>
	</row>
	<row id="msg_0724_00770" index="770">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je fais les choses à mon rythme.\nUn jour, je serai meilleure que toi.\r</language>
	</row>
	<row id="msg_0724_00771" index="771">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne sais pas trop pourquoi j’ai acheté\nce vélo. Je ne sais même pas en faire.</language>
	</row>
	<row id="msg_0724_00772" index="772">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai eu du mal à venir ici avec ce vélo!\nJ’ai dû le pousser tout le temps!\r</language>
	</row>
	<row id="msg_0724_00773" index="773">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Maintenant que je l’ai acheté, je\ndevrais vraiment apprendre à en faire!\r</language>
	</row>
	<row id="msg_0724_00774" index="774">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne recherche pas les sensations\nfortes. Je n’ai pas besoin de ça.</language>
	</row>
	<row id="msg_0724_00775" index="775">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Par contre, j’apprécie toujours\nun bon combat.\r</language>
	</row>
	<row id="msg_0724_00776" index="776">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je crois que ce travail n’est pas\nfait pour moi, finalement...\r</language>
	</row>
	<row id="msg_0724_00777" index="777">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Au combat, j’ai mon propre style.\nToi aussi, tu as ton propre style.</language>
	</row>
	<row id="msg_0724_00778" index="778">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nous sommes tous uniques.\nJe suis mon propre chemin.\r</language>
	</row>
	<row id="msg_0724_00779" index="779">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nous sommes tous uniques.\nTu suis ton propre chemin.\r</language>
	</row>
	<row id="msg_0724_00780" index="780">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aujourd’hui, j’ai une petite surprise\npour tous mes fans!</language>
	</row>
	<row id="msg_0724_00781" index="781">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci de ton soutien!\r</language>
	</row>
	<row id="msg_0724_00782" index="782">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Est-ce que tu fais partie de mes fans?\r</language>
	</row>
	<row id="msg_0724_00783" index="783">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’en ai marre d’être une Star. Je veux\nretourner vivre dans ma campagne.</language>
	</row>
	<row id="msg_0724_00784" index="784">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne peux pas tout plaquer comme ça!\nLes enfants rêvent d’être comme moi!\r</language>
	</row>
	<row id="msg_0724_00785" index="785">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La cuisine de ma mère me manque...\r</language>
	</row>
	<row id="msg_0724_00786" index="786">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il n’y en a pas deux comme moi.\nTu peux me croire.</language>
	</row>
	<row id="msg_0724_00787" index="787">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je reste naturel.\nC’est ce qui fait ma force.\r</language>
	</row>
	<row id="msg_0724_00788" index="788">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis resté naturel, mais j’ai perdu.\nJ’imagine que ta nature est plus forte.\r</language>
	</row>
	<row id="msg_0724_00789" index="789">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salut! C’est toi mon adversaire?\nBattons-nous dans le respect!</language>
	</row>
	<row id="msg_0724_00790" index="790">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça fait du bien de se battre sans avoir\nà craindre les coups bas.\r</language>
	</row>
	<row id="msg_0724_00791" index="791">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’était vraiment génial!\nIl faudra qu’on remette ça!\r</language>
	</row>
	<row id="msg_0724_00792" index="792">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est simple, dans la vie, j’ai deux\npassions: la pêche et le Lait Meumeu.</language>
	</row>
	<row id="msg_0724_00793" index="793">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gagner ou perdre, ça m’est bien égal.\r</language>
	</row>
	<row id="msg_0724_00794" index="794">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu n’aurais pas un peu de\nLait Meumeu à m’offrir?\r</language>
	</row>
	<row id="msg_0724_00795" index="795">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu sais, l’autre jour, j’ai pêché un\nPokémon gros comme ça! Au bas mot!</language>
	</row>
	<row id="msg_0724_00796" index="796">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vois que ça t’impressionne. Je dois\ndire que je suis assez fier de moi.\r</language>
	</row>
	<row id="msg_0724_00797" index="797">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un conseil. Si un adulte se vante devant\ntoi, fais au moins semblant d’écouter.\r</language>
	</row>
	<row id="msg_0724_00798" index="798">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu es un Dresseur. Montre-moi ce que\ntu sais faire avec des Pokémon.</language>
	</row>
	<row id="msg_0724_00799" index="799">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et alors? C’est tout ce que\ntu sais faire?\r</language>
	</row>
	<row id="msg_0724_00800" index="800">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Super! Excellent!\nC’est bon, ça!\r</language>
	</row>
	<row id="msg_0724_00801" index="801">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voilà ma victime!\nA l’abordage!</language>
	</row>
	<row id="msg_0724_00802" index="802">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gwahahahaha!\r</language>
	</row>
	<row id="msg_0724_00803" index="803">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nous sommes perdus!\nSabordez le navire!\r</language>
	</row>
	<row id="msg_0724_00804" index="804">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et c’est parti!\nOoooh! Haaa!</language>
	</row>
	<row id="msg_0724_00805" index="805">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci bien!\r</language>
	</row>
	<row id="msg_0724_00806" index="806">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci beaucoup!\r</language>
	</row>
	<row id="msg_0724_00807" index="807">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La montagne, je trouve ça fascinant.\nJe lui ai consacré ma vie!</language>
	</row>
	<row id="msg_0724_00808" index="808">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La montagne est bien plus importante\npour moi que cette victoire, tu sais.\r</language>
	</row>
	<row id="msg_0724_00809" index="809">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu te bats bien. Mais je suis impatient\nde retourner dans mes montagnes.\r</language>
	</row>
	<row id="msg_0724_00810" index="810">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Attention à toi, petite tête.</language>
	</row>
	<row id="msg_0724_00811" index="811">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Même si tu as perdu, tu gardes\nl’attitude d’un vainqueur. C’est bien.\r</language>
	</row>
	<row id="msg_0724_00812" index="812">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pourtant, j’ai fait tout ce que j’ai\npu, je te jure.\r</language>
	</row>
	<row id="msg_0724_00813" index="813">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai visité le monde entier. Je suis un\nDresseur de classe internationale!</language>
	</row>
	<row id="msg_0724_00814" index="814">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne perds jamais un combat.\nJe suis beaucoup trop cool pour ça!\r</language>
	</row>
	<row id="msg_0724_00815" index="815">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je repars sur les routes pour\nméditer sur cet échec. Adieu!\r</language>
	</row>
	<row id="msg_0724_00816" index="816">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Au combat, je ne suis pas trop mauvais.\nEn musique? Je suis une catastrophe.</language>
	</row>
	<row id="msg_0724_00817" index="817">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est bien beau tout ça, mais j’aimerais\ntellement être meilleur à la guitare...\r</language>
	</row>
	<row id="msg_0724_00818" index="818">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je n’arrive pas à choisir entre la\nmusique et les Pokémon.\r</language>
	</row>
	<row id="msg_0724_00819" index="819">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai composé une chanson en n’utilisant\nque des cris de Pokémon.</language>
	</row>
	<row id="msg_0724_00820" index="820">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Groooooo! Butoké!\nChu! Chu! Maaaaaaa!\r</language>
	</row>
	<row id="msg_0724_00821" index="821">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pikaaa! Zaaaaare!\nToge Toge! Miiiia!\r</language>
	</row>
	<row id="msg_0724_00822" index="822">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’en ai assez d’être un Collec!\nJe vais tout plaquer.</language>
	</row>
	<row id="msg_0724_00823" index="823">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne sais pas ce que je vais faire\nmaintenant. Peut-être devenir clown...</language>
	</row>
	<row id="msg_0724_00824" index="824">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce combat est la marque d’un nouveau\ndépart. Je me sens libéré.</language>
	</row>
	<row id="msg_0724_00825" index="825">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh! Une petite seconde!\nJe viens de recevoir un message!</language>
	</row>
	<row id="msg_0724_00826" index="826">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tic-tic-tic... Tic-tic...\nHein? Le combat est terminé?\r</language>
	</row>
	<row id="msg_0724_00827" index="827">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé, arrête tout de suite!\nC’est un message personnel!\r</language>
	</row>
	<row id="msg_0724_00828" index="828">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A quoi bon combattre?\nLes Pokémon, c’est l’amour!</language>
	</row>
	<row id="msg_0724_00829" index="829">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les combats m’épuisent.\nJe préfère jouer avec mes Pokémon!\r</language>
	</row>
	<row id="msg_0724_00830" index="830">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les combats sont destructeurs.\nJe préfère jouer avec mes Pokémon!\r</language>
	</row>
	<row id="msg_0724_00831" index="831">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu veux te battre? Contre moi?\nTsk, vous les jeunes...</language>
	</row>
	<row id="msg_0724_00832" index="832">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Maintenant, rentre chez toi, et va\naider ta maman à faire la vaisselle!\r</language>
	</row>
	<row id="msg_0724_00833" index="833">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La vie n’est pas un jeu. Souviens-toi\nde ça ou tu finiras comme moi.\r</language>
	</row>
	<row id="msg_0724_00834" index="834">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Comment comptes-tu contrer le pouvoir\nimplacable de la logique?</language>
	</row>
	<row id="msg_0724_00835" index="835">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tous mes calculs étaient exacts...\nCette victoire est absolue.\r</language>
	</row>
	<row id="msg_0724_00836" index="836">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta formule était plus avancée?\nJ’ai du mal à le croire.\r</language>
	</row>
	<row id="msg_0724_00837" index="837">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon labo est trop petit.\nJ’ai un terrible mal de dos.</language>
	</row>
	<row id="msg_0724_00838" index="838">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci pour cette petite pause!\nJe suis beaucoup plus détendu!\r</language>
	</row>
	<row id="msg_0724_00839" index="839">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je devrais prendre un peu plus\nl’air et faire de l’exercice.\r</language>
	</row>
	<row id="msg_0724_00840" index="840">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Humm... Si jeune...\nJe vais retenir mes coups...</language>
	</row>
	<row id="msg_0724_00841" index="841">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu es tellement jeune...\nC’est bon. Tu peux partir.\r</language>
	</row>
	<row id="msg_0724_00842" index="842">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous les jeunes, vous ne\npensez qu’à gagner...\r</language>
	</row>
	<row id="msg_0724_00843" index="843">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu me prends pour un vieillard?\nIl ne faut pas se fier aux apparences.</language>
	</row>
	<row id="msg_0724_00844" index="844">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Perdre face à un jeune Dresseur serait\nune abomination.\r</language>
	</row>
	<row id="msg_0724_00845" index="845">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je n’aurais pas dû me laisser\nabuser par ta jeunesse apparente...\r</language>
	</row>
	<row id="msg_0724_00846" index="846">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis un Ouvrier. On me paie pour\nconstruire, mais aussi pour démolir.</language>
	</row>
	<row id="msg_0724_00847" index="847">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu devrais devenir Ouvrier toi aussi.\nC’est à la fois amusant et gratifiant.\r</language>
	</row>
	<row id="msg_0724_00848" index="848">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Construire est plus difficile que\ndémolir, mais aussi plus intéressant.\r</language>
	</row>
	<row id="msg_0724_00849" index="849">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais te battre sans problème.</language>
	</row>
	<row id="msg_0724_00850" index="850">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quel spectacle pathétique. Prends tes\ncliques et tes claques et disparais.\r</language>
	</row>
	<row id="msg_0724_00851" index="851">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Argh... Dommage...\nJe n’ai pas été à la hauteur.\r</language>
	</row>
	<row id="msg_0724_00852" index="852">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une souplesse légendaire et un sens de\nl’humour éprouvé: je suis un Bouffon!</language>
	</row>
	<row id="msg_0724_00853" index="853">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Etre Bouffon exige des qualités uniques.\nC’est une fonction réservée à l’élite.\r</language>
	</row>
	<row id="msg_0724_00854" index="854">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Savoir rire de ses défaites est une\nqualité indispensable au Bouffon!\r</language>
	</row>
	<row id="msg_0724_00855" index="855">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un sourire sur le visage et des larmes\ndans le cœur, voilà le lot du Bouffon.</language>
	</row>
	<row id="msg_0724_00856" index="856">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hahahahaha!\r</language>
	</row>
	<row id="msg_0724_00857" index="857">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha... Hahahahaha!\r</language>
	</row>
	<row id="msg_0724_00858" index="858">
		<attribute name="window_context_name">used</attribute>
		<language name="English">N’oublie pas, je suis un Agent, certes,\nmais je suis avant tout un Dresseur!</language>
	</row>
	<row id="msg_0724_00859" index="859">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Alors quoi? Un Agent ne peut pas\nperdre son sang-froid?\r</language>
	</row>
	<row id="msg_0724_00860" index="860">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis un Agent, mais j’ai des rêves...\nEt je veux... je vais... Snif...\r</language>
	</row>
	<row id="msg_0724_00861" index="861">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les mains en l’air! Pas de geste\nbrusque! Tu es en état d’arrestation.</language>
	</row>
	<row id="msg_0724_00862" index="862">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Affaire classée!\r</language>
	</row>
	<row id="msg_0724_00863" index="863">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est une grotesque erreur judiciaire!\r</language>
	</row>
	<row id="msg_0724_00864" index="864">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je travaille comme cyberdétective.</language>
	</row>
	<row id="msg_0724_00865" index="865">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le pouvoir de l’observation et de la\nlogique a triomphé!\r</language>
	</row>
	<row id="msg_0724_00866" index="866">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu te crois plus habile que moi?\nPeut-être que je t’ai tendu un piège...\r</language>
	</row>
	<row id="msg_0724_00867" index="867">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne refuse jamais un combat!\nPeu importe le moment ou l’endroit!</language>
	</row>
	<row id="msg_0724_00868" index="868">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Où, quand, comment... Rien n’a\nd’importance, tant qu’on se bat.\r</language>
	</row>
	<row id="msg_0724_00869" index="869">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha, ha, ha! C’est génial!\nContinue comme ça!\r</language>
	</row>
	<row id="msg_0724_00870" index="870">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Dresseur qui perd le combat devra\nimiter MOUFOUETTE, d’accord?</language>
	</row>
	<row id="msg_0724_00871" index="871">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hi hi, tu as perdu!\nTu dois imiter MOUFOUETTE!\r</language>
	</row>
	<row id="msg_0724_00872" index="872">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bien, voilà mon imitation de MOUFOUETTE!\nTrois, deux, un...\r</language>
	</row>
	<row id="msg_0724_00873" index="873">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le vent s’est levé dehors...\nC’est bon signe! Je vais gagner!</language>
	</row>
	<row id="msg_0724_00874" index="874">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le vent nous a poussés vers la\nvictoire! Je crois...\r</language>
	</row>
	<row id="msg_0724_00875" index="875">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Finalement, c’est nous qui avons\npris un vent...\r</language>
	</row>
	<row id="msg_0724_00876" index="876">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il ne faut pas croire, j’adore le soleil.</language>
	</row>
	<row id="msg_0724_00877" index="877">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’espère que le soleil sera au\nrendez-vous demain...\r</language>
	</row>
	<row id="msg_0724_00878" index="878">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il pleut dans mon cœur...\nJ’ai tant besoin de soleil...\r</language>
	</row>
	<row id="msg_0724_00879" index="879">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eh bien, quelle impatience! Je devrais\nm’affoler un peu moi aussi!</language>
	</row>
	<row id="msg_0724_00880" index="880">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je me suis beaucoup amusée!\nJ’espère qu’on se reverra.\r</language>
	</row>
	<row id="msg_0724_00881" index="881">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quelle fougue! Quelle énergie!\nJe me sens pleine de vie!\r</language>
	</row>
	<row id="msg_0724_00882" index="882">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Combien de temps vais-je devoir\nattendre un Dresseur compétent?</language>
	</row>
	<row id="msg_0724_00883" index="883">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis lasse de tous ces incompétents.\nJe devrais prendre ma retraite...\r</language>
	</row>
	<row id="msg_0724_00884" index="884">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Contente d’avoir fait ta connaissance.\nTu n’es pas n’importe qui.\r</language>
	</row>
	<row id="msg_0724_00885" index="885">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Personne ne résiste à ma beauté\nravageuse!</language>
	</row>
	<row id="msg_0724_00886" index="886">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’était juste! Il ne faut jamais\nsous-estimer son adversaire.\r</language>
	</row>
	<row id="msg_0724_00887" index="887">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Etre fair-play ne me plaît pas\nbeaucoup. Je préférerais gagner.\r</language>
	</row>
	<row id="msg_0724_00888" index="888">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Certaines senteurs plaisent à certaines\npersonnes, mais pas à d’autres.</language>
	</row>
	<row id="msg_0724_00889" index="889">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moi, j’adore l’odeur de la victoire.\r</language>
	</row>
	<row id="msg_0724_00890" index="890">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’odeur de la défaite ne me plaît pas,\ncurieusement...\r</language>
	</row>
	<row id="msg_0724_00891" index="891">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Snif, snif... Oui! Je le sens!\nLe pouvoir des arômes!</language>
	</row>
	<row id="msg_0724_00892" index="892">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Grâce au pouvoir des arômes,\nje suis invincible!\r</language>
	</row>
	<row id="msg_0724_00893" index="893">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh non...\nJ’ai le nez bouché...\r</language>
	</row>
	<row id="msg_0724_00894" index="894">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un, deux, trois, un, deux, trois!\nJe répète mes pas de danse!</language>
	</row>
	<row id="msg_0724_00895" index="895">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je danse avec passion et précision.\nJe ne peux pas perdre.\r</language>
	</row>
	<row id="msg_0724_00896" index="896">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non! Tu n’es pas du tout en rythme!\nTu as gâché mon entraînement!\r</language>
	</row>
	<row id="msg_0724_00897" index="897">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis toujours disponible pour mon\npublic. N’hésite pas à venir me voir.</language>
	</row>
	<row id="msg_0724_00898" index="898">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est pour cela que les gens me\nconsidèrent comme une grande Star.\r</language>
	</row>
	<row id="msg_0724_00899" index="899">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non! Je n’avais jamais perdu avant.\nC’est une grande première pour moi.\r</language>
	</row>
	<row id="msg_0724_00900" index="900">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0724_00901" index="901">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0724_00902" index="902">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0724_00903" index="903">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0724_00904" index="904">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0724_00905" index="905">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0724_00906" index="906">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0724_00907" index="907">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0724_00908" index="908">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0724_00909" index="909">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0724_00910" index="910">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0724_00911" index="911">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0724_00912" index="912">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0724_00913" index="913">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0724_00914" index="914">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0724_00915" index="915">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0724_00916" index="916">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, excellent! C’était fantastique!\nJ’espère que tu reviendras!\r</language>
	</row>
	<row id="msg_0724_00917" index="917">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est un honneur de perdre face\nà un Dresseur de si grand talent!\r</language>
	</row>
	<row id="msg_0724_00918" index="918">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0724_00919" index="919">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, excellent! C’était fantastique!\nJ’espère que tu reviendras!\r</language>
	</row>
	<row id="msg_0724_00920" index="920">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est un honneur de perdre face\nà un Dresseur de si grand talent!\r</language>
	</row>
	<row id="msg_0724_00921" index="921">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quels atouts as-tu dans ta manche?\nJe suis impatiente de les découvrir.</language>
	</row>
	<row id="msg_0724_00922" index="922">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tout à fait remarquable! Merci.\nReviens quand tu le souhaites.\r</language>
	</row>
	<row id="msg_0724_00923" index="923">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Toutes les bonnes choses ont une fin,\nmalheureusement.\r</language>
	</row>
	<row id="msg_0724_00924" index="924">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quels atouts as-tu dans ta manche\ncette fois?\fJe suis impatiente de les découvrir.</language>
	</row>
	<row id="msg_0724_00925" index="925">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tout à fait extraordinaire! Merci.\nReviens quand tu le souhaites.\r</language>
	</row>
	<row id="msg_0724_00926" index="926">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Toutes les bonnes choses ont une fin.\nCelle-ci arrive toujours trop vite.\r</language>
	</row>
	<row id="msg_0724_00927" index="927">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Peu importe quelle stratégie tu\nemploies. Tu ne peux pas gagner.\rJ’ai fait des analyses très poussées\npour en arriver à cette conclusion.</language>
	</row>
	<row id="msg_0724_00928" index="928">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu captes?\nTout était calculé.\r</language>
	</row>
	<row id="msg_0724_00929" index="929">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouah!\nTu m’as donné une bonne leçon!\r</language>
	</row>
	<row id="msg_0724_00930" index="930">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Peu importe quelle stratégie tu\nemploies. Tu ne peux pas gagner.\rGrâce à mes calculs très poussés,\nla victoire ne m’échappera pas.</language>
	</row>
	<row id="msg_0724_00931" index="931">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu captes?\nTout était calculé.\r</language>
	</row>
	<row id="msg_0724_00932" index="932">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouah!\nTu m’as donné une bonne leçon!\r</language>
	</row>
	<row id="msg_0724_00933" index="933">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Respire à fond et souris un peu!\nDame Chance favorise les audacieux!\rAujourd’hui, elle est avec moi,\nje vais donc gagner, tu verras!</language>
	</row>
	<row id="msg_0724_00934" index="934">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu es un adversaire redoutable!\nEt un Dresseur des plus capables!\r</language>
	</row>
	<row id="msg_0724_00935" index="935">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta puissance, tu l’as démontrée!\nTu nous as tous épatés!\r</language>
	</row>
	<row id="msg_0724_00936" index="936">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Face à un Dresseur épatant,\nj’aime combattre en souriant!\rEt toi, qu’as-tu donc à l’esprit\nlorsqu’un adversaire te défie?</language>
	</row>
	<row id="msg_0724_00937" index="937">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La victoire m’importe peu.\nAprès un combat si joyeux!\r</language>
	</row>
	<row id="msg_0724_00938" index="938">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Affronter un Dresseur de talent\nest un plaisir de chaque instant!\r</language>
	</row>
	<row id="msg_0724_00939" index="939">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Très bien...\nPouvons-nous commencer?</language>
	</row>
	<row id="msg_0724_00940" index="940">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, un effort des plus louables.\rJ’ai pu m’octroyer la victoire\ncette fois-ci, mais...\r</language>
	</row>
	<row id="msg_0724_00941" index="941">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mes Pokémon ne peuvent être blâmés\npour cet insuccès.\rToutes mes félicitations.\r</language>
	</row>
	<row id="msg_0724_00942" index="942">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai bien peur de devoir vous défaire\nau nom de Dame Percila...</language>
	</row>
	<row id="msg_0724_00943" index="943">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, un effort des plus louables.\rJ’ai pu m’octroyer la victoire\ncette fois-ci, mais...\r</language>
	</row>
	<row id="msg_0724_00944" index="944">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quel remarquable talent! Mon admiration\nà votre égard est sans limite.\r</language>
	</row>
</body>
