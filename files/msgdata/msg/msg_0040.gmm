	<row id="msg_0040_00098" index="98">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} trouve une Feuille d’Or!\r{STRVAR_1 1, 1, 0} la tient déjà.</language>
	</row>
	<row id="msg_0040_00099" index="99">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quoi?\n{STRVAR_1 1, 0, 0} évolue!\r</language>
	</row>
	<row id="msg_0040_00100" index="100">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0} a pris\nsa Forme Terrestre.</language>
	</row>
	<row id="msg_0040_00101" index="101">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le numéro de téléphone est\nenregistré dans le Pokématos.\r</language>
	</row>
	<row id="msg_0040_00102" index="102">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Comme {STRVAR_1 0, 0, 0} est en forme, vous\navez décidé de vous promener avec!\r</language>
	</row>
	<row id="msg_0040_00103" index="103">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bonjour!\rPouvez-vous me dire ce que vous\nressentez juste avant un combat?\rQue dites-vous après une victoire,\nune défaite? Que ressentiriez-vous\fsi vous étiez numéro un? {YESNO 0}</language>
	</row>
	<row id="msg_0040_00104" index="104">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quel est votre sentiment quand vous\nvous préparez à un combat?\r</language>
	</row>
	<row id="msg_0040_00105" index="105">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Que dites-vous quand vous avez\ngagné un combat?\r</language>
	</row>
	<row id="msg_0040_00106" index="106">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Que dites-vous quand vous avez\nperdu un combat?\r</language>
	</row>
	<row id="msg_0040_00107" index="107">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quel effet cela vous ferait-il de\ndevenir numéro un?\r</language>
	</row>
	<row id="msg_0040_00108" index="108">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah... Vous préférez ne rien dire?\nSoit... A votre guise...</language>
	</row>
	<row id="msg_0040_00109" index="109">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci!\rPuis-je vous poser une autre\nquestion? {YESNO 0}</language>
	</row>
	<row id="msg_0040_00110" index="110">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Compris! Merci!</language>
	</row>
	<row id="msg_0040_00111" index="111">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Compris! Merci!\nOK, {STRVAR_1 28, 0, 0}...</language>
	</row>
	<row id="msg_0040_00112" index="112">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Avant\nle combat</language>
	</row>
	<row id="msg_0040_00113" index="113">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Après\nune victoire</language>
	</row>
	<row id="msg_0040_00114" index="114">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Après\nune défaite</language>
	</row>
