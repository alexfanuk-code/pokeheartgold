<?xml version="1.0"?>
<body language="English">
	<row id="msg_0040_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bonjour! Bienvenue au\nCentre Pokémon.\rNous pouvons soigner vos Pokémon.\rVoulez-vous les soigner? {YESNO 0}</language>
	</row>
	<row id="msg_0040_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK, je prends vos Pokémon un\ninstant.</language>
	</row>
	<row id="msg_0040_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci d’avoir attendu.\rVos Pokémon sont en super\nforme maintenant.\r</language>
	</row>
	<row id="msg_0040_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A une prochaine fois peut-être!</language>
	</row>
	<row id="msg_0040_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bonjour! Bienvenue au\nCentre Pokémon.\rNous pouvons soigner vos Pokémon.\rVoulez-vous les...\r</language>
	</row>
	<row id="msg_0040_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cette... Carte de Dresseur!\rQuelle couleur!\nEt toutes ces étoiles!\rJ’ai déjà vu plusieurs Dresseurs avec\nune carte Violette...\rMais vous les surpassez\ntous avec cette carte-ci.\rS’il vous plaît, {STRVAR_1 3, 0, 0}, puis-je\navoir l’honneur de soigner vos\fPokémon? {YESNO 0}</language>
	</row>
	<row id="msg_0040_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous revoilà, {STRVAR_1 3, 0, 0}!\nMême chose, comme d’habitude? {YESNO 0}</language>
	</row>
	<row id="msg_0040_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK, je prends vos Pokémon un instant.</language>
	</row>
	<row id="msg_0040_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci d’avoir patienté.</language>
	</row>
	<row id="msg_0040_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Encore merci et à bientôt!</language>
	</row>
	<row id="msg_0040_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ton Pokémon a peut-être attrapé\nle Pokérus.\rOn sait peu de choses sur les Pokérus,\nsi ce n’est qu’il s’agit d’organismes\fvivants microscopiques se fixant sur\fles Pokémon.\rIl paraît que les Pokémon contaminés\nse développent incroyablement bien.</language>
	</row>
	<row id="msg_0040_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} n’a plus de\nPokémon en forme!\r{STRVAR_1 3, 0, 0} est hors-jeu!</language>
	</row>
	<row id="msg_0040_00012" index="12">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0040_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous sauvegarder\nla partie? {YESNO 0}</language>
	</row>
	<row id="msg_0040_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il y a déjà une sauvegarde.\nVoulez-vous la remplacer? {YESNO 0}</language>
	</row>
	<row id="msg_0040_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sauvegarde en cours...\nNe pas éteindre.</language>
	</row>
	<row id="msg_0040_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} a sauvegardé la partie.</language>
	</row>
	<row id="msg_0040_00017" index="17">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0040_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erreur de sauvegarde.</language>
	</row>
	<row id="msg_0040_00019" index="19">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0040_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une autre partie est déjà sauvegardée.\nSauvegarde impossible.\rVeuillez vous référer au\nmanuel pour plus d’informations.\rAppuyez sur haut, SELECT et le\nbouton B à l’écran titre pour effacer\fla sauvegarde actuelle.</language>
	</row>
	<row id="msg_0040_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sauvegarde de beaucoup de données...\nNe pas éteindre.</language>
	</row>
	<row id="msg_0040_00022" index="22">
