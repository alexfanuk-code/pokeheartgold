<?xml version="1.0"?>
<body language="English">
	<row id="msg_0723_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Attention, j’arrive!</language>
	</row>
	<row id="msg_0723_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yahou!\r</language>
	</row>
	<row id="msg_0723_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Beurk!\r</language>
	</row>
	<row id="msg_0723_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eh, novice! Montre-moi\nce que tu sais faire!</language>
	</row>
	<row id="msg_0723_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha, ha! Je m’en doutais! Tu ne\nconnais rien aux Pokémon.\r</language>
	</row>
	<row id="msg_0723_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Beurk! Pourtant tu ne\nconnais rien aux Pokémon!\r</language>
	</row>
	<row id="msg_0723_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu sais quoi? Les shorts, c’est super!\nIl n’y a rien de plus confortable.</language>
	</row>
	<row id="msg_0723_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vive les shorts!\r</language>
	</row>
	<row id="msg_0723_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Personne ne m’empêchera de\nporter des shorts, personne!\r</language>
	</row>
	<row id="msg_0723_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai pour principe de ne\nporter que des minijupes!</language>
	</row>
	<row id="msg_0723_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Longue vie aux minijupes!\r</language>
	</row>
	<row id="msg_0723_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Est-ce que tu as un principe toi aussi?\r</language>
	</row>
	<row id="msg_0723_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’adore ma minijupe!</language>
	</row>
	<row id="msg_0723_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eh oh, tu t’endors?! Ce n’est pas\nl’heure de la sieste!\r</language>
	</row>
	<row id="msg_0723_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mes jambes ont l’air plus longues avec\nune minijupe. C’est bien, non?\r</language>
	</row>
	<row id="msg_0723_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis à la recherche\nd’Accessoires mignons.</language>
	</row>
	<row id="msg_0723_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si tu trouves des Accessoires\nintéressants, tiens-moi au courant!\r</language>
	</row>
	<row id="msg_0723_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’aimerais bien me faire belle moi aussi!\r</language>
	</row>
	<row id="msg_0723_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je voudrais essayer un truc\nque j’ai appris à l’école.</language>
	</row>
	<row id="msg_0723_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oui!\nÇa marche à la perfection!\r</language>
	</row>
	<row id="msg_0723_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hum...\nQuelque chose ne colle pas...\r</language>
	</row>
	<row id="msg_0723_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hein... Grrroa!</language>
	</row>
	<row id="msg_0723_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour gagner un combat, il faut\nbeaucoup de volonté et d’ardeur.\r</language>
	</row>
	<row id="msg_0723_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon, d’accord, la volonté\nne suffit pas toujours.\r</language>
	</row>
	<row id="msg_0723_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tous les jours, j’étudie pour pouvoir\ntravailler dans le monde entier.</language>
	</row>
	<row id="msg_0723_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je rêve de parcourir le monde!\r</language>
	</row>
	<row id="msg_0723_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ferais bien d’étudier aussi\nles combats de Pokémon.\r</language>
	</row>
	<row id="msg_0723_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quand je serai grande, je serai\nprofesseur Pokémon!</language>
	</row>
	<row id="msg_0723_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hum, hum! Tu as beaucoup\nà apprendre, jeune élève!\r</language>
	</row>
	<row id="msg_0723_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hum, hum! On dirait que j’ai\nencore beaucoup à apprendre.\r</language>
	</row>
	<row id="msg_0723_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis incollable sur les Pokémon!</language>
	</row>
	<row id="msg_0723_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est la victoire du savoir!\r</language>
	</row>
	<row id="msg_0723_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais réviser ma leçon, et quand je\nreviendrai, je t’en donnerai une bonne!\r</language>
	</row>
	<row id="msg_0723_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Toi, tu n’as pas l’air très énergique.\nJ’ai peut-être un coup à jouer.</language>
	</row>
	<row id="msg_0723_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trop facile!\r</language>
	</row>
	<row id="msg_0723_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aïe, ça fait mal.\r</language>
	</row>
	<row id="msg_0723_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça va, ça va. \nInutile d’en dire plus.</language>
	</row>
	<row id="msg_0723_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça va, ça va.\nJe sais que tu as fait de ton mieux.\r</language>
	</row>
	<row id="msg_0723_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça va, ça va...\nInutile d’en dire plus...\r</language>
	</row>
	<row id="msg_0723_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis riche!</language>
	</row>
	<row id="msg_0723_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quoi de plus normal?\nAprès tout, je suis riche.\r</language>
	</row>
	<row id="msg_0723_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais que s’est-il passé?\nJe suis riche, pourtant...\r</language>
	</row>
	<row id="msg_0723_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hum. Alors, tu sais bien te défendre?</language>
	</row>
	<row id="msg_0723_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hum. Pas très impressionnant tout ça.\nHum?\r</language>
	</row>
	<row id="msg_0723_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hum. Je vois, tu es plutôt habile.\nHum.\r</language>
	</row>
	<row id="msg_0723_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, oui, c’est vrai. Je dois\npasser à l’attaque.</language>
	</row>
	<row id="msg_0723_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai réussi! Incroyable!\r</language>
	</row>
	<row id="msg_0723_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, c’est très décevant.\r</language>
	</row>
	<row id="msg_0723_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">De toucher à sa fin, ton aventure\nest sur le point. Te rosser, je vais!</language>
	</row>
	<row id="msg_0723_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Couru d’avance, c’était.\r</language>
	</row>
	<row id="msg_0723_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, très vexant, cela est.\nDu fond du cœur, merci...\r</language>
	</row>
	<row id="msg_0723_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quel ennui...</language>
	</row>
	<row id="msg_0723_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quel terrible ennui...\r</language>
	</row>
	<row id="msg_0723_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’était un moyen comme un\nautre de passer le temps.\r</language>
	</row>
	<row id="msg_0723_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hein?!\nOù sont-ils tous passés?</language>
	</row>
	<row id="msg_0723_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eh, les gars!\nVous êtes où?!\r</language>
	</row>
	<row id="msg_0723_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis venu ici pour camper, mais\nj’ai perdu la trace de mes amis...\r</language>
	</row>
	<row id="msg_0723_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh!\nTu n’as pas de Pokémontre?</language>
	</row>
	<row id="msg_0723_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai réussi à gagner alors que je\nm’amusais avec ma Pokémontre!\r</language>
	</row>
	<row id="msg_0723_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voilà ce qui arrive quand on joue avec\nsa Pokémontre au lieu de se concentrer.\r</language>
	</row>
	<row id="msg_0723_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mes Pokémon s’entraînent\ndans la forêt.</language>
	</row>
	<row id="msg_0723_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est la force des arbres!\r</language>
	</row>
	<row id="msg_0723_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je retourne dans la forêt.\r</language>
	</row>
	<row id="msg_0723_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce combat contre toi, ça\nva être du gâteau!</language>
	</row>
	<row id="msg_0723_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La-la-la!\r</language>
	</row>
	<row id="msg_0723_00065" index="65">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est malin, avec tout ça, j’avais\nl’esprit obnubilé par ce gâteau...\r</language>
	</row>
	<row id="msg_0723_00066" index="66">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La-la-la!\nNous voilà!</language>
	</row>
	<row id="msg_0723_00067" index="67">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La-la-la!\nJ’ai gagné, tra-la-la!\r</language>
	</row>
	<row id="msg_0723_00068" index="68">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La-la-la! Même quand je perds,\nje garde le moral!\r</language>
	</row>
	<row id="msg_0723_00069" index="69">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vas voir, les combats de Pokémon,\nil n’y a rien de plus amusant.</language>
	</row>
	<row id="msg_0723_00070" index="70">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Alors, tu vois! C’était amusant, non?\r</language>
	</row>
	<row id="msg_0723_00071" index="71">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouah, c’était impressionnant!\nTu es incroyable!\r</language>
	</row>
	<row id="msg_0723_00072" index="72">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je... Je sais très bien nager!\nJe n’ai pas besoin de ma bouée!</language>
	</row>
	<row id="msg_0723_00073" index="73">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais puisque je te dis que je n’ai\npas besoin de ma bouée!\r</language>
	</row>
	<row id="msg_0723_00074" index="74">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je... Je ne mens pas!\r</language>
	</row>
	<row id="msg_0723_00075" index="75">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je préfère les rivières plutôt que la\nmer. Et toi?</language>
	</row>
	<row id="msg_0723_00076" index="76">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’eau des rivières est plus froide,\nmais c’est beaucoup plus agréable.\r</language>
	</row>
	<row id="msg_0723_00077" index="77">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je n’aime pas la mer parce que\nl’eau salée me brûle les yeux!\r</language>
	</row>
	<row id="msg_0723_00078" index="78">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allez, c’est parti!</language>
	</row>
	<row id="msg_0723_00079" index="79">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On est les meilleurs!\r</language>
	</row>
	<row id="msg_0723_00080" index="80">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On est sur la bonne voie!\r</language>
	</row>
	<row id="msg_0723_00081" index="81">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le sable est brûlant! Quand je marche,\nje fais “Aïe, ouille, aïe!”</language>
	</row>
	<row id="msg_0723_00082" index="82">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’adore la mer! Je peux m’y tremper\nles pieds pour les rafraîchir!\r</language>
	</row>
	<row id="msg_0723_00083" index="83">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aïe, ouille, aïe!\r</language>
	</row>
	<row id="msg_0723_00084" index="84">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Plif, plof!</language>
	</row>
	<row id="msg_0723_00085" index="85">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Shplouf!\nShplouf!\r</language>
	</row>
	<row id="msg_0723_00086" index="86">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Plic, ploc!\r</language>
	</row>
	<row id="msg_0723_00087" index="87">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bonjour, je suis amoureuse de ma\nbouée. Ravie de te connaître!</language>
	</row>
	<row id="msg_0723_00088" index="88">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis amoureuse de ma bouée!\nMerci!\r</language>
	</row>
	<row id="msg_0723_00089" index="89">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis amoureuse de ma bouée!\nAu revoir!\r</language>
	</row>
	<row id="msg_0723_00090" index="90">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yeah! Ecoute ce son! Je me suis\naccordé sur ta longueur d’onde!</language>
	</row>
	<row id="msg_0723_00091" index="91">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rock-and-roll!\r</language>
	</row>
	<row id="msg_0723_00092" index="92">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Argh!\nLa défaite m’a fait perdre le rythme!\r</language>
	</row>
	<row id="msg_0723_00093" index="93">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rock? Jazz? Techno?\nQuand je combats, tout me va!</language>
	</row>
	<row id="msg_0723_00094" index="94">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je fais hurler les cordes!\r</language>
	</row>
	<row id="msg_0723_00095" index="95">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK... Avec tout ça, je me sens d’humeur\nà chanter un petit blues...\r</language>
	</row>
	<row id="msg_0723_00096" index="96">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Prépare-toi à écouter\nun solo qui décoiffe!</language>
	</row>
	<row id="msg_0723_00097" index="97">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu manques de pratique.\r</language>
	</row>
	<row id="msg_0723_00098" index="98">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mes rêves de gloire et de\ntournée mondiale s’envolent...\r</language>
	</row>
	<row id="msg_0723_00099" index="99">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, bonjour...\nTon écharpe est ultrachic!</language>
	</row>
	<row id="msg_0723_00100" index="100">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Où as-tu acheté cette écharpe?\r</language>
	</row>
	<row id="msg_0723_00101" index="101">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Incroyable! Tu t’y connais aussi bien en\nPokémon qu’en mode, c’est pas juste!\r</language>
	</row>
	<row id="msg_0723_00102" index="102">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci pour ton admiration, merci!</language>
	</row>
	<row id="msg_0723_00103" index="103">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quoi? Je croyais que tu faisais\npartie de mes nombreux fans.\r</language>
	</row>
	<row id="msg_0723_00104" index="104">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce ne sont pas des façons de\ntraiter une Star...\r</language>
	</row>
	<row id="msg_0723_00105" index="105">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La, lala, laaaaââ.</language>
	</row>
	<row id="msg_0723_00106" index="106">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La lalalaaââ.\nLalalah laaââ.\r</language>
	</row>
	<row id="msg_0723_00107" index="107">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bye-bye, lalaaââ!\r</language>
	</row>
	<row id="msg_0723_00108" index="108">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On va voir si tu aimes les\nPokémon autant que moi.</language>
	</row>
	<row id="msg_0723_00109" index="109">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bouhahaha! On dirait que j’aime mille\nfois plus les Pokémon que toi!\r</language>
	</row>
	<row id="msg_0723_00110" index="110">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Grrrr... Ton amour pour les Pokémon\nserait plus fort que le mien?!\r</language>
	</row>
	<row id="msg_0723_00111" index="111">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je te préviens, mes Pokémon\nsont plutôt coriaces.</language>
	</row>
	<row id="msg_0723_00112" index="112">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il ne faut pas me sous-estimer.\r</language>
	</row>
	<row id="msg_0723_00113" index="113">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu es plutôt coriace, toi aussi.\r</language>
	</row>
	<row id="msg_0723_00114" index="114">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allez, montre-moi ton Pokémon\npréféré, ne sois pas timide.</language>
	</row>
	<row id="msg_0723_00115" index="115">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vois le genre...\nMignon, mais plutôt faible.\r</language>
	</row>
	<row id="msg_0723_00116" index="116">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vois!\nPetit, mais costaud.\r</language>
	</row>
	<row id="msg_0723_00117" index="117">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mes Pokémon sont mignons, mais\nils ne sont pas très forts!</language>
	</row>
	<row id="msg_0723_00118" index="118">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quoi?\nOn a gagné? Pour de vrai?\r</language>
	</row>
	<row id="msg_0723_00119" index="119">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça m’est égal. J’aime mes Pokémon,\nc’est tout ce qui compte.\r</language>
	</row>
	<row id="msg_0723_00120" index="120">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je bichonne trop mes Pokémon. Est-ce\nqu’ils vont quand même tenir le coup?</language>
	</row>
	<row id="msg_0723_00121" index="121">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, ils l’ont fait! Je savais que\nje pouvais compter sur eux!\r</language>
	</row>
	<row id="msg_0723_00122" index="122">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce n’est pas très bon de trop\nbichonner ses Pokémon...\r</language>
	</row>
	<row id="msg_0723_00123" index="123">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu ne voudrais pas rejoindre\nnotre Fan Club Pokémon?</language>
	</row>
	<row id="msg_0723_00124" index="124">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu sais, on ne s’ennuie jamais\ndans notre Fan Club!\r</language>
	</row>
	<row id="msg_0723_00125" index="125">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Joins-toi à nous! Deviens\nPokéfan, comme moi!\r</language>
	</row>
	<row id="msg_0723_00126" index="126">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Puis-je prendre votre commande?</language>
	</row>
	<row id="msg_0723_00127" index="127">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, un très bon choix.\nUne défaite servie bien fraîche.\r</language>
	</row>
	<row id="msg_0723_00128" index="128">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, un excellent choix.\nUne victoire bien assaisonnée.\r</language>
	</row>
	<row id="msg_0723_00129" index="129">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moi ce que je voulais,\nc’était devenir cuisinier.</language>
	</row>
	<row id="msg_0723_00130" index="130">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais je dois dire que je me\nsuis bien fait à ce travail.\r</language>
	</row>
	<row id="msg_0723_00131" index="131">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai juste un peu de mal\nà parler aux inconnus.\r</language>
	</row>
	<row id="msg_0723_00132" index="132">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour les combats comme pour prendre\nles commandes, faut pas lambiner!</language>
	</row>
	<row id="msg_0723_00133" index="133">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Genre hop, hop, la clientèle est servie!\r</language>
	</row>
	<row id="msg_0723_00134" index="134">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La nourriture, c’est comme les combats:\nil faut pas laisser refroidir!\r</language>
	</row>
	<row id="msg_0723_00135" index="135">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon travail est de rendre service,\nmais cette fois, c’est à ton tour.</language>
	</row>
	<row id="msg_0723_00136" index="136">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hi, hi, hi.\r</language>
	</row>
	<row id="msg_0723_00137" index="137">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu ne veux pas me rendre service?\nTu ne te feras jamais d’amis comme ça!\r</language>
	</row>
	<row id="msg_0723_00138" index="138">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est mon uniforme. Il est\nmignon, n’est-ce pas?</language>
	</row>
	<row id="msg_0723_00139" index="139">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est mon préféré!\r</language>
	</row>
	<row id="msg_0723_00140" index="140">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as sali mon uniforme!\r</language>
	</row>
	<row id="msg_0723_00141" index="141">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu t’y connais en dressage\nde Pokémon, non?</language>
	</row>
	<row id="msg_0723_00142" index="142">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bof...\nPlutôt décevant.\r</language>
	</row>
	<row id="msg_0723_00143" index="143">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je savais bien que tu avais le niveau.\r</language>
	</row>
	<row id="msg_0723_00144" index="144">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’attrape et j’entraîne toutes\nsortes de Pokémon.</language>
	</row>
	<row id="msg_0723_00145" index="145">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vois?\nJe les ai bien entraînés.\r</language>
	</row>
	<row id="msg_0723_00146" index="146">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ces Pokémon ont encore\nbesoin d’entraînement!\r</language>
	</row>
	<row id="msg_0723_00147" index="147">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais t’attraper dans mon filet!</language>
	</row>
	<row id="msg_0723_00148" index="148">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Joli coup de filet!\r</language>
	</row>
	<row id="msg_0723_00149" index="149">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eh! Reviens ici que je t’attrape!\r</language>
	</row>
	<row id="msg_0723_00150" index="150">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sais-tu où je pourrais trouver\nun SCARHINO géant?</language>
	</row>
	<row id="msg_0723_00151" index="151">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je veux un SCARHINO énorme.\nGenre, immense!\r</language>
	</row>
	<row id="msg_0723_00152" index="152">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si seulement j’avais un\nSCARHINO géant...\r</language>
	</row>
	<row id="msg_0723_00153" index="153">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Prépare-toi à perdre!</language>
	</row>
	<row id="msg_0723_00154" index="154">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu es à moi!\r</language>
	</row>
	<row id="msg_0723_00155" index="155">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis vaincu...\r</language>
	</row>
	<row id="msg_0723_00156" index="156">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vise un peu mes terrifiantes\ntechniques de ninja!</language>
	</row>
	<row id="msg_0723_00157" index="157">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha, ha!\nJe te l’avais dit!\r</language>
	</row>
	<row id="msg_0723_00158" index="158">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon coup de bluff ninja n’aura\nservi à rien...\r</language>
	</row>
	<row id="msg_0723_00159" index="159">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quand je serai grand, je\nserai un vrai ninja!</language>
	</row>
	<row id="msg_0723_00160" index="160">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Excellent! Excellent!\r</language>
	</row>
	<row id="msg_0723_00161" index="161">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon, que ferait un vrai ninja\ndans cette situation?\r</language>
	</row>
	<row id="msg_0723_00162" index="162">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Est-ce que je peux te battre?</language>
	</row>
	<row id="msg_0723_00163" index="163">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yaouh! Yaouh!\r</language>
	</row>
	<row id="msg_0723_00164" index="164">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non! S’il te plaît, laisse-moi gagner!\r</language>
	</row>
	<row id="msg_0723_00165" index="165">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma maman m’a fait ce déguisement.</language>
	</row>
	<row id="msg_0723_00166" index="166">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il est beau, hein?\r</language>
	</row>
	<row id="msg_0723_00167" index="167">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma maman sait très bien coudre.\r</language>
	</row>
	<row id="msg_0723_00168" index="168">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allez les Pokémon, on\nfait de notre mieux!</language>
	</row>
	<row id="msg_0723_00169" index="169">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bravo tout le monde!\r</language>
	</row>
	<row id="msg_0723_00170" index="170">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouin!\r</language>
	</row>
	<row id="msg_0723_00171" index="171">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oui, bien sûr qu’on va se battre, mais\nn’en fais pas toute une affaire.</language>
	</row>
	<row id="msg_0723_00172" index="172">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Attends, relax, relax... Il faut\nrester cool, tu piges?\r</language>
	</row>
	<row id="msg_0723_00173" index="173">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu devrais te détendre de temps en\ntemps. Tu as déjà pensé à la pêche?\r</language>
	</row>
	<row id="msg_0723_00174" index="174">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pêcher, pêcher, pêcher, c’est\ntout ce que j’aime faire!</language>
	</row>
	<row id="msg_0723_00175" index="175">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha, ha, ha!\nJe suis le roi de la pêche!\r</language>
	</row>
	<row id="msg_0723_00176" index="176">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, non!\nJ’ai laissé échapper cette prise!\r</language>
	</row>
	<row id="msg_0723_00177" index="177">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chercher des reliques, c’est\npas de tout repos, tu sais!</language>
	</row>
	<row id="msg_0723_00178" index="178">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vu ton niveau, tu ne ferais pas un\ntrès bon Ruinemaniac.\r</language>
	</row>
	<row id="msg_0723_00179" index="179">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dans les ruines, le danger est partout!\r</language>
	</row>
	<row id="msg_0723_00180" index="180">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On a beaucoup bourlingué, mes\npetits compagnons et moi!</language>
	</row>
	<row id="msg_0723_00181" index="181">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Alors, tu vois? Plutôt costauds, non?\r</language>
	</row>
	<row id="msg_0723_00182" index="182">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Peut-être qu’on devrait\nreprendre la route...\r</language>
	</row>
	<row id="msg_0723_00183" index="183">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eh, toi! Regarde ça!\nMes Pokémon rares!</language>
	</row>
	<row id="msg_0723_00184" index="184">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et en plus d’être rares, mes\nPokémon sont forts!\r</language>
	</row>
	<row id="msg_0723_00185" index="185">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aïe! Non! Arrête! Stop! Pas touche!\r</language>
	</row>
	<row id="msg_0723_00186" index="186">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Attends, je vais te montrer\nma collection privée.</language>
	</row>
	<row id="msg_0723_00187" index="187">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vois, tu vois? Ne sont-ils pas\nmerveilleux? Ils sont top!\r</language>
	</row>
	<row id="msg_0723_00188" index="188">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouiiiiiiiin... Mes... snif...\nMes Pokémon...\r</language>
	</row>
	<row id="msg_0723_00189" index="189">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Regarde! C’est mon ombrelle préférée!\nEt mes magnifiques Pokémon!</language>
	</row>
	<row id="msg_0723_00190" index="190">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ne sont-ils pas mignons?\r</language>
	</row>
	<row id="msg_0723_00191" index="191">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On touche avec les yeux!\nTu ne les auras pas!\r</language>
	</row>
	<row id="msg_0723_00192" index="192">
		<attribute name="window_context_name">used</attribute>
		<language name="English">As-tu déjà vu un arc-en-ciel?</language>
	</row>
	<row id="msg_0723_00193" index="193">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu n’as jamais eu envie de savoir ce qui\nse cachait derrière les arcs-en-ciel?\r</language>
	</row>
	<row id="msg_0723_00194" index="194">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quand je vois un arc-en-ciel, tous\nmes soucis s’envolent.\r</language>
	</row>
	<row id="msg_0723_00195" index="195">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si la météo s’accordait avec tes\nsentiments, quel temps ferait-il\faujourd’hui?</language>
	</row>
	<row id="msg_0723_00196" index="196">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moi, je me sens ensoleillée,\navec un grand ciel bleu!\r</language>
	</row>
	<row id="msg_0723_00197" index="197">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je me sens nuageuse...\r</language>
	</row>
	<row id="msg_0723_00198" index="198">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai horreur des Dresseurs novices!</language>
	</row>
	<row id="msg_0723_00199" index="199">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu n’inspires pas vraiment\nla confiance...\r</language>
	</row>
	<row id="msg_0723_00200" index="200">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un Dresseur se doit d’être\nfort et débordant de vie!\r</language>
	</row>
	<row id="msg_0723_00201" index="201">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai beaucoup de soucis\nen ce moment...</language>
	</row>
	<row id="msg_0723_00202" index="202">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La victoire me fait oublier\nmes problèmes!\r</language>
	</row>
	<row id="msg_0723_00203" index="203">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et un souci de plus...\r</language>
	</row>
	<row id="msg_0723_00204" index="204">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça ne devrait pas durer très longtemps.\nCe sera une victoire facile!</language>
	</row>
	<row id="msg_0723_00205" index="205">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voilà, c’est fait! Tu vois,\nça n’a pas été long.\r</language>
	</row>
	<row id="msg_0723_00206" index="206">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aïe, ouille!\nMais ça fait mal!\r</language>
	</row>
	<row id="msg_0723_00207" index="207">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Snif... snif...</language>
	</row>
	<row id="msg_0723_00208" index="208">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Snif... snif...\nJe crois gue j’ai un rhube...\r</language>
	</row>
	<row id="msg_0723_00209" index="209">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Snif... snif...\nJ’ai le nez bouché...\r</language>
	</row>
	<row id="msg_0723_00210" index="210">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Snifffff...</language>
	</row>
	<row id="msg_0723_00211" index="211">
		<attribute name="window_context_name">used</attribute>
		<language name="English">D’où vient ce doux parfum?\r</language>
	</row>
	<row id="msg_0723_00212" index="212">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Est-ce que tu as mis du parfum?\nTu sens plutôt bon!\r</language>
	</row>
	<row id="msg_0723_00213" index="213">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vas perdre, mais au moins tu auras\nl’occasion de humer un parfum délicieux!</language>
	</row>
	<row id="msg_0723_00214" index="214">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha, ha, ha! Voilà qui t’apprendra à\nspolier mes douces senteurs!\r</language>
	</row>
	<row id="msg_0723_00215" index="215">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gniiiih!\nTrès... en... colère!\r</language>
	</row>
	<row id="msg_0723_00216" index="216">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ecoute hurler les cordes!\nEcoute hurler ma voix!</language>
	</row>
	<row id="msg_0723_00217" index="217">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yeaaaaah!\r</language>
	</row>
	<row id="msg_0723_00218" index="218">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Guiyaaaah!\r</language>
	</row>
	<row id="msg_0723_00219" index="219">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu devrais exprimer tes sentiments\nà travers le chant, baby.</language>
	</row>
	<row id="msg_0723_00220" index="220">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Comment je me sens maintenant?\nRock-and-roll, baby! Yeah!\r</language>
	</row>
	<row id="msg_0723_00221" index="221">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je sens que j’ai le blues...\r</language>
	</row>
	<row id="msg_0723_00222" index="222">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ecoute bien ça!\nLa devise de l’Ornithologue!</language>
	</row>
	<row id="msg_0723_00223" index="223">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vole haut dans le ciel,\njusqu’à la victoire!\r</language>
	</row>
	<row id="msg_0723_00224" index="224">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Après une défaite, repose tes ailes!\r</language>
	</row>
	<row id="msg_0723_00225" index="225">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Faisons chacun de notre mieux!</language>
	</row>
	<row id="msg_0723_00226" index="226">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oui, on a chacun fait de notre mieux!\r</language>
	</row>
	<row id="msg_0723_00227" index="227">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bien joué!\r</language>
	</row>
	<row id="msg_0723_00228" index="228">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vole, vole, vole!\nEnvolons-nous vers la victoire!</language>
	</row>
	<row id="msg_0723_00229" index="229">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zooooum!\r</language>
	</row>
	<row id="msg_0723_00230" index="230">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On va s’écraser!\r</language>
	</row>
	<row id="msg_0723_00231" index="231">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis le roi des mers, je suis\nné au creux des vagues!</language>
	</row>
	<row id="msg_0723_00232" index="232">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les vagues berçaient mes nuits,\nde la mer j’étais l’enfant!\r</language>
	</row>
	<row id="msg_0723_00233" index="233">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blourgh... Gouah. Bon, au moins à\nterre, je n’ai plus le mal de mer...\r</language>
	</row>
	<row id="msg_0723_00234" index="234">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La mer, majestueuse et infinie!</language>
	</row>
	<row id="msg_0723_00235" index="235">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh... Je l’entends...\nJ’entends l’appel des vagues...\r</language>
	</row>
	<row id="msg_0723_00236" index="236">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je veux devenir quelqu’un de grandiose,\ngrandiose comme la mer.\r</language>
	</row>
	<row id="msg_0723_00237" index="237">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yaouh!</language>
	</row>
	<row id="msg_0723_00238" index="238">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allez, à ton tour de\ncrier un bon coup!\r</language>
	</row>
	<row id="msg_0723_00239" index="239">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bouarf! Kof! Kof!\nJe m’étrangle à force de crier!\r</language>
	</row>
	<row id="msg_0723_00240" index="240">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu devrais adhérer au mode\nde vie du Montagnard!</language>
	</row>
	<row id="msg_0723_00241" index="241">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Alors, tu vois?\nTu adores ce mode de vie, non?\r</language>
	</row>
	<row id="msg_0723_00242" index="242">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allez, réveille-toi!\nMon mode de vie est génial!\r</language>
	</row>
	<row id="msg_0723_00243" index="243">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis une Star!</language>
	</row>
	<row id="msg_0723_00244" index="244">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu comprends pourquoi je suis\nune Star!\r</language>
	</row>
	<row id="msg_0723_00245" index="245">
		<attribute name="window_context_name">used</attribute>
		<language name="English">D’accord, mais en popularité,\nje te bats à plate couture!\r</language>
	</row>
	<row id="msg_0723_00246" index="246">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Regardez-moi!\nAdorez-moi!</language>
	</row>
	<row id="msg_0723_00247" index="247">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh...\nC’est toute ma vie...\r</language>
	</row>
	<row id="msg_0723_00248" index="248">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis devenue une Star parce que je\nvoulais que tout le monde me regarde!\r</language>
	</row>
	<row id="msg_0723_00249" index="249">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A cause de mon amour pour les combats,\nje risque de perdre mon emploi de Star.</language>
	</row>
	<row id="msg_0723_00250" index="250">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les combats sont tellement fun!\r</language>
	</row>
	<row id="msg_0723_00251" index="251">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’aime trop les combats, personne ne\npourra jamais m’enlever ça.\r</language>
	</row>
	<row id="msg_0723_00252" index="252">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je cours un marathon tous les matins!\nC’est excellent pour la forme.</language>
	</row>
	<row id="msg_0723_00253" index="253">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma condition physique parfaite\nm’assure une victoire facile!\r</language>
	</row>
	<row id="msg_0723_00254" index="254">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon, j’ai perdu... Il n’empêche que\nje suis en excellente forme!\r</language>
	</row>
	<row id="msg_0723_00255" index="255">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais courir sur place pendant notre\ncombat. Je dois garder la forme!</language>
	</row>
	<row id="msg_0723_00256" index="256">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et un point pour les sportifs!\r</language>
	</row>
	<row id="msg_0723_00257" index="257">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Argh! Ma cheville! \nJe me suis tordu la cheville!\r</language>
	</row>
	<row id="msg_0723_00258" index="258">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hors de mon chemin!\nJ’ai des livraisons à faire!</language>
	</row>
	<row id="msg_0723_00259" index="259">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quoi? Tu veux que je livre\nquelque chose pour toi?\r</language>
	</row>
	<row id="msg_0723_00260" index="260">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Toutes ces livraisons, chaque jour...\nJe suis tout courbaturé!\r</language>
	</row>
	<row id="msg_0723_00261" index="261">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai participé à la construction des\nbâtiments que tu peux voir dans le coin.</language>
	</row>
	<row id="msg_0723_00262" index="262">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Alors, qu’en penses-tu?\nC’est de la belle construction, non?\r</language>
	</row>
	<row id="msg_0723_00263" index="263">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon rêve, c’est de construire un\nbâtiment plus grand qu’une montagne!\r</language>
	</row>
	<row id="msg_0723_00264" index="264">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu sens cette odeur? L’odeur du\nfoin me suit partout...</language>
	</row>
	<row id="msg_0723_00265" index="265">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Waouh!\r</language>
	</row>
	<row id="msg_0723_00266" index="266">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cette odeur, c’est le doux parfum du\nfoin que les Pokémon adorent.\r</language>
	</row>
	<row id="msg_0723_00267" index="267">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vas-y, rentre-moi dedans!\nJ’ai du coffre, je tiendrai le coup!</language>
	</row>
	<row id="msg_0723_00268" index="268">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quoi? C’est tout ce que tu peux faire?\nTu peux y aller plus fort contre moi!\r</language>
	</row>
	<row id="msg_0723_00269" index="269">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aïe... Ouille... Ça fait mal... C’est\ncomme si tu m’avais cassé une côte...\r</language>
	</row>
	<row id="msg_0723_00270" index="270">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne rajeunis pas, tu sais?\nJe dois me ménager.</language>
	</row>
	<row id="msg_0723_00271" index="271">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne suis peut-être plus tout jeune,\nmais je compense par l’expérience.\r</language>
	</row>
	<row id="msg_0723_00272" index="272">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Haaa, la fougue de la jeunesse.\nTu débordes de vie!\r</language>
	</row>
	<row id="msg_0723_00273" index="273">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eh, toi là-bas!\nC’est entre toi et moi!</language>
	</row>
	<row id="msg_0723_00274" index="274">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Victoire!\r</language>
	</row>
	<row id="msg_0723_00275" index="275">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Incroyable!\r</language>
	</row>
	<row id="msg_0723_00276" index="276">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vois ça, ce sont mes Pokémon.\nJe les ai élevés avec ’man et ’pa.</language>
	</row>
	<row id="msg_0723_00277" index="277">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils sont costauds, pas vrai?\r</language>
	</row>
	<row id="msg_0723_00278" index="278">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nom d’une vache!\nOn a perdu!\r</language>
	</row>
	<row id="msg_0723_00279" index="279">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je te préviens, je ne rigole pas,\nalors accroche-toi à tes bretelles!</language>
	</row>
	<row id="msg_0723_00280" index="280">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Waouh! On a vraiment assuré!\r</language>
	</row>
	<row id="msg_0723_00281" index="281">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bah, j’ai fait de mon mieux!\r</language>
	</row>
	<row id="msg_0723_00282" index="282">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Attention tout le monde, je\nveux des beaux sourires!</language>
	</row>
	<row id="msg_0723_00283" index="283">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allez, des jolis sourires!\r</language>
	</row>
	<row id="msg_0723_00284" index="284">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quel sourire! Ta pose victorieuse\ncrève l’écran!\r</language>
	</row>
	<row id="msg_0723_00285" index="285">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zoom avant sur toi!</language>
	</row>
	<row id="msg_0723_00286" index="286">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mise au point!\r</language>
	</row>
	<row id="msg_0723_00287" index="287">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zoom arrière, fondu...\r</language>
	</row>
	<row id="msg_0723_00288" index="288">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On ne dirait pas, mais cette\ncaméra est plutôt lourde.</language>
	</row>
	<row id="msg_0723_00289" index="289">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais grâce à cette caméra, mon\népaule est bien musclée.\r</language>
	</row>
	<row id="msg_0723_00290" index="290">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Argh...\nJe suis sonné...\r</language>
	</row>
	<row id="msg_0723_00291" index="291">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bonjour, futur sujet de reportage!\nTu veux bien combattre contre moi?</language>
	</row>
	<row id="msg_0723_00292" index="292">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci pour ton témoignage!\r</language>
	</row>
	<row id="msg_0723_00293" index="293">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu m’as donné une belle leçon de vie!\r</language>
	</row>
	<row id="msg_0723_00294" index="294">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis prête à tout pour un scoop!</language>
	</row>
	<row id="msg_0723_00295" index="295">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis aussi prête à tout\npour gagner un combat!\r</language>
	</row>
	<row id="msg_0723_00296" index="296">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stop! Arrête!\nTu vas casser mon micro!\r</language>
	</row>
	<row id="msg_0723_00297" index="297">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est pour un sondage:\nque penses-tu de moi?</language>
	</row>
	<row id="msg_0723_00298" index="298">
		<attribute name="window_context_name">used</attribute>
		<language name="English">“Quel Dresseur fantastique!”\nC’est ton opinion?\r</language>
	</row>
	<row id="msg_0723_00299" index="299">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je fais un reportage sur\nma propre personne!\r</language>
	</row>
	<row id="msg_0723_00300" index="300">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allez, viens, on fait la course!</language>
	</row>
	<row id="msg_0723_00301" index="301">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Premier!\r</language>
	</row>
	<row id="msg_0723_00302" index="302">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Attends-moi!\nJ’arrive pas à suivre!\r</language>
	</row>
	<row id="msg_0723_00303" index="303">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Changement de vitesse!\nOn appuie sur le champignon!</language>
	</row>
	<row id="msg_0723_00304" index="304">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vrooooum!\r</language>
	</row>
	<row id="msg_0723_00305" index="305">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Baboum!\r</language>
	</row>
	<row id="msg_0723_00306" index="306">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Est-ce que tu pourras résister à mes\nPokémon lancés à pleine vitesse?</language>
	</row>
	<row id="msg_0723_00307" index="307">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trop rapides pour toi!\r</language>
	</row>
	<row id="msg_0723_00308" index="308">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai franchi le mur du son...\r</language>
	</row>
	<row id="msg_0723_00309" index="309">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je préfère pédaler tranquillement\nplutôt qu’aller le plus vite possible.</language>
	</row>
	<row id="msg_0723_00310" index="310">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allons-y doucement.\r</language>
	</row>
	<row id="msg_0723_00311" index="311">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu prends les choses trop au sérieux...\r</language>
	</row>
	<row id="msg_0723_00312" index="312">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Désolé, mais je ne sais pas retenir mes\ncoups, même contre les débutants!</language>
	</row>
	<row id="msg_0723_00313" index="313">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Puissance maximum, c’est\ncomme ça que je gagne!\r</language>
	</row>
	<row id="msg_0723_00314" index="314">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je te décerne la ceinture\nnoire du dressage!\r</language>
	</row>
	<row id="msg_0723_00315" index="315">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon esprit est affûté, mes poings sont\ncomme l’acier, ma sueur coule à flot!</language>
	</row>
	<row id="msg_0723_00316" index="316">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kiai!\r</language>
	</row>
	<row id="msg_0723_00317" index="317">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai sué plus que toi! Ça fait de moi\nle vainqueur de ce combat.\r</language>
	</row>
	<row id="msg_0723_00318" index="318">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En garde!</language>
	</row>
	<row id="msg_0723_00319" index="319">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’en veux encore!\r</language>
	</row>
	<row id="msg_0723_00320" index="320">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Argh... Je m’en souviendrai!\r</language>
	</row>
	<row id="msg_0723_00321" index="321">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allez, prépare-toi!</language>
	</row>
	<row id="msg_0723_00322" index="322">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Beau combat!\r</language>
	</row>
	<row id="msg_0723_00323" index="323">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Toi, tu as de la ressource.\r</language>
	</row>
	<row id="msg_0723_00324" index="324">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vas comprendre la puissance\nde ma technique ultime!</language>
	</row>
	<row id="msg_0723_00325" index="325">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis le plus grand!\nMouahahaha!\r</language>
	</row>
	<row id="msg_0723_00326" index="326">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis tombé au combat?\nNoooooooooon!\r</language>
	</row>
	<row id="msg_0723_00327" index="327">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eh, toi!\nUn combat, ça te dit?</language>
	</row>
	<row id="msg_0723_00328" index="328">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eh, toi!\nMerci beaucoup!\r</language>
	</row>
	<row id="msg_0723_00329" index="329">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eh, toi!\nJe suis pas très content!\r</language>
	</row>
	<row id="msg_0723_00330" index="330">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Euh... Je... n’ai jamais fait\nde karaté de ma vie...</language>
	</row>
	<row id="msg_0723_00331" index="331">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je le crois pas!\nJ’ai un don inné pour le karaté!\r</language>
	</row>
	<row id="msg_0723_00332" index="332">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Etre Karatéka, c’est la classe,\nalors je m’habille comme ça.\r</language>
	</row>
	<row id="msg_0723_00333" index="333">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça fait cinq ans que je vis recluse dans\nla montagne. Mes cheveux ont poussé!</language>
	</row>
	<row id="msg_0723_00334" index="334">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eh, je me lave tous les jours, tu sais!\nComment oses-tu?\r</language>
	</row>
	<row id="msg_0723_00335" index="335">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’y retourne pour cinq autres\nannées...?\r</language>
	</row>
	<row id="msg_0723_00336" index="336">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai des muscles, moi!</language>
	</row>
	<row id="msg_0723_00337" index="337">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu ne sais pas apprécier la\nbeauté des muscles!\r</language>
	</row>
	<row id="msg_0723_00338" index="338">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Etre musclée, c’est la beauté ultime!\r</language>
	</row>
	<row id="msg_0723_00339" index="339">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En combat comme en amour, je\nn’ai jamais connu l’échec!</language>
	</row>
	<row id="msg_0723_00340" index="340">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vois? Encore une victoire!\r</language>
	</row>
	<row id="msg_0723_00341" index="341">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai perdu, et alors? Je m’en fiche!\nJ’ai un rendez-vous galant!\r</language>
	</row>
	<row id="msg_0723_00342" index="342">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Préparez-vous à l’assaut, soldats!\nChaaaaaargez!</language>
	</row>
	<row id="msg_0723_00343" index="343">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Dresseur ennemi est vaincu!\nLa victoire est à nous!\r</language>
	</row>
	<row id="msg_0723_00344" index="344">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est une déroute!\nSonnez la retraite!\r</language>
	</row>
	<row id="msg_0723_00345" index="345">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai 75 ans de dressage derrière moi. Tu\ncrois que tu peux me battre?</language>
	</row>
	<row id="msg_0723_00346" index="346">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Portons un toast à la mémoire du passé!\r</language>
	</row>
	<row id="msg_0723_00347" index="347">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma longue histoire de gloire et de\nréussite touche à sa fin...\r</language>
	</row>
	<row id="msg_0723_00348" index="348">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tout le monde est prêt?</language>
	</row>
	<row id="msg_0723_00349" index="349">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, un combat superbe.\r</language>
	</row>
	<row id="msg_0723_00350" index="350">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je te tire mon chapeau.\r</language>
	</row>
	<row id="msg_0723_00351" index="351">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma foi...\nQuel adorable Dresseur...</language>
	</row>
	<row id="msg_0723_00352" index="352">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est de la déception que je vois?\nComme c’est chou...\r</language>
	</row>
	<row id="msg_0723_00353" index="353">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vois...\nTu es plus que simplement adorable.\r</language>
	</row>
	<row id="msg_0723_00354" index="354">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Haaa-yaaah!</language>
	</row>
	<row id="msg_0723_00355" index="355">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un cri retentissant, n’est-ce pas?\nCrier ainsi est très tonifiant.</language>
	</row>
	<row id="msg_0723_00356" index="356">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pfou... Pfou...\nOh... Je suis épuisée.\r</language>
	</row>
	<row id="msg_0723_00357" index="357">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Etre riche, ça ne vous met pas\nà l’abri des soucis...</language>
	</row>
	<row id="msg_0723_00358" index="358">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bien sûr, être à l’abri du\nbesoin a ses avantages...\r</language>
	</row>
	<row id="msg_0723_00359" index="359">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Des réceptions somptueuses tous les\njours... C’est quelque peu fatigant.\r</language>
	</row>
	<row id="msg_0723_00360" index="360">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu viens goûter à la défaite et\napprendre ce que c’est que combattre?</language>
	</row>
	<row id="msg_0723_00361" index="361">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je te vois devenir un Dresseur\nencore plus fort...\r</language>
	</row>
	<row id="msg_0723_00362" index="362">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le vaincu s’esquive sans attendre...\r</language>
	</row>
	<row id="msg_0723_00363" index="363">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Regarde-moi dans les yeux!</language>
	</row>
	<row id="msg_0723_00364" index="364">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu étais sous mon emprise!\r</language>
	</row>
	<row id="msg_0723_00365" index="365">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon pouvoir de persuasion a échoué!\r</language>
	</row>
	<row id="msg_0723_00366" index="366">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...</language>
	</row>
	<row id="msg_0723_00367" index="367">
		<attribute name="window_context_name">used</attribute>
		<language name="English">... C’est fait.\r</language>
	</row>
	<row id="msg_0723_00368" index="368">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je me suis concentré en silence...\r</language>
	</row>
	<row id="msg_0723_00369" index="369">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai des pouvoirs!\nGaranti sans trucage!</language>
	</row>
	<row id="msg_0723_00370" index="370">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est le pouvoir du Kinésiste!\r</language>
	</row>
	<row id="msg_0723_00371" index="371">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’aurais mieux fait de truquer,\nau bout du compte...\r</language>
	</row>
	<row id="msg_0723_00372" index="372">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Prépare-toi!</language>
	</row>
	<row id="msg_0723_00373" index="373">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ahaha!\r</language>
	</row>
	<row id="msg_0723_00374" index="374">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Argh!\r</language>
	</row>
	<row id="msg_0723_00375" index="375">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ferme les yeux et compte...\nLentement... Plus lentement...</language>
	</row>
	<row id="msg_0723_00376" index="376">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’était le compte à rebours\nvers ma victoire!\r</language>
	</row>
	<row id="msg_0723_00377" index="377">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pfff...\nJe voulais juste te forcer à dormir.\r</language>
	</row>
	<row id="msg_0723_00378" index="378">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vis aux côtés des Pokémon.</language>
	</row>
	<row id="msg_0723_00379" index="379">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je n’ai jamais vraiment aimé\nles combats, mais...\r</language>
	</row>
	<row id="msg_0723_00380" index="380">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne suis vraiment pas\nfait pour les combats.\r</language>
	</row>
	<row id="msg_0723_00381" index="381">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai élevé ces Pokémon avec mon père...</language>
	</row>
	<row id="msg_0723_00382" index="382">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Papa, est-ce que tu as vu ça?\nJ’ai réussi...\r</language>
	</row>
	<row id="msg_0723_00383" index="383">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Papa, je n’y arrive pas...\nJe dois encore les entraîner...\r</language>
	</row>
	<row id="msg_0723_00384" index="384">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Elever des Pokémon demande beaucoup\nd’efforts et d’honnêteté!</language>
	</row>
	<row id="msg_0723_00385" index="385">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha! J’ai élevé ces Pokémon\nà la perfection!\r</language>
	</row>
	<row id="msg_0723_00386" index="386">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouin! Regarde ce que tu\nas fait à mes Pokémon!\r</language>
	</row>
	<row id="msg_0723_00387" index="387">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu veux voir les Pokémon\nque j’ai élevés?</language>
	</row>
	<row id="msg_0723_00388" index="388">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Alors?\nIls sont mignons, hein?\r</language>
	</row>
	<row id="msg_0723_00389" index="389">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu pourrais y aller doucement!\r</language>
	</row>
	<row id="msg_0723_00390" index="390">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je me suis spécialisée dans\nles Pokémon gracieux!</language>
	</row>
	<row id="msg_0723_00391" index="391">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gracieux, mais costauds, non?!\r</language>
	</row>
	<row id="msg_0723_00392" index="392">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooooh, mais ils sont si gracieux!\r</language>
	</row>
	<row id="msg_0723_00393" index="393">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ravie de faire ta connaissance.\nAttention, ne me sous-estime pas!</language>
	</row>
	<row id="msg_0723_00394" index="394">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je te l’avais dit!\r</language>
	</row>
	<row id="msg_0723_00395" index="395">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est peut-être moi qui ai\nsous-estimé ton potentiel...\r</language>
	</row>
	<row id="msg_0723_00396" index="396">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hum... J’aime cette flamme\ndans tes yeux.</language>
	</row>
	<row id="msg_0723_00397" index="397">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Malgré la défaite, tu as toujours\ncette étincelle dans les yeux!\r</language>
	</row>
	<row id="msg_0723_00398" index="398">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma plus belle pierre précieuse n’est\nrien comparée à l’éclat de ton regard!\r</language>
	</row>
	<row id="msg_0723_00399" index="399">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quand j’avais ton âge, je\nn’avais peur de rien.</language>
	</row>
	<row id="msg_0723_00400" index="400">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quand je te vois, ça me rappelle ma\nvie de jeune homme rebelle.\r</language>
	</row>
	<row id="msg_0723_00401" index="401">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je dois dire que tu n’as pas\nfroid aux yeux non plus!\r</language>
	</row>
	<row id="msg_0723_00402" index="402">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si tu veux rentrer chez ta môman, c’est\nmaintenant ou jamais!</language>
	</row>
	<row id="msg_0723_00403" index="403">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Guéhéhé!\r</language>
	</row>
	<row id="msg_0723_00404" index="404">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouinnn!\nJe veux ma maman!\r</language>
	</row>
	<row id="msg_0723_00405" index="405">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La violence ne résout rien!\nPrends ma main! Tout n’est qu’amour!</language>
	</row>
	<row id="msg_0723_00406" index="406">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne voulais pas me battre, mais...\nPrends ma main! Tout n’est qu’amour!\r</language>
	</row>
	<row id="msg_0723_00407" index="407">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les combats sont futiles!\nPrends ma main! Tout n’est qu’amour!\r</language>
	</row>
	<row id="msg_0723_00408" index="408">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mes lunettes sont sales!\nJe n’y vois rien!</language>
	</row>
	<row id="msg_0723_00409" index="409">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Est-ce que j’ai gagné?\nJe ne vois vraiment rien.\r</language>
	</row>
	<row id="msg_0723_00410" index="410">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Est-ce que j’ai perdu?\nJe ne vois vraiment rien.\r</language>
	</row>
	<row id="msg_0723_00411" index="411">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une carrière de Dresseur se construit\ndoucement mais sûrement.</language>
	</row>
	<row id="msg_0723_00412" index="412">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Doucement mais sûrement, voilà\ncomment je gagne!\r</language>
	</row>
	<row id="msg_0723_00413" index="413">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais... J’ai pourtant combattu\ndoucement mais sûrement...\r</language>
	</row>
	<row id="msg_0723_00414" index="414">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé, hé, hé, hé...</language>
	</row>
	<row id="msg_0723_00415" index="415">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Guahahaha!\r</language>
	</row>
	<row id="msg_0723_00416" index="416">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bouh, ouh, ouh...\r</language>
	</row>
	<row id="msg_0723_00417" index="417">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Attention mesdames et messieurs, voici\nmon fabulifiant spectacle de Pokémon!</language>
	</row>
	<row id="msg_0723_00418" index="418">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ben quoi, t’as pas trouvé ça drôle?\r</language>
	</row>
	<row id="msg_0723_00419" index="419">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arggggh...\nÇa n’a rien de drôle.\r</language>
	</row>
	<row id="msg_0723_00420" index="420">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais m’entraîner avec toi.</language>
	</row>
	<row id="msg_0723_00421" index="421">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un peu de fierté!\nRelève-toi!\r</language>
	</row>
	<row id="msg_0723_00422" index="422">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bien!\nÇa suffit comme ça!\r</language>
	</row>
	<row id="msg_0723_00423" index="423">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pourquoi passer sa vie à se triturer\nles méninges? Les combats, c’est bien!</language>
	</row>
	<row id="msg_0723_00424" index="424">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vois, on combat, je gagne,\noù est le problème?\r</language>
	</row>
	<row id="msg_0723_00425" index="425">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai perdu, et alors? Pas grave!\nTant qu’on s’amuse, c’est bien!\r</language>
	</row>
	<row id="msg_0723_00426" index="426">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’espère que tu seras à la hauteur...\nNe me déçois pas!</language>
	</row>
	<row id="msg_0723_00427" index="427">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je me suis trompé sur ton compte...\r</language>
	</row>
	<row id="msg_0723_00428" index="428">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as des qualités.\r</language>
	</row>
	<row id="msg_0723_00429" index="429">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mes parents sont de grands Dresseurs,\neux aussi.</language>
	</row>
	<row id="msg_0723_00430" index="430">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est dans mes gènes!\r</language>
	</row>
	<row id="msg_0723_00431" index="431">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Papa, maman, je suis désolée!\r</language>
	</row>
	<row id="msg_0723_00432" index="432">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dans un combat, je fais mon maximum,\nquoi qu’il arrive!</language>
	</row>
	<row id="msg_0723_00433" index="433">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’était un résultat prévisible!\r</language>
	</row>
	<row id="msg_0723_00434" index="434">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’accepte ma défaite!\r</language>
	</row>
	<row id="msg_0723_00435" index="435">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le voilà! Le combat le plus important de\ntoute ma vie! Je ne peux pas perdre!</language>
	</row>
	<row id="msg_0723_00436" index="436">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yaouh, youpi!\r</language>
	</row>
	<row id="msg_0723_00437" index="437">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et voilà, je redescends au\nrang de Fillette...\r</language>
	</row>
	<row id="msg_0723_00438" index="438">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon amour de la nature et des Pokémon\nm’a poussé à devenir un ₧₦ Ranger!</language>
	</row>
	<row id="msg_0723_00439" index="439">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’aime aussi les combats!\r</language>
	</row>
	<row id="msg_0723_00440" index="440">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh...\nPas grave, j’aime toujours les combats.\r</language>
	</row>
	<row id="msg_0723_00441" index="441">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salut! Tu as déjà pensé à\ndevenir un ₧₦ Ranger?</language>
	</row>
	<row id="msg_0723_00442" index="442">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eh bien, tu n’as pas encore\nle niveau d’un ₧₦ Ranger.\r</language>
	</row>
	<row id="msg_0723_00443" index="443">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as le potentiel! Etre un ₧₦ Ranger\noffre plein d’avantages, tu sais?\r</language>
	</row>
	<row id="msg_0723_00444" index="444">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Victoire ou défaite, un combat\nse vit dans l’instant!</language>
	</row>
	<row id="msg_0723_00445" index="445">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as des regrets?\r</language>
	</row>
	<row id="msg_0723_00446" index="446">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne regrette rien!\r</language>
	</row>
	<row id="msg_0723_00447" index="447">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai fait le serment de protéger la\nnature et les Pokémon qui l’habitent.</language>
	</row>
	<row id="msg_0723_00448" index="448">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est une mission difficile, mais\ntellement gratifiante.\r</language>
	</row>
	<row id="msg_0723_00449" index="449">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est une noble mission, n’est-ce pas?\r</language>
	</row>
	<row id="msg_0723_00450" index="450">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mes charmants petits Pokémon\nvoudraient te faire un bisou!</language>
	</row>
	<row id="msg_0723_00451" index="451">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voilà. Comme c’est mignon!\r</language>
	</row>
	<row id="msg_0723_00452" index="452">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu es vraiment insensible!\nC’est presque choquant...\r</language>
	</row>
	<row id="msg_0723_00453" index="453">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je voulais tellement trouver une bonne\nstratégie que je n’ai pas dormi!</language>
	</row>
	<row id="msg_0723_00454" index="454">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma stratégie a marché!\r</language>
	</row>
	<row id="msg_0723_00455" index="455">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, mais non!\nJ’aurais mieux fait de dormir...\r</language>
	</row>
	<row id="msg_0723_00456" index="456">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Retiens bien la devise du Dracologue!</language>
	</row>
	<row id="msg_0723_00457" index="457">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dans la victoire, rugis!\nAvec ton dragon, rugis!\r</language>
	</row>
	<row id="msg_0723_00458" index="458">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Même dans la défaite, rugis!\nAvec ton dragon, rugis!\r</language>
	</row>
	<row id="msg_0723_00459" index="459">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La puissance du dragon!</language>
	</row>
	<row id="msg_0723_00460" index="460">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai la puissance!\r</language>
	</row>
	<row id="msg_0723_00461" index="461">
		<attribute name="window_context_name">used</attribute>
		<language name="English">... Arf...\nJe voulais la puissance...\r</language>
	</row>
	<row id="msg_0723_00462" index="462">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Observe attentivement!\nC’est sans doute le pouvoir ultime!</language>
	</row>
	<row id="msg_0723_00463" index="463">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis invincible, j’ai sans\ndoute le pouvoir ultime...\r</language>
	</row>
	<row id="msg_0723_00464" index="464">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est toi qui as le pouvoir ultime...\nÇa ne fait aucun doute!\r</language>
	</row>
	<row id="msg_0723_00465" index="465">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eh, regarde là-bas!\nUn Pokémon rare!</language>
	</row>
	<row id="msg_0723_00466" index="466">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha, ha, ha... Et voilà ce qui se passe\nquand on se fait avoir!\r</language>
	</row>
	<row id="msg_0723_00467" index="467">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pfff...\nMa feinte n’a pas marché.\r</language>
	</row>
	<row id="msg_0723_00468" index="468">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai horreur du froid, mais j’adore\nles combats de Pokémon.</language>
	</row>
	<row id="msg_0723_00469" index="469">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brr... Brrrrr...\nJ’ai gagné!\r</language>
	</row>
	<row id="msg_0723_00470" index="470">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brr... Brrrr...\nJe ne sens plus mon cerveau...\r</language>
	</row>
	<row id="msg_0723_00471" index="471">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Attention, je lâche mes\nmeilleurs Pokémon!</language>
	</row>
	<row id="msg_0723_00472" index="472">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Surprenant!\nTu as de bonnes capacités!\r</language>
	</row>
	<row id="msg_0723_00473" index="473">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as un bon esprit, continue!\r</language>
	</row>
	<row id="msg_0723_00474" index="474">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’adore la neige!\nTout devient blanc.</language>
	</row>
	<row id="msg_0723_00475" index="475">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est tellement romantique, la neige!\r</language>
	</row>
	<row id="msg_0723_00476" index="476">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je fonds comme neige au soleil...\r</language>
	</row>
	<row id="msg_0723_00477" index="477">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il est pas super, mon manteau? Le hic,\nc’est qu’il gêne un peu mes mouvements.</language>
	</row>
	<row id="msg_0723_00478" index="478">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce manteau me tient bien chaud.\r</language>
	</row>
	<row id="msg_0723_00479" index="479">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai l’impression d’avoir de\nla neige dans le cou...\r</language>
	</row>
	<row id="msg_0723_00480" index="480">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est moi le meilleur! Je suis le\nroi des gamins en short!</language>
	</row>
	<row id="msg_0723_00481" index="481">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vois? C’est ça, être le meilleur!\r</language>
	</row>
	<row id="msg_0723_00482" index="482">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et zut...\nJe suis le roi...\r</language>
	</row>
	<row id="msg_0723_00483" index="483">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est moi le meilleur! Le vrai\nprince des gamins en short!</language>
	</row>
	<row id="msg_0723_00484" index="484">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vois? C’est ça, être un prince!\r</language>
	</row>
	<row id="msg_0723_00485" index="485">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et zut...\nJe suis un prince...\r</language>
	</row>
	<row id="msg_0723_00486" index="486">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hum...\nRavie de te connaître.</language>
	</row>
	<row id="msg_0723_00487" index="487">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouah, quoi? On a gagné?\nEuh... Désolée...\r</language>
	</row>
	<row id="msg_0723_00488" index="488">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eh bien... Euh...\nMerci...\r</language>
	</row>
	<row id="msg_0723_00489" index="489">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Prends garde!</language>
	</row>
	<row id="msg_0723_00490" index="490">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bravo!\r</language>
	</row>
	<row id="msg_0723_00491" index="491">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayeuh!\r</language>
	</row>
	<row id="msg_0723_00492" index="492">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Toi aussi tu as des choses à apprendre!</language>
	</row>
	<row id="msg_0723_00493" index="493">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est la dure réalité du combat!\r</language>
	</row>
	<row id="msg_0723_00494" index="494">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les joies de la victoire!\r</language>
	</row>
	<row id="msg_0723_00495" index="495">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu feras un très bon sujet d’étude.</language>
	</row>
	<row id="msg_0723_00496" index="496">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je n’ai rien appris de\nnouveau avec toi...\r</language>
	</row>
	<row id="msg_0723_00497" index="497">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je comprends maintenant. Dans cette\nsituation, j’aurais dû faire ça...\r</language>
	</row>
	<row id="msg_0723_00498" index="498">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le prof m’a donné des conseils.</language>
	</row>
	<row id="msg_0723_00499" index="499">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le prof avait raison!\nC’était trop facile!\r</language>
	</row>
	<row id="msg_0723_00500" index="500">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Haaa, le prof avait faux sur toute la\nligne! Ça marche pas du tout!\r</language>
	</row>
	<row id="msg_0723_00501" index="501">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais pourquoi nous battons-nous?\nJe ne comprends pas.</language>
	</row>
	<row id="msg_0723_00502" index="502">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais pourquoi? Pourquoi?\r</language>
	</row>
	<row id="msg_0723_00503" index="503">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pourquoi tu as gagné? Qu’est-ce\nqu’on fait maintenant?\r</language>
	</row>
	<row id="msg_0723_00504" index="504">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En fait, les Pokémon sont une\nmarchandise comme une autre.</language>
	</row>
	<row id="msg_0723_00505" index="505">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce résultat était tellement prévisible\nqu’il n’a pas grand intérêt.\r</language>
	</row>
	<row id="msg_0723_00506" index="506">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais enfin... Mes... Mes Pokémon...\nMes chers Pokémon... Excusez-moi!\r</language>
	</row>
	<row id="msg_0723_00507" index="507">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai tellement d’argent, je peux avoir\nce que je veux... Même des victoires!</language>
	</row>
	<row id="msg_0723_00508" index="508">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’argent peut tout acheter.\r</language>
	</row>
	<row id="msg_0723_00509" index="509">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si je te donne mon argent de poche,\ntu me laisseras gagner?\r</language>
	</row>
	<row id="msg_0723_00510" index="510">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je crois que je ne suis vraiment pas\nfaite pour toutes ces mondanités.</language>
	</row>
	<row id="msg_0723_00511" index="511">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha, ha, hah! Youhouuuuu!\r</language>
	</row>
	<row id="msg_0723_00512" index="512">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Espèce de cloporte! Je vais te\npiétiner, t’écrabouiller, te...\r</language>
	</row>
	<row id="msg_0723_00513" index="513">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais régler ton cas illico!</language>
	</row>
	<row id="msg_0723_00514" index="514">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je me suis occupée de toi illico!\r</language>
	</row>
	<row id="msg_0723_00515" index="515">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais débarrasser le plancher illico!\r</language>
	</row>
	<row id="msg_0723_00516" index="516">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miam-miam...</language>
	</row>
	<row id="msg_0723_00517" index="517">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’adore ces Lava Cookies\ncroustillants...\r</language>
	</row>
	<row id="msg_0723_00518" index="518">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai l’impression de marcher\nsur des Poké Balls cassées!\r</language>
	</row>
	<row id="msg_0723_00519" index="519">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est la voie du Scout!\nPrends garde à toi!</language>
	</row>
	<row id="msg_0723_00520" index="520">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est ça, la voie du Scout!\r</language>
	</row>
	<row id="msg_0723_00521" index="521">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vive les Scouts!\r</language>
	</row>
	<row id="msg_0723_00522" index="522">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouvre bien les yeux et admire les\ntechniques secrètes de mes ancêtres!</language>
	</row>
	<row id="msg_0723_00523" index="523">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Alors, dis-moi, tu n’en crois\npas tes yeux, hein?\r</language>
	</row>
	<row id="msg_0723_00524" index="524">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Normalement, c’est à ce moment-là que\nje disparais dans un nuage de fumée...\r</language>
	</row>
	<row id="msg_0723_00525" index="525">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cible en vue!</language>
	</row>
	<row id="msg_0723_00526" index="526">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ne m’en veux pas, je n’ai fait\nque mon devoir de ninja...\r</language>
	</row>
	<row id="msg_0723_00527" index="527">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Argh!\r</language>
	</row>
	<row id="msg_0723_00528" index="528">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pikaaa!</language>
	</row>
	<row id="msg_0723_00529" index="529">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pikapikaaa!\r</language>
	</row>
	<row id="msg_0723_00530" index="530">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pika...\r</language>
	</row>
	<row id="msg_0723_00531" index="531">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un combat? D’accord, mais pas\nmoyen que je perde contre toi!</language>
	</row>
	<row id="msg_0723_00532" index="532">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yaaahou! Youpiii!\nJ’ai gagné, j’ai gagné!\r</language>
	</row>
	<row id="msg_0723_00533" index="533">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Beurk...\nJ’ai perdu...\r</language>
	</row>
	<row id="msg_0723_00534" index="534">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Etre mignonne fait\npartie de mon travail!</language>
	</row>
	<row id="msg_0723_00535" index="535">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On peut gagner sa vie juste\nen étant mignonne!\r</language>
	</row>
	<row id="msg_0723_00536" index="536">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hein?!\nOh... Tu me le paieras!\r</language>
	</row>
	<row id="msg_0723_00537" index="537">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je t’autorise à me serrer la main.\nC’est un grand honneur, tu sais!</language>
	</row>
	<row id="msg_0723_00538" index="538">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si tu avais gagné, je t’aurais\nmême signé un autographe!\r</language>
	</row>
	<row id="msg_0723_00539" index="539">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, ça ne se passera pas comme ça,\nje vais en parler à mes avocats!\r</language>
	</row>
	<row id="msg_0723_00540" index="540">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cours!\nNe réfléchis pas! Cours!</language>
	</row>
	<row id="msg_0723_00541" index="541">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Plus vite!\nEncore plus vite!\r</language>
	</row>
	<row id="msg_0723_00542" index="542">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je cours!\nJe... suis à court d’arguments...\r</language>
	</row>
	<row id="msg_0723_00543" index="543">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salut.\nContent de te connaître.</language>
	</row>
	<row id="msg_0723_00544" index="544">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon, ben, ce fut un plaisir. Salut!\r</language>
	</row>
	<row id="msg_0723_00545" index="545">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon, ben, merci pour ta visite. Salut!\r</language>
	</row>
	<row id="msg_0723_00546" index="546">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les autres pêcheurs me surnomment\nl’empereur de la pêche!</language>
	</row>
	<row id="msg_0723_00547" index="547">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et une autre grosse prise! Oh, sans\nvouloir t’offenser, bien sûr...\r</language>
	</row>
	<row id="msg_0723_00548" index="548">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pourquoi l’empereur de la pêche?\nC’est une ancienne légende chinoise...\r</language>
	</row>
	<row id="msg_0723_00549" index="549">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quand on est aussi fort que moi, on peut\ngagner facilement, même en dormant.</language>
	</row>
	<row id="msg_0723_00550" index="550">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zzz... Zzz...\r</language>
	</row>
	<row id="msg_0723_00551" index="551">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bonne nuit...\r</language>
	</row>
	<row id="msg_0723_00552" index="552">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma mère et moi, on voyage à la\nrecherche de merveilles.</language>
	</row>
	<row id="msg_0723_00553" index="553">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le reste du temps, on pêche et on\ntravaille aux champs.\r</language>
	</row>
	<row id="msg_0723_00554" index="554">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eh ben, t’as l’air sur les nerfs.\r</language>
	</row>
	<row id="msg_0723_00555" index="555">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gagner, voilà ce que je vais faire\naujourd’hui! Et puis demain aussi!</language>
	</row>
	<row id="msg_0723_00556" index="556">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nahaha! Nahaha!\nJe vais jamais perdre de ma vie!\r</language>
	</row>
	<row id="msg_0723_00557" index="557">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nooooon! Pas moyen!\nJe peux pas perdre!\r</language>
	</row>
	<row id="msg_0723_00558" index="558">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Laisse-moi évaluer tes \nqualités de Collec.</language>
	</row>
	<row id="msg_0723_00559" index="559">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il te manque encore quelques spécimens\nrares. Continue à chercher.\r</language>
	</row>
	<row id="msg_0723_00560" index="560">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est une sacrée collection que tu as.\nJe te reprends le tout!\r</language>
	</row>
	<row id="msg_0723_00561" index="561">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tiens! Tiens! Et tiens!</language>
	</row>
	<row id="msg_0723_00562" index="562">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oui, chef!\r</language>
	</row>
	<row id="msg_0723_00563" index="563">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Owowowoouh!\r</language>
	</row>
	<row id="msg_0723_00564" index="564">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ecoute-moi ça, ce cri qui vient\ndu cœur!</language>
	</row>
	<row id="msg_0723_00565" index="565">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’aime la musique, et la musique m’aime!\r</language>
	</row>
	<row id="msg_0723_00566" index="566">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allez, tous ensemble!\r</language>
	</row>
	<row id="msg_0723_00567" index="567">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un combat? Quand tu veux, baby!</language>
	</row>
	<row id="msg_0723_00568" index="568">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yeah. Trop bon.\r</language>
	</row>
	<row id="msg_0723_00569" index="569">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci public!\r</language>
	</row>
	<row id="msg_0723_00570" index="570">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zoooum!</language>
	</row>
	<row id="msg_0723_00571" index="571">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Flap! Flap!\r</language>
	</row>
	<row id="msg_0723_00572" index="572">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, je vais te donner des coups de bec!\r</language>
	</row>
	<row id="msg_0723_00573" index="573">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allez, on se bat!</language>
	</row>
	<row id="msg_0723_00574" index="574">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allez, on remet ça!\r</language>
	</row>
	<row id="msg_0723_00575" index="575">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allez, tu t’en sors pas mal.\r</language>
	</row>
	<row id="msg_0723_00576" index="576">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A regarder ainsi la mer... Je me\nremémore les joies de mon enfance...</language>
	</row>
	<row id="msg_0723_00577" index="577">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouinnnnnnh!\nPapa!\r</language>
	</row>
	<row id="msg_0723_00578" index="578">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouinnnnnnh!\nMaman!\r</language>
	</row>
	<row id="msg_0723_00579" index="579">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Viens, montre-moi ce\ndont tu es capable!</language>
	</row>
	<row id="msg_0723_00580" index="580">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Alors, je suis trop costaud pour toi?\r</language>
	</row>
	<row id="msg_0723_00581" index="581">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Beau travail! Tu as réussi à contrer\nma force physique.\r</language>
	</row>
	<row id="msg_0723_00582" index="582">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouh, là! Attends une minute,\nje ne suis pas prêt!</language>
	</row>
	<row id="msg_0723_00583" index="583">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hein? C’est déjà fini?\nQuoi, j’ai gagné?\r</language>
	</row>
	<row id="msg_0723_00584" index="584">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hein? C’est déjà fini?\nQuoi, j’ai perdu?\r</language>
	</row>
	<row id="msg_0723_00585" index="585">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma boisson préférée, c’est le\nLait Meumeu. Tu en as sur toi?</language>
	</row>
	<row id="msg_0723_00586" index="586">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouahaha! Victoire!\nUn peu de lait pour fêter ça!\r</language>
	</row>
	<row id="msg_0723_00587" index="587">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouah! Du Lait Meumeu!\nQu’on m’apporte du Lait Meumeu!\r</language>
	</row>
	<row id="msg_0723_00588" index="588">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les mains en l’air!\nTu es en état d’arrestation!</language>
	</row>
	<row id="msg_0723_00589" index="589">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Flagrant délit de défaite!\r</language>
	</row>
	<row id="msg_0723_00590" index="590">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Agent en détresse!\r</language>
	</row>
	<row id="msg_0723_00591" index="591">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne suis pas un vrai Agent,\nje collectionne juste les uniformes.</language>
	</row>
	<row id="msg_0723_00592" index="592">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je crois que tu porterais\nbien l’uniforme.\r</language>
	</row>
	<row id="msg_0723_00593" index="593">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, les combats, c’est vraiment génial.\r</language>
	</row>
	<row id="msg_0723_00594" index="594">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Qui peut dire de quoi demain sera fait?</language>
	</row>
	<row id="msg_0723_00595" index="595">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On peut gagner un jour, et perdre\nle lendemain, c’est la vie.\r</language>
	</row>
	<row id="msg_0723_00596" index="596">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Peut-être que demain, c’est moi qui vais\ngagner.\r</language>
	</row>
	<row id="msg_0723_00597" index="597">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce combat est mon dernier espoir,\nje vais donner le maximum.</language>
	</row>
	<row id="msg_0723_00598" index="598">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yahaaaa! Yahouuuu!\r</language>
	</row>
	<row id="msg_0723_00599" index="599">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tout est fini...\r</language>
	</row>
	<row id="msg_0723_00600" index="600">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et voici l’infatigable Campeur\ndans toute sa splendeur!</language>
	</row>
	<row id="msg_0723_00601" index="601">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu pourrais devenir adepte\ndu camping toi aussi.\r</language>
	</row>
	<row id="msg_0723_00602" index="602">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais peut-être laisser tomber le\ncamping et me joindre à tes aventures.\r</language>
	</row>
	<row id="msg_0723_00603" index="603">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mes chances de victoire sont minces,\nmais je combattrai quand même.</language>
	</row>
	<row id="msg_0723_00604" index="604">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouah, je ne m’attendais pas à ça.\r</language>
	</row>
	<row id="msg_0723_00605" index="605">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je le savais... Désolé.\r</language>
	</row>
	<row id="msg_0723_00606" index="606">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je crois que tu m’aimes\nbien, je me trompe?</language>
	</row>
	<row id="msg_0723_00607" index="607">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as perdu parce que tu ne\nvoulais pas me vexer.\r</language>
	</row>
	<row id="msg_0723_00608" index="608">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pourquoi est-ce que tu m’as battue?\nJe croyais que tu m’aimais bien.\r</language>
	</row>
	<row id="msg_0723_00609" index="609">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Perdant ou gagnant, l’important\nest de s’amuser.</language>
	</row>
	<row id="msg_0723_00610" index="610">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oui, oui, OUI!\nVictoire! Ha, ha, ha!\r</language>
	</row>
	<row id="msg_0723_00611" index="611">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, attends un peu...\nJe ne suis pas près d’oublier ça!\r</language>
	</row>
	<row id="msg_0723_00612" index="612">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Pokémon, c’est pas que pour les\nenfants... Je vais te montrer.</language>
	</row>
	<row id="msg_0723_00613" index="613">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Alors, ça donne quoi? Est-ce que je suis\ncool comme un vieux chanteur de blues?\r</language>
	</row>
	<row id="msg_0723_00614" index="614">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça fait mal, mais il faut savoir\nsupporter la douleur.\r</language>
	</row>
	<row id="msg_0723_00615" index="615">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vois, cet objet que je tiens\nn’est pas vraiment une guitare.</language>
	</row>
	<row id="msg_0723_00616" index="616">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bip, boup, bzzt...\r</language>
	</row>
	<row id="msg_0723_00617" index="617">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est un synthétiseur portable.\r</language>
	</row>
	<row id="msg_0723_00618" index="618">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour mon travail, je dois parfois\nincarner une Nageuse ou un Canon.</language>
	</row>
	<row id="msg_0723_00619" index="619">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une Star peut jouer tous les rôles!\r</language>
	</row>
	<row id="msg_0723_00620" index="620">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais au fond de moi... je suis\nune Fillette!\r</language>
	</row>
	<row id="msg_0723_00621" index="621">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allez, amusons-nous! Mais attention,\nje suis douillette.</language>
	</row>
	<row id="msg_0723_00622" index="622">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha, ha, ha! Quelle rigolade!\r</language>
	</row>
	<row id="msg_0723_00623" index="623">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouille! Fais attention!\nJeux de mains, jeux de vilains!\r</language>
	</row>
	<row id="msg_0723_00624" index="624">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Avec mon Pokémon préféré,\nça va être vite réglé!</language>
	</row>
	<row id="msg_0723_00625" index="625">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les liens qui m’unissent à mes\nPokémon sont très forts...\r</language>
	</row>
	<row id="msg_0723_00626" index="626">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quoi? Quoi?!\nPourquoi ai-je perdu?!\r</language>
	</row>
	<row id="msg_0723_00627" index="627">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vivre avec les Pokémon, c’est ce\nqu’il y a de plus beau au monde.</language>
	</row>
	<row id="msg_0723_00628" index="628">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé, hé, hé...\nLes Pokémon sont les meilleurs...\r</language>
	</row>
	<row id="msg_0723_00629" index="629">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Peu importe que je perde, tant\nque j’ai mes Pokémon...\r</language>
	</row>
	<row id="msg_0723_00630" index="630">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tant que mes Pokémon sont avec moi,\nje n’ai besoin de rien de plus.</language>
	</row>
	<row id="msg_0723_00631" index="631">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Grâce à mes Pokémon, tous\nmes soucis s’envolent.\r</language>
	</row>
	<row id="msg_0723_00632" index="632">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est la même chose pour toi,\nn’est-ce pas?\r</language>
	</row>
	<row id="msg_0723_00633" index="633">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On ne dirait pas, mais j’étais la\nreine de la fête dans ma jeunesse.</language>
	</row>
	<row id="msg_0723_00634" index="634">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je n’ai pas perdu la forme!\r</language>
	</row>
	<row id="msg_0723_00635" index="635">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je me souviens de cette\npériode avec nostalgie...\r</language>
	</row>
	<row id="msg_0723_00636" index="636">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allez mes petits, faites de votre mieux!</language>
	</row>
	<row id="msg_0723_00637" index="637">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Waouh! Bien joué!\nPapa est fier de vous!\r</language>
	</row>
	<row id="msg_0723_00638" index="638">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’aime mes Pokémon comme\ns’ils étaient mes enfants.\r</language>
	</row>
	<row id="msg_0723_00639" index="639">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeune garçon? Jeune fille?\nPeu importe, allons-y!</language>
	</row>
	<row id="msg_0723_00640" index="640">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeune garçon? Jeune fille?\nPeu importe, je suis désolé.\r</language>
	</row>
	<row id="msg_0723_00641" index="641">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeune garçon? Jeune fille?\nPeu importe, tu as un don!\r</language>
	</row>
	<row id="msg_0723_00642" index="642">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta chevauchée s’arrête ici,\npied tendre.</language>
	</row>
	<row id="msg_0723_00643" index="643">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’te l’avais dit.\r</language>
	</row>
	<row id="msg_0723_00644" index="644">
		<attribute name="window_context_name">used</attribute>
		<language name="English">T’es trop coriace pour moi!\r</language>
	</row>
	<row id="msg_0723_00645" index="645">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En selle pour la victoire!\nHue, en avant!</language>
	</row>
	<row id="msg_0723_00646" index="646">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yaouh! Yihaaaaa!\r</language>
	</row>
	<row id="msg_0723_00647" index="647">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hoooo, c’est perdu...\nSnif... snif...\r</language>
	</row>
	<row id="msg_0723_00648" index="648">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Laisse-moi te présenter mes\npetits compagnons!</language>
	</row>
	<row id="msg_0723_00649" index="649">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Alors, comment tu les trouves,\nmes petits compagnons?\r</language>
	</row>
	<row id="msg_0723_00650" index="650">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouin! \nMes petits compagnons!\r</language>
	</row>
	<row id="msg_0723_00651" index="651">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Combattre, ce n’est pas simplement\ngagner ou perdre.</language>
	</row>
	<row id="msg_0723_00652" index="652">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon, bien sûr, ça fait toujours\nplaisir de gagner.\r</language>
	</row>
	<row id="msg_0723_00653" index="653">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce qui compte, c’est de faire\nde son mieux.\r</language>
	</row>
	<row id="msg_0723_00654" index="654">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Etre trop dur n’apporte rien de bon,\net trop couver ses Pokémon non plus...</language>
	</row>
	<row id="msg_0723_00655" index="655">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Elever des Pokémon est un défi\ncomplexe.\r</language>
	</row>
	<row id="msg_0723_00656" index="656">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bien élever ses Pokémon, c’est une\nquestion d’équilibre.\r</language>
	</row>
	<row id="msg_0723_00657" index="657">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais te dire si tes Pokémon\nont été bien élevés.</language>
	</row>
	<row id="msg_0723_00658" index="658">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tes Pokémon ne sont pas assez\nentraînés, tu dois revoir tes méthodes.\r</language>
	</row>
	<row id="msg_0723_00659" index="659">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Impressionnant! Voilà des Pokémon\nparfaitement entraînés!\r</language>
	</row>
	<row id="msg_0723_00660" index="660">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais gagner, point à la ligne.\n</language>
	</row>
	<row id="msg_0723_00661" index="661">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vois?\r</language>
	</row>
	<row id="msg_0723_00662" index="662">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bah!\r</language>
	</row>
	<row id="msg_0723_00663" index="663">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bouahaha!\nTu crois pouvoir me battre?</language>
	</row>
	<row id="msg_0723_00664" index="664">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bouahaha!\nJ’ai gagné!\r</language>
	</row>
	<row id="msg_0723_00665" index="665">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bouahaha...\r</language>
	</row>
	<row id="msg_0723_00666" index="666">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu es à moi maintenant. Abandonne!</language>
	</row>
	<row id="msg_0723_00667" index="667">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pas si mauvais. Et si on remettait\nça une autre fois?\r</language>
	</row>
	<row id="msg_0723_00668" index="668">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Comment est-ce possible?\r</language>
	</row>
	<row id="msg_0723_00669" index="669">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yo, yo!\nAmusons-nous un peu!</language>
	</row>
	<row id="msg_0723_00670" index="670">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci!\nOn remet ça?\r</language>
	</row>
	<row id="msg_0723_00671" index="671">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci!\nA quand notre prochain combat?\r</language>
	</row>
	<row id="msg_0723_00672" index="672">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu n’as pas le niveau, je vais\nt’apprendre deux ou trois choses.</language>
	</row>
	<row id="msg_0723_00673" index="673">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non, non! Ça ne va pas du tout!\nRecommence, n’abandonne jamais!\r</language>
	</row>
	<row id="msg_0723_00674" index="674">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as de bonnes capacités... Et tu as\nfait de ton mieux, en plus. Excellent!\r</language>
	</row>
	<row id="msg_0723_00675" index="675">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je mets la puissance au maximum!\n100 000 volts!</language>
	</row>
	<row id="msg_0723_00676" index="676">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis sous haute tension!\r</language>
	</row>
	<row id="msg_0723_00677" index="677">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aïeuh! Je me suis électrocuté!\r</language>
	</row>
	<row id="msg_0723_00678" index="678">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je t’attends!</language>
	</row>
	<row id="msg_0723_00679" index="679">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha! Trop faible, essaie encore!\r</language>
	</row>
	<row id="msg_0723_00680" index="680">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ho! Tu m’as bien eue!\nJe veux ma revanche!\r</language>
	</row>
	<row id="msg_0723_00681" index="681">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vas devoir faire le\nmaximum contre moi!</language>
	</row>
	<row id="msg_0723_00682" index="682">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, c’est tout?\r</language>
	</row>
	<row id="msg_0723_00683" index="683">
		<attribute name="window_context_name">used</attribute>
		<language name="English">D’accord...\nPlutôt pas mal...\r</language>
	</row>
	<row id="msg_0723_00684" index="684">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha, ha, ha! Pas de chance pour toi, je\nsuis ton prochain adversaire.</language>
	</row>
	<row id="msg_0723_00685" index="685">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha, ha, ha!\r</language>
	</row>
	<row id="msg_0723_00686" index="686">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha...\nHa, ha...\r</language>
	</row>
	<row id="msg_0723_00687" index="687">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as peur?</language>
	</row>
	<row id="msg_0723_00688" index="688">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’était un beau combat. J’espère\nte croiser à nouveau.\r</language>
	</row>
	<row id="msg_0723_00689" index="689">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Waouh...\nJe ne m’attendais pas à perdre.\r</language>
	</row>
	<row id="msg_0723_00690" index="690">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Laisse-moi te montrer le\npouvoir de la nature!</language>
	</row>
	<row id="msg_0723_00691" index="691">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voilà le vrai pouvoir de la nature!\r</language>
	</row>
	<row id="msg_0723_00692" index="692">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il faut protéger l’environnement...</language>
	</row>
	<row id="msg_0723_00693" index="693">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un combat? Contre moi?\nMais pour quoi faire?</language>
	</row>
	<row id="msg_0723_00694" index="694">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vois?\nJe savais que ça allait arriver.\r</language>
	</row>
	<row id="msg_0723_00695" index="695">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bouh! Bouh!\nC’est nul!\r</language>
	</row>
	<row id="msg_0723_00696" index="696">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fouhahaha!\nJe suis ton prochain adversaire!</language>
	</row>
	<row id="msg_0723_00697" index="697">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fouhahaha! Tu croyais vraiment\npouvoir me battre?\r</language>
	</row>
	<row id="msg_0723_00698" index="698">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fouhahaha!\nA la prochaine!\r</language>
	</row>
	<row id="msg_0723_00699" index="699">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’en est fini de toi! Tu vas affronter\nmon équipe de Pokémon surentraînés.</language>
	</row>
	<row id="msg_0723_00700" index="700">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bravo! Je savais que mes Pokémon\nseraient à la hauteur!\r</language>
	</row>
	<row id="msg_0723_00701" index="701">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, non! C’est horrible! Regarde ce\nque tu as fait à mes Pokémon!\r</language>
	</row>
	<row id="msg_0723_00702" index="702">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Combattre est une affaire sérieuse, il\nfaut être attentif du début à la fin!</language>
	</row>
	<row id="msg_0723_00703" index="703">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ne baisse jamais ta garde!\r</language>
	</row>
	<row id="msg_0723_00704" index="704">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je crois que j’ai eu une\nseconde d’inattention...\r</language>
	</row>
	<row id="msg_0723_00705" index="705">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé!</language>
	</row>
	<row id="msg_0723_00706" index="706">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hééé!\r</language>
	</row>
	<row id="msg_0723_00707" index="707">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé...\r</language>
	</row>
	<row id="msg_0723_00708" index="708">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis forte, point final.</language>
	</row>
	<row id="msg_0723_00709" index="709">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai gagné, point final.\r</language>
	</row>
	<row id="msg_0723_00710" index="710">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai perdu, point final.\r</language>
	</row>
	<row id="msg_0723_00711" index="711">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Shaah!</language>
	</row>
	<row id="msg_0723_00712" index="712">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Houhooh!\r</language>
	</row>
	<row id="msg_0723_00713" index="713">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Haouah!\r</language>
	</row>
	<row id="msg_0723_00714" index="714">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça fait des années que je viens ici.\nJe ne m’en lasserai jamais!</language>
	</row>
	<row id="msg_0723_00715" index="715">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça ne se voit pas, mais je suis encore\nun enfant. J’ai le même âge que toi.\r</language>
	</row>
	<row id="msg_0723_00716" index="716">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je continuerai les combats longtemps\naprès mes premiers cheveux gris.\r</language>
	</row>
	<row id="msg_0723_00717" index="717">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon, que les choses soient claires,\ntu ne me battras jamais!</language>
	</row>
	<row id="msg_0723_00718" index="718">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vois? Tu n’avais aucune chance.\r</language>
	</row>
	<row id="msg_0723_00719" index="719">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais... La seule à m’avoir battu avant\ntoi était cette fille avec la bouée...\r</language>
	</row>
	<row id="msg_0723_00720" index="720">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Que tu es jeune!</language>
	</row>
	<row id="msg_0723_00721" index="721">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les enfants sont tellement\nimprudents de nos jours...\r</language>
	</row>
	<row id="msg_0723_00722" index="722">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les enfants sont tellement\nexubérants de nos jours...\r</language>
	</row>
	<row id="msg_0723_00723" index="723">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’aimerais que mes enfants deviennent\ndes Dresseurs de grande classe.</language>
	</row>
	<row id="msg_0723_00724" index="724">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’espère que mes enfants\nseront meilleurs que toi...\r</language>
	</row>
	<row id="msg_0723_00725" index="725">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si mes enfants étaient aussi forts que\ntoi, je serais comblée...\r</language>
	</row>
	<row id="msg_0723_00726" index="726">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Admire! Admire le pouvoir\nmystique du Kinésiste!</language>
	</row>
	<row id="msg_0723_00727" index="727">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vois?\nPouvoir mystique!\r</language>
	</row>
	<row id="msg_0723_00728" index="728">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais...?\nMon pouvoir mystique...\r</language>
	</row>
	<row id="msg_0723_00729" index="729">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Laisse-moi te présenter\nma petite famille!</language>
	</row>
	<row id="msg_0723_00730" index="730">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Beau travail, ma petite famille!\nÇa suffira pour aujourd’hui!\r</language>
	</row>
	<row id="msg_0723_00731" index="731">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma petite famille adorée...\r</language>
	</row>
	<row id="msg_0723_00732" index="732">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tourne sur toi-même, tourne, tourne...</language>
	</row>
	<row id="msg_0723_00733" index="733">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as la tête qui tourne?\r</language>
	</row>
	<row id="msg_0723_00734" index="734">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouh, là...\nC’est moi qui ai la tête qui tourne...\r</language>
	</row>
	<row id="msg_0723_00735" index="735">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon grand frère m’a donné une\nastuce: trouver le point faible!</language>
	</row>
	<row id="msg_0723_00736" index="736">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha, ha! J’ai gagné!\nLe plan de mon grand frère a marché!</language>
	</row>
	<row id="msg_0723_00737" index="737">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon grand frère m’avait dit qu’il fallait\nbrouiller la vue de l’adversaire...</language>
	</row>
	<row id="msg_0723_00738" index="738">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hola! Tu as l’air d’être un sacré\nDresseur, on va s’amuser!</language>
	</row>
	<row id="msg_0723_00739" index="739">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est bien ce que je pensais! Tu as un\ndon! Mais ce n’est pas encore assez.\r</language>
	</row>
	<row id="msg_0723_00740" index="740">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça oui, tu es habile.\nContinue comme ça!\r</language>
	</row>
	<row id="msg_0723_00741" index="741">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue!\nQu’est-ce que je vous sers?</language>
	</row>
	<row id="msg_0723_00742" index="742">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vous apporte l’addition?\r</language>
	</row>
	<row id="msg_0723_00743" index="743">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci et à bientôt, j’espère!\r</language>
	</row>
	<row id="msg_0723_00744" index="744">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bonjour.\nQu’est-ce que j’vous sers?</language>
	</row>
	<row id="msg_0723_00745" index="745">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voilà, c’est servi...\r</language>
	</row>
	<row id="msg_0723_00746" index="746">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Au revoir!\r</language>
	</row>
	<row id="msg_0723_00747" index="747">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’adore la clientèle sympa comme toi.\nJe suis à toi tout de suite!</language>
	</row>
	<row id="msg_0723_00748" index="748">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça va, l’addition n’était pas trop\nsalée?\r</language>
	</row>
	<row id="msg_0723_00749" index="749">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eh, mais attends... Je n’ai pas encore\napporté ta commande.\r</language>
	</row>
	<row id="msg_0723_00750" index="750">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais qu’est-ce que c’est que ce...</language>
	</row>
	<row id="msg_0723_00751" index="751">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Désolé, mais je crois que tu as\nun truc sur le nez...\r</language>
	</row>
	<row id="msg_0723_00752" index="752">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon, excuse-moi. C’est juste que tu\navais un truc sur le nez.\r</language>
	</row>
	<row id="msg_0723_00753" index="753">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça faisait longtemps que j’attendais\nun Dresseur de ton calibre.</language>
	</row>
	<row id="msg_0723_00754" index="754">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha, ha! Je ne suis pas déçu,\ntu as failli m’avoir!\r</language>
	</row>
	<row id="msg_0723_00755" index="755">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je le savais! La classe!\r</language>
	</row>
	<row id="msg_0723_00756" index="756">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Comment est-ce que je vais\ncouvrir cet événement...?</language>
	</row>
	<row id="msg_0723_00757" index="757">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu dois faire mieux que ça si tu veux\nque ce soit un reportage intéressant.\r</language>
	</row>
	<row id="msg_0723_00758" index="758">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai ce qu’il me faut. Je vais rédiger\nun article sur cet affrontement.\r</language>
	</row>
	<row id="msg_0723_00759" index="759">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mes Pokémon sortent de l’ordinaire.</language>
	</row>
	<row id="msg_0723_00760" index="760">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as vu la différence?\nC’est une équipe très élaborée.\r</language>
	</row>
	<row id="msg_0723_00761" index="761">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as vu la différence?\nCette équipe ne marche pas très fort...\r</language>
	</row>
	<row id="msg_0723_00762" index="762">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salut! Tu m’as tout l’air d’un\nDresseur redoutable!</language>
	</row>
	<row id="msg_0723_00763" index="763">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cette victoire m’emplit de\njoie et d’allégresse!\r</language>
	</row>
	<row id="msg_0723_00764" index="764">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouille...\nJe ne suis pas de taille.\r</language>
	</row>
	<row id="msg_0723_00765" index="765">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vavoooum!\nVitesse maximum!</language>
	</row>
	<row id="msg_0723_00766" index="766">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vavavavoooum!\nJe vais exploser le compteur!\r</language>
	</row>
	<row id="msg_0723_00767" index="767">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vrrr... Vrrouuu...\nPanne d’essence...\r</language>
	</row>
	<row id="msg_0723_00768" index="768">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dring, dring!</language>
	</row>
	<row id="msg_0723_00769" index="769">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hiii-hiii-hiii-hiii!\r</language>
	</row>
	<row id="msg_0723_00770" index="770">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vlan!\r</language>
	</row>
	<row id="msg_0723_00771" index="771">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je rêve de promenades à\nBicyclette avec mon petit ami...</language>
	</row>
	<row id="msg_0723_00772" index="772">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais pas de tandem!\r</language>
	</row>
	<row id="msg_0723_00773" index="773">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si seulement j’avais un petit ami...\r</language>
	</row>
	<row id="msg_0723_00774" index="774">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Qu’est-ce qui t’amène ici?\nQuelle est ta motivation profonde?</language>
	</row>
	<row id="msg_0723_00775" index="775">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Maintenant que tu as perdu,\nque vas-tu faire?\r</language>
	</row>
	<row id="msg_0723_00776" index="776">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta motivation a l’air d’être noble\net désintéressée.\r</language>
	</row>
	<row id="msg_0723_00777" index="777">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Commençons.</language>
	</row>
	<row id="msg_0723_00778" index="778">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’admire ta technique.\r</language>
	</row>
	<row id="msg_0723_00779" index="779">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je me retire dignement...\r</language>
	</row>
	<row id="msg_0723_00780" index="780">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un combat? Contre moi?\nSérieusement?</language>
	</row>
	<row id="msg_0723_00781" index="781">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha, ha! J’en glousse de joie!\nTu n’aurais même pas dû essayer!\r</language>
	</row>
	<row id="msg_0723_00782" index="782">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Double waouh!\r</language>
	</row>
	<row id="msg_0723_00783" index="783">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais danser et chanter\npour capter ton attention!</language>
	</row>
	<row id="msg_0723_00784" index="784">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, baby!\r</language>
	</row>
	<row id="msg_0723_00785" index="785">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vois que je n’ai pas vraiment\ncapté ton attention...\r</language>
	</row>
	<row id="msg_0723_00786" index="786">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Prêt, partez!</language>
	</row>
	<row id="msg_0723_00787" index="787">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Premier!\r</language>
	</row>
	<row id="msg_0723_00788" index="788">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouaah! Attends-moi!\r</language>
	</row>
	<row id="msg_0723_00789" index="789">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu peux me dire ce que je fais ici?</language>
	</row>
	<row id="msg_0723_00790" index="790">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais, tu es qui, toi?\r</language>
	</row>
	<row id="msg_0723_00791" index="791">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pourquoi est-ce que je combats?\r</language>
	</row>
	<row id="msg_0723_00792" index="792">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma maîtrise de la canne à pêche est\nsans égale dans tout Sinnoh!</language>
	</row>
	<row id="msg_0723_00793" index="793">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu comprends maintenant?\nJ’imagine ta surprise!\r</language>
	</row>
	<row id="msg_0723_00794" index="794">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bah, la pêche n’a rien à voir avec\nles combats de Pokémon...\r</language>
	</row>
	<row id="msg_0723_00795" index="795">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai deux amours: la pêche\net les combats de Pokémon.</language>
	</row>
	<row id="msg_0723_00796" index="796">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Attraper un beau poisson ou gagner un\ncombat, rien ne me rend plus heureux!\r</language>
	</row>
	<row id="msg_0723_00797" index="797">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis né pour pêcher et combattre!\r</language>
	</row>
	<row id="msg_0723_00798" index="798">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis arrivé ici sur un bateau,\nun grand bateau.</language>
	</row>
	<row id="msg_0723_00799" index="799">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sinnoh, j’aime bien.\nBel endroit.\r</language>
	</row>
	<row id="msg_0723_00800" index="800">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu veux aller sur la mer? Avec mon\nbateau, viens, belles choses à voir.\r</language>
	</row>
	<row id="msg_0723_00801" index="801">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hein? Tu es mon adversaire?\nMauvais tirage pour moi...</language>
	</row>
	<row id="msg_0723_00802" index="802">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne m’attendais pas à gagner...\r</language>
	</row>
	<row id="msg_0723_00803" index="803">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Argh, je le savais que je\nn’étais pas à la hauteur.\r</language>
	</row>
	<row id="msg_0723_00804" index="804">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha, ha! Bonjour!</language>
	</row>
	<row id="msg_0723_00805" index="805">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha, ha! On remet ça quand tu veux!\r</language>
	</row>
	<row id="msg_0723_00806" index="806">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha, ha! Merci pour ce bon moment!\r</language>
	</row>
	<row id="msg_0723_00807" index="807">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allez, on est là pour s’amuser!\nJe veux te voir sourire!</language>
	</row>
	<row id="msg_0723_00808" index="808">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha, ha! Ha, ha, ha!\nAllez, rigole un peu!\r</language>
	</row>
	<row id="msg_0723_00809" index="809">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Même dans la défaite, je garde le\nsourire! Ha, ha! Ha, ha, ha!\r</language>
	</row>
	<row id="msg_0723_00810" index="810">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Haut les cœurs!</language>
	</row>
	<row id="msg_0723_00811" index="811">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pas mal.\r</language>
	</row>
	<row id="msg_0723_00812" index="812">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Superbe.\r</language>
	</row>
	<row id="msg_0723_00813" index="813">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le meilleur moment du combat?\nLe coup fatal!</language>
	</row>
	<row id="msg_0723_00814" index="814">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Prends ça!\nC’est mon coup fatal!\r</language>
	</row>
	<row id="msg_0723_00815" index="815">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouille...\nTon coup fatal est redoutable...\r</language>
	</row>
	<row id="msg_0723_00816" index="816">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé, j’adore ton look, t’es cool!</language>
	</row>
	<row id="msg_0723_00817" index="817">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé, t’as fait de ton mieux, non?\r</language>
	</row>
	<row id="msg_0723_00818" index="818">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé, tu te défends, baby.\r</language>
	</row>
	<row id="msg_0723_00819" index="819">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ecoute-moi ça! Je chante et mes\nPokémon jouent les choristes!</language>
	</row>
	<row id="msg_0723_00820" index="820">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Shoubi-doubi-douwap!\r</language>
	</row>
	<row id="msg_0723_00821" index="821">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eh, reviens!\nLa chanson n’est pas finie!\r</language>
	</row>
	<row id="msg_0723_00822" index="822">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Des amis Dresseurs connectés en ligne\nm’ont donné quelques conseils.</language>
	</row>
	<row id="msg_0723_00823" index="823">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais remercier mes amis en ligne.\nMais je ne sais pas qui ils sont...\r</language>
	</row>
	<row id="msg_0723_00824" index="824">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Argh, c’est nul! Mes amis en ligne ne\nm’ont pas beaucoup aidé!\r</language>
	</row>
	<row id="msg_0723_00825" index="825">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu peux attendre un moment?\nJ’envoie un e-mail.</language>
	</row>
	<row id="msg_0723_00826" index="826">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vite, je dois rentrer chez moi\npour regarder mes e-mails!\r</language>
	</row>
	<row id="msg_0723_00827" index="827">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon, c’est fini? Je m’en vais.\r</language>
	</row>
	<row id="msg_0723_00828" index="828">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Papa... Maman...\nVeillez sur moi...</language>
	</row>
	<row id="msg_0723_00829" index="829">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Papa... Maman...\nVous avez vu ça?\r</language>
	</row>
	<row id="msg_0723_00830" index="830">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Papa... Maman...\nJe suis désolé...\r</language>
	</row>
	<row id="msg_0723_00831" index="831">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je te préviens, les combats,\nc’est pas trop mon truc.</language>
	</row>
	<row id="msg_0723_00832" index="832">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai gagné mais...\nJ’en tremble encore...\r</language>
	</row>
	<row id="msg_0723_00833" index="833">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Grrr... Je suis tellement en colère...\nJe crois que je vais pleurer...\r</language>
	</row>
	<row id="msg_0723_00834" index="834">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est le pouvoir de la science!</language>
	</row>
	<row id="msg_0723_00835" index="835">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as vu ça? Impressionnant, non?\nC’est ça, le pouvoir de la science!\r</language>
	</row>
	<row id="msg_0723_00836" index="836">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est inconcevable... Le pouvoir\nde la science est vaincu...\r</language>
	</row>
	<row id="msg_0723_00837" index="837">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais te montrer le fruit de mes\nexpériences!</language>
	</row>
	<row id="msg_0723_00838" index="838">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eurêka, ma théorie est validée!\nA moi les bourses d’études!\r</language>
	</row>
	<row id="msg_0723_00839" index="839">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quel genre d’expériences?\nC’est top secret!</language>
	</row>
	<row id="msg_0723_00840" index="840">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Afin de mieux appréhender ce combat,\nje vais retrouver mon âme d’enfant.</language>
	</row>
	<row id="msg_0723_00841" index="841">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gougou gaga.\r</language>
	</row>
	<row id="msg_0723_00842" index="842">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Areu...\r</language>
	</row>
	<row id="msg_0723_00843" index="843">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha, ha, ha!\nTu en as fait du chemin!</language>
	</row>
	<row id="msg_0723_00844" index="844">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha, ha, ha! Tout ce chemin pour rien!\r</language>
	</row>
	<row id="msg_0723_00845" index="845">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha, ha, ha! N’oublie pas tes amis\nen route!\r</language>
	</row>
	<row id="msg_0723_00846" index="846">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais te démonter pièce par pièce.</language>
	</row>
	<row id="msg_0723_00847" index="847">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais te recycler.\r</language>
	</row>
	<row id="msg_0723_00848" index="848">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pense écologique, pense bio.\r</language>
	</row>
	<row id="msg_0723_00849" index="849">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais oui! Un combat! Fantastique!</language>
	</row>
	<row id="msg_0723_00850" index="850">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Boum! Et voilà le travail!\r</language>
	</row>
	<row id="msg_0723_00851" index="851">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha, rien de tel qu’un bon\ncombat pendant la pause.\r</language>
	</row>
	<row id="msg_0723_00852" index="852">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais faire de mon mieux,\nmais laisse-moi une chance!</language>
	</row>
	<row id="msg_0723_00853" index="853">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai réussi!\nJ’ai atteint mon but!\r</language>
	</row>
	<row id="msg_0723_00854" index="854">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bah, j’ai fait de mon mieux!\nMerci pour tes encouragements!\r</language>
	</row>
	<row id="msg_0723_00855" index="855">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un combat, c’est comme... comme une\ndéclaration d’amour écrite sur le sable.</language>
	</row>
	<row id="msg_0723_00856" index="856">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu comprends ce que je veux dire?\nJ’imagine que non.\r</language>
	</row>
	<row id="msg_0723_00857" index="857">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu comprends ce que je veux dire?\nJ’imagine que non.\r</language>
	</row>
	<row id="msg_0723_00858" index="858">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eh, toi là-bas! Oui, toi!\nHalte-là, on ne bouge plus!</language>
	</row>
	<row id="msg_0723_00859" index="859">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il est tard pour jouer dehors à ton\nâge. Rentre vite chez toi!\r</language>
	</row>
	<row id="msg_0723_00860" index="860">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce n’est pas une façon de traiter un\nmembre des forces de l’ordre.\r</language>
	</row>
	<row id="msg_0723_00861" index="861">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rooooon... Piiiish...</language>
	</row>
	<row id="msg_0723_00862" index="862">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MELOFEE... Mmmm...\nAttends-moi... Zzzzzz...\r</language>
	</row>
	<row id="msg_0723_00863" index="863">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mmm... Hé, hé, hé...\nZzzzzzz...\r</language>
	</row>
	<row id="msg_0723_00864" index="864">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Combattons avec classe et élégance!</language>
	</row>
	<row id="msg_0723_00865" index="865">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, truculent!\r</language>
	</row>
	<row id="msg_0723_00866" index="866">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma foi, tu te défends bien!\r</language>
	</row>
	<row id="msg_0723_00867" index="867">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tout combat comprend aussi\nune part de hasard.</language>
	</row>
	<row id="msg_0723_00868" index="868">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu comprends?\nOn gagne quand on gagne.\r</language>
	</row>
	<row id="msg_0723_00869" index="869">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu comprends?\nOn perd quand on perd.\r</language>
	</row>
	<row id="msg_0723_00870" index="870">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En ce moment, rien ne se\npasse comme je le voudrais.</language>
	</row>
	<row id="msg_0723_00871" index="871">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Youpi!\nTout s’est passé comme je le voulais!\r</language>
	</row>
	<row id="msg_0723_00872" index="872">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vois...\r</language>
	</row>
	<row id="msg_0723_00873" index="873">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu ne peux pas m’échapper!</language>
	</row>
	<row id="msg_0723_00874" index="874">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un résultat prévisible!\r</language>
	</row>
	<row id="msg_0723_00875" index="875">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon vent!\r</language>
	</row>
	<row id="msg_0723_00876" index="876">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Qu’il pleuve ou qu’il vente, j’attends\nqu’un bon Dresseur passe par ici.</language>
	</row>
	<row id="msg_0723_00877" index="877">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et tout ça m’a rendue très forte...\r</language>
	</row>
	<row id="msg_0723_00878" index="878">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon, je vais plutôt attendre un\nDresseur moins fort.\r</language>
	</row>
	<row id="msg_0723_00879" index="879">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je me protège du soleil\navec cette ombrelle.</language>
	</row>
	<row id="msg_0723_00880" index="880">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis une combattante féroce, mais le\nsoleil est plus fort que moi...\r</language>
	</row>
	<row id="msg_0723_00881" index="881">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je n’ai pas envie d’attraper\ndes coups de soleil.\r</language>
	</row>
	<row id="msg_0723_00882" index="882">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tiens, quel Pokémon étrange...</language>
	</row>
	<row id="msg_0723_00883" index="883">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je n’avais jamais vu un Pokémon pareil.\nIl doit être très rare.\r</language>
	</row>
	<row id="msg_0723_00884" index="884">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, mais tu es un Dresseur?\nJe pensais que tu étais un Pokémon!\r</language>
	</row>
	<row id="msg_0723_00885" index="885">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK?</language>
	</row>
	<row id="msg_0723_00886" index="886">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cool.\r</language>
	</row>
	<row id="msg_0723_00887" index="887">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bye-bye.\r</language>
	</row>
	<row id="msg_0723_00888" index="888">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Toi, me battre?\nReviens dans une dizaine d’années!</language>
	</row>
	<row id="msg_0723_00889" index="889">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aucune fierté!\r</language>
	</row>
	<row id="msg_0723_00890" index="890">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as un don!\nTu es une source d’inspiration!\r</language>
	</row>
	<row id="msg_0723_00891" index="891">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Toutes ces odeurs de fleurs...\nÇa me donne envie de faire la sieste.</language>
	</row>
	<row id="msg_0723_00892" index="892">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouaaaah...\nOh? C’est déjà fini?\r</language>
	</row>
	<row id="msg_0723_00893" index="893">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouaaaah...\nJ’ai perdu? Mince...\r</language>
	</row>
	<row id="msg_0723_00894" index="894">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu crois vraiment être à la hauteur?\nJe suis une Star gigagalactique!</language>
	</row>
	<row id="msg_0723_00895" index="895">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ne sois pas triste. Je suis une\nStar gigagalactique, après tout.\r</language>
	</row>
	<row id="msg_0723_00896" index="896">
		<attribute name="window_context_name">used</attribute>
		<language name="English">T’es carrément supragalactique!\r</language>
	</row>
	<row id="msg_0723_00897" index="897">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne vis que pour les combats. Gagner\nme fait tellement plaisir...</language>
	</row>
	<row id="msg_0723_00898" index="898">
		<attribute name="window_context_name">used</attribute>
		<language name="English">... C’était couru d’avance.\r</language>
	</row>
	<row id="msg_0723_00899" index="899">
