<?xml version="1.0"?>
<body language="English">
	<row id="msg_0563_T22R0701_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça fait longtemps que je n’ai pas vu\nquelqu’un qui venait de Doublonville...</language>
	</row>
	<row id="msg_0563_T22R0701_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Beaucoup de gens viennent de Rosalia et\nde Doublonville, c’est bien mieux!</language>
	</row>
	<row id="msg_0563_T22R0701_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Même les plantes sont vivantes...\nEt parfois, elles peuvent même bouger!</language>
	</row>
</body>
