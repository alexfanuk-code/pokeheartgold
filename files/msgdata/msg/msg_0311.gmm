<?xml version="1.0"?>
<body language="English">
	<row id="msg_0311_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’espoir du moment!\nNe vous fiez pas à leur douceur!\r</language>
	</row>
	<row id="msg_0311_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils ne font pas l’école buissonnière!\nLe sport, c’est leur vie!\r</language>
	</row>
	<row id="msg_0311_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils grandissent ensemble!\nEt deviennent plus fort ensemble!\r</language>
	</row>
	<row id="msg_0311_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arriverez-vous à les suivre?\nOn les appelle... “La Bourrasque”!\r</language>
	</row>
	<row id="msg_0311_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Courez! Volez! Filez telle la bise! Sa\nlégende claquera au vent de l’histoire!\r</language>
	</row>
	<row id="msg_0311_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La force sous la douceur...\nVous allez voir, elle va vous montrer...\r</language>
	</row>
	<row id="msg_0311_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sa devise: C’est notre équipe!\nNotre force!\r</language>
	</row>
	<row id="msg_0311_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La force, c’est le pouvoir; le pouvoir,\nc’est la force! Toujours plus haut!\r</language>
	</row>
	<row id="msg_0311_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les avez-vous déjà vus en action?\nEux et leur force terrifiante?\r</language>
	</row>
	<row id="msg_0311_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous allez découvrir...\nLa force de ses Pokémon!\r</language>
	</row>
	<row id="msg_0311_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’amitié et l’amour des Pokémon!\nAvec eux, impossible de perdre!\r</language>
	</row>
	<row id="msg_0311_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils l’ont toujours protégée!\nIls ne peuvent pas perdre!\r</language>
	</row>
	<row id="msg_0311_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Pokémon Insecte s’adaptent à\ntout! Et eux savent tout sur tout!\r</language>
	</row>
	<row id="msg_0311_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils ont la précision d’une horloge!\nLe résultat est couru d’avance.\r</language>
	</row>
	<row id="msg_0311_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Connaissez-vous la technique\nextraordinaire de ces Pokémon?\r</language>
	</row>
	<row id="msg_0311_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Leur amitié indestructible les mènera\nà la victoire!\r</language>
	</row>
	<row id="msg_0311_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Des cris et des larmes de joie!\nPour les meilleurs des sportifs!\r</language>
	</row>
	<row id="msg_0311_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Avec ces 5 années passées dans la\nmontagne... Leur amitié est éternelle!\r</language>
	</row>
	<row id="msg_0311_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Leur technique est parfaite. Ils vivent\npour elle! Et pour le Pokéathlon!\r</language>
	</row>
	<row id="msg_0311_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils savent déjà comment ça se finira...\nParce qu’ils ne peuvent PAS perdre!\r</language>
	</row>
	<row id="msg_0311_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ses Pokémon peuvent voler partout!\n... Même par delà l’arc-en-ciel!\r</language>
	</row>
	<row id="msg_0311_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vers la victoire... et au-delà!\r</language>
	</row>
	<row id="msg_0311_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pourquoi ils sautent si haut? Parce\nqu’ils ne peuvent pas faire autrement!\r</language>
	</row>
	<row id="msg_0311_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Leur aventure commence à peine!! Vous\nallez voir jusqu’où ils peuvent aller!\r</language>
	</row>
	<row id="msg_0311_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voler pour vivre!\nC’est leur seconde nature!\r</language>
	</row>
	<row id="msg_0311_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Impossible de rivaliser avec eux!\nIls sont plus rapides que la lumière!\r</language>
	</row>
	<row id="msg_0311_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Votre Champion préféré! Elle assure\ntoujours autant avec ses Pokémon!\r</language>
	</row>
	<row id="msg_0311_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’espoir du moment, le retour!\nCette fois, douceur, vitesse et force!\r</language>
	</row>
	<row id="msg_0311_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Personne ne peut les rattraper!\nMême l’éclair se traîne derrière eux!\r</language>
	</row>
	<row id="msg_0311_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Courez! Leur Médaille sera comme leur\namitié! En or!\r</language>
	</row>
	<row id="msg_0311_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Après la télé, le stade! Castor, votre\nstar préférée, et ses Pokémon!\r</language>
	</row>
	<row id="msg_0311_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Venue exprès de Sinnoh, voici l’adorable\net courageuse Mélina, et ses Pokémon!\r</language>
	</row>
	<row id="msg_0311_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La force ET la douceur, vous n’allez\npas en revenir cette fois!\r</language>
	</row>
	<row id="msg_0311_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oubliez les livres et les jeux vidéo!\nÇa c’est la réalité!\r</language>
	</row>
	<row id="msg_0311_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La force, c’est la justice!\nC’est la preuve de l’amitié!\r</language>
	</row>
	<row id="msg_0311_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Son habileté est innée!\nCe génie assurera sa victoire!\r</language>
	</row>
	<row id="msg_0311_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">“L’amitié? Si tu veux... Nous, nous ne\nfaisons qu’un!” disent-ils.\r</language>
	</row>
	<row id="msg_0311_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils la protègent toujours!\nIls ne peuvent pas perdre!\r</language>
	</row>
	<row id="msg_0311_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Danse éblouissante, victoire éclatante!\nKomomo et ses Pokémon, de Rosalia!\r</language>
	</row>
	<row id="msg_0311_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Est-ce une illusion?\nNon, ils sont bien l’habileté incarnée!\r</language>
	</row>
	<row id="msg_0311_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Champion d’Acier, pour vous servir!\nEt ses Pokémon à la volonté inoxydable!\r</language>
	</row>
	<row id="msg_0311_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils pètent le feu! La fatigue, connaît\npas! D’où leur vient cette endurance?\r</language>
	</row>
	<row id="msg_0311_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La victoire est assurée à 100%!\nLeurs calculs sont infaillibles!\r</language>
	</row>
	<row id="msg_0311_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le matin... préparation! Le midi...\nexercice! Le soir... ENTRAINEMENT!\r</language>
	</row>
	<row id="msg_0311_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Leur devise... “On y était...\nParce qu’on ne connait pas la fatigue!”\r</language>
	</row>
	<row id="msg_0311_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Leur nouvelle dimension,\nc’est l’amitié!\r</language>
	</row>
	<row id="msg_0311_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Boing! Boing! La gravité n’ose pas\ns’approcher d’eux!\r</language>
	</row>
	<row id="msg_0311_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est le Champion aérien! Les Pokémon\nde son père l’accompagnent!\r</language>
	</row>
	<row id="msg_0311_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous allez voir jusqu’où ils peuvent\naller! Ensemble, tout est possible!\r</language>
	</row>
	<row id="msg_0311_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En-dessous d’eux... le ciel.\nAu-dessus... l’infini!\r</language>
	</row>
</body>
