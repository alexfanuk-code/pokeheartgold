<?xml version="1.0"?>
<body language="English">
	<row id="msg_0527_T10R0601_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Peter: Je t’attendais!\r{STRVAR_1 3, 0, 0}!\rJe savais que tu allais finir par\narriver jusqu’ici.\rBon. Assez parlé!\rNous allons juste nous battre pour\nsavoir qui est le plus fort.\rJe suis le Dresseur le plus puissant!\nLe Maître de la Ligue!\rL’expert Dracologue!\nEn garde!\r</language>
	</row>
	<row id="msg_0527_T10R0601_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Peter: Je t’attendais!\r{STRVAR_1 3, 0, 0}!\rJe savais que tu allais finir par\narriver jusqu’ici.\rBon. Assez parlé!\rNous allons juste nous battre pour\nsavoir qui est le plus fort.\rJe suis le Dresseur le plus puissant!\nLe Maître de la Ligue!\rL’expert Dracologue!\nEn garde!\r</language>
	</row>
	<row id="msg_0527_T10R0601_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">... Eh bien...\rTu as bien progressé, {STRVAR_1 3, 0, 0}.\rToi et ton équipe êtes en parfaite\nharmonie.\rJe suis sûr que vous continuerez à\nprogresser encore...\r</language>
	</row>
	<row id="msg_0527_T10R0601_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">... Eh bien...\rTu as bien progressé, {STRVAR_1 3, 0, 0}.\rToi et ton équipe êtes en parfaite\nharmonie.\rJe suis sûr que vous continuerez à\nprogresser encore...\r</language>
	</row>
	<row id="msg_0527_T10R0601_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...!\r</language>
	</row>
	<row id="msg_0527_T10R0601_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lula: Oh, non! C’est fini!\nC’est votre faute, Professeur!\r</language>
	</row>
	<row id="msg_0527_T10R0601_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chen: Ah, {STRVAR_1 3, 0, 0}!\nÇa faisait bien longtemps.\rTu as changé, ma parole!\nTa victoire sur la Ligue est,\fma foi, impressionnante!\rTon amour et ton dévouement t’ont\nmené jusque-là.\rTon équipe Pokémon a aussi fait\ndu beau boulot.\rTu es reconnu comme étant un\nêtre et un Dresseur d’exception.\rEncore bravo, {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0527_T10R0601_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chen: Ah, {STRVAR_1 3, 0, 0}!\nÇa faisait bien longtemps.\rTu as changé, ma parole!\nTa victoire sur la Ligue est,\fma foi, impressionnante!\rTon amour et ton dévouement t’ont\nmenée jusque-là.\rTon équipe Pokémon a aussi fait\ndu beau boulot.\rTu es reconnue comme étant un\nêtre et un Dresseur d’exception.\rEncore bravo, {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0527_T10R0601_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lula: Faisons une interview du\nnouveau Maître!\r</language>
	</row>
	<row id="msg_0527_T10R0601_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Peter: Eh bien, quelle animation\ntout d’un coup...\r{STRVAR_1 3, 0, 0}!\nSuis-moi!\r</language>
	</row>
	<row id="msg_0527_T10R0601_00010" index="10">
