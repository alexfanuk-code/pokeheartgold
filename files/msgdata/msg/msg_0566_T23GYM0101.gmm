<?xml version="1.0"?>
<body language="English">
	<row id="msg_0566_T23GYM0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salut, toi!\rCette Arène est un gigantesque nid de\nPokémon Insecte construit par Hector!\rIl est encore jeune, mais personne ne\nl’égale dans son domaine!\rTu auras bien besoin de conseils!\nPar exemple...\rLes Pokémon Insecte détestent le feu!\nEt les capacités de type Vol sont\fsuper efficaces ici!</language>
	</row>
	<row id="msg_0566_T23GYM0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bravo!\nUn magnifique combat de deux jeunes\fDresseurs...\rL’avenir du monde des Pokémon est\nentre de bonnes mains!</language>
	</row>
	<row id="msg_0566_T23GYM0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arène d’Ecorcia</language>
	</row>
	<row id="msg_0566_T23GYM0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arène d’Ecorcia\rChampion: Hector\nDresseur estimé:\f{STRVAR_1 3, 0, 0}</language>
	</row>
</body>
