<?xml version="1.0"?>
<body language="English">
	<row id="msg_0052_D10R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous n’avez pas encore capturé tous\nles Pokémon, mais...\rVoulez-vous abandonner\nle Show Capture? {YESNO 0}</language>
	</row>
	<row id="msg_0052_D10R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vois...\rJe suis triste de vous voir abandonner.\nVous ferez mieux la prochaine fois!\r</language>
	</row>
	<row id="msg_0052_D10R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est le bon esprit, {STRVAR_1 3, 0, 0}!\nVotre détermination me plaît!</language>
	</row>
	<row id="msg_0052_D10R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est le bon esprit, {STRVAR_1 3, 0, 0}!\nJ’apprécie votre détermination!</language>
	</row>
	<row id="msg_0052_D10R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ding dong!\nFélicitations!\r{STRVAR_1 3, 0, 0} a réussi à \ncapturer les Pokémon!\r</language>
	</row>
	<row id="msg_0052_D10R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous abandonner?</language>
	</row>
	<row id="msg_0052_D10R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lançons le compte à rebours!</language>
	</row>
	<row id="msg_0052_D10R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trois...</language>
	</row>
	<row id="msg_0052_D10R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Deux...</language>
	</row>
	<row id="msg_0052_D10R0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un...</language>
	</row>
	<row id="msg_0052_D10R0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Partez!</language>
	</row>
</body>
