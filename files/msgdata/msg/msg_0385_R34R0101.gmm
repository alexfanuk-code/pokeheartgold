<?xml version="1.0"?>
<body language="English">
	<row id="msg_0385_R34R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Célesta: Mamie!\rJe te présente {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0385_R34R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hoho... Ma petite-fille a un petit\nami...? Héhé, c’est bien la jeunesse!\r</language>
	</row>
	<row id="msg_0385_R34R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Célesta: Mais Ma...\nTu racontes n’importe quoi!\rÇa n’a rien à voir, c’est juste\nun voisin qui...\r</language>
	</row>
	<row id="msg_0385_R34R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je comprends, je comprends...\nSi tu l’as amené ici, c’est qu’il\fdoit être très doué.\rDans ce cas, {STRVAR_1 3, 0, 0},\nreviens quand tu veux!\r</language>
	</row>
	<row id="msg_0385_R34R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Célesta: B-bon!\nEh bien, j’y vais, moi!\r</language>
	</row>
	<row id="msg_0385_R34R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Célesta: Ah!!\nJ’allais oublier!\r</language>
	</row>
	<row id="msg_0385_R34R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Célesta: Tiens!\nC’est mon numéro de Pokématos!\r</language>
	</row>
	<row id="msg_0385_R34R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} a enregistré Célesta\ndans son Pokématos!\r</language>
	</row>
	<row id="msg_0385_R34R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Célesta: Est-ce que tu parles parfois\nau Pokémon qui se promène avec toi?\rSes réactions sont différentes selon là\noù vous êtes: une route, une ville...\rJe les observe toutes et je les note.\nSi tu m’appelles, je t’en dirai plus!\r</language>
	</row>
	<row id="msg_0385_R34R0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Célesta: Mamie!\rOn s’est échangé nos numéros parce\nqu’on est des Dresseurs, hein!\fRien de plus!\r</language>
	</row>
	<row id="msg_0385_R34R0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Luth: Mémé!\rJe te présente {STRVAR_1 3, 0, 0}!\r</language>
	</row>
