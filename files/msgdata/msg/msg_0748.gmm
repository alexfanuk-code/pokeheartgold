	</row>
	<row id="msg_0748_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} apprend {STRVAR_1 6, 1, 0}.\nGénial!\r</language>
