	</row>
	<row id="msg_0748_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">1{PAUSE 20}, 2{PAUSE 20} et...{PAUSE 20} ...{PAUSE 20} ... Tadam!</language>
