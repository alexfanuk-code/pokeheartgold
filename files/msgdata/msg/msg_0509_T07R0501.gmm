	</row>
	<row id="msg_0509_T07R0501_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Puis. Cachée\n6 000 Jetons</language>
	</row>
	<row id="msg_0509_T07R0501_00026" index="26">
		<attribute name="window_context_name">used</attribute>
