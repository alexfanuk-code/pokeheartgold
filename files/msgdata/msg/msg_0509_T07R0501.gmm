	</row>
	<row id="msg_0509_T07R0501_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Giga Impact\n15 000 Jetons</language>
	</row>
	<row id="msg_0509_T07R0501_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mouch. Soie\n1 000 Jetons</language>
	</row>
	<row id="msg_0509_T07R0501_00030" index="30">
