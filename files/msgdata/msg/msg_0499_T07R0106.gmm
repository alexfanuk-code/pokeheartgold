<?xml version="1.0"?>
<body language="English">
	<row id="msg_0499_T07R0106_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La roulette du Distributeur ne permet\nde gagner qu’un lot de 200 $, mais on\fest quand même content quand on gagne!\rEn d’autres termes, le bonheur, ça ne\ndépend pas de la valeur des choses,\fmais de la façon dont on les regarde.</language>
	</row>
	<row id="msg_0499_T07R0106_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dis! Dis!\nY’a pas de jeux ici!\fJe m’ennuie!</language>
	</row>
	<row id="msg_0499_T07R0106_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">5⁴: Espace Détente, pour\nsouffler. Distributeurs à disposition.</language>
	</row>
	<row id="msg_0499_T07R0106_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est un Distributeur.\nQuelle boisson vous fait envie? {YESNO 0}</language>
	</row>
	<row id="msg_0499_T07R0106_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Clang!\rUne canette {STRVAR_1 8, 0, 0} vient\nde tomber.\r</language>
	</row>
	<row id="msg_0499_T07R0106_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Clang!\rBonus! Une autre canette\n{STRVAR_1 8, 0, 0} vient de tomber.\r</language>
	</row>
	<row id="msg_0499_T07R0106_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous n’avez pas assez d’argent...</language>
	</row>
	<row id="msg_0499_T07R0106_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous changez d’avis.</language>
	</row>
</body>
