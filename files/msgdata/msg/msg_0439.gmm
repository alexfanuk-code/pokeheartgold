<?xml version="1.0"?>
<body language="English">
	<row id="msg_0439_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis l’Hôte de la Pension.\rNous bichonnons les Pokémon\nchéris des Dresseurs.\rVa voir ma femme si tu veux\nnous confier tes Pokémon.</language>
	</row>
	<row id="msg_0439_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, c’est toi!\rOn a eu une surprise en élevant tes\nPokémon!\rUn beau matin, l’un d’entre eux est\nvenu avec un Oeuf!\rOn ne sait pas où il l’a trouvé,\nmais c’est celui de ton Pokémon.\rTu comptes le prendre,\nn’est-ce pas? {YESNO 0}</language>
	</row>
	<row id="msg_0439_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, c’est toi! Content de te voir. Ton\n{STRVAR_1 0, 0, 0} se porte comme un charme.</language>
	</row>
	<row id="msg_0439_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dans ce cas, je vais m’en occuper.\nMerci bien!</language>
	</row>
	<row id="msg_0439_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu n’as pas de place, on dirait...\nReviens plus tard.</language>
	</row>
	<row id="msg_0439_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} obtient l’Oeuf de la part\nde l’Hôte de la Pension.</language>
	</row>
	<row id="msg_0439_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Prends-en bien soin!</language>
	</row>
	<row id="msg_0439_00007" index="7">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0439_00008" index="8">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0439_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, c’est toi!\nContent de te voir!\rTon {STRVAR_1 0, 0, 0} et ton {STRVAR_1 0, 1, 0}\nse portent bien.\r</language>
	</row>
	<row id="msg_0439_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais vraiment le garder.\nTu le veux, ou pas? {YESNO 0}</language>
	</row>
	<row id="msg_0439_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Occupe-toi bien de lui!\rMais un Oeuf, quelle surprise\nquand même!...\rOn en trouvera peut-être d’autres,\nqui sait!\r</language>
	</row>
	<row id="msg_0439_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci beaucoup de me le\nlaisser!\rMais un Oeuf, quelle surprise\nquand même!...\rOn en trouvera peut-être d’autres,\nqui sait!\r</language>
	</row>
	<row id="msg_0439_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon p’tit {STRVAR_1 3, 0, 0}...\nLes Pokémon qu’on nous confie\fnous ramènent parfois des Oeufs, et\fnous avons l’habitude d’appeler leur\fDresseur dans ces cas-là. Et\ftoi, voudrais-tu qu’on t’appelle? {YESNO 0}</language>
	</row>
	<row id="msg_0439_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma p’tite {STRVAR_1 3, 0, 0}...\nLes Pokémon qu’on nous confie\fnous ramènent parfois des Oeufs, et\fnous avons l’habitude d’appeler leur\fDresseur dans ces cas-là. Et\ftoi, voudrais-tu qu’on t’appelle? {YESNO 0}\n</language>
	</row>
	<row id="msg_0439_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Parfait!\nTu peux compter sur moi!\rVa voir ma femme si tu veux\nnous confier tes Pokémon.</language>
	</row>
	<row id="msg_0439_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">D’accord, je comprends...\rVa voir ma femme si tu veux\nnous confier tes Pokémon.</language>
	</row>
	<row id="msg_0439_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils ont l’air de très bien s’entendre.</language>
	</row>
	<row id="msg_0439_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils ont l’air de s’entendre.</language>
	</row>
	<row id="msg_0439_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils ont l’air de ne pas s’aimer.</language>
	</row>
	<row id="msg_0439_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils préfèrent jouer chacun\nde leur côté...</language>
	</row>
	<row id="msg_0439_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis l’Hôtesse de la Pension.\rNous pouvons élever des Pokémon\npour toi.\rTu veux qu’on en élève un? {YESNO 0}</language>
	</row>
	<row id="msg_0439_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quel Pokémon veux-tu que l’on élève?\r</language>
	</row>
	<row id="msg_0439_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Très bien, nous allons nous occuper de\n{STRVAR_1 0, 0, 0} pendant quelque temps.\rReviens le chercher plus tard.\r</language>
	</row>
	<row id="msg_0439_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nous pouvons élever deux Pokémon.\nTu veux qu’on en élève un autre? {YESNO 0}</language>
	</row>
	<row id="msg_0439_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, te voilà!\nMon mari te cherchait.</language>
	</row>
	<row id="msg_0439_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, très bien.\nReviens plus tard, dans ce cas.</language>
	</row>
	<row id="msg_0439_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu n’as pas assez d’argent...</language>
	</row>
	<row id="msg_0439_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Veux-tu également récupérer\nl’autre? {YESNO 0}</language>
	</row>
	<row id="msg_0439_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Très bien.\nA une prochaine fois.</language>
	</row>
	<row id="msg_0439_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, c’est toi! Ravie de te voir.\nA propos...\r</language>
	</row>
	<row id="msg_0439_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ton {STRVAR_1 0, 0, 0} est monté\nde {STRVAR_1 51, 1, 0} niveau(x).\r</language>
	</row>
	<row id="msg_0439_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ton équipe Pokémon est au complet.\nFais de la place et reviens me voir.</language>
	</row>
	<row id="msg_0439_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour récupérer ton {STRVAR_1 0, 0, 0},\ntu dois payer {STRVAR_1 53, 1, 0} $. {YESNO 0}</language>
	</row>
	<row id="msg_0439_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Parfait!\nVoilà ton Pokémon.\r</language>
	</row>
	<row id="msg_0439_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 1, 0} reprend le {STRVAR_1 0, 0, 0}\nà l’Hôtesse de la Pension.\r</language>
	</row>
	<row id="msg_0439_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh? Mais tu n’as qu’un Pokémon.\rTu ne peux pas repartir sans Pokémon.\nReviens une autre fois.</language>
	</row>
	<row id="msg_0439_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Veux-tu reprendre ton Pokémon? {YESNO 0}</language>
	</row>
	<row id="msg_0439_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si tu me laisses ce Pokémon, comment\nvas-tu faire pour te battre?\rReviens me voir une autre fois.</language>
	</row>
	<row id="msg_0439_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hein?\nBon.\rSi tu me laisses ce Pokémon, il ne\nt’en restera qu’un.\rJe te conseille d’en attraper\nquelques-uns de plus.</language>
	</row>
	<row id="msg_0439_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voyons, voyons...\nCe n’est qu’un Oeuf!</language>
	</row>
	<row id="msg_0439_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Très bien, nous allons nous occuper de\nton {STRVAR_1 0, 0, 0} pendant quelque\ftemps.\rReviens le chercher plus tard.</language>
	</row>
	<row id="msg_0439_00042" index="42">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
