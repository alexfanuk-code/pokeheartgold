		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0439_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils ont l’air de très bien s’entendre.\r</language>
	</row>
	<row id="msg_0439_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils ont l’air de s’entendre.\r</language>
	</row>
	<row id="msg_0439_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils ont l’air de ne pas s’aimer.\r</language>
	</row>
	<row id="msg_0439_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils préfèrent jouer chacun\nde leur côté...\r</language>
	</row>
