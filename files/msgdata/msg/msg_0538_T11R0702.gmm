<?xml version="1.0"?>
<body language="English">
	<row id="msg_0538_T11R0702_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} est entré dans le moteur.\r{STRVAR_1 0, 0, 0} tente d’apprendre\n{STRVAR_1 6, 1, 0}.\rMais {STRVAR_1 0, 0, 0} ne peut pas\navoir plus de quatre capacités.\rEffacer une ancienne capacité pour\n{STRVAR_1 6, 1, 0}? {YESNO 0}</language>
	</row>
	<row id="msg_0538_T11R0702_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous arrêter d’apprendre\n{STRVAR_1 6, 1, 0}? {YESNO 0}</language>
	</row>
	<row id="msg_0538_T11R0702_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} n’a pas appris\n{STRVAR_1 6, 1, 0}.\r{STRVAR_1 0, 0, 0} sort du moteur.</language>
	</row>
	<row id="msg_0538_T11R0702_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La capacité {STRVAR_1 6, 1, 0} va être\noubliée. Continuer? {YESNO 0}</language>
	</row>
	<row id="msg_0538_T11R0702_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">1,{PAUSE 20} 2{PAUSE 20} et...{PAUSE 20} ...{PAUSE 20} Tadaa!</language>
	</row>
	<row id="msg_0538_T11R0702_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0} ne sait plus comment\nutiliser {STRVAR_1 6, 1, 0}.\rEt...</language>
	</row>
	<row id="msg_0538_T11R0702_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0} apprend {STRVAR_1 6, 1, 0}!</language>
	</row>
	<row id="msg_0538_T11R0702_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quel MOTISMA choisissez-vous?\r</language>
	</row>
	<row id="msg_0538_T11R0702_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un Oeuf ne peut pas entrer\ndans le moteur.</language>
	</row>
	<row id="msg_0538_T11R0702_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce Pokémon ne peut pas entrer\ndans le moteur.</language>
	</row>
	<row id="msg_0538_T11R0702_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} est entré dans le moteur.\r</language>
	</row>
	<row id="msg_0538_T11R0702_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} est sorti du moteur.\r</language>
	</row>
	<row id="msg_0538_T11R0702_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A quel MOTISMA voulez-vous faire\nreprendre sa forme d’origine? {YESNO 0}</language>
	</row>
	<row id="msg_0538_T11R0702_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh? On dirait que MOTISMA veut\nreprendre sa forme d’origine.\rDésirez-vous le rappeler pour qu’il \nsorte du moteur? {YESNO 0}</language>
	</row>
	<row id="msg_0538_T11R0702_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">RAPPELER</language>
	</row>
	<row id="msg_0538_T11R0702_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OUI</language>
	</row>
	<row id="msg_0538_T11R0702_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">NON</language>
	</row>
	<row id="msg_0538_T11R0702_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce MOTISMA n’est pas entré\ndans le moteur.</language>
	</row>
	<row id="msg_0538_T11R0702_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il y avait un appareil électrique au\nmoteur étrange ici.</language>
	</row>
	<row id="msg_0538_T11R0702_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">NON</language>
	</row>
	<row id="msg_0538_T11R0702_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un four à micro-ondes.\nIl est équipé d’un étrange moteur.</language>
	</row>
	<row id="msg_0538_T11R0702_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un four à micro-ondes.\nIl est équipé d’un étrange moteur.\rOh? On dirait que MOTISMA veut entrer\ndans le moteur.\rLe laisser entrer dans le moteur? {YESNO 0}</language>
	</row>
	<row id="msg_0538_T11R0702_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MOTISMA renonce malgré lui à entrer\ndans le moteur du four à micro-ondes...</language>
	</row>
	<row id="msg_0538_T11R0702_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un réfrigérateur.\nIl est équipé d’un étrange moteur.</language>
