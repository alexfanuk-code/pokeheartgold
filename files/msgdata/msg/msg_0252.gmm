<?xml version="1.0"?>
<body language="English">
	<row id="msg_0252_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0} est entré(e).</language>
	</row>
	<row id="msg_0252_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous arrêter de dessiner?</language>
	</row>
	<row id="msg_0252_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0} est parti(e).</language>
	</row>
	<row id="msg_0252_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le meneur, {STRVAR_1 1, 0, 0}, est parti.\nCe groupe va être dissous.</language>
	</row>
	<row id="msg_0252_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si le meneur part, le groupe\nest dissous. Continuer?</language>
	</row>
	<row id="msg_0252_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il n’y a pas de membres.\nLe groupe va être dissous.</language>
	</row>
	<row id="msg_0252_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La séance de dessin est terminée.</language>
	</row>
	<row id="msg_0252_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">QUITTER</language>
	</row>
	<row id="msg_0252_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0}</language>
	</row>
	<row id="msg_0252_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Signez ici!</language>
	</row>
	<row id="msg_0252_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça vous convient?</language>
	</row>
	<row id="msg_0252_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous refaire votre\nsignature?</language>
	</row>
	<row id="msg_0252_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK</language>
	</row>
	<row id="msg_0252_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous rejoignez une séance de dessin!</language>
	</row>
</body>
