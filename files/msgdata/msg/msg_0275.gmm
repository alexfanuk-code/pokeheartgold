	<row id="msg_0275_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le combat du siècle!\n{STRVAR_1 1, 1, 0} a gagné de justesse!</language>
	</row>
	<row id="msg_0275_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le combat du siècle!\nQuelle regrettable erreur sur la fin!</language>
	</row>
	<row id="msg_0275_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 1, 0} tente de lancer un coup\nde semonce... et se casse la figure!</language>
