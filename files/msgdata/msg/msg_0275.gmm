	<row id="msg_0275_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 1, 0} est si vif! {STRVAR_1 1, 3, 0}\nne pouvait pas se rapprocher!</language>
