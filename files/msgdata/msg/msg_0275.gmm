	<row id="msg_0275_00079" index="79">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça fait {STRVAR_1 54, 7, 0} pas!\n{STRVAR_1 1, 1, 0} est super content\nd’avoir tellement marché avec\n{STRVAR_1 3, 0, 0}. On le lit sur son visage!</language>
	</row>
	<row id="msg_0275_00080" index="80">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça fait {STRVAR_1 54, 7, 0} pas!\n{STRVAR_1 1, 1, 0} en est tout frétillant!\nOn dirait qu’il va vous sauter dessus!</language>
	</row>
	<row id="msg_0275_00081" index="81">
