<?xml version="1.0"?>
<body language="English">
	<row id="msg_0705_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sean</language>
	</row>
	<row id="msg_0705_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">T’es fortiche.\nJe n’ai pas vu ça depuis longtemps.\rJe peux avoir ton numéro?\rJ’aimerais encore me battre\nquand j’aurai fini de soigner\fmes Pokémon. {YESNO 0}</language>
	</row>
	<row id="msg_0705_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Comment te battre?\nJe ne pense qu’à ça...</language>
	</row>
	<row id="msg_0705_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je comprends.\nSi tu changes d’avis, reviens me voir.</language>
	</row>
	<row id="msg_0705_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je peux avoir ton numéro?\rJ’aimerais encore me battre\nquand j’aurai fini de soigner\fmes Pokémon. {YESNO 0}</language>
	</row>
	<row id="msg_0705_00005" index="5">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0705_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je t’entends vraiment bien.\nTu es à côté, je me trompe?</language>
	</row>
	<row id="msg_0705_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon {STRVAR_1 0, 10, 0} est plus fort que je\nle pensais.\rIl n’y a pas un seul {STRVAR_1 0, 10, 0} qui\npuisse surpasser le mien!</language>
	</row>
	<row id="msg_0705_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’autre fois, j’ai voulu attraper un\n{STRVAR_1 0, 11, 0}.\rMais il m’a échappé.\nIl faut toujours faire attention.</language>
	</row>
	<row id="msg_0705_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, j’ai eu du mal à battre un\n{STRVAR_1 0, 11, 0} l’autre jour.\rJe n’avais jamais vu de {STRVAR_1 0, 11, 0}\naussi fort...\rOn devrait toujours faire attention.</language>
	</row>
	<row id="msg_0705_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Combat!\nJ’attends sur la {STRVAR_1 4, 3, 0}.\rAppelle si tu es dans le coin.</language>
	</row>
	<row id="msg_0705_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, où es-tu?\rPasse par la {STRVAR_1 4, 3, 0} si\ntu l’oses!\fJe vais t’écraser!</language>
	</row>
	<row id="msg_0705_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, où es-tu?\rPasse par la {STRVAR_1 4, 3, 0} si\ntu l’oses!\fJe vais t’écraser!</language>
	</row>
	<row id="msg_0705_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je n’ai pas oublié ton talent.\nJe réfléchis au moyen de te battre\fchaque jour, ça m’obsède...</language>
	</row>
</body>
