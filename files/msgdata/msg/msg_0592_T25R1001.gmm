<?xml version="1.0"?>
<body language="English">
	<row id="msg_0592_T25R1001_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue au Centre Commercial\nde Doublonville!</language>
	</row>
	<row id="msg_0592_T25R1001_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce Centre Commercial a toutes sortes\nde produits.\rMais il y a dans cette ville des objets\nque l’on ne peut gagner qu’au Casino.</language>
	</row>
	<row id="msg_0592_T25R1001_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Qu’est-ce que la Team Rocket a à faire\ndans un Centre Commercial!\rOn ne vend pas d’uniformes\nridicules, ici!</language>
	</row>
	<row id="msg_0592_T25R1001_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais encore faire plein de shopping\naujourd’hui!</language>
	</row>
	<row id="msg_0592_T25R1001_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je me fiche de vos Team Rocket ou\nPocket, hors de mon chemin!\rJe ne permets à personne de m’empêcher\nde faire mon shopping!</language>
	</row>
	<row id="msg_0592_T25R1001_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Maman est la reine des courses!\rElle achète toujours les trucs\nun peu moins chers!</language>
	</row>
	<row id="msg_0592_T25R1001_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma maman m’a dit de ne pas m’approcher\ndes gens habillés tout en noir.</language>
	</row>
	<row id="msg_0592_T25R1001_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">RC: Accueil\n1¹: Boutique du Dresseur\f2⁴: Collection de Combat\f3⁴: Pharmacie\f4⁴: Le Coin des CT\f5⁴: Coin tranquille</language>
	</row>
</body>
