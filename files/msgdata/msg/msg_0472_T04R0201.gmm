	<row id="msg_0472_T04R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On raconte qu’un drôle de type\nrôde dans le coin.\rSi c’est un voleur, il va\nentendre parler de moi!</language>
