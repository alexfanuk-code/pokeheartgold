<?xml version="1.0"?>
<body language="English">
	<row id="msg_0598_T25R1007_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bonjour, merci de faire vos courses\ndans notre établissement.\rA quel étage voulez-vous accéder? {YESNO 0}</language>
	</row>
	<row id="msg_0598_T25R1007_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nous espérons vous revoir bientôt.</language>
	</row>
	<row id="msg_0598_T25R1007_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Certainement.\nNous montons.\r</language>
	</row>
	<row id="msg_0598_T25R1007_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Certainement.\nNous descendons.\r</language>
	</row>
	<row id="msg_0598_T25R1007_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nous sommes déjà à cet étage?!</language>
	</row>
	<row id="msg_0598_T25R1007_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rez-de-chaussée: Accueil\net hall principal.</language>
	</row>
	<row id="msg_0598_T25R1007_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">1¹ étage: Votre compagnon de\nvoyage, la Boutique du Dresseur!</language>
	</row>
	<row id="msg_0598_T25R1007_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">2⁴ étage: Gagnez vos combats grâce\nà la Collection de Combat!</language>
	</row>
	<row id="msg_0598_T25R1007_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">3⁴ étage: Améliorez vos Pokémon\nà la pharmacie!</language>
	</row>
	<row id="msg_0598_T25R1007_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">4⁴ étage: Les Pokémon comme on les\naime au Coin des CT!</language>
	</row>
	<row id="msg_0598_T25R1007_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">5⁴ étage: Faites une pause pendant\nvos courses au Coin tranquille!</language>
	</row>
	<row id="msg_0598_T25R1007_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il n’y a que l’entrepôt au sous-sol.\nJe ne pense pas que ça vous intéresse.</language>
	</row>
</body>
