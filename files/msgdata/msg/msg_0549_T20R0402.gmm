	<row id="msg_0549_T20R0402_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il y a une console Wii!\rElle est populaire même à Johto!</language>
	</row>
	<row id="msg_0549_T20R0402_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce n’est pas bien de toucher\nau PC d’autrui!</language>
