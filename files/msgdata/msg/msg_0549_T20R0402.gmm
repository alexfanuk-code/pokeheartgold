<?xml version="1.0"?>
<body language="English">
	<row id="msg_0549_T20R0402_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Célesta: {STRVAR_1 3, 0, 0}!\rLe Professeur Orme te faisait chercher,\ntu es déjà allé à son Laboratoire?</language>
	</row>
	<row id="msg_0549_T20R0402_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Luth: {STRVAR_1 3, 0, 0}!\rLe Professeur Orme te faisait chercher,\ntu es déjà allée à son Laboratoire?</language>
	</row>
	<row id="msg_0549_T20R0402_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Célesta: Mon MARILL est absolument\nadorable, mais...\fJe dois avouer que ton {STRVAR_1 0, 1, 0}\fest pas mal non plus!</language>
	</row>
	<row id="msg_0549_T20R0402_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Luth: Mon MARILL est vraiment\nbien, mais...\fJe dois avouer que ton {STRVAR_1 0, 1, 0}\fest pas mal non plus!</language>
	</row>
	<row id="msg_0549_T20R0402_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MARILL: Marimari!</language>
	</row>
	<row id="msg_0549_T20R0402_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Célesta: C’est étrange, non?\rQuand on se balade avec son Pokémon,\nmême les courses deviennent amusantes!\r{STRVAR_1 3, 0, 0}...\rPromène ton Pokémon dans autant\nd’endroits que possible!\rEt parle-lui, de temps à autre! Il y a\nplein de choses à découvrir comme ça!</language>
	</row>
	<row id="msg_0549_T20R0402_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Luth: C’est étrange, non?\rQuand on se balade avec son Pokémon,\nmême les courses deviennent amusantes!\r{STRVAR_1 3, 0, 0}...\rPromène ton Pokémon dans autant\nd’endroits que possible!\rEt parle-lui, de temps à autre! Il y a\nplein de choses à découvrir comme ça!</language>
	</row>
	<row id="msg_0549_T20R0402_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Célesta: Ah! {STRVAR_1 3, 0, 0}!\nComment vont tes Pokémon?\fParle-leur, de temps en temps...\rTiens? Ce Pokémon a l’air de tenir\nune feuille de quelque chose...\rÇa ne serait quand même pas...\nune Feuille d’Or?\rOn raconte que seuls les Pokémon qui\nont tissé des liens d’amitié profonds\favec leur Dresseur peuvent\fen trouver une...\rEt on dit aussi que si tu en trouves 5,\ntu peux en faire une magnifique\fcouronne...\rC’est incroyable!\nBravo, {STRVAR_1 3, 0, 0}!\rSi tu en trouves une autre, n’oublie\npas de venir me la montrer!</language>
	</row>
	<row id="msg_0549_T20R0402_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Luth: Ah! {STRVAR_1 3, 0, 0}!\nComment vont tes Pokémon?\fParle-leur, de temps en temps...\rTiens? Ce Pokémon a l’air de tenir\nune feuille de quelque chose...\rÇa ne serait quand même pas...\nune Feuille d’Or?\rOn raconte que seuls les Pokémon qui\nont tissé des liens d’amitié profonds\favec leur Dresseur peuvent\fen trouver une...\rEt on dit aussi que si tu en trouves 5,\ntu peux en faire une magnifique\fcouronne...\rC’est incroyable!\nBravo, {STRVAR_1 3, 0, 0}!\rSi tu en trouves une autre, n’oublie\npas de venir me la montrer!</language>
	</row>
	<row id="msg_0549_T20R0402_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Célesta: Ah! {STRVAR_1 3, 0, 0}!\nComment vont tes Pokémon?\rParle-leur, de temps en temps...\nÇa renforcera vos liens!\r...\rWah!\nIl a encore une Feuille d’Or!\rEuh... Donc...\nça t’en fait déjà {STRVAR_1 50, 1, 0}!\fTu te débrouilles vraiment très bien!\rCourage! Essaye d’en trouver\nencore {STRVAR_1 50, 2, 0}!</language>
	</row>
	<row id="msg_0549_T20R0402_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Luth: Ah! {STRVAR_1 3, 0, 0}!\nComment vont tes Pokémon?\rParle-leur, de temps en temps...\nÇa renforcera vos liens!\r...\rWah!\nIl a encore une Feuille d’Or!\rEuh... Donc...\nça t’en fait déjà {STRVAR_1 50, 1, 0}!\fTu te débrouilles vraiment très bien!\rCourage! Essaye d’en trouver\nencore {STRVAR_1 50, 2, 0}!</language>
	</row>
	<row id="msg_0549_T20R0402_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Célesta: Ah! {STRVAR_1 3, 0, 0}!\nComment vont tes Pokémon?\rParle-leur, de temps en temps...\nÇa renforcera vos liens!\r...\rWah!\nÇa y est, tu en as trouvé 5!\rAlors, laisse-moi faire! Je vais te faire\nune couronne avec tes Feuilles d’Or!\rEt en plus...\rTiens! En souvenir!\r</language>
	</row>
	<row id="msg_0549_T20R0402_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Luth: Ah! {STRVAR_1 3, 0, 0}!\nComment vont tes Pokémon?\rParle-leur, de temps en temps...\nÇa renforcera vos liens!\r...\rWah!\nÇa y est, tu en as trouvé 5!\rAlors, laisse-moi faire! Je vais te faire\nune couronne avec tes Feuilles d’Or!\rEt en plus...\rTiens! En souvenir!\r</language>
	</row>
	<row id="msg_0549_T20R0402_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Célesta: Continue à prendre bien soin\nde tes Pokémon!</language>
	</row>
	<row id="msg_0549_T20R0402_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Luth: Continue à prendre bien soin\nde tes Pokémon!</language>
	</row>
	<row id="msg_0549_T20R0402_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Célesta: Ah! {STRVAR_1 3, 0, 0}!\nComment vont tes Pokémon?\rParle-leur, de temps en temps...\nÇa renforcera vos liens!\r...\rAh, bien sûr.\nTu viens vérifier le palmarès\fde {STRVAR_1 1, 1, 0}?\r</language>
	</row>
	<row id="msg_0549_T20R0402_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Luth: Ah! {STRVAR_1 3, 0, 0}!\nComment vont tes Pokémon?\rParle-leur, de temps en temps...\nÇa renforcera vos liens!\r...\rAh, bien sûr.\nTu viens vérifier le palmarès\fde {STRVAR_1 1, 1, 0}?\r</language>
