<?xml version="1.0"?>
<body language="English">
	<row id="msg_0348_R12_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Route 12\nNord: Lavanville</language>
	</row>
	<row id="msg_0348_R12_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous vous trouvez sur\nun célèbre lieu de pêche.\rOn appelle cet ensemble d’appontements\n“le Pont Silence”, car chacun ici\fmarche en silence pour ne pas\feffrayer les Pokémon dans l’eau.</language>
	</row>
	<row id="msg_0348_R12_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">... Un énorme Pokémon dort\npaisiblement. Il a l’air\fd’apprécier son somme!</language>
	</row>
	<row id="msg_0348_R12_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...!\rRONFLEX ouvre les yeux!\r</language>
	</row>
</body>
