<?xml version="1.0"?>
<body language="English">
	<row id="msg_0494_T07R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue au Centre Commercial\nde Céladopole!\rLes informations sont sur le mur.</language>
	</row>
	<row id="msg_0494_T07R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce Centre Commercial appartient à la\nmême chaîne que celui de Doublonville.\rIls ont été rénovés en même temps.</language>
	</row>
	<row id="msg_0494_T07R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est la première fois que je viens ici.\nC’est grand...\rJe vais me perdre.\nC’est sûr.</language>
	</row>
	<row id="msg_0494_T07R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">RC: Comptoir service\n1¹: Marché du Dresseur\f2⁴: Marché aux CT\f3⁴: Cadeaux du Sage\f4⁴: Pharmacie\f5⁴: Espace Détente</language>
	</row>
</body>
