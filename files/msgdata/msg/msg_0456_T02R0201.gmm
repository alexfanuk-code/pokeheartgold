<?xml version="1.0"?>
<body language="English">
	<row id="msg_0456_T02R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Est-ce que tu réfléchis assez avant\nde donner un surnom à un Pokémon?\rEn leur donnant des noms intéressants,\ntu rendras les échanges avec d’autres\fDresseurs encore plus amusants!</language>
	</row>
	<row id="msg_0456_T02R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon PIAFABEC s’appelle Piaffy,\net mon RATTATA s’appelle Rattatami!</language>
	</row>
	<row id="msg_0456_T02R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Piaffy: Piaaaa!</language>
	</row>
	<row id="msg_0456_T02R0201_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rattatami: Rataaa!</language>
	</row>
</body>
