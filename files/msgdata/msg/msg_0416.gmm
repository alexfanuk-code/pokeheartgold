<?xml version="1.0"?>
<body language="English">
	<row id="msg_0416_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Musique Pokémon</language>
	</row>
	<row id="msg_0416_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ben</language>
	</row>
	<row id="msg_0416_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">DJ Ben: C’est moi, DJ Ben, pour\nMusique Pokémon!</language>
	</row>
	<row id="msg_0416_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est un super dimanche aujourd’hui!\nPour tous les potes, voici un album\nd’enfer plein de souvenirs!</language>
	</row>
	<row id="msg_0416_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour un lundi en pleine forme, voici la\nFanfare Pokémon!</language>
	</row>
	<row id="msg_0416_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aujourd’hui, mardi!\nUne Berceuse Pokémon pour nos p’tits\nPokémon chéris endormis.</language>
	</row>
	<row id="msg_0416_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour un mercredi en pleine forme, voici la\nFanfare Pokémon!</language>
	</row>
	<row id="msg_0416_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aujourd’hui, jeudi!\nUne Berceuse Pokémon pour nos p’tits\nPokémon chéris endormis.</language>
	</row>
	<row id="msg_0416_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour un vendredi en pleine forme, voici la\nFanfare Pokémon!</language>
	</row>
	<row id="msg_0416_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aujourd’hui, samedi!\nUne Berceuse Pokémon pour nos p’tits\nPokémon chéris endormis.</language>
	</row>
	<row id="msg_0416_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce mercredi, Musique Pokémon\nvous fait goûter au son de Hoenn!\nQui sait, les Pokémon de Hoenn vont\npeut-être répondre à l’appel!</language>
	</row>
	<row id="msg_0416_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce jeudi, Musique Pokémon\nvous fait goûter au son de Sinnoh!\nQui sait, les Pokémon de Sinnoh vont\npeut-être répondre à l’appel!</language>
	</row>
	<row id="msg_0416_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour un dimanche en pleine forme, voici la\nFanfare Pokémon!</language>
	</row>
</body>
