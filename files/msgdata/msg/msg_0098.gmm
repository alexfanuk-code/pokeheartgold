<?xml version="1.0"?>
<body language="English">
	<row id="msg_0098_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci d’avoir participé!\rJe vais sauvegarder votre partie.\nVeuillez ne pas éteindre.</language>
	</row>
	<row id="msg_0098_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A une prochaine fois peut-être!</language>
	</row>
	<row id="msg_0098_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nous allons soigner vos Pokémon.</language>
	</row>
	<row id="msg_0098_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’équipe adverse numéro {STRVAR_1 50, 0, 0} est prête.\nQue voulez-vous faire?</language>
	</row>
	<row id="msg_0098_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous sauvegarder et \ninterrompre votre progression?</language>
	</row>
	<row id="msg_0098_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous annuler votre défi?</language>
	</row>
	<row id="msg_0098_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous enregistrer la vidéo du\ndernier combat sur le Magnéto VS?</language>
	</row>
	<row id="msg_0098_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le combat de {STRVAR_1 3, 0, 0} a été\nenregistré en tant que Vidéo de combat.\r</language>
	</row>
	<row id="msg_0098_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une erreur est survenue.\nLa sauvegarde a échoué.\r</language>
	</row>
	<row id="msg_0098_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Effacer la Vidéo de combat précédente\npour enregistrer ce combat?</language>
	</row>
	<row id="msg_0098_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sauvegarde en cours...\nNe pas éteindre.</language>
	</row>
	<row id="msg_0098_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le défi a été abandonné.</language>
	</row>
	<row id="msg_0098_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En attente de la réponse\nd’un(e) ami(e)...</language>
	</row>
	<row id="msg_0098_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Félicitations! Vous avez gagné sept\ncombats consécutifs!\rPour célébrer votre victoire, nous vous\noffrons des Points de Combat!\r</language>
	</row>
	<row id="msg_0098_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} obtient {STRVAR_1 51, 1, 0} PCo!\r</language>
	</row>
	<row id="msg_0098_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sauvegarde en cours...\nNe pas éteindre.</language>
	</row>
	<row id="msg_0098_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci de patienter.</language>
	</row>
</body>
