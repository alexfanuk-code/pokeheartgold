<?xml version="1.0"?>
<body language="English">
	<row id="msg_0644_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blanche</language>
	</row>
	<row id="msg_0644_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hein?\nOn n’entend que dalle!\rRéessaye d’un autre endroit!</language>
	</row>
	<row id="msg_0644_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô?\nOui?\fMoi je pète la forme!\r</language>
	</row>
	<row id="msg_0644_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Y’a plein d’autres Champions\nqui déchirent!\fFais gaffe!</language>
	</row>
	<row id="msg_0644_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moi, c’est d’acc’ pour le samedi\nen journée!\fPhone-moi ce jour-là!</language>
	</row>
	<row id="msg_0644_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais j’suis trop open là!\nOn s’fait un p’tit match retour? {YESNO 0}</language>
	</row>
	<row id="msg_0644_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">T’as intérêt à venir, hein!\rJ’t’attends au Dojo de Safrania!</language>
	</row>
	<row id="msg_0644_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais euh!\nTrop moche, ça!</language>
	</row>
	<row id="msg_0644_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">T’es libre?\rArrête tes salades, t’as plein d’autres\nmatches de prévus!</language>
	</row>
	<row id="msg_0644_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’t’attends au Dojo de Safrania!\nT’as pas intérêt à avoir un autre\ftruc de prévu!</language>
	</row>
	<row id="msg_0644_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouais, c’est Blanche.\nÇa boume?\r</language>
	</row>
	<row id="msg_0644_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un match au Dojo de Safrania, OK?\nOublie pas, hein! Promis juré craché!</language>
	</row>
	<row id="msg_0644_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu connais le Ranch Meumeu sur\nla Route 39?\rMon p’tit Crémouh... - C’est mon\nECREMEUH - vient de là-bas.</language>
	</row>
	<row id="msg_0644_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je crève la dalle!\nPas toi?\rMais non je mange pas de trop!\nTu verras, quand tu auras mon âge!</language>
	</row>
	<row id="msg_0644_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le plus mignon du Conseil 4?\nAldo, non?\rJ’suis pas la seule à le penser!\nY’en a plein d’autres qui pensent\fpareil!\fUn mec baraqué, y’a que ça de vrai!</language>
	</row>
</body>
