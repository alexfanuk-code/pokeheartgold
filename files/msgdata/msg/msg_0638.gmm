<?xml version="1.0"?>
<body language="English">
	<row id="msg_0638_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Appuyez sur le bouton A pour\nsauvegarder la Vidéo de combat.</language>
	</row>
	<row id="msg_0638_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous enregistrer la vidéo du\ndernier combat sur le Magnéto VS?</language>
	</row>
	<row id="msg_0638_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Effacer la Vidéo de combat précédente\npour enregistrer ce combat?</language>
	</row>
	<row id="msg_0638_00003" index="3">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0638_00004" index="4">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0638_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Veuillez patienter.</language>
	</row>
	<row id="msg_0638_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La Vidéo de combat a été sauvegardée.</language>
	</row>
	<row id="msg_0638_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une erreur est survenue.\nLa sauvegarde a échoué.</language>
	</row>
	<row id="msg_0638_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sauvegarde en cours...\nNe pas éteindre.</language>
	</row>
	<row id="msg_0638_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En attente d’une réponse de votre ami.\nVeuillez patienter.</language>
	</row>
</body>
