	<row id="msg_0209_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, oh... {STRVAR_1 3, 0, 0}, vous n’avez\npas encore obtenu la Pokémontre.\rJe ne peux pas vous donner ce logiciel\nsi vous n’avez pas de Pokémontre.</language>
