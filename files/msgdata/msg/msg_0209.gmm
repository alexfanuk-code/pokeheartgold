	<row id="msg_0209_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh! {STRVAR_1 3, 0, 0}!\nVotre Album Photo est plein!\rPourriez-vous revenir après y avoir\nfait le ménage dans votre PC?</language>
