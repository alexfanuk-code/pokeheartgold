	<row id="msg_0209_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bonsoir. Vous devez être\n{STRVAR_1 3, 0, 0}.\rJ’ai reçu un cadeau pour vous.\nLe voici!\r</language>
	</row>
	<row id="msg_0209_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je n’ai reçu aucun autre cadeau pour\nvous.\rNous espérons vous revoir bientôt.</language>
	</row>
	<row id="msg_0209_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Votre équipe est au complet.\rJe ne peux pas vous le donner\npour l’instant.</language>
	</row>
	<row id="msg_0209_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 8, 0, 0}, vous en voulez\nd’autres? Vous en avez déjà trop.</language>
	</row>
	<row id="msg_0209_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour accepter ceci, vous devez faire du\nvide dans vos articles de décoration.</language>
	</row>
