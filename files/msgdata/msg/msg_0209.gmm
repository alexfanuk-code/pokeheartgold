	<row id="msg_0209_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bonjour. Vous devez être\n{STRVAR_1 3, 0, 0}.\rJ’ai reçu un cadeau pour vous.\nLe voici!\r</language>
	</row>
	<row id="msg_0209_00001" index="1">
