<?xml version="1.0"?>
<body language="English">
	<row id="msg_0268_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il oubliera l’expression qu’il\nconnaît actuellement. D’accord? {YESNO 0}</language>
	</row>
	<row id="msg_0268_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Appuyez sur le bouton SUITE,\npuis parlez dans le micro.\r</language>
	</row>
	<row id="msg_0268_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0} a appris une nouvelle\nexpression!\r</language>
	</row>
	<row id="msg_0268_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0} n’a pas réussi à\napprendre une nouvelle expression.\r</language>
	</row>
	<row id="msg_0268_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous essayer de nouveau? {YESNO 0}</language>
	</row>
	<row id="msg_0268_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il a l’air distrait et incapable\nde se concentrer...</language>
	</row>
	<row id="msg_0268_00006" index="6">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0268_00007" index="7">
		<attribute name="window_context_name">garbage</attribute>
