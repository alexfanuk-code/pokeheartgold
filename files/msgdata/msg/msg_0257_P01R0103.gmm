<?xml version="1.0"?>
<body language="English">
	<row id="msg_0257_P01R0103_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue sur l’Aquaria!\rVotre ticket... Merci!\nVous pouvez passer!\r</language>
	</row>
	<row id="msg_0257_P01R0103_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Qu’est-ce que c’est fatigant de faire\nnaviguer ce bateau tous les jours...\rAujourd’hui, c’est le jour\nde l’express.\rLe bateau qui va à Oliville navigue\nle mercredi et le dimanche!</language>
	</row>
	<row id="msg_0257_P01R0103_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue sur l’Aquaria!\rVotre ticket... Merci!\nVous pouvez passer!</language>
	</row>
	<row id="msg_0257_P01R0103_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu viens de Johto?\rQuelle chance!\nOn dit qu’il y a plein de Pokémon\frares là-bas!</language>
	</row>
</body>
