<?xml version="1.0"?>
<body language="English">
	<row id="msg_0427_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ding dong!\rTemps écoulé!\nVotre Jeu Safari est terminé.\r</language>
	</row>
	<row id="msg_0427_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ding dong!\rVous n’avez plus de Safari Balls.\nVotre Jeu Safari est terminé.\r</language>
	</row>
	<row id="msg_0427_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ding dong!\rVous n’avez plus de place\npour d’autres Pokémon.\rVotre Jeu Safari est terminé!\r</language>
	</row>
	<row id="msg_0427_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous quitter la partie? {YESNO 0}</language>
	</row>
	<row id="msg_0427_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Poser un Bloc? {YESNO 0}</language>
	</row>
	<row id="msg_0427_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bloc {STRVAR_1 8, 0, 0} posé!</language>
	</row>
	<row id="msg_0427_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Enlever Bloc {STRVAR_1 8, 0, 0}? {YESNO 0}</language>
	</row>
	<row id="msg_0427_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bloc {STRVAR_1 8, 0, 0} enlevé.</language>
	</row>
	<row id="msg_0427_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous ne pouvez plus poser de Blocs\ndans cette zone!</language>
	</row>
	<row id="msg_0427_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous n’avez pas de Blocs à poser ici!</language>
	</row>
	<row id="msg_0427_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il n’y a pas la place!</language>
	</row>
