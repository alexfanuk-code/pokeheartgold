<?xml version="1.0"?>
<body language="English">
	<row id="msg_0533_T11R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yaaaah!\rLe Roi du Karaté, le maître respecté de\nnotre Dojo, est parti s’isoler dans une\fgrotte de Johto pour s’entraîner!</language>
	</row>
	<row id="msg_0533_T11R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yaaaah!\rPendant que le Roi du Karaté, le maître\nrespecté de notre Dojo, est absent, on\fa décidé d’ouvrir ce lieu aussi aux\fChampions d’Arènes!\rSi tu as le numéro de téléphone de l’un\nd’eux, appelle-le!\rTu pourras te battre contre eux ici\ntant que tu voudras... s’ils peuvent\ffaire le déplacement.</language>
	</row>
	<row id="msg_0533_T11R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La vengeance est un plat qui\nse mange froid...</language>
	</row>
	<row id="msg_0533_T11R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Attention aux fractures!</language>
	</row>
	<row id="msg_0533_T11R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Albert: Salut! Je t’attendais!\rJe suis content de pouvoir me battre\nà nouveau avec toi!\r</language>
	</row>
	<row id="msg_0533_T11R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Albert: Hmmm...\nLe chemin pour être le meilleur\fDresseur du monde est encore long!</language>
	</row>
	<row id="msg_0533_T11R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hector: On se retrouve!\rJe vais te montrer le résultat de mes\nétudes sur les Pokémon Insecte!\r</language>
	</row>
	<row id="msg_0533_T11R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hector: Eh bien, tu as beaucoup étudié\nles Pokémon!</language>
	</row>
	<row id="msg_0533_T11R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blanche: J’suis là, comme promis!\nOn démarre maintenant!\r</language>
	</row>
	<row id="msg_0533_T11R0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blanche: Punaise, tu déchires!\nMais la prochaine fois, j’te retourne!</language>
	</row>
	<row id="msg_0533_T11R0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chuck: Salut, je suis venu!\rTu vas goûter les fruits de mon\nentraînement spécial 24h/24!\r</language>
	</row>
	<row id="msg_0533_T11R0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chuck: Hahaha! C’est toujours aussi\ninstructif de se battre avec toi!</language>
	</row>
	<row id="msg_0533_T11R0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasmine: ... J’ai tenu ma promesse.\nCommençons-nous tout de suite?\r</language>
	</row>
	<row id="msg_0533_T11R0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasmine: ... Sans surprise.</language>
	</row>
	<row id="msg_0533_T11R0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mortimer: Je suis venu aussi vite que\nj’ai pu! Allez, en garde!\r</language>
	</row>
	<row id="msg_0533_T11R0101_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mortimer: Je n’arrive toujours pas à\nte battre...\rTu as quelque chose de plus que de la\nsimple force...</language>
	</row>
	<row id="msg_0533_T11R0101_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Frédo: Je t’attendais.\rNon, ne dis rien.\nNos Pokémon parleront pour nous.\r</language>
	</row>
	<row id="msg_0533_T11R0101_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Frédo: ... Hmm!\nC’était excellent.</language>
	</row>
	<row id="msg_0533_T11R0101_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sandra: ... Tu es là...\nAllez, commençons!\r</language>
	</row>
	<row id="msg_0533_T11R0101_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sandra: Parfait!\n...\f... Bonne chance.</language>
	</row>
	<row id="msg_0533_T11R0101_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Major Bob: Hey!\nAs promis! Let’s combattons encore!\r</language>
	</row>
	<row id="msg_0533_T11R0101_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Major Bob: Oh noes!\nTu es very strong!\fMais j’aurai ma revenge!</language>
	</row>
	<row id="msg_0533_T11R0101_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Morgane: J’étais sûre que tu viendrais!\nJ’en avais le pressentiment!\rComment ça, c’était prévu?\rHmm... Pas faux...\r</language>
	</row>
	<row id="msg_0533_T11R0101_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Morgane: Je sens que tu me\ntéléphoneras encore, un jour...</language>
	</row>
	<row id="msg_0533_T11R0101_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erika: Bonjouuur...\nJe suis heureuse de ces retrouvailles.\rCet endroit ne me plaît guère, mais\nce n’est pas important.\r</language>
	</row>
	<row id="msg_0533_T11R0101_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erika: Oh... Ta force augmente\nde plus en plus...</language>
	</row>
	<row id="msg_0533_T11R0101_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ondine: Ah, ça y est! Tu es là!\nIl paraît que tu as vécu des tas\fde trucs depuis la dernière fois, hein?\rAllez, montre-moi ça! En garde!\r</language>
	</row>
	<row id="msg_0533_T11R0101_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ondine: Incroyable!\nTu combats de mieux en mieux!</language>
	</row>
	<row id="msg_0533_T11R0101_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pierre: Parfait! Comme prévu!\nAllez, combattons!\r</language>
	</row>
	<row id="msg_0533_T11R0101_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pierre: Je n’arrive toujours pas à\ngagner... Je vois le fruit de tous\ftes voyages!</language>
	</row>
	<row id="msg_0533_T11R0101_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeannine: Hahaha... Je ne peux\npas utiliser mes techniques ninja ici,\fmais je vais quand même te battre!\r</language>
	</row>
	<row id="msg_0533_T11R0101_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeannine: Je n’ai pas gagné aujourd’hui,\nmais je gagnerai la prochaine fois!</language>
	</row>
	<row id="msg_0533_T11R0101_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Auguste: Woooooh!\nJ’aime les gens ponctuels!\r</language>
	</row>
	<row id="msg_0533_T11R0101_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Auguste: Woooooh...\rSi j’avais pu emprunter ce Dojo, je\nn’aurais pas eu à reconstruire\fmon Arène...\rNon, c’était impossible de toute façon.</language>
	</row>
	<row id="msg_0533_T11R0101_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blue: Enfin!\nOn vient se faire battre?\r</language>
	</row>
	<row id="msg_0533_T11R0101_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blue: Même les provocations ne\nmarchent pas contre toi!</language>
	</row>
</body>
