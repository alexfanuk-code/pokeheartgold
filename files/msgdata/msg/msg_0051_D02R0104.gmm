<?xml version="1.0"?>
<body language="English">
	<row id="msg_0051_D02R0104_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MELOFEE: Mélomélo!</language>
	</row>
	<row id="msg_0051_D02R0104_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aire de repos du Mont Sélénite.\rPar respect pour autrui, veuillez\nremporter vos déchets chez vous!</language>
	</row>
	<row id="msg_0051_D02R0104_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} trouve {STRVAR_1 8, 1, 0}!</language>
	</row>
	<row id="msg_0051_D02R0104_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} met {STRVAR_1 8, 1, 0} dans\nla Poche {STRVAR_1 31, 2, 0}.</language>
	</row>
	<row id="msg_0051_D02R0104_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Obtenu: {STRVAR_1 8, 0, 0}!\rDommage!\nLe Sac est plein.</language>
	</row>
	<row id="msg_0051_D02R0104_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci de revenir pendant nos\nhoraires d’ouverture.</language>
	</row>
</body>
