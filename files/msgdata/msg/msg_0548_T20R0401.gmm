<?xml version="1.0"?>
<body language="English">
	<row id="msg_0548_T20R0401_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salut, {STRVAR_1 3, 0, 0}!\nCélesta est à l’étage, dans sa chambre!\rElle s’amuse avec son Pokémon,\ncomme d’habitude.\rEt toi? Tu n’as pas amené le tien?\nAh! C’est vrai!\rTu n’as pas encore de Pokémon!\nDésolé, désolé.\rJ’espère que tu ne m’en veux pas.</language>
	</row>
	<row id="msg_0548_T20R0401_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salut, {STRVAR_1 3, 0, 0}!\nLuth est à l’étage, dans sa chambre!\rIl s’amuse avec son Pokémon,\ncomme d’habitude.\rEt toi? Tu n’as pas amené le tien?\nAh! C’est vrai!\rTu n’as pas encore de Pokémon!\nDésolé, désolé.\rJ’espère que tu ne m’en veux pas.</language>
	</row>
	<row id="msg_0548_T20R0401_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, {STRVAR_1 3, 0, 0}!\nCélesta s’est encore absentée!\rComme elle aide le Professeur, elle est\nsouvent envoyée à droite, à gauche...\fElle a l’air encore plus occupée\fque les adultes comme moi!</language>
	</row>
	<row id="msg_0548_T20R0401_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, {STRVAR_1 3, 0, 0}!\nLuth s’est encore absenté!\rComme il aide le Professeur, il est\nsouvent envoyé à droite, à gauche...\fIl a l’air encore plus occupé\fque les adultes comme moi!</language>
	</row>
	<row id="msg_0548_T20R0401_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salut, {STRVAR_1 3, 0, 0}!\nCélesta est à l’étage, dans sa chambre!\rElle s’amuse avec son Pokémon,\ncomme d’habitude.</language>
	</row>
	<row id="msg_0548_T20R0401_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salut, {STRVAR_1 3, 0, 0}!\nLuth est à l’étage, dans sa chambre!\rIl s’amuse avec son Pokémon,\ncomme d’habitude.</language>
