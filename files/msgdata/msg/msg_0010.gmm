	</row>
	<row id="msg_0010_00119" index="119">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce n’est pas le moment pour ça!</language>
	</row>
	<row id="msg_0010_00120" index="120">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Poche OBJETS\nLes objets utiles pour l’aventure\ny sont rangés.</language>
