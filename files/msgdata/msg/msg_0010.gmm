	<row id="msg_0010_00121" index="121">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Poche MEDICAMENTS\nLes objets permettant de restaurer les\nPP et les PV des Pokémon y sont rangés.</language>
	</row>
	<row id="msg_0010_00122" index="122">
