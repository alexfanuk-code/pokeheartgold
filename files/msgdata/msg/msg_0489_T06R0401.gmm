	<row id="msg_0489_T06R0401_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu connais le Train Magnétique?\rC’est un train qui relie Kanto et Johto.</language>
	</row>
	<row id="msg_0489_T06R0401_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Safrania! Safrania!\nEmmène-moi à Safrania!\rLe train! Le train!\nJe veux voir le Train Magnétique!</language>
	</row>
</body>
