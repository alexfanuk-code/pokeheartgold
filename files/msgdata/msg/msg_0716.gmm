	<row id="msg_0716_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, {STRVAR_1 3, 0, 0}!\rQuel malheur!\nPendant que je ne regardais pas...\fIl y a... Quelle tragédie!</language>
