	<row id="msg_0716_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô, {STRVAR_1 3, 0, 0}?\rJ’ai quelque chose pour toi de la part\ndu Professeur Chen.\rTu peux passer au Labo?\rA bientôt!</language>
	</row>
	<row id="msg_0716_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô, {STRVAR_1 3, 0, 0}?\rJ’ai quelque chose pour toi de la part\ndu Professeur Chen.\rTu peux passer au Labo?\rA bientôt!</language>
	</row>
	<row id="msg_0716_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô, {STRVAR_1 3, 0, 0}?\rL’évolution des Pokémon n’en finit pas\nde me surprendre!\rCertains Pokémon n’évoluent que si\ntu remplis des conditions particulières,\fon dirait!</language>
	</row>
	<row id="msg_0716_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô, {STRVAR_1 3, 0, 0}?\rL’évolution des Pokémon n’en finit pas\nde me surprendre!\rCertains Pokémon n’évoluent que si\ntu remplis des conditions particulières,\fon dirait!</language>
	</row>
	<row id="msg_0716_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô, {STRVAR_1 3, 0, 0}?\rJe suis sûr qu’il reste encore des\nPokémon que je ne connais pas à Kanto.\rAvec des méthodes d’évolution encore\ninconnues!\rJe compte sur ton œil aiguisé!</language>
	</row>
	<row id="msg_0716_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô, {STRVAR_1 3, 0, 0}?\rJe suis sûr qu’il reste encore des\nPokémon que je ne connais pas à Kanto.\rAvec des méthodes d’évolution encore\ninconnues!\rJe compte sur ton œil aiguisé!</language>
	</row>
	<row id="msg_0716_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô, {STRVAR_1 3, 0, 0}?\rUn Pokémon ayant attrapé un Pokérus\nse développe plus facilement.\fMais je ne sais pas pourquoi...</language>
	</row>
	<row id="msg_0716_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô, {STRVAR_1 3, 0, 0}?\rUn Pokémon ayant attrapé un Pokérus\nse développe plus facilement.\fMais je ne sais pas pourquoi...</language>
	</row>
	<row id="msg_0716_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">All... Allô, {STRVAR_1 3, 0, 0}?\rC’est...\nC’est terrible!\rC’est...\nAFFREUX!\rQue faire?\nOh, non...\rReviens vite!</language>
	</row>
	<row id="msg_0716_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">All... Allô, {STRVAR_1 3, 0, 0}?\rC’est...\nC’est terrible!\rC’est...\nAFFREUX!\rQue faire?\nOh, non...\rReviens vite!</language>
	</row>
	<row id="msg_0716_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô, {STRVAR_1 3, 0, 0}?\rOn a découvert quelque chose!\rJe ne peux pas t’en dire plus, mais je\nvoudrais te confier l’Oeuf.\rVa voir mon assistant à la Boutique\nPokémon de Mauville. Il te le remettra!</language>
	</row>
	<row id="msg_0716_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô, {STRVAR_1 3, 0, 0}?\rOn a découvert quelque chose!\rJe ne peux pas t’en dire plus, mais je\nvoudrais te confier l’Oeuf.\rVa voir mon assistant à la Boutique\nPokémon de Mauville. Il te le remettra!</language>
	</row>
	<row id="msg_0716_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô, {STRVAR_1 3, 0, 0}?\nTout va bien?\rJe t’appelle à propos des émissions\nde radio.\fQuelque chose ne va pas.\rElles parlent de la Team Rocket.\nSerais-tu au courant de tout ceci?\rLa Team Rocket est peut-être de\nretour.\fCe serait impensable, tout de même...\rDésolé pour ce coup de fil alarmiste...</language>
	</row>
	<row id="msg_0716_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô, {STRVAR_1 3, 0, 0}?\nTout va bien?\rJe t’appelle à propos des émissions\nde radio.\fQuelque chose ne va pas.\rElles parlent de la Team Rocket.\nSerais-tu au courant de tout ceci?\rLa Team Rocket est peut-être de\nretour.\fCe serait impensable, tout de même...\rDésolé pour ce coup de fil alarmiste...</language>
	</row>
