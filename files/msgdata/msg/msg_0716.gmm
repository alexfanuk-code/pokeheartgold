	<row id="msg_0716_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô, {STRVAR_1 3, 0, 0}?\rLes capacités qu’un Pokémon connaît en\nsortant d’un Oeuf restent un mystère.\rNous poursuivons nos recherches.</language>
	</row>
