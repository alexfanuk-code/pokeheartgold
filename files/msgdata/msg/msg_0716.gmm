	<row id="msg_0716_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô, {STRVAR_1 3, 0, 0}?\rPlus qu’un Badge de Johto\net tu les as tous?\rMais fais attention! Le Champion\nd’Ebènelle est une terrible Dracologue!</language>
	</row>
	<row id="msg_0716_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô, {STRVAR_1 3, 0, 0}?\rPlus qu’un Badge de Johto\net tu les as tous?\rMais fais attention! Le Champion\nd’Ebènelle est une terrible Dracologue!</language>
	</row>
	<row id="msg_0716_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô, {STRVAR_1 3, 0, 0}?\nTu as l’air en forme!\rJe n’ai pas à m’inquiéter!\nJe sais que tu y arriveras!</language>
	</row>
	<row id="msg_0716_00024" index="24">
