	<row id="msg_0063_D22R0102_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il y a une affiche...\rLes combats sont uniquement autorisés\ndans l’herbe.\f          Le Gardien du Parc Naturel</language>
	</row>
	<row id="msg_0063_D22R0102_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il y a une affiche...\rLes jeux de ballon hors Poké Ball\nsont interdits dans l’enceinte du parc.\f          Le Gardien du Parc Naturel</language>
	</row>
	<row id="msg_0063_D22R0102_00003" index="3">
