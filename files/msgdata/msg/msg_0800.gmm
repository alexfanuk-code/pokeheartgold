<?xml version="1.0"?>
<body language="English">
	<row id="msg_0800_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Impossible de se connecter à\nla connexion Wi-Fi Nintendo.\n\nPour toute assistance, consultez\nle mode d’emploi ou visitez le\nsite support.nintendo.com.\n({STRVAR_1 54, 0, 0})</language>
	</row>
	<row id="msg_0800_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Soit la connexion Wi-Fi Nintendo \nconnaît un trafic trop important, \nsoit le service est interrompu. \nVeuillez réessayer \nultérieurement.\nPour toute assistance, visitez \nle site support.nintendo.com.\n({STRVAR_1 54, 0, 0})</language>
	</row>
	<row id="msg_0800_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’identifiant de connexion Wi-Fi \nNintendo a été effacé parce qu’il \nest resté inutilisé pendant une \npériode prolongée. \n\nPour toute assistance, visitez \nle site support.nintendo.com.\n({STRVAR_1 54, 0, 0})</language>
	</row>
	<row id="msg_0800_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le service de connexion Wi-Fi \nNintendo pour ce logiciel a été \ninterrompu. \nVisitez le site \nsupport.nintendo.com pour une \nliste actuelle des logiciels \ncompatibles avec la connexion\nWi-Fi Nintendo. ({STRVAR_1 54, 0, 0})</language>
	</row>
	<row id="msg_0800_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le point d’accès n’est pas \ndisponible. Vous ne pouvez pas \nvous connecter. Veuillez \nréessayer ultérieurement. \n\nPour toute assistance, visitez\nle site support.nintendo.com.\n({STRVAR_1 54, 0, 0})</language>
	</row>
	<row id="msg_0800_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aucun point d’accès ne se trouve\nà proximité. Veuillez réessayer en\nvous rapprochant d’un point\nd’accès.\n\nPour toute assistance, visitez le\nsite support.nintendo.com.\n({STRVAR_1 54, 0, 0})</language>
	</row>
	<row id="msg_0800_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aucun point d’accès compatible \nne se trouve à proximité. Veuillez \nvérifier vos paramètres de \nconnexion et réessayer.\n\nPour toute assistance, visitez\nle site support.nintendo.com.\n({STRVAR_1 54, 0, 0})</language>
	</row>
	<row id="msg_0800_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Impossible de se connecter au \nconnecteur Wi-Fi USB Nintendo. \nVérifiez les paramètres de la \nconnexion Wi-Fi Nintendo. \n\nPour toute assistance, visitez \nle site support.nintendo.com.\n({STRVAR_1 54, 0, 0})</language>
	</row>
	<row id="msg_0800_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Impossible de se connecter à la \nconnexion Wi-Fi Nintendo. Vérifiez \nles paramètres de la connexion.\n\nPour toute assistance, visitez \nle site support.nintendo.com.\n({STRVAR_1 54, 0, 0})</language>
	</row>
	<row id="msg_0800_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aucune réponse. Le joueur n’est \npas connecté à la connexion Wi-Fi \nNintendo ou vous n’êtes pas dans \nsa liste d’amis.\n({STRVAR_1 54, 0, 0})</language>
	</row>
	<row id="msg_0800_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erreur de communication.\nPour toute assistance, visitez\nle site support.nintendo.com.\n{STRVAR_1 54, 0, 0}</language>
	</row>
	<row id="msg_0800_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erreur de communication.\n\nPour toute assistance, visitez\nle site support.nintendo.com.\n({STRVAR_1 54, 0, 0})</language>
	</row>
	<row id="msg_0800_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le téléchargement a échoué.\n\nPour toute assistance, visitez\nle site support.nintendo.com.\n({STRVAR_1 54, 0, 0})</language>
	</row>
	<row id="msg_0800_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erreur de communication. Vous\nn’êtes plus connecté à la\nconnexion Wi-Fi Nintendo.</language>
	</row>
	<row id="msg_0800_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erreur de communication...</language>
	</row>
	<row id="msg_0800_00015" index="15">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0800_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vos informations d’utilisateur\nde la connexion Wi-Fi Nintendo\npeuvent avoir été effacées.\nVérifiez vos paramètres de\nconnexion Wi-Fi Nintendo.</language>
	</row>
	<row id="msg_0800_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Se connecter à la connexion \nWi-Fi Nintendo?</language>
	</row>
	<row id="msg_0800_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La connexion Wi-Fi Nintendo\nconsidère votre carte DS et\nvotre console comme un ensemble.\nSe connecter à la CWF Nintendo\nen sauvegardant les informations\nd’utilisateur de la CWF Nintendo\nde cette console sur cette\ncarte DS?</language>
	</row>
	<row id="msg_0800_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les informations d’utilisateur\nde la connexion Wi-Fi Nintendo\nde cette console ont été\nsauvegardées sur la carte DS.\nA partir de maintenant, utilisez\ncette console pour vous\nconnecter à la connexion\nWi-Fi Nintendo.</language>
	</row>
	<row id="msg_0800_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les informations d’utilisateur de\nla connexion Wi-Fi Nintendo de\ncette console et de la carte DS\nne correspondent pas.\nImpossible de se connecter à la\nconnexion Wi-Fi Nintendo.</language>
	</row>
	<row id="msg_0800_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mettre à jour les informations\nd’utilisateur de la connexion Wi-Fi\nNintendo sauvegardées sur la\ncarte DS?\nVous perdrez toutes les données\nutilisées pour vous connecter\nà la connexion Wi-Fi Nintendo\nsi vous continuez.</language>
	</row>
	<row id="msg_0800_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous effectuer \nla mise à jour?\n\nAttention:\nTous les amis enregistrés \ndans votre Registre Ami \nseront effacés.</language>
	</row>
	<row id="msg_0800_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Accès à la connexion Wi-Fi Nintendo...\nVeuillez patienter...</language>
	</row>
	<row id="msg_0800_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Impossible d’accéder à la \nconnexion Wi-Fi Nintendo \navec ce nom d’utilisateur.\n\nVeuillez changer votre nom \nd’utilisateur et recommencer.</language>
	</row>
	<row id="msg_0800_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous interrompre\nla connexion Wi-Fi Nintendo?</language>
	</row>
	<row id="msg_0800_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Déconnexion de la connexion \nWi-Fi Nintendo.</language>
	</row>
	<row id="msg_0800_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous avez été déconnecté de \nla connexion Wi-Fi Nintendo.</language>
	</row>
	<row id="msg_0800_00028" index="28">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0800_00029" index="29">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0800_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sauvegarde en cours...\nNe pas éteindre.</language>
	</row>
	<row id="msg_0800_00031" index="31">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0800_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erreur de communication dans\nle Square Wi-Fi.\n({STRVAR_1 54, 0, 0})</language>
	</row>
</body>
