<?xml version="1.0"?>
<body language="English">
	<row id="msg_0634_T30R0301_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">DRACO est mignon mais je ne l’ai pas.\nTu aurais un DRACO♀?\rTu veux bien l’échanger contre\nun DODRIO? {YESNO 0}</language>
	</row>
	<row id="msg_0634_T30R0301_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Woah! Merci!\nJe voulais tant un DRACO!</language>
	</row>
	<row id="msg_0634_T30R0301_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est pas un DRACO♀, ça!\nAmène-m’en un, par pitié!!!</language>
	</row>
	<row id="msg_0634_T30R0301_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu veux pas échanger? Bah mince...</language>
	</row>
	<row id="msg_0634_T30R0301_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Comment va mon DODRIO?\nToujours la pêche?\rTon DRACO est si mignon!</language>
	</row>
	<row id="msg_0634_T30R0301_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh?\nTon {STRVAR_1 0, 0, 0}...\r</language>
	</row>
	<row id="msg_0634_T30R0301_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ton Pokémon a fourni \ndes efforts prodigieux!\rEn récompense, ce Ruban Effort\nest pour lui.\r</language>
	</row>
	<row id="msg_0634_T30R0301_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 1, 0} obtient le Ruban Effort.\r</language>
	</row>
	<row id="msg_0634_T30R0301_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 1, 0} met le Ruban Effort\nsur {STRVAR_1 0, 0, 0}.</language>
	</row>
	<row id="msg_0634_T30R0301_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ton Pokémon doit fournir plus\nd’efforts.\rQuand il aura vraiment fait de son mieux,\nje lui offrirai une belle récompense.</language>
	</row>
	<row id="msg_0634_T30R0301_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il fait pas mal d’efforts...\nMais ça ne suffit pas!\rAllez, encore quelques efforts!</language>
	</row>
	<row id="msg_0634_T30R0301_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il fait beaucoup d’efforts...\nMais ça ne suffit pas!\rAllez, encore un peu plus d’efforts!</language>
	</row>
	<row id="msg_0634_T30R0301_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il fait vraiment beaucoup d’efforts...\nMais ça ne suffit pas!\rAllez, encore un effort!</language>
	</row>
	<row id="msg_0634_T30R0301_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il fait énormément d’efforts...\nMais ça ne suffit pas!\rAllez, encore un tout petit effort!</language>
	</row>
	<row id="msg_0634_T30R0301_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh! Ce Ruban Effort va à\nmerveille à ton {STRVAR_1 0, 0, 0}!</language>
	</row>
</body>
