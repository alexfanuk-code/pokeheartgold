	<row id="msg_0062_D22R0101_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">René: Les Pokémon de niveau élevé ont\nplus de chances de gagner...\fMais ce n’est pas le seul facteur.</language>
	</row>
