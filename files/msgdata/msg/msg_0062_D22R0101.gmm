	<row id="msg_0062_D22R0101_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odilon: Pour gagner, il ne suffit pas\nd’attraper le Pokémon le plus gros...</language>
	</row>
