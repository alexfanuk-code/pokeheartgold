	<row id="msg_0062_D22R0101_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Samia: On m’a dit que les Pokémon avec\nde jolies couleurs avaient plus de\fchances de gagner... C’est vrai?</language>
	</row>
