<?xml version="1.0"?>
<body language="English">
	<row id="msg_0608_T26R0301_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé, toi!\nJe cherche un Pokémon!\rSi tu avais un KRABBY, tu ne voudrais\npas l’échanger contre mon\fVOLTORBE? {YESNO 0}</language>
	</row>
	<row id="msg_0608_T26R0301_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SU-PER!\nMERCI!\rEnfin, un KRABBY!</language>
	</row>
	<row id="msg_0608_T26R0301_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pas de KRABBY?\nAlors tant pis!</language>
	</row>
	<row id="msg_0608_T26R0301_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Même toi tu n’en as pas?\nQuel dommage...</language>
	</row>
	<row id="msg_0608_T26R0301_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SU-PER!\rTon KRABBY tient vraiment la forme!</language>
	</row>
</body>
