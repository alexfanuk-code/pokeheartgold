<?xml version="1.0"?>
<body language="English">
	<row id="msg_0577_T24R0501_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hein? Une Potion?\rMais ton Pokémon... m’a l’air en pleine\nforme! Quel est le problème?\r...\rAh...\nLe Pokémon du phare...\rJe vois!\nDans ce cas, j’ai ce qu’il lui faut!\fTiens, prends ceci.</language>
	</row>
	<row id="msg_0577_T24R0501_00001" index="1">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0577_T24R0501_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma Potionsecret est légèrement\ntrop forte. Je ne l’offre qu’en\fcas d’extrême urgence.</language>
	</row>
	<row id="msg_0577_T24R0501_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oui? Que veux-tu?\nTu as besoin d’un médicament? {YESNO 0}</language>
	</row>
	<row id="msg_0577_T24R0501_00004" index="4">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
