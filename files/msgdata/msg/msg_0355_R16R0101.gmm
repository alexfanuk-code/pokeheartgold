<?xml version="1.0"?>
<body language="English">
	<row id="msg_0355_R16R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si tu suis la Piste Cyclable\njusqu’au bout, tu arriveras à\fParmanie.</language>
	</row>
	<row id="msg_0355_R16R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bonjour! Tu veux connaître\nune expression à la mode? {YESNO 0}</language>
	</row>
	<row id="msg_0355_R16R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Très bien...\rPour toi, l’expression à la mode\nserait certainement...\r{STRVAR_1 28, 0, 0}!\rC’est trop fashion!</language>
	</row>
	<row id="msg_0355_R16R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, allez. Avec cette attitude, tu\nfiniras complètement has-been!</language>
	</row>
	<row id="msg_0355_R16R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Avec ces expressions à la mode, tu\ndeviendras la coqueluche des paparazzi.</language>
	</row>
	<row id="msg_0355_R16R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bonjour, bonjour. Alors, tu les utilises\nmes expressions à la mode?</language>
	</row>
</body>
