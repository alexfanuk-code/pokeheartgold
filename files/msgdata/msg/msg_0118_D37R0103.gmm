<?xml version="1.0"?>
<body language="English">
	<row id="msg_0118_D37R0103_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allez! T’es prêt, MACHOPEUR?\nPorte-moi ça là-bas!\r</language>
	</row>
	<row id="msg_0118_D37R0103_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On va ranger tout ça en un rien de\ntemps grâce à ces MACHOPEUR!\rQuelques trucs sont tombés des\ncaisses... Si tu les veux, sers-toi!</language>
	</row>
	<row id="msg_0118_D37R0103_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MACHOPEUR: Maacho!</language>
	</row>
</body>
