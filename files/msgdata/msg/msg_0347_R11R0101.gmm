<?xml version="1.0"?>
<body language="English">
	<row id="msg_0347_R11R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Toi qui passes par là!\nAs-tu déjà visité la Cave TAUPIQUEUR?\rNormalement, elle est très pratique,\nparce qu’elle permet de rejoindre\fla Route 2 facilement.\rMais tant qu’on n’aura pas trouvé un\nmoyen de réveiller ce RONFLEX,\fpersonne ne pourra l’utiliser...</language>
	</row>
	<row id="msg_0347_R11R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Toi qui passes par là!\nAs-tu déjà visité la Cave TAUPIQUEUR?\rMaintenant que l’on est débarrassés du\nRONFLEX qui en bouchait l’entrée, on\fpeut à nouveau rejoindre facilement\fla Route 2!</language>
	</row>
</body>
