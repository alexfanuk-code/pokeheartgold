<?xml version="1.0"?>
<body language="English">
	<row id="msg_0765_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Avez-vous déjà vu un film Pokémon?</language>
	</row>
	<row id="msg_0765_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Possédez-vous une peluche Pokémon?</language>
	</row>
	<row id="msg_0765_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quel est le point fort de votre\nPokémon favori?</language>
	</row>
	<row id="msg_0765_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Avez-vous déjà obtenu un Pokémon\nlors d’un événement?</language>
	</row>
	<row id="msg_0765_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A combien d’autres jeux Pokémon\navez-vous joué?</language>
	</row>
	<row id="msg_0765_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous avez commencé à jouer à Pokémon\nlorsque vous étiez...</language>
	</row>
	<row id="msg_0765_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si vous étiez un Pokémon, vous aimeriez\nêtre de type...</language>
	</row>
	<row id="msg_0765_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quelle est votre stratégie de combat?</language>
	</row>
	<row id="msg_0765_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A qui aimeriez-vous faire découvrir\nPokémon?</language>
	</row>
	<row id="msg_0765_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Avez-vous déjà participé à\nun événement Pokémon?</language>
	</row>
</body>
