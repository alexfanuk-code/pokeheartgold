<?xml version="1.0"?>
<body language="English">
	<row id="msg_0552_T21PC0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Heureusement qu’on peut laisser autant\nde Pokémon qu’on veut gratuitement!</language>
	</row>
	<row id="msg_0552_T21PC0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le PC posé là-bas peut être utilisé par\nn’importe quel Dresseur, alors\fne te gêne pas!</language>
	</row>
	<row id="msg_0552_T21PC0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils installent un centre de connexion\nà l’étage.\rMais il n’est pas encore prêt.</language>
	</row>
	<row id="msg_0552_T21PC0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils ont installé un centre de connexion\nà l’étage.\rJ’ai déjà fait un échange de Pokémon!</language>
	</row>
	<row id="msg_0552_T21PC0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue à la Salle Union du\nClub Sans Fil Pokémon!\r... C’est ce que je vais devoir dire à\ntout le monde quand ça sera ouvert...\rÇa ne devrait plus tarder, alors un\npeu de patience!</language>
	</row>
	<row id="msg_0552_T21PC0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue au Colisée du Club Link\nPokémon!\r... C’est ce que je vais devoir dire à\ntout le monde quand ça sera ouvert...\rÇa ne devrait plus tarder, alors un\npeu de patience!</language>
	</row>
</body>
