<?xml version="1.0"?>
<body language="English">
	<row id="msg_0221_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">???</language>
	</row>
	<row id="msg_0221_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Assurément la Ball la plus performante.\nElle permet de capturer à coup sûr un\nPokémon sauvage.</language>
	</row>
	<row id="msg_0221_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une Ball ultraperformante dont le taux\nde réussite est supérieur à celui de la\nSuper Ball.</language>
	</row>
	<row id="msg_0221_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une Ball très performante dont le taux\nde réussite est supérieur à celui de la\nPoké Ball.</language>
	</row>
	<row id="msg_0221_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un objet pareil à une capsule qui\ncapture les Pokémon sauvages. Il suffit\npour cela de le jeter comme une balle.</language>
	</row>
	<row id="msg_0221_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une Poké Ball spéciale dont l’usage\nest réservé au Parc Safari. Elle est\ndécorée d’un motif camouflage.</language>
	</row>
	<row id="msg_0221_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une Poké Ball un peu spéciale qui\nfonctionne particulièrement bien sur les\nPokémon Eau ou Insecte.</language>
	</row>
	<row id="msg_0221_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une Poké Ball un peu spéciale qui\nfonctionne particulièrement bien sur les\nPokémon sous-marins.</language>
	</row>
	<row id="msg_0221_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une Poké Ball un peu spéciale qui\nfonctionne particulièrement bien sur les\nPokémon les plus faibles.</language>
	</row>
	<row id="msg_0221_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une Poké Ball un peu spéciale qui\nfonctionne particulièrement bien sur les\nespèces de Pokémon déjà capturées.</language>
	</row>
	<row id="msg_0221_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une Poké Ball un peu spéciale qui\nfonctionne de mieux en mieux à mesure\nque le combat s’éternise.</language>
	</row>
	<row id="msg_0221_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une Poké Ball pratique qui permet de\ngagner rapidement l’amitié d’un Pokémon\nsauvage attrapé.</language>
	</row>
	<row id="msg_0221_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une Poké Ball assez rare qui fut créée\npour un événement particulier.</language>
	</row>
	<row id="msg_0221_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une Poké Ball efficace pour attraper\nles Pokémon de nuit ou dans des\nendroits sombres tels que les grottes.</language>
	</row>
	<row id="msg_0221_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une Poké Ball de soin qui rend tous les\nPV du Pokémon attrapé et qui soigne\ntous les changements de statut.</language>
