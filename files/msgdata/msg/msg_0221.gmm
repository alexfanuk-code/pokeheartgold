	</row>
	<row id="msg_0221_00355" index="355">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lanceur creuse au 1¹ tour et frappe\nau 2⁴. Permet aussi de s’échapper d’un\ndonjon.</language>
