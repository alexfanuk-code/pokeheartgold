<?xml version="1.0"?>
<body language="English">
	<row id="msg_0672_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erin</language>
	</row>
	<row id="msg_0672_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce n’est pas grave si j’ai perdu.\nIl faut que je m’améliore encore plus!\rTu peux me donner ton numéro pour\nqu’on se rencontre à nouveau? {YESNO 0}</language>
	</row>
	<row id="msg_0672_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si tu veux te battre encore contre moi,\ntéléphone-moi!</language>
	</row>
	<row id="msg_0672_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh non!\nSi tu changeais d’avis,\freviens me voir!</language>
	</row>
	<row id="msg_0672_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai vraiment encore envie de me\nbattre! On échange nos numéros? {YESNO 0}</language>
	</row>
	<row id="msg_0672_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouin! J’ai encore perdu!\nÇa fait combien de fois déjà?\rMais merci pour ta venue.\nPour la peine, tiens, un cadeau!\r</language>
	</row>
	<row id="msg_0672_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Qu’est-ce qu’il y a?\nPourquoi tu téléphones d’aussi près?\fJe te fais peur? Tu ne veux pas\fvenir me voir directement?</language>
	</row>
	<row id="msg_0672_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu sais, mon {STRVAR_1 0, 10, 0}...\nIl est devenu encore plus fort!\rA bientôt!</language>
	</row>
	<row id="msg_0672_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu sais quoi?\rLà je viens de me battre avec un\n{STRVAR_1 0, 11, 0} et j’ai gagné!\rJe l’ai bien entraîné, super!\rA bientôt!</language>
	</row>
	<row id="msg_0672_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu sais quoi?\rUn {STRVAR_1 0, 11, 0} sauvage m’a encore\néchappé! C’est pas juste!\rA bientôt!</language>
	</row>
	<row id="msg_0672_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé, tu ne veux pas te battre à\nnouveau contre moi?\fJe t’attends sur la {STRVAR_1 4, 3, 0}!</language>
	</row>
	<row id="msg_0672_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé, {STRVAR_1 3, 0, 0}!\nViens te battre contre moi!\rJe t’attends sur la {STRVAR_1 4, 3, 0}!</language>
	</row>
	<row id="msg_0672_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’entraîne bien mes Pokémon!\rReviens pour m’affronter!</language>
	</row>
</body>
