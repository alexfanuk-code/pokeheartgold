<?xml version="1.0"?>
<body language="English">
	<row id="msg_0295_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 28, 0, 0}!\nBonjour!</language>
	</row>
	<row id="msg_0295_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quelle joie de te rencontrer!\nJ’aime {STRVAR_1 28, 0, 0}!</language>
	</row>
	<row id="msg_0295_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis un Dresseur {STRVAR_1 28, 0, 0}!\nOn fait un combat?</language>
	</row>
	<row id="msg_0295_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On fait un échange?\nJe propose un {STRVAR_1 28, 0, 0}!</language>
	</row>
	<row id="msg_0295_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On fait un échange?\nJe veux un {STRVAR_1 28, 0, 0}!</language>
	</row>
	<row id="msg_0295_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis dans la Salle Union.</language>
	</row>
	<row id="msg_0295_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et si on dessinait? Je veux dessiner \n{STRVAR_1 28, 0, 0}!</language>
	</row>
	<row id="msg_0295_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je dois partir!\n{STRVAR_1 28, 0, 0}!</language>
	</row>
	<row id="msg_0295_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je veux qu’on me laisse tranquille...</language>
	</row>
	<row id="msg_0295_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quelqu’un veut\n{STRVAR_1 28, 0, 0}?</language>
	</row>
	<row id="msg_0295_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allez, {STRVAR_1 28, 0, 0}!</language>
	</row>
	<row id="msg_0295_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 28, 0, 0}, voilà ce que \nj’aimerais faire. Alors?</language>
	</row>
	<row id="msg_0295_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je veux {STRVAR_1 28, 0, 0}!</language>
	</row>
	<row id="msg_0295_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK!</language>
	</row>
	<row id="msg_0295_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne veux pas\n{STRVAR_1 28, 0, 0}.</language>
	</row>
	<row id="msg_0295_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais aller attendre au Colisée.</language>
	</row>
	<row id="msg_0295_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’aimerais qu’on discute!</language>
	</row>
	<row id="msg_0295_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Où suis-je?</language>
	</row>
	<row id="msg_0295_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je veux échanger {STRVAR_1 28, 0, 0}.\nJ’aimerais qu’on discute!</language>
	</row>
	<row id="msg_0295_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je veux un combat {STRVAR_1 28, 0, 0}!\nJ’aimerais qu’on discute!</language>
	</row>
</body>
