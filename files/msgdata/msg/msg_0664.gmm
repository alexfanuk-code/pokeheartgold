<?xml version="1.0"?>
<body language="English">
	<row id="msg_0664_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Maman</language>
	</row>
	<row id="msg_0664_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô? Mon petit {STRVAR_1 3, 0, 0}?\rJ’ai tellement l’habitude de\nt’entendre, mais là, au téléphone,\fta voix est si distante qu’on\fdirait quelqu’un d’autre.\fÇa fait bizarre...</language>
	</row>
	<row id="msg_0664_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô? Ma petite {STRVAR_1 3, 0, 0}?\rJ’ai tellement l’habitude de\nt’entendre, mais là, au téléphone,\fta voix est si distante qu’on\fdirait quelqu’un d’autre.\fÇa fait bizarre...</language>
	</row>
	<row id="msg_0664_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô?\rMais c’est toi, mon poussin!\nTout se passe bien?\rÇa n’a pas l’air facile, hein!\rJe sais que tu n’abandonneras pas,\nje compte sur toi!\rA une prochaine fois!</language>
	</row>
	<row id="msg_0664_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô?\rMon poussin?\nTu n’aurais un reçu un coup de fil du\fProfesseur Orme?\fJe crois qu’il t’attend...</language>
	</row>
	<row id="msg_0664_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô?\rMon poussin?\nTout se passe bien avec le\fProfesseur Orme?\rJe sais que tu n’abandonneras pas,\nje compte sur toi!</language>
	</row>
	<row id="msg_0664_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô?\rMon poussin?\nSi tu as fini ton travail, tu ne\fvoudrais pas repasser par la maison?</language>
	</row>
	<row id="msg_0664_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô?\rMon poussin?\nTout se passe bien avec les Pokémon?\rSi tu les traites avec gentillesse, ils\ndeviendront tes amis!\fFais attention à eux!\r</language>
	</row>
	<row id="msg_0664_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô?\rMon poussin?\nTout se passe bien?\rAh, tu es à Ville Griotte?\nCe n’est pas loin de la maison!\fTu pourrais passer me voir!\r</language>
	</row>
	<row id="msg_0664_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô?\rMon poussin?\nTout se passe bien?\rAh, tu es à Mauville?\nTu devrais essayer de passer à la\fTour CHETIFLOR alors!\r</language>
	</row>
	<row id="msg_0664_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô?\rMon poussin?\nTout se passe bien?\rAh, tu es à Ecorcia?\nTu devrais essayer de passer au Puits\fRAMOLOSS alors!\r</language>
	</row>
	<row id="msg_0664_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô?\rMon poussin?\nTout se passe bien?\rAh, tu es à Irisia?\nTu devrais essayer de faire un tour\fau Parc Safari alors!\fJe crois qu’ils l’ont enfin ouvert!\r</language>
	</row>
	<row id="msg_0664_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô?\rMon poussin?\nTout se passe bien?\rAh, tu es à Doublonville?\nTu devrais essayer de passer à la Tour\fRadio alors!\r</language>
	</row>
	<row id="msg_0664_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô?\rMon poussin?\nTout se passe bien?\rAh, tu es à Oliville?\nTu devrais essayer de passer au phare\falors!\r</language>
	</row>
	<row id="msg_0664_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô?\rMon poussin?\nTout se passe bien?\rAh, tu es à Rosalia?\nTu devrais essayer de passer à la Tour\fCarillon alors!\r</language>
	</row>
	<row id="msg_0664_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô?\rMon poussin?\nTout se passe bien?\rAh, tu es à {STRVAR_1 4, 2, 0}?\nTu avances bien dans ta collection\fde Pokémon?\r</language>
	</row>
	<row id="msg_0664_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô?\rMon poussin?\nTout se passe bien?\rAh, tu es à {STRVAR_1 4, 2, 0}?\nJe sais que, où que tu ailles, tu feras\fbien attention!\r</language>
	</row>
	<row id="msg_0664_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô?\rMon poussin?\nTu as l’air en forme!\fJe suis rassurée!\r</language>
	</row>
	<row id="msg_0664_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô?\rMon poussin?\nTout se passe bien?\rÇa n’a pas l’air facile ce que tu fais!\nMais je sais que tu n’abandonneras pas,\fje compte sur toi!\r</language>
	</row>
	<row id="msg_0664_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô?\rMon poussin?\nTout se passe bien?\rQuoi, tu es à Kanto?\nTu es vraiment formidable!\r</language>
	</row>
	<row id="msg_0664_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô?\rMon poussin?\nTu participes au Pokéathlon?\rVas-y mon poussin!\nMaman croit en toi!\r</language>
	</row>
	<row id="msg_0664_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu n’as pas encore reçu le cadeau de\nMaman?\rPasse voir le livreur! Il est dans les\nBoutiques Pokémon!</language>
	</row>
	<row id="msg_0664_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô?\r{STRVAR_1 3, 0, 0}?\nLe Professeur Orme m’a dit que...\ftu partais pour un long voyage.\rJ’aurais aimé que tu passes me voir\nune dernière fois avant...\rQu’est-ce que je dois faire avec ton\nargent? L’économiser?</language>
	</row>
	<row id="msg_0664_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A propos, je t’ai mis {STRVAR_1 55, 10, 0} $ de côté!\nTu veux continuer à économiser?</language>
	</row>
	<row id="msg_0664_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Au fait, je t’ai mis {STRVAR_1 55, 10, 0} $ de côté!\nTu veux recommencer à économiser?</language>
	</row>
	<row id="msg_0664_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">D’accord! Je m’occupe de\ntes économies!\rContinue comme ça, mon poussin!</language>
	</row>
	<row id="msg_0664_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">D’accord! Je ne m’occupe pas de\ntes économies!\rContinue comme ça, mon poussin!</language>
	</row>
	<row id="msg_0664_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est important d’économiser!</language>
	</row>
	<row id="msg_0664_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, mon Poussin, tu n’as pas d’argent\nde côté...\rTu ne voudrais pas essayer\nd’économiser? {YESNO 0}</language>
	</row>
	<row id="msg_0664_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô? Mon poussin?\nC’est Maman... Tu vas bien?\rAujourd’hui, en allant faire les\ncourses, j’ai trouvé quelque chose qui\fdevrait te plaire... Alors j’ai craqué,\fet j’ai dépensé tes sous! Désolée!\rJ’ai confié ton cadeau au livreur, alors\npasse à la Boutique Pokémon ou au\fCentre Commercial le plus proche!\fJe suis sûre que ça te sera utile!</language>
	</row>
</body>
