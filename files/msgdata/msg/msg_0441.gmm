	</row>
	<row id="msg_0441_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Veuillez choisir le type de Pokémon\nque vous voulez affronter.\r</language>
	</row>
	<row id="msg_0441_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous affronter le type\n{STRVAR_1 15, 0, 0}, rang {STRVAR_1 51, 1, 0}?</language>
	</row>
