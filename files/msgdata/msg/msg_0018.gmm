<?xml version="1.0"?>
<body language="English">
	<row id="msg_0018_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quel défi souhaitez-vous\nrelever? {YESNO 0}</language>
	</row>
	<row id="msg_0018_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} a abandonné.\r</language>
	</row>
	<row id="msg_0018_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Veuillez choisir qui vous inscrivez.\r</language>
	</row>
	<row id="msg_0018_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Votre ami(e) et vous n’avez pas choisi\nle même bâtiment ou le même niveau.\fVeuillez choisir à nouveau.\r</language>
	</row>
	<row id="msg_0018_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Veuillez patienter.</language>
	</row>
	<row id="msg_0018_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Votre ami(e) et vous avez des records\ndifférents pour ce défi.\rLe défi commencera tout au début.\r</language>
	</row>
	<row id="msg_0018_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Votre ami(e) et vous avez choisi le\nPokémon {STRVAR_1 0, 0, 0}.\rVeuillez discuter avec votre ami(e) et\ninscrire des Pokémon différents.\r</language>
	</row>
	<row id="msg_0018_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Votre ami(e) et vous avez choisi les\nPokémon {STRVAR_1 0, 0, 0} et {STRVAR_1 0, 1, 0}.\rVeuillez discuter avec votre ami(e) et\ninscrire des Pokémon différents.\r</language>
	</row>
