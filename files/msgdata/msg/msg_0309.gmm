	<row id="msg_0309_00198" index="198">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sautez, courez jusqu’à l’arrivée!</language>
	</row>
	<row id="msg_0309_00199" index="199">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Courez et ramenez les drapeaux!</language>
	</row>
	<row id="msg_0309_00200" index="200">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rentrez dans les cercles!</language>
	</row>
	<row id="msg_0309_00201" index="201">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cassez tous les rocs!</language>
	</row>
	<row id="msg_0309_00202" index="202">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Attrapez les disques en plein vol!</language>
	</row>
	<row id="msg_0309_00203" index="203">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Visez les boules lumineuses!</language>
	</row>
	<row id="msg_0309_00204" index="204">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Courez, changez, courez!</language>
	</row>
	<row id="msg_0309_00205" index="205">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Virez les adversaires du ring!</language>
	</row>
	<row id="msg_0309_00206" index="206">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bombardez de boules de neige!</language>
