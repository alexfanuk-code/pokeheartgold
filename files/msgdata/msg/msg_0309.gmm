<?xml version="1.0"?>
<body language="English">
	<row id="msg_0309_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue au Pokéathlon!\nAujourd’hui, {STRVAR_4 1, 0, 0}!\rQui sera notre éblouissant vainqueur?\rLaissez-moi vous présenter nos\nvaleureux Poké Athlètes!\r</language>
	</row>
	<row id="msg_0309_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 1, 0}, {STRVAR_1 1, 2, 0} et \n{STRVAR_1 1, 3, 0},\fpour l’équipe {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0309_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Que le Pokéathlon...\r{ALN_CENTER}{SIZE 200}COMMENCE!\r</language>
	</row>
	<row id="msg_0309_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bravo à tous nos Poké Athlètes!\rQuelle équipe est sortie vainqueur\nde cette intense rencontre?\rVoici les résultats!\rMais tout d’abord...\nAu nom de l’esprit du sport...\r</language>
	</row>
	<row id="msg_0309_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voici les bonus distribués aux\nPokémon et aux équipes!\r</language>
	</row>
	<row id="msg_0309_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Equipe {STRVAR_1 3, 0, 0}: {STRVAR_1 52, 1, 0} points!\r</language>
	</row>
	<row id="msg_0309_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ensuite, les prix individuels...\r</language>
	</row>
	<row id="msg_0309_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Prix du sans-faute!\r</language>
	</row>
	<row id="msg_0309_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le {STRVAR_1 0, 1, 0} de\nl’équipe {STRVAR_1 3, 0, 0}!</language>
	</row>
	<row id="msg_0309_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">... Personne? Soit, passons...\r</language>
	</row>
	<row id="msg_0309_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est tout!\r</language>
	</row>
	<row id="msg_0309_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Prix du Roi du Point!\r</language>
	</row>
	<row id="msg_0309_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le {STRVAR_1 0, 1, 0} de\nl’équipe {STRVAR_1 3, 0, 0}!</language>
	</row>
	<row id="msg_0309_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est tout!\r</language>
	</row>
	<row id="msg_0309_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Maintenant...\nLes prix des performances individuelles!\r</language>
	</row>
	<row id="msg_0309_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le prix récompensant un Pokémon\nparticulièrement bondissant va à...\r</language>
	</row>
	<row id="msg_0309_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le prix récompensant un Pokémon\nqui n’hésite jamais à charger va à...\r</language>
	</row>
	<row id="msg_0309_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le prix accordé à un Pokémon qui\néchoue constamment va à...\r</language>
	</row>
	<row id="msg_0309_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le prix récompensant un Pokémon\nqui sprinte en permanence va à...\r</language>
	</row>
	<row id="msg_0309_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Pokémon qui a remporté le moins\nde points...\r</language>
	</row>
	<row id="msg_0309_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">... {STRVAR_1 0, 1, 0} de l’équipe\n{STRVAR_1 3, 0, 0}!</language>
	</row>
	<row id="msg_0309_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est tout!\r</language>
	</row>
	<row id="msg_0309_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Enfin...\nVoici les points des épreuves!\r</language>
	</row>
	<row id="msg_0309_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Epreuve numéro {STRVAR_1 50, 0, 0}!</language>
	</row>
	<row id="msg_0309_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hein? Quoi? Une égalité?\nDans ce cas, il y a tirage au sort!\r(Farfouille farfouille)...\n...\r...\nEt donc...\r</language>
	</row>
	<row id="msg_0309_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Notre vainqueur, qui a remporté\n{STRVAR_1 52, 0, 0} points, est...\r</language>
	</row>
	<row id="msg_0309_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}{SIZE 200}L’EQUIPE {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0309_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’équipe {STRVAR_1 3, 0, 0} se voit décerner\nla {STRVAR_4 3, 1, 0}!\r</language>
	</row>
	<row id="msg_0309_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’équipe {STRVAR_1 3, 0, 0} se voit décerner\nla {STRVAR_4 3, 1, 0} et\fla {STRVAR_4 3, 2, 0}!\r</language>
	</row>
	<row id="msg_0309_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’équipe {STRVAR_1 3, 0, 0} a battu son\npropre record\fà {STRVAR_4 1, 1, 0}!\r</language>
	</row>
	<row id="msg_0309_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Belle performance!\r</language>
	</row>
	<row id="msg_0309_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bravo!\nC’était époustouflant!\rRendez-vous au faîte\nde la gloire!\rC’est la fièvre du...\r{ALN_CENTER}{SIZE 200}POKéATHLON!\r</language>
	</row>
	<row id="msg_0309_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous avez déjà participé...\n{STRVAR_1 55, 1, 0} fois!\rVous êtes l’étoile montante\ndes Poké Athlètes!\r</language>
	</row>
	<row id="msg_0309_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous avez déjà participé...\n{STRVAR_1 55, 1, 0} fois!\rVous êtes l’étoile filante\ndes Poké Athlètes!\r</language>
	</row>
	<row id="msg_0309_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous avez déjà participé...\n{STRVAR_1 55, 1, 0} fois!\rVous êtes la supernova\ndes Poké Athlètes!\r</language>
	</row>
	<row id="msg_0309_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous avez déjà participé...\n{STRVAR_1 55, 1, 0} fois!\rVous êtes le big bang\ndes Poké Athlètes!\r</language>
	</row>
	<row id="msg_0309_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brille au firmament de la victoire!\nL’étoile du Pokéathlon!\r</language>
	</row>
	<row id="msg_0309_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 55, 1, 0} victoires!\nLes choses sérieuses commencent!\r</language>
	</row>
	<row id="msg_0309_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 55, 1, 0} victoires!\nLes lauriers de la victoire lui siéent!\r</language>
	</row>
	<row id="msg_0309_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 55, 1, 0} victoires!\nSa devise: “Le Pokéathlon, c’est moi!”\r</language>
	</row>
	<row id="msg_0309_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La persévérance paye toujours!\r</language>
	</row>
	<row id="msg_0309_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 55, 1, 0} fois en dernière place!\nIl ne faut pas abandonner!\r</language>
	</row>
	<row id="msg_0309_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 55, 1, 0} fois en dernière place...\nEt alors?\r</language>
	</row>
	<row id="msg_0309_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 55, 1, 0} fois en dernière place...\nPersonne n’a jamais vu son dos!\r</language>
	</row>
	<row id="msg_0309_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Que le meilleur gagne!\nC’est parti!\r</language>
	</row>
	<row id="msg_0309_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 55, 1, 0} fois en première place!\nArriverez-vous à suivre?\r</language>
	</row>
	<row id="msg_0309_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 55, 1, 0} fois en première place!\nEt bientôt une victoire de plus?\r</language>
	</row>
	<row id="msg_0309_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 55, 1, 0} fois en première place!\nCela va-t-il continuer?\r</language>
	</row>
	<row id="msg_0309_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il ne faut pas craindre la défaite!\nToujours se relever et se battre!\r</language>
	</row>
	<row id="msg_0309_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 55, 1, 0} fois en dernière position!\nMais il ne faut jamais abandonner!\r</language>
	</row>
	<row id="msg_0309_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 55, 1, 0} fois en dernière position!\nC’est un record après tout!\r</language>
	</row>
	<row id="msg_0309_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 55, 1, 0} fois en dernière position!\nC’est ce qui fait sa célébrité!\r</language>
	</row>
	<row id="msg_0309_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une victoire due au talent?\nOu à la chance?\r</language>
	</row>
	<row id="msg_0309_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les points bonus de la cérémonie de\nclôture! A {STRVAR_1 55, 1, 0} fois, c’est de\fla chance, non?\r</language>
	</row>
	<row id="msg_0309_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les points bonus de la cérémonie de\nclôture! A {STRVAR_1 55, 1, 0} fois, c’est du\ftalent, non?\r</language>
	</row>
	<row id="msg_0309_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les points bonus de la cérémonie de\nclôture! A {STRVAR_1 55, 1, 0} fois, c’est de\fla chance et du talent, non?\r</language>
	</row>
	<row id="msg_0309_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils sont capables de bouger\ndes montagnes!\r</language>
	</row>
	<row id="msg_0309_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Leur travail d’équipe\nmarquera l’histoire!\r</language>
	</row>
	<row id="msg_0309_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Admirez leur travail d’équipe!\nEt leur incroyable amitié!\r</language>
	</row>
	<row id="msg_0309_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils sont liés par une incroyable amitié!\r</language>
	</row>
	<row id="msg_0309_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La victoire sourit aux audacieux!\r</language>
	</row>
	<row id="msg_0309_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 55, 1, 0} échecs!\nC’est la seule chose qui augmente dans\fcette équipe!\r</language>
	</row>
	<row id="msg_0309_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 55, 1, 0} échecs!\nTous les chemins, même la défaite,\fmènent à la victoire?\r</language>
	</row>
	<row id="msg_0309_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 55, 1, 0} échecs!\nLa défaite est la base de la victoire,\fnon?\r</language>
	</row>
	<row id="msg_0309_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voler toujours plus haut!\nVers les sommets de la victoire!\r</language>
	</row>
	<row id="msg_0309_00065" index="65">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Leur ascension vers la victoire\nest tout simplement irrésistible!\r</language>
	</row>
	<row id="msg_0309_00066" index="66">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour des lendemains qui chantent!\r</language>
	</row>
	<row id="msg_0309_00067" index="67">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils sont nés pour gagner!\r</language>
	</row>
	<row id="msg_0309_00068" index="68">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils ne vivent que pour les records!\r</language>
	</row>
	<row id="msg_0309_00069" index="69">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ne jamais gaspiller un point!\nC’est la base de la victoire!\r</language>
	</row>
	<row id="msg_0309_00070" index="70">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un point est un point!\nC’est toujours ça de gagné!\r</language>
	</row>
	<row id="msg_0309_00071" index="71">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voilà les rois du point!\nIls leur reviennent tous de droit!\r</language>
	</row>
	<row id="msg_0309_00072" index="72">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils mordent! Ils griffent!\nIl tirent même les cheveux!\r</language>
	</row>
	<row id="msg_0309_00073" index="73">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les voilà, les démons cogneurs!\nDéjà {STRVAR_1 55, 1, 0} charges à leur actif!\r</language>
	</row>
	<row id="msg_0309_00074" index="74">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils bousculent jusqu’aux convenances\npour la victoire.\fDéjà {STRVAR_1 55, 1, 0} charges à leur actif!\r</language>
	</row>
	<row id="msg_0309_00075" index="75">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rien ne pourra se dresser en travers\nde leur victoire!\fDéjà {STRVAR_1 55, 1, 0} charges à leur actif!\r</language>
	</row>
	<row id="msg_0309_00076" index="76">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pourquoi tu tombes?\nParce qu’il y a un trou!\r</language>
	</row>
	<row id="msg_0309_00077" index="77">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils adorent tomber!\nIls n’en ont jamais assez!!\r</language>
	</row>
	<row id="msg_0309_00078" index="78">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Seuls les vrais Poké Athlètes se\nbattent au bord du ring!\r</language>
	</row>
	<row id="msg_0309_00079" index="79">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Se battre sans penser aux\nconséquences! C’est ÇA leur truc!\r</language>
	</row>
	<row id="msg_0309_00080" index="80">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quel sprint!\nJ’en suis tout décoiffé!\r</language>
	</row>
	<row id="msg_0309_00081" index="81">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La course à la gloire!\nLe sprint vers la victoire!\r</language>
	</row>
	<row id="msg_0309_00082" index="82">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils sont plus rapides que la lumière!\r</language>
	</row>
	<row id="msg_0309_00083" index="83">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils sont plus vifs que l’éclair!\r</language>
	</row>
	<row id="msg_0309_00084" index="84">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La force ne fait pas tout!\nLa stratégie est la clé!\r</language>
	</row>
	<row id="msg_0309_00085" index="85">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voici les cerveaux!\nRien ne résiste à leur analyse!\r</language>
	</row>
	<row id="msg_0309_00086" index="86">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ne les sous-estimez pas!\nLeur stratégie retourne même\fles situations désespérées!\r</language>
	</row>
	<row id="msg_0309_00087" index="87">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le génie des Pokémon, qui sait\nexploiter toutes leurs capacités!\r</language>
	</row>
	<row id="msg_0309_00088" index="88">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous n’êtes pas seuls au monde!\nTout le monde est venu pour\fse mesurer à vous!\r</language>
	</row>
	<row id="msg_0309_00089" index="89">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tout le monde est venu pour\nse mesurer à eux!\fLa preuve qu’ils sont forts!\r</language>
	</row>
	<row id="msg_0309_00090" index="90">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chaque combat nous en apprend plus\nsur nous-mêmes et les autres!\r</language>
	</row>
	<row id="msg_0309_00091" index="91">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une équipe qui collectionne les\namis et les Pokémon!\r</language>
	</row>
	<row id="msg_0309_00092" index="92">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est en se mesurant aux vétérans\nqu’ils sont devenus si forts!\r</language>
	</row>
	<row id="msg_0309_00093" index="93">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le monde est peuplé de gens très\nforts! Et ils sont venus pour\fse mesurer à eux!\r</language>
	</row>
	<row id="msg_0309_00094" index="94">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils ne peuvent pas perdre! A eux\nles lauriers de la victoire!\r</language>
	</row>
	<row id="msg_0309_00095" index="95">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils visent sans cesse à s’améliorer!\r</language>
	</row>
	<row id="msg_0309_00096" index="96">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils pensent que perdre, c’est aussi\ndevenir plus fort!\r</language>
	</row>
	<row id="msg_0309_00097" index="97">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le monde est rempli de gens très forts.\nEt ils le savent mieux que personne!\r</language>
	</row>
	<row id="msg_0309_00098" index="98">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils se mesurent contre les autres.\nMais aussi entre eux!\r</language>
	</row>
	<row id="msg_0309_00099" index="99">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gagner, perdre, quelle importance?\nL’essentiel, c’est d’affronter\fla crème!\r</language>
	</row>
	<row id="msg_0309_00100" index="100">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les champions nés pour le combat!\r</language>
	</row>
	<row id="msg_0309_00101" index="101">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quelle grâce!\nAdmirez leur jeu de jambes!\r</language>
	</row>
	<row id="msg_0309_00102" index="102">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aucune difficulté, aucune épreuve ne\nleur résistent!\r</language>
	</row>
	<row id="msg_0309_00103" index="103">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils ne connaissent pas les obstacles!\nIls volent vers la victoire!\r</language>
	</row>
	<row id="msg_0309_00104" index="104">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nés pour capturer des drapeaux!\nIls sont la terreur de la plage!\r</language>
	</row>
	<row id="msg_0309_00105" index="105">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les héros de Capture Drapeau!\nIls les attraperont tous!\r</language>
	</row>
	<row id="msg_0309_00106" index="106">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est LEUR plage!\nLEUR terrain de prédilection!\r</language>
	</row>
	<row id="msg_0309_00107" index="107">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils collectionnent tous les drapeaux.\nSurtout celui de la victoire!\r</language>
	</row>
	<row id="msg_0309_00108" index="108">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils poussent comme des SCARABRUTE!\r</language>
	</row>
	<row id="msg_0309_00109" index="109">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Faites place!\nSinon ils la feront eux-mêmes!\r</language>
	</row>
	<row id="msg_0309_00110" index="110">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous poussez pour gagner?\nIls poussent pour vivre!\r</language>
	</row>
	<row id="msg_0309_00111" index="111">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wouah, quelle pression ils dégagent!\nLeur aura suffit à me faire reculer!\r</language>
	</row>
	<row id="msg_0309_00112" index="112">
		<attribute name="window_context_name">used</attribute>
		<language name="English">PIF! PAF! BOUM!\nAucun roc ne leur résiste!\r</language>
	</row>
	<row id="msg_0309_00113" index="113">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voilà les rois de la destruction!\r</language>
	</row>
	<row id="msg_0309_00114" index="114">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils taillent le chemin de la victoire à\nmême le roc!\r</language>
	</row>
	<row id="msg_0309_00115" index="115">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ces montagnes de gravats... C’étaient\ndes rocs avant qu’ils ne les cassent!\r</language>
	</row>
	<row id="msg_0309_00116" index="116">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bondir est comme un réflexe pour eux!\r</language>
	</row>
	<row id="msg_0309_00117" index="117">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils attraperont tout! Les disques...\nEt la victoire!\r</language>
	</row>
	<row id="msg_0309_00118" index="118">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ces disques sont leurs étoiles filantes!\nEt ils ont déjà fait leurs vœux!\r</language>
	</row>
	<row id="msg_0309_00119" index="119">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Même les disques tremblent!\r</language>
	</row>
	<row id="msg_0309_00120" index="120">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Est-ce un avion? Une fusée?\nNon, c’est...\r</language>
	</row>
	<row id="msg_0309_00121" index="121">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Volez au firmament de la victoire!\r</language>
	</row>
	<row id="msg_0309_00122" index="122">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils sont les rois des airs!\r</language>
	</row>
	<row id="msg_0309_00123" index="123">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils sont à moitié oiseaux!\r</language>
	</row>
	<row id="msg_0309_00124" index="124">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Personne ne peut les arrêter!\nIls sont nés en courant!\r</language>
	</row>
	<row id="msg_0309_00125" index="125">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils sont montés sur batterie?\nIls ne s’arrêtent jamais de courir!\r</language>
	</row>
	<row id="msg_0309_00126" index="126">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils ne s’arrêtent jamais de courir...\nCe sont des machines ou quoi?\r</language>
	</row>
	<row id="msg_0309_00127" index="127">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils carburent à l’amitié!\nLe moteur de leur victoire!\r</language>
	</row>
	<row id="msg_0309_00128" index="128">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quelle posture parfaite! Tous les\nPokémon tombent... (dans le piège)!\r</language>
	</row>
	<row id="msg_0309_00129" index="129">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il ne doit en rester qu’un...\nIls auront viré tous les autres!\r</language>
	</row>
	<row id="msg_0309_00130" index="130">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les rois du ring!\nIls y sont, ils y restent!\r</language>
	</row>
	<row id="msg_0309_00131" index="131">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le ring vous fera découvrir ce qui est\nau fond... de chacun de vous!\r</language>
	</row>
	<row id="msg_0309_00132" index="132">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La victoire est drapée de blanc... celui\nde la neige qui couvre les adversaires!\r</language>
	</row>
	<row id="msg_0309_00133" index="133">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chaque boule de neige envoyée est un\nticket vers la victoire!\r</language>
	</row>
	<row id="msg_0309_00134" index="134">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On dirait une mitraillette!\nOups, elle était pour qui celle-là?\r</language>
	</row>
	<row id="msg_0309_00135" index="135">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Elles se dédoublent ou quoi?\nJ’en perds la boule!\r</language>
	</row>
	<row id="msg_0309_00136" index="136">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ces ballons filent droit vers les buts...\net la victoire!\r</language>
	</row>
	<row id="msg_0309_00137" index="137">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quel splendide travail d’équipe!\r</language>
	</row>
	<row id="msg_0309_00138" index="138">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un but pour la victoire!\r</language>
	</row>
	<row id="msg_0309_00139" index="139">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils vivent pour le ballon...\nOu peut-être DANS le ballon?\r</language>
	</row>
	<row id="msg_0309_00140" index="140">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Des points pour ces jeunes champions!\nIls transpirent le fair-play!\r</language>
	</row>
	<row id="msg_0309_00141" index="141">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les erreurs les font sourire! Le\nPokéathlon, c’est aussi pour le plaisir!\r</language>
	</row>
	<row id="msg_0309_00142" index="142">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils veulent ce but, ils le prennent!\nQuitte à marquer chez eux...\r</language>
	</row>
	<row id="msg_0309_00143" index="143">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Marquer contre son équipe,\nc’est exprimer son attachement, non?\r</language>
	</row>
	<row id="msg_0309_00144" index="144">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils font tout pour se faire remarquer,\nparce que la victoire n’est pas tout!\r</language>
	</row>
	<row id="msg_0309_00145" index="145">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voilà les vedettes!\nAttendez un peu pour les autographes!\r</language>
	</row>
	<row id="msg_0309_00146" index="146">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si vous voulez voir comment ils gagnent,\nils vont vous montrer sans tarder!\r</language>
	</row>
	<row id="msg_0309_00147" index="147">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La victoire, oui, mais parce qu’ils\nne veulent pas décevoir les fans!\r</language>
	</row>
