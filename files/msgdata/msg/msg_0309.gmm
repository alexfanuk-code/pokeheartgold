	<row id="msg_0309_00246" index="246">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quels sont les résultats\nde la première épreuve?\r</language>
	</row>
	<row id="msg_0309_00247" index="247">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Qu’a donné la deuxième épreuve?\r</language>
	</row>
	<row id="msg_0309_00248" index="248">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Troisième et dernière épreuve...\nLa tension est à son comble!\r</language>
	</row>
	<row id="msg_0309_00249" index="249">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quels sont les résultats\nde la première épreuve?\r</language>
	</row>
	<row id="msg_0309_00250" index="250">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Qu’a donné la deuxième épreuve?\r</language>
	</row>
	<row id="msg_0309_00251" index="251">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah! Déjà les résultats\nde la troisième épreuve!\r</language>
	</row>
	<row id="msg_0309_00252" index="252">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quatrième et dernière épreuve...\nLa tension est à son comble!\r</language>
	</row>
	<row id="msg_0309_00253" index="253">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{SIZE 200}Equipe {STRVAR_1 3, 0, 0}!{SIZE 100}\rFélicitations pour\ncette première place!\r</language>
	</row>
	<row id="msg_0309_00254" index="254">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quel match serré!\r</language>
	</row>
	<row id="msg_0309_00255" index="255">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les résultats de cette épreuve\ndécideront de votre score!\r</language>
	</row>
	<row id="msg_0309_00256" index="256">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Donnez-vous à fond dans\nl’épreuve suivante!\r</language>
	</row>
	<row id="msg_0309_00257" index="257">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et ça ne fait que commencer!\nSoyez prêts pour la prochaine épreuve!\r</language>
	</row>
	<row id="msg_0309_00258" index="258">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Qu’est-ce qui nous attend dans\nla prochaine épreuve?\r</language>
	</row>
	<row id="msg_0309_00259" index="259">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Encore à se jauger mutuellement?\rIl est temps de sortir l’artillerie\nlourde avec l’épreuve qui suit!\r</language>
	</row>
	<row id="msg_0309_00260" index="260">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fin de la première épreuve!\rLes choses sérieuses vont pouvoir\ncommencer!\r</language>
	</row>
	<row id="msg_0309_00261" index="261">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La dernière épreuve!\rVa-t-on assister à un retournement de\nsituation?\r</language>
	</row>
	<row id="msg_0309_00262" index="262">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Donnez tout ce que vous avez pour\ncette ultime épreuve!\r</language>
	</row>
	<row id="msg_0309_00263" index="263">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Enfin, la dernière épreuve!\nQui va l’emporter? Quel suspens!\r</language>
	</row>
	<row id="msg_0309_00264" index="264">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tout va se jouer maintenant!\nFaites comme si demain n’existait pas!\r</language>
	</row>
	<row id="msg_0309_00265" index="265">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La foule est en délire pour\ncette dernière épreuve!\r</language>
	</row>
	<row id="msg_0309_00266" index="266">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voici les résultats finaux!\r</language>
	</row>
	<row id="msg_0309_00267" index="267">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Que vont nous apprendre ces résultats\nfinaux?\r</language>
	</row>
	<row id="msg_0309_00268" index="268">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Félicitations à tous!\nVoici les résultats finaux!\r</language>
	</row>
	<row id="msg_0309_00269" index="269">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Qui est donc notre grand vainqueur?\nVoici les résultats finaux!\r</language>
	</row>
	<row id="msg_0309_00270" index="270">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Qui sera couronné de lauriers?\nVoici les résultats finaux!\r</language>
	</row>
	<row id="msg_0309_00271" index="271">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Donnez-vous à fond dans\nl’épreuve suivante!\r</language>
	</row>
	<row id="msg_0309_00272" index="272">
