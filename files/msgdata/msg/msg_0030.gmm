<?xml version="1.0"?>
<body language="English">
	<row id="msg_0030_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bien le bonjour en cet étrange endroit!\nJe suis F. Otto, le vieux photographe!\rTu me sembles fort photogénique;\nça te dirait, une photo souvenir? {YESNO 0}</language>
	</row>
	<row id="msg_0030_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est décidé! Alors\nprends la pose!\r</language>
	</row>
	<row id="msg_0030_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bien! Très bien, même!\nElle est réussie, celle-là!\rTu peux regarder la photo\ndepuis ton PC!</language>
	</row>
	<row id="msg_0030_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Euh... Tiens? Attends un peu...\rMon instinct hors du commun m’avertit\nque ton Album Photo pourrait bien\fêtre rempli à ras bord!\rDésolé de te demander ça, mais ça te\ndérangerait de revenir me parler après\favoir fait un peu de place?</language>
	</row>
	<row id="msg_0030_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tiens?!\nTu n’as pas d’Album Photo...\rTu en auras besoin pour ranger\nla photo que je vais prendre.\rMon grand frère a un studio de photos\nsouvenir à Doublonville.\fIl pourra t’en donner un!</language>
	</row>
	<row id="msg_0030_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allons! Allons!\nTu n’as aucune raison d’être timide!</language>
	</row>
	<row id="msg_0030_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il y a un appareil photo automatique.\rVoulez-vous prendre une photo? {YESNO 0}</language>
	</row>
	<row id="msg_0030_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Alors, mettez-vous en position.\r</language>
	</row>
	<row id="msg_0030_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La photo a été prise correctement.</language>
	</row>
	<row id="msg_0030_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Votre Album Photo est plein!\rRevenez après y avoir fait le ménage.</language>
	</row>
	<row id="msg_0030_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous n’avez pas d’Album Photo.\rRevenez après en avoir reçu un\ndans le Doublon-Tunnel.</language>
	</row>
</body>
