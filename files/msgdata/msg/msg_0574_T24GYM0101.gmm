<?xml version="1.0"?>
<body language="English">
	<row id="msg_0574_T24GYM0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chuck: Wooooooh!!!\nLe flot impétueux qui se déverse\fsans discontinuer sur mon crâne\fviril me... Hé! Toi, la demi-portion!\rQui t’a permis de couper l’eau! J’vais\nt’montrer de quel bois j’me chauffe!\rEt tu vas voir, je suis balèze, moi!\nJe médite sous cette cascade\fplusieurs heures chaque jour!\rQuoi?\nÇa n’a aucun rapport avec les Pokémon?\r...\n... Ouais, c’est pas faux.\r...\n...\rBon, allez, finissons-en.\r</language>
	</row>
	<row id="msg_0574_T24GYM0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Urgh...\n...\rAaaaargh!!!</language>
	</row>
	<row id="msg_0574_T24GYM0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Alors! Ça t’en bouche un coin, hein!\rQuoi?\nÇa n’a aucun rapport avec les Pokémon?\rOuais, c’est pas faux.\nAllez, finissons-en!\r</language>
	</row>
	<row id="msg_0574_T24GYM0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chuck: Ça alors...\nJe m’attendais pas à perdre!\rTiens! Tu as bien mérité ce\nBadge Choc!\r</language>
	</row>
	<row id="msg_0574_T24GYM0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} reçoit le Badge Choc\nde Chuck!</language>
	</row>
	<row id="msg_0574_T24GYM0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chuck: Avec ce Badge, tu pourras\nutiliser Vol pour revenir en un instant\fà une ville déjà visitée!\rAh, et tant qu’on y est,\nprends ça!\r</language>
	</row>
	<row id="msg_0574_T24GYM0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chuck: La CT01 contient Mitra-Poing!\rIl faut attaquer en premier, sinon elle\néchoue, mais si tu y arrives,\felle fait des dégâts gigantesques!</language>
	</row>
	<row id="msg_0574_T24GYM0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha, ton Sac est plein!</language>
	</row>
	<row id="msg_0574_T24GYM0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chuck: Hahaha!\nJe me suis bien amusé avec toi!\rMais une défaite est une défaite! Je\nvais reprendre l’entraînement 24h/24!</language>
	</row>
	<row id="msg_0574_T24GYM0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il est plongé dans sa méditation,\nil ne vous entend pas.</language>
	</row>
	<row id="msg_0574_T24GYM0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il y a une grosse vanne.\nVoulez-vous la tourner? {YESNO 0}</language>
	</row>
	<row id="msg_0574_T24GYM0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} tourne la vanne\nde toutes ses forces!\r</language>
	</row>
	<row id="msg_0574_T24GYM0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Elle ne tourne pas plus loin.</language>
	</row>
	<row id="msg_0574_T24GYM0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arène d’Irisia</language>
	</row>
	<row id="msg_0574_T24GYM0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arène d’Irisia\rChampion: Chuck\nDresseur estimé:\f{STRVAR_1 3, 0, 0}</language>
	</row>
</body>
