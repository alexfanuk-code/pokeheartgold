<?xml version="1.0"?>
<body language="English">
	<row id="msg_0333_R05R0401_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Griiiiiiiiih!!!\rJe sens une présence maléfique\nplaner sur toi!\rTu auras besoin de ce talisman!\r</language>
	</row>
	<row id="msg_0333_R05R0401_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu l’as échappé belle... Mais tu n’as\nplus rien à craindre maintenant!</language>
	</row>
	<row id="msg_0333_R05R0401_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma grand-mère est passionnée par\nses exorcismes...\rExcuse-la si elle t’a fait peur.</language>
	</row>
</body>
