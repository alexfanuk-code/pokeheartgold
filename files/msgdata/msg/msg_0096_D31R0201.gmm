<?xml version="1.0"?>
<body language="English">
	<row id="msg_0096_D31R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue dans la Tour de Combat!\rJe suis votre guide pour les\nSalles de Combat Solo et Duo.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous relever le défi\nd’une Salle de Combat? {YESNO 0}</language>
	</row>
	<row id="msg_0096_D31R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A une prochaine fois peut-être!</language>
	</row>
	<row id="msg_0096_D31R0201_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La Tour de Combat propose des Combats\nSolo et des Combats Duo.\rUne fois à l’intérieur, les combats\ns’enchaînent jusqu’à votre défaite.\rEn Combat Solo, vous avez droit à trois\nPokémon.\rEn Combat Duo, vous entrez avec quatre\nPokémon.\rChaque combat se déroule dans une des\nnombreuses Salles de Combat de la tour.\rDans chacune des Salles de Combat,\nsept Dresseurs vous attendent.\rSi vous parvenez à tous les vaincre,\nvous gagnerez des PCo.\rSi vous voulez interrompre votre\nprogression, vous devrez sauvegarder.\rSi vous ne le faites pas, nous\ndevrons vous disqualifier.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dans quelle Salle de Combat\nvoulez-vous aller? Solo ou Duo? {YESNO 0}</language>
	</row>
	<row id="msg_0096_D31R0201_00005" index="5">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0096_D31R0201_00006" index="6">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0096_D31R0201_00007" index="7">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0096_D31R0201_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Veuillez choisir les Pokémon à inscrire.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous ne pouvez inscrire\ndeux Pokémon identiques.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les objets portés doivent\ntous être différents.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Veuillez me suivre dans la\nSalle de Combat.</language>
	</row>
	<row id="msg_0096_D31R0201_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Félicitations!\nVous avez gagné les sept combats!\r</language>
	</row>
	<row id="msg_0096_D31R0201_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Félicitations!\nVous avez battu l’Aigle Tour!\rPour récompenser vos efforts, nous\nvous offrons des Points de Combat!\r{STRVAR_1 3, 0, 0} obtient {STRVAR_1 50, 1, 0} PCo.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sauvegarde en cours...\nNe pas éteindre.</language>
	</row>
	<row id="msg_0096_D31R0201_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A une prochaine fois peut-être!</language>
	</row>
	<row id="msg_0096_D31R0201_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nous vous attendions!\rAvant de continuer, votre partie\ndoit être sauvegardée.</language>
	</row>
	<row id="msg_0096_D31R0201_00017" index="17">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0096_D31R0201_00018" index="18">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0096_D31R0201_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je regrette.\rVous n’avez pas sauvegardé avant\nl’interruption de votre dernier défi.\rPar conséquent, nous sommes\nobligés de vous disqualifier!\r</language>
	</row>
	<row id="msg_0096_D31R0201_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue dans la Tour de Combat!\rJe serai votre guide dans les\nSalles de Combat Multi!\r</language>
	</row>
	<row id="msg_0096_D31R0201_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous relever le défi d’une\nSalle de Combat Multi? {YESNO 0}</language>
	</row>
	<row id="msg_0096_D31R0201_00022" index="22">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0096_D31R0201_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Salles de Combat Multi de la\nTour de Combat sont consacrées\faux Combats Multi.\rPour les Combats Multi, vous devez\nfaire équipe avec un autre Dresseur.\rVous entrerez avec 2 Pokémon chacun.\rA l’intérieur de la tour, il y a une salle\nappelée le Salon de Combat où vous\fpouvez rencontrer d’autres Dresseurs.\rVous pourrez y trouver un\npartenaire avec qui faire équipe.\rVous pouvez aussi faire équipe avec un\nami via la communication sans fil.\rVotre équipe formée, vous pourrez\naccéder à une Salle de Combat Multi.\rDans chacune des Salles de Combat\nMulti, sept équipes vous attendent.\rSi vous parvenez à toutes les battre,\nvous obtiendrez des Points de Combat.\rSi vous voulez interrompre votre\nprogression, vous devrez sauvegarder.\rSi vous ne le faites pas, nous\ndevrons vous disqualifier.\rNéanmoins, si vous faites équipe\navec un ami, vous ne pourrez\fpas interrompre la partie.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00024" index="24">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0096_D31R0201_00025" index="25">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0096_D31R0201_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous communiquer avec\nun ami pour faire équipe? {YESNO 0}</language>
	</row>
	<row id="msg_0096_D31R0201_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’un de vous deux devra sélectionner\n“MENEUR”.\rL’autre Dresseur devra choisir\n“JOINDRE”. {YESNO 0}</language>
	</row>
	<row id="msg_0096_D31R0201_00028" index="28">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0096_D31R0201_00029" index="29">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0096_D31R0201_00030" index="30">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0096_D31R0201_00031" index="31">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0096_D31R0201_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Veuillez me suivre dans la\nSalle de Combat Multi.</language>
	</row>
	<row id="msg_0096_D31R0201_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les deux Dresseurs ont choisi le\nPokémon {STRVAR_1 0, 0, 0}.\rVeuillez choisir des Pokémon différents.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les deux Dresseurs ont choisi les\nPokémon {STRVAR_1 0, 0, 0} et {STRVAR_1 0, 1, 0}.\rVeuillez choisir des Pokémon différents.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Veuillez me suivre dans le\nSalon de Combat.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue dans la Tour de Combat!\rJe suis votre guide pour les\nSalles de Combat Wi-Fi.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous relever le défi d’une\nSalle de Combat Wi-Fi? {YESNO 0}</language>
	</row>
	<row id="msg_0096_D31R0201_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Salles de Combat Wi-Fi de la Tour\nde Combat sont consacrées aux combats\fvia la connexion Wi-Fi (CWF) Nintendo.\rDans les Combats Wi-Fi, vous\naffronterez des Dresseurs du\fmonde entier via la CWF Nintendo.\rDans chacune des Salles de Combat\nWi-Fi, sept Dresseurs vous attendent.\rSi vous parvenez à tous les battre,\nvous obtiendrez des Points de Combat.\rSelon vos résultats, vous pourrez\nmême devenir le leader de la salle.\rEn effet, les Salles de Combat Wi-Fi\nsont régies par un système de rangs.\rLes Dresseurs accumulant les victoires\nverront leur rang s’améliorer.\rEn revanche, ceux qui accumulent les\ndéfaites perdront des rangs.\rPour atteindre plus rapidement\nles premières places, gagnez\fcontre des Dresseurs plus forts!\rSi vous voulez interrompre votre \nprogression, vous devrez sauvegarder.\rSi vous ne le faites pas, nous\ndevrons vous disqualifier.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A une prochaine fois peut-être!</language>
	</row>
