	<row id="msg_0777_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Faites tourner le ballon pour empêcher\nMIME JR. de tomber.</language>
	</row>
	<row id="msg_0777_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jetez des Baies dans la bouche\nd’AVALTOUT.</language>
	</row>
	<row id="msg_0777_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Utilisez la pompe QULBUTOKE pour\nfaire éclater des ballons.</language>
