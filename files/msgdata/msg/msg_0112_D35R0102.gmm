<?xml version="1.0"?>
<body language="English">
	<row id="msg_0112_D35R0102_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé là!\nUn intrus! Plus un geste!\r</language>
	</row>
	<row id="msg_0112_D35R0102_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est mon tour!\nTu ne nous échapperas pas!\r</language>
	</row>
	<row id="msg_0112_D35R0102_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une statue de PERSIAN...\nSes yeux rouges brillent...!\rVous avez l’impression que quelqu’un,\nquelque part, vous épie...</language>
	</row>
	<row id="msg_0112_D35R0102_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une statue de PERSIAN...\nSes yeux bleus brillent...!\rVous n’avez plus l’impression\nd’être épié...</language>
	</row>
	<row id="msg_0112_D35R0102_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une statue de PERSIAN...\nSes yeux ne brillent plus...</language>
	</row>
	<row id="msg_0112_D35R0102_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un interrupteur caché!\rUne diode rouge clignote\nde façon inquiétante.\fVoulez-vous l’actionner? {YESNO 0}</language>
	</row>
	<row id="msg_0112_D35R0102_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un interrupteur caché!\rLa diode bleue est allumée.\nVoulez-vous l’actionner? {YESNO 0}</language>
	</row>
	<row id="msg_0112_D35R0102_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">... Clic!\r</language>
	</row>
	<row id="msg_0112_D35R0102_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La diode de l’interrupteur caché est\néteinte...</language>
	</row>
	<row id="msg_0112_D35R0102_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le système de surveillance\nest désactivé!</language>
	</row>
	<row id="msg_0112_D35R0102_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le système de surveillance\nest activé!</language>
	</row>
</body>
