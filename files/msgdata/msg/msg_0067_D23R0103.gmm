<?xml version="1.0"?>
<body language="English">
	<row id="msg_0067_D23R0103_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nous possédons un enregistrement de\ntous les cris de Pokémon que nous\fconnaissons.\fIl y en a près de 200 différents.</language>
	</row>
	<row id="msg_0067_D23R0103_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Pokémon sont les partenaires\nchéris des Dresseurs, non?\rC’est vraiment affreux d’ordonner\ndes choses aussi horribles\faux Pokémon!</language>
	</row>
	<row id="msg_0067_D23R0103_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nous diffusons 24h sur 24!\rEt moi, je suis prêt à garder le micro\n24h sur 24 pour amuser mon public!</language>
	</row>
	<row id="msg_0067_D23R0103_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Leur chef s’est barricadé derrière\ncette porte.\rMais le directeur peut l’ouvrir!\nIl est au 4⁴...\rSauve-le! Par pitié!\n</language>
	</row>
	<row id="msg_0067_D23R0103_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le directeur est-il en sécurité?</language>
	</row>
	<row id="msg_0067_D23R0103_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci! Tu es notre sauveur!\nPrends ceci, en récompense!\r</language>
	</row>
	<row id="msg_0067_D23R0103_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} reçoit la CT 11!</language>
	</row>
	<row id="msg_0067_D23R0103_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Elle renferme Zénith. En l’utilisant,\ntu renforces temporairement\fles capacités de type Feu.</language>
	</row>
	<row id="msg_0067_D23R0103_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tiens? Ton Sac est plein.</language>
	</row>
	<row id="msg_0067_D23R0103_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’était vraiment du grand spectacle!</language>
	</row>
	<row id="msg_0067_D23R0103_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La porte est fermée...\nIl faut la Carte Magnétique!</language>
	</row>
	<row id="msg_0067_D23R0103_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un lecteur de Carte Magnétique.\r</language>
	</row>
	<row id="msg_0067_D23R0103_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} insère\nla Carte Magnétique.\r</language>
	</row>
	<row id="msg_0067_D23R0103_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il faut une Carte Magnétique\npour ouvrir cette porte!</language>
	</row>
	<row id="msg_0067_D23R0103_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un lecteur de Carte Magnétique</language>
	</row>
	<row id="msg_0067_D23R0103_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">2⁴: Personnel</language>
	</row>
	<row id="msg_0067_D23R0103_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Musique Pokémon\navec DJ Ben</language>
	</row>
</body>
