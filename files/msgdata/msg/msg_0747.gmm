	<row id="msg_0747_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 6, 0, 0} est la capacité qui doit\nêtre oubliée?</language>
	</row>
	<row id="msg_0747_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">De quelle capacité {STRVAR_1 1, 0, 0} doit se\nsouvenir?</language>
	</row>
	<row id="msg_0747_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Pokémon doit se souvenir de\n{STRVAR_1 6, 1, 0}?</language>
	</row>
	<row id="msg_0747_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0} ne doit plus se souvenir\nde la capacité?</language>
	</row>
	<row id="msg_0747_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0} se souvient de la\ncapacité {STRVAR_1 6, 1, 0} oubliée!\r</language>
	</row>
	<row id="msg_0747_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0} veut se souvenir de la\ncapacité {STRVAR_1 6, 1, 0}.\rMais {STRVAR_1 1, 0, 0} ne peut pas\napprendre plus de quatre capacités.\rEffacer une capacité\npour {STRVAR_1 6, 1, 0}?</language>
	</row>
	<row id="msg_0747_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">1, {PAUSE 20}2, et{PAUSE 20}... {PAUSE 20}... {PAUSE 20}... Tadaa!{WAIT 3}{WAIT 5}\r{STRVAR_1 1, 0, 0} oublie\n{STRVAR_1 6, 1, 0}.\rEt...\r</language>
