	<row id="msg_0747_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Enseigner quoi à\n{STRVAR_1 1, 0, 0}?</language>
	</row>
	<row id="msg_0747_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Enseigner\n{STRVAR_1 6, 1, 0}?</language>
	</row>
	<row id="msg_0747_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arrêter d’enseigner la nouvelle\ncapacité à {STRVAR_1 1, 0, 0}?</language>
	</row>
	<row id="msg_0747_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0} apprend\n{STRVAR_1 6, 1, 0}.\r</language>
	</row>
	<row id="msg_0747_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0} tente d’apprendre\n{STRVAR_1 6, 1, 0}.\rMais {STRVAR_1 1, 0, 0} ne peut pas\napprendre plus de quatre capacités.\rEffacer une capacité\npour {STRVAR_1 6, 1, 0}?</language>
	</row>
	<row id="msg_0747_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">1{PAUSE 20}, 2{PAUSE 20}, {PAUSE 20}... {PAUSE 20}... Tadaa!{WAIT 3}{WAIT 5}\r{STRVAR_1 1, 0, 0} oublie\n{STRVAR_1 6, 1, 0}.\rEt...\r</language>
	</row>
	<row id="msg_0747_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0}\napprend {STRVAR_1 6, 1, 0}.{WAIT 4}{WAIT 2}\r</language>
	</row>
	<row id="msg_0747_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arrêter d’apprendre\n{STRVAR_1 6, 1, 0}?</language>
	</row>
	<row id="msg_0747_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0} n’a pas appris la\ncapacité {STRVAR_1 6, 1, 0}.\r</language>
	</row>
