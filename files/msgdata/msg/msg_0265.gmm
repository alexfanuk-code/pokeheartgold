	<row id="msg_0265_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais? On dirait que {STRVAR_1 1, 0, 0} tient\nquelque chose...\rLui prendre cet objet? {YESNO 0}</language>
	</row>
	<row id="msg_0265_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On dirait que {STRVAR_1 1, 0, 0} a l’air\ncontent d’avoir trouvé quelque chose.</language>
	</row>
	<row id="msg_0265_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">!!! Il a l’air d’y tenir et refuse de le\ncéder!</language>
