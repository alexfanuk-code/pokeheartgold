	<row id="msg_0430_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un bosquet herbu.\nLes Pokémon vivant dans les herbes\nl’apprécient.</language>
	</row>
	<row id="msg_0430_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une fleur aux couleurs éclatantes.\nLes Pokémon vivant dans les herbes\nl’apprécient.</language>
	</row>
	<row id="msg_0430_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une fleur aux couleurs tendres.\nLes Pokémon vivant dans les herbes\nl’apprécient.</language>
	</row>
	<row id="msg_0430_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un petit arbre.\nLes Pokémon vivant dans les bois\nl’apprécient.</language>
	</row>
	<row id="msg_0430_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La souche d’un arbre coupé.\nLes Pokémon vivant dans les bois\nl’apprécient.</language>
	</row>
	<row id="msg_0430_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un tas de branches cassées.\nLes Pokémon vivant dans les bois\nl’apprécient.</language>
	</row>
	<row id="msg_0430_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un petit rocher rond.\nLes Pokémon vivant dans les rochers\nl’apprécient.</language>
	</row>
	<row id="msg_0430_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un gros rocher irrégulier.\nLes Pokémon vivant dans les rochers\nl’apprécient.</language>
	</row>
	<row id="msg_0430_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un rocher couvert de mousse.\nLes Pokémon vivant dans les rochers\nl’apprécient.</language>
	</row>
	<row id="msg_0430_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">De l’eau accumulée sur le sol.\nLes Pokémon vivant dans l’eau\nl’apprécient.</language>
	</row>
	<row id="msg_0430_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On peut en créer grâce à Surf.\nLes Pokémon vivant dans l’eau\nl’apprécient.</language>
	</row>
	<row id="msg_0430_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une eau fraîche et pure en sort.\nLes Pokémon vivant dans l’eau\nl’apprécient.</language>
	</row>
	<row id="msg_0430_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un long banc étroit.\nOn en voit souvent dans les parcs et\nles aires de repos.</language>
	</row>
	<row id="msg_0430_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une courte haie horizontale.\nIl est possible d’en raccorder plusieurs\npour clôturer une zone, comme un étang.</language>
	</row>
	<row id="msg_0430_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une courte haie verticale.\nIl est possible d’en raccorder plusieurs\npour clôturer une zone, comme un étang.</language>
	</row>
	<row id="msg_0430_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une longue haie horizontale.\nIl est possible d’en raccorder plusieurs\npour clôturer une zone, comme un étang.</language>
	</row>
	<row id="msg_0430_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une longue haie verticale.\nIl est possible d’en raccorder plusieurs\npour clôturer une zone, comme un étang.</language>
	</row>
	<row id="msg_0430_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un panneau en bois.\nIl est constitué d’un poteau planté dans\nle sol et d’une planche.</language>
	</row>
	<row id="msg_0430_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une fidèle reproduction de vous en\npierre. Goûtez à la gloire!</language>
	</row>
	<row id="msg_0430_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un drapeau à votre effigie.\nGoûtez à la mégalomanie!</language>
	</row>
	<row id="msg_0430_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un lumineux réverbère.\nAlignez-en plusieurs pour baigner le\nparc dans une douce lumière la nuit.</language>
	</row>
	<row id="msg_0430_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un panneau qui indique la droite.\nLes gens qui le verront suivront\nsûrement la flèche.</language>
	</row>
	<row id="msg_0430_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un panneau qui indique la gauche.\nLes gens qui le verront suivront\nsûrement la flèche.</language>
	</row>
	<row id="msg_0430_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un panier pour jeter les déchets.\nUtilisons-le, ou ramenons les ordures\nà la maison!</language>
	</row>
