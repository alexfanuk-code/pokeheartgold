<?xml version="1.0"?>
<body language="English">
	<row id="msg_0041_00000" index="0">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0041_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erreur de communication.\nSi vous étiez dans la Salle Union,\nappuyez sur le bouton A pour\nredémarrer la communication sans\nfil DS et revenir dans la Salle Union,\nou appuyez sur B pour retourner\nà l’écran titre. Autrement, appuyez\nsur A pour retourner à votre dernier\npoint de sauvegarde.</language>
	</row>
	<row id="msg_0041_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une erreur est survenue lors de la\ncommunication. ({STRVAR_1 54, 0, 0})\nVeuillez éteindre la Nintendo DS,\nla rallumer et réessayer.\n\nSi ce message apparaît de nouveau,\ncontactez le service consommateurs\nNintendo.</language>
	</row>
	<row id="msg_0041_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erreur de communication.\n\nVous allez être renvoyé à\nl’écran titre.\nVeuillez appuyer sur le bouton A.</language>
	</row>
	<row id="msg_0041_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Soit la GTS connaît un trafic trop\nimportant, soit le service est\ninterrompu. Veuillez réessayer\nultérieurement.\n\nVous avez été déconnecté de la\nconnexion Wi-Fi Nintendo. Veuillez\nappuyer sur le bouton A.</language>
	</row>
	<row id="msg_0041_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une erreur est survenue lors de la\ncommunication.\nVeuillez éteindre la console Nintendo\nDS, la rallumer et réessayer.\n\nSi ce message apparaît de nouveau,\ncontactez le service consommateurs\nNintendo.</language>
	</row>
	<row id="msg_0041_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erreur de communication.\n\nVous avez été déconnecté de la\nconnexion Wi-Fi Nintendo.\nVous allez être renvoyé à\nl’endroit de votre dernière\nsauvegarde.\nVeuillez appuyer sur le bouton A.</language>
	</row>
	<row id="msg_0041_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erreur de communication.\n\nVous avez été déconnecté de la\nconnexion Wi-Fi Nintendo.\nVous allez être renvoyé à\nl’écran titre.\nVeuillez appuyer sur le bouton A.</language>
	</row>
	<row id="msg_0041_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erreur de communication ({STRVAR_1 54, 0, 0}).\n\nVous avez été déconnecté de la\nconnexion Wi-Fi Nintendo.\nVous allez être renvoyé à\nl’endroit de votre dernière\nsauvegarde.\nVeuillez appuyer sur le bouton A.</language>
	</row>
	<row id="msg_0041_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erreur de communication ({STRVAR_1 54, 0, 0}).\n\nVous avez été déconnecté de la\nconnexion Wi-Fi Nintendo.\nVous allez être renvoyé à\nl’écran titre.\nVeuillez appuyer sur le bouton A.</language>
	</row>
</body>
