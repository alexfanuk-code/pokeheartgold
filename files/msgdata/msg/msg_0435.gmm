		<language name="日本語"></language>
	</row>
	<row id="msg_0435_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 51, 0, 0}, ça fait\n{STRVAR_1 55, 1, 0} $.</language>
	</row>
	<row id="msg_0435_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voilà!\nMerci beaucoup!{WAIT 1}\rVous placez votre achat\ndans la Poche {STRVAR_1 27, 1, 0}.</language>
	</row>
	<row id="msg_0435_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous n’avez plus de place pour cela.</language>
	</row>
	<row id="msg_0435_00017" index="17">
