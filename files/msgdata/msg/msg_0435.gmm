		<language name="日本語"></language>
	</row>
	<row id="msg_0435_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nous espérons vous revoir bientôt!</language>
	</row>
	<row id="msg_0435_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Très bien. A la prochaine!</language>
	</row>
	<row id="msg_0435_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reviens me voir!</language>
	</row>
	<row id="msg_0435_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah oui, vraiment?\nReviens-nous vite!\fFyuuuyuuu!</language>
	</row>
	<row id="msg_0435_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">N’hésite pas à revenir!\nMais n’oublie pas que nous fermons\fle soir!</language>
	</row>
	<row id="msg_0435_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Souhaitez-vous autre chose? {YESNO 0}</language>
	</row>
	<row id="msg_0435_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">T’as besoin d’autre chose? {YESNO 0}</language>
	</row>
	<row id="msg_0435_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Y-t’faut encore quéqu’chose? {YESNO 0}</language>
	</row>
	<row id="msg_0435_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Besoin d’autre chose?\nFyuuu! Fyuuu! {YESNO 0}</language>
	</row>
	<row id="msg_0435_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Autre chose? {YESNO 0}</language>
	</row>
	<row id="msg_0435_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous n’avez pas assez d’argent.</language>
	</row>
	<row id="msg_0435_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 8, 0, 0}? OK!\nCombien en voulez-vous?</language>
	</row>
	<row id="msg_0435_00013" index="13">
		<attribute name="window_context_name">garbage</attribute>
