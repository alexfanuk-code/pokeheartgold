<?xml version="1.0"?>
<body language="English">
	<row id="msg_0259_P01R0301_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Bateau Express Aquaria se dirige\nvers Carmin sur Mer.\rNous ferons une annonce lorsque nous\narriverons.</language>
	</row>
	<row id="msg_0259_P01R0301_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Bateau Express Aquaria se dirige\nvers Oliville.\rNous ferons une annonce lorsque nous\narriverons.</language>
	</row>
	<row id="msg_0259_P01R0301_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Bateau Express Aquaria est arrivé\nà Carmin sur Mer.\r</language>
	</row>
	<row id="msg_0259_P01R0301_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Bateau Express Aquaria est arrivé\nà Carmin sur Mer.</language>
	</row>
	<row id="msg_0259_P01R0301_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh?\nNous sommes déjà arrivés?\r</language>
	</row>
	<row id="msg_0259_P01R0301_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Bateau Express Aquaria est arrivé\nà Oliville.\r</language>
	</row>
	<row id="msg_0259_P01R0301_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Bateau Express Aquaria est arrivé\nà Oliville.</language>
	</row>
	<row id="msg_0259_P01R0301_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oups! Pardon...\nJ’ai un gros problème...!\rMa petite-fille a disparu,\net je la cherche!\rElle est toute jeune...\nPréviens-moi si tu la vois!\r</language>
	</row>
	<row id="msg_0259_P01R0301_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voici votre cabine.\rSi votre équipe Pokémon est mal\nen point, allongez-vous dans le lit,\fet ça ira tout de suite mieux!</language>
	</row>
	<row id="msg_0259_P01R0301_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voici votre cabine.\rDormez dans votre lit pour soigner\nvos Pokémon. Le bateau arrivera\fpendant votre sieste.</language>
	</row>
	<row id="msg_0259_P01R0301_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La plupart des passagers sont\ndes Dresseurs.\rNombre d’entre eux veulent se battre\ndans leur cabine.</language>
	</row>
</body>
