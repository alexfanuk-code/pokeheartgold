<?xml version="1.0"?>
<body language="English">
	<row id="msg_0531_T11GYM0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Morgane: Je savais que tu viendrais.\nJ’ai eu une vision il y a trois ans.\rTu en as après mon Badge, non?\nJe n’aime pas combattre mais en tant\fque Champion, je me dois de ne confier\fmon Badge qu’aux Dresseurs\fqui le méritent.\rComme tu insistes, prépare-toi à\naffronter mes pouvoirs psychiques!\r</language>
	</row>
	<row id="msg_0531_T11GYM0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Morgane: Ta force est grande...\nPlus encore que je ne l’avais prévu...\rPeut-être qu’il est impossible de\nprédire totalement l’avenir...\rBien. Tu as mérité ce Badge Marais.\r</language>
	</row>
	<row id="msg_0531_T11GYM0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} reçoit le Badge Marais\nde Morgane!</language>
	</row>
	<row id="msg_0531_T11GYM0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Morgane: J’ai été incapable de prévoir\nta puissance...\rCela signifie que ta puissance dépasse\nmes pouvoirs psychiques...\rTu mérites de recevoir en plus\nune Capsule Technique.\r</language>
	</row>
	<row id="msg_0531_T11GYM0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Morgane: Elle contient Echange, qui\nintervertit les capacités spéciales\fdes Pokémon.\rTon futur est radieux.\nTu deviendras Maître.</language>
	</row>
	<row id="msg_0531_T11GYM0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Morgane: Ton amour pour tes Pokémon a\nbrouillé mes pouvoirs psychiques...\rJe pense que l’amour est aussi une\nsorte de pouvoir surnaturel...</language>
	</row>
	<row id="msg_0531_T11GYM0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salut! Future légende!\rUn bon Dresseur comme toi sait\ndéjà comment battre des Pokémon\fdu type Psy, non?\rTu vas faire un beau combat!\nBonne chance!</language>
	</row>
	<row id="msg_0531_T11GYM0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quelle belle rencontre!</language>
	</row>
	<row id="msg_0531_T11GYM0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arène de Safrania</language>
	</row>
	<row id="msg_0531_T11GYM0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arène de Safrania\rChampion: Morgane\nDresseur estimé:\f{STRVAR_1 3, 0, 0}</language>
	</row>
</body>
