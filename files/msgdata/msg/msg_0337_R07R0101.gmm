	<row id="msg_0337_R07R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il paraît qu’il y a eu un incident\nà la Centrale...\rElle est de l’autre côté,\nvers Lavanville.</language>
	</row>
	<row id="msg_0337_R07R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je prends mon travail de vigile très\nau sérieux. Oh! Mais c’est un Pokédex!\fTu peux passer!</language>
	</row>
