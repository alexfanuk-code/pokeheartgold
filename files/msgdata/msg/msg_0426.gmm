	<row id="msg_0426_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le niveau des Pokémon de {STRVAR_1 3, 0, 0}\net {STRVAR_1 3, 1, 0} sera augmenté\fpour ce combat!</language>
	</row>
	<row id="msg_0426_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Pokémon de {STRVAR_1 3, 0, 0} seront\nempoisonnés avant le combat!</language>
	</row>
	<row id="msg_0426_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Pokémon de {STRVAR_1 3, 0, 0} et\n{STRVAR_1 3, 1, 0} seront empoisonnés\favant le combat!</language>
	</row>
	<row id="msg_0426_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Pokémon de {STRVAR_1 3, 0, 0} seront\nparalysés avant le combat!</language>
