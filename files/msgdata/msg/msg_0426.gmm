	<row id="msg_0426_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Pokémon de {STRVAR_1 3, 0, 0} et\n{STRVAR_1 3, 1, 0} seront paralysés\favant le combat!</language>
