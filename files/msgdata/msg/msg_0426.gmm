<?xml version="1.0"?>
<body language="English">
	<row id="msg_0426_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Avant tout, nous allons mettre de côté\ntous les objets tenus par vos Pokémon.\r</language>
	</row>
	<row id="msg_0426_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Veuillez patienter.</language>
	</row>
	<row id="msg_0426_00002" index="2">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0426_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Excellent!\nLaissez-moi soigner vos Pokémon.</language>
	</row>
	<row id="msg_0426_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Prochaine étape, le combat nº {STRVAR_1 53, 0, 0}!\nOn y va?</language>
	</row>
	<row id="msg_0426_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous enregistrer la vidéo du\ndernier combat sur le Magnéto VS?</language>
	</row>
	<row id="msg_0426_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La Vidéo de combat de {STRVAR_1 3, 0, 0}\na été sauvegardée.\r</language>
	</row>
	<row id="msg_0426_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une erreur est survenue.\nLa sauvegarde a échoué.\r</language>
	</row>
	<row id="msg_0426_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Effacer la Vidéo de combat précédente\npour enregistrer ce combat?</language>
	</row>
	<row id="msg_0426_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sauvegarde en cours...\nNe pas éteindre.</language>
	</row>
	<row id="msg_0426_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous sauvegarder et faire une\npause?</language>
	</row>
	<row id="msg_0426_00011" index="11">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
