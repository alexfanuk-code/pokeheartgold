	<row id="msg_0426_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Attente d’une réponse de {STRVAR_1 3, 0, 0}.\nVeuillez patienter.</language>
	</row>
	<row id="msg_0426_00017" index="17">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0426_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} a décidé d’abandonner.</language>
	</row>
	<row id="msg_0426_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue à l’Arcade de Combat!\r</language>
	</row>
	<row id="msg_0426_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Combat numéro {STRVAR_1 53, 0, 0}!\nC’est parti!</language>
	</row>
	<row id="msg_0426_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sans plus attendre...\nActivons le tableau de jeu!</language>
	</row>
	<row id="msg_0426_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et voici le résultat!</language>
	</row>
	<row id="msg_0426_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Pokémon de {STRVAR_1 3, 0, 0}\ncommenceront le combat avec\fdes PV en moins!</language>
	</row>
	<row id="msg_0426_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Pokémon de {STRVAR_1 3, 0, 0} et\n{STRVAR_1 3, 1, 0} commenceront le combat\favec des PV en moins!</language>
	</row>
	<row id="msg_0426_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le niveau des Pokémon de {STRVAR_1 3, 0, 0}\nsera augmenté pour ce combat!</language>
