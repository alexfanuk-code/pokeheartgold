	<row id="msg_0004_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}Se battre, avancer avec son ami\n{ALN_CENTER}Ce lien si puissant\n{ALN_CENTER}Jamais ne sera coupé\n{ALN_CENTER}Il appartient à l’éternité\n{ALN_CENTER}En témoigne ce document</language>
