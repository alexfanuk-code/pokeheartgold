	<row id="msg_0544_T20R0102_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah! {STRVAR_1 3, 0, 0}!\rMon mari est très occupé...\nJ’ai peur qu’il se surmène!\rQuand il se plonge dans ses recherches\nsur les Pokémon, il en oublie de manger!</language>
	</row>
	<row id="msg_0544_T20R0102_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah! {STRVAR_1 3, 0, 0}!\rMon mari est très occupé...\nJ’ai peur qu’il se surmène!\rQuand il se plonge dans ses recherches\nsur les Pokémon, il en oublie de manger!</language>
	</row>
	<row id="msg_0544_T20R0102_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moi, quand je serai grand, je veux\nêtre l’assistant de papa!\rEt je serai un super Professeur\nen Pokémon!</language>
	</row>
