<?xml version="1.0"?>
<body language="English">
	<row id="msg_0414_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chronique du Professeur Chen</language>
	</row>
	<row id="msg_0414_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lula et Chen</language>
	</row>
	<row id="msg_0414_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lula: Pour tous les amoureux\ndes Pokémon...\nLa Chronique du Professeur Chen.\nAvec moi, Lula!</language>
	</row>
	<row id="msg_0414_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon, Pokémon\nAntenne Pokémon!</language>
	</row>
	<row id="msg_0414_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Prof. Chen: {STRVAR_1 4, 0, 0}! C’est là\nqu’on trouve des {STRVAR_1 0, 1, 0}!</language>
	</row>
	<row id="msg_0414_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lula: Les {STRVAR_1 0, 1, 0}!\n{STRVAR_1 28, 2, 0}\n{STRVAR_1 28, 3, 0}</language>
	</row>
	<row id="msg_0414_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un coup d’œil suffit...</language>
	</row>
	<row id="msg_0414_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils apparaissent même en rêve!</language>
	</row>
	<row id="msg_0414_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon, je ne sais pas pourquoi mais...</language>
	</row>
	<row id="msg_0414_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il suffit qu’ils soient à côté...</language>
	</row>
	<row id="msg_0414_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On peut le prendre dans tous les sens...</language>
	</row>
	<row id="msg_0414_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quand on se promène avec...</language>
	</row>
	<row id="msg_0414_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En les appelant par leur nom...</language>
	</row>
	<row id="msg_0414_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En considérant les choses autrement...</language>
	</row>
	<row id="msg_0414_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils ressemblent à mon prof particulier!</language>
	</row>
	<row id="msg_0414_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est trop dur!</language>
	</row>
	<row id="msg_0414_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouais, quand même...</language>
	</row>
	<row id="msg_0414_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quand ils cherchent votre attention...</language>
	</row>
	<row id="msg_0414_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Plus qu’on ne pourrait l’imaginer...</language>
	</row>
	<row id="msg_0414_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On a trop envie de rire!</language>
	</row>
	<row id="msg_0414_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils font fondre le cœur!</language>
	</row>
	<row id="msg_0414_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On peut compter sur eux.</language>
	</row>
	<row id="msg_0414_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On ne les quitte plus des yeux!</language>
	</row>
	<row id="msg_0414_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On tombe sous leur charme.</language>
	</row>
	<row id="msg_0414_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils deviennent de bons amis.</language>
	</row>
	<row id="msg_0414_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tout le monde les adore!</language>
	</row>
	<row id="msg_0414_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est toujours surprenant!</language>
	</row>
	<row id="msg_0414_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quel pouvoir ils ont!</language>
	</row>
	<row id="msg_0414_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Y sont pas trop choux?</language>
	</row>
	<row id="msg_0414_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils sont vraiment cool!</language>
	</row>
	<row id="msg_0414_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça fait bizarre...</language>
	</row>
	<row id="msg_0414_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est bien des Pokémon, tiens!</language>
	</row>
	<row id="msg_0414_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lula: Dernière dépêche!\nOn dit qu’un troupeau de\n{STRVAR_1 0, 1, 0} se trouverait à\nl’endroit suivant: {STRVAR_1 4, 0, 0}.\nTous les Dresseurs qui veulent en\nrencontrer feraient bien de s’y hâter!\nC’était la dépêche du moment!</language>
	</row>
</body>
