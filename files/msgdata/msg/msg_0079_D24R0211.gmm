<?xml version="1.0"?>
<body language="English">
	<row id="msg_0079_D24R0211_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est la réplique d’un ancien Pokémon.</language>
	</row>
	<row id="msg_0079_D24R0211_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmmm...\nCe n’était pas là la dernière fois...\rQu’est-ce que ça veut dire...\n...\r</language>
	</row>
	<row id="msg_0079_D24R0211_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Retournons au Centre de Recherche!\nD’accord?\r</language>
	</row>
	<row id="msg_0079_D24R0211_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voilà ce qu’il y avait d’écrit\nsur la pierre...\r</language>
	</row>
	<row id="msg_0079_D24R0211_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AMITIE\nSUR VOUS VEILLONS\fSOYEZ HEUREUX\r</language>
	</row>
	<row id="msg_0079_D24R0211_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmmm... Qu’est-ce que ça veut dire...?\nJe crois que nous devrions retourner\finspecter les ruines.\r</language>
	</row>
	<row id="msg_0079_D24R0211_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} a pris des notes dans\nson Carnet ZARBI!</language>
	</row>
</body>
