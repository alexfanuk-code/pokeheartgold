<?xml version="1.0"?>
<body language="English">
	<row id="msg_0704_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Timéo</language>
	</row>
	<row id="msg_0704_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu en connais un rayon!\nC’est bien!\rOn s’échange des astuces?\nJe t’appelle si j’ai du nouveau.\rTu me donnes ton numéro? {YESNO 0}</language>
	</row>
	<row id="msg_0704_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je t’appelle si j’ai du nouveau.</language>
	</row>
	<row id="msg_0704_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, OK. Dommage.\rSi tu veux mon numéro, viens me voir,\nOK?</language>
	</row>
	<row id="msg_0704_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On s’échange des astuces?\nJe t’appelle si j’ai du nouveau.\rTu me donnes ton numéro? {YESNO 0}</language>
	</row>
	<row id="msg_0704_00005" index="5">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0704_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais pourquoi?\nPourquoi tu viens pas me voir?</language>
	</row>
	<row id="msg_0704_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon {STRVAR_1 0, 10, 0} est trop malin!\nIl est plus intelligent que tes Pokémon!\rA plus tard!</language>
	</row>
	<row id="msg_0704_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’autre jour, j’ai battu un\n{STRVAR_1 0, 11, 0}.\rLes trucs que tu m’as conseillés\nmarchent bien.\rA plus tard!</language>
	</row>
	<row id="msg_0704_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, écoute ça.\nJ’ai loupé un {STRVAR_1 0, 11, 0} de peu.\rJ’aurais dû faire plus attention...\nA plus tard!</language>
	</row>
	<row id="msg_0704_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le savais-tu?\rLorsqu’il pleut, Fatal-Foudre ne\nloupe jamais.</language>
	</row>
	<row id="msg_0704_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le savais-tu?\rSi tu lances Boul’Armure, la puissance\nde Roulade est boostée.</language>
	</row>
	<row id="msg_0704_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le savais-tu?\rSi le soleil brille, Lance-Soleil n’a pas\nbesoin de charger.</language>
	</row>
	<row id="msg_0704_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le savais-tu?\rSi l’ennemi lance Lilliput,\nEcrasement fera un max de dégâts.</language>
	</row>
	<row id="msg_0704_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le savais-tu?\rSi l’ennemi Vole, la capacité\nTornade sera plus puissante.</language>
	</row>
	<row id="msg_0704_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le savais-tu?\rSi l’ennemi Vole, la capacité\nOuragan sera plus puissante.</language>
	</row>
	<row id="msg_0704_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le savais-tu?\rSi l’ennemi lance Tunnel, la capacité\nSéisme sera plus puissante.</language>
	</row>
	<row id="msg_0704_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le savais-tu?\rSi l’ennemi lance Tunnel, la capacité\nAmpleur sera plus puissante.</language>
	</row>
	<row id="msg_0704_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le savais-tu?\rLes types Roche, Sol et Acier sont\ninsensibles à Tempêtesable.</language>
	</row>
	<row id="msg_0704_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le savais-tu?\rSi le soleil brille, les attaques de type\nEau sont plus faibles.</language>
	</row>
	<row id="msg_0704_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le savais-tu?\rS’il pleut, les attaques de type\nFeu sont plus faibles.</language>
	</row>
	<row id="msg_0704_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu veux te faire un p’tit match?\nJe vais te montrer ma stratégie.\rJe suis au {STRVAR_1 4, 3, 0}.\nAppelle-moi si ça te tente.</language>
	</row>
	<row id="msg_0704_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dis donc toi!\rTu te souviens de ta promesse?\nOn doit se battre!\rJe suis au {STRVAR_1 4, 3, 0}.</language>
	</row>
	<row id="msg_0704_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dis donc toi!\rTu te souviens de ta promesse?\nOn doit se battre!\rJe suis au {STRVAR_1 4, 3, 0}.</language>
	</row>
	<row id="msg_0704_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon pote a reçu de bons conseils.\nIl va m’en parler très bientôt.\rDès que j’en sais plus, je te passe\nun coup de fil.</language>
	</row>
</body>
