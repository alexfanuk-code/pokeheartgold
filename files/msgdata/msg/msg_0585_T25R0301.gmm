<?xml version="1.0"?>
<body language="English">
	<row id="msg_0585_T25R0301_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu sais, si tu traites tes Pokémon\navec amour, ils te le rendront!\rOh?\nTon Pokémon...\r</language>
	</row>
	<row id="msg_0585_T25R0301_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il a l’air très heureux!\nIl doit t’aimer énormément!</language>
	</row>
	<row id="msg_0585_T25R0301_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il a confiance en toi.\nDu moins c’est l’impression que j’ai.</language>
	</row>
	<row id="msg_0585_T25R0301_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il t’aime bien...\nIl a l’air assez heureux.</language>
	</row>
	<row id="msg_0585_T25R0301_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il est assez mignon.</language>
	</row>
	<row id="msg_0585_T25R0301_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu devrais prendre davantage soin de\nlui. Il n’est pas habitué à toi.</language>
	</row>
	<row id="msg_0585_T25R0301_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il n’a pas l’air de beaucoup t’aimer.\nJe n’aime pas son regard...</language>
	</row>
	<row id="msg_0585_T25R0301_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je perds toujours mes combats... Et\nmes Pokémon finissent toujours K.O.!\rC’est peut-être pour ça qu’ils ne\nm’aiment pas?</language>
	</row>
	<row id="msg_0585_T25R0301_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quand j’utilise certains objets sur mon\nPokémon, ça le rend vraiment heureux!</language>
	</row>
</body>
