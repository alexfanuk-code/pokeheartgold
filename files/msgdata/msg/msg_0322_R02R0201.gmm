<?xml version="1.0"?>
<body language="English">
	<row id="msg_0322_R02R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé! J’suis content de te voir. Ça fait\nlongtemps que je n’ai pas eu de visite.\fAh! Je suis tellement content!\rEt pour la peine, je vais t’offrir\nun p’tit cadeau.\r</language>
	</row>
	<row id="msg_0322_R02R0201_00001" index="1">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0322_R02R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est ma Pépite.\nPrends-en soin!\fC’est ma Pépite, quand même!</language>
	</row>
</body>
