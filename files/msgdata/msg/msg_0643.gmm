<?xml version="1.0"?>
<body language="English">
	<row id="msg_0643_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fargas</language>
	</row>
	<row id="msg_0643_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé, {STRVAR_1 1, 0, 0}!\nPlutôt qu’un coup de fil, pourquoi ne\fpas venir me parler directement?</language>
	</row>
	<row id="msg_0643_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis Fargas!\nHé, c’est pas toi, {STRVAR_1 1, 0, 0}?\r</language>
	</row>
	<row id="msg_0643_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai fini de faire des Poké Balls avec\nles Noigrumes que tu m’avais confiés!\rAlors, on a dit {STRVAR_1 8, 10, 0}... ça\nt’en fait {STRVAR_1 51, 11, 0}.\fTu peux passer chercher ça\fquand tu veux!</language>
	</row>
	<row id="msg_0643_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis en pleine fabrication!\nAttends encore un jour!</language>
	</row>
	<row id="msg_0643_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Apporte-moi des Noigrumes si tu veux\ndes Poké Balls!\fJe suis toujours à la maison!</language>
	</row>
	<row id="msg_0643_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oui allô? Papy n’est pas là, mais\nje vous écoute...\fAh, il vient d’arriver, je vous le passe!\r</language>
	</row>
</body>
