<?xml version="1.0"?>
<body language="English">
	<row id="msg_0002_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quit.</language>
	</row>
	<row id="msg_0002_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un Pokémon qui se cachait au\nfond des mers. Ses yeux\nscrutaient les environs.</language>
	</row>
	<row id="msg_0002_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un Pokémon qui arpentait le\nciel il y a fort longtemps\nsans connaître la peur.</language>
	</row>
	<row id="msg_0002_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un Pokémon planctophage qui\nparcourait le fond des océans\ngrâce à ses 10 tentacules.</language>
	</row>
	<row id="msg_0002_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On raconte qu’il survole le\nmonde en permanence avec ses\nmerveilleuses ailes colorées.</language>
	</row>
	<row id="msg_0002_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Etes-vous sûr de vouloir quitter?</language>
	</row>
</body>
