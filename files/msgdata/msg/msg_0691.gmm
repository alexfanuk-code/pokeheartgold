<?xml version="1.0"?>
<body language="English">
	<row id="msg_0691_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Anthony</language>
	</row>
	<row id="msg_0691_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Alors ça!\nToi t’es fortiche!\rQuoi? C’est toi? Tu as sauvé les\nRAMOLOSS, non?\rVoilà pourquoi t’es aussi balèze!\rJe peux avoir ton numéro?\rJe veux savoir tout\nce que tu fais! {YESNO 0}</language>
	</row>
	<row id="msg_0691_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OUAIS! Trop fort!\nJe peux t’appeler tout le temps\fmaintenant!\rOn va être trop potes!</language>
	</row>
	<row id="msg_0691_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, mais...\nJe suis pas bizarre, tu sais!\rJe veux juste parler...\nC’est tout! J’te jure!</language>
	</row>
	<row id="msg_0691_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu veux bien me donner\nton numéro? {YESNO 0}</language>
	</row>
	<row id="msg_0691_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu es dans le coin, non?</language>
	</row>
	<row id="msg_0691_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, tu es au courant?\rLa Tour Radio de Doublonville a été\nenvahie par la Team Rocket!\rHeu... Au fait, c’est quoi\nla Team Rocket?</language>
	</row>
	<row id="msg_0691_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, tu es au courant?\rLa Tour Radio de Doublonville a été\nenvahie par la Team Rocket!\rHeu... Au fait, c’est quoi\nla Team Rocket?</language>
	</row>
	<row id="msg_0691_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}!\rTu as battu Blanche?\nJe suis fier d’être ton ami!\rBon ben, à la prochaine!</language>
	</row>
	<row id="msg_0691_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}!\rTu as battu Blanche?\nJe suis fier d’être ton ami!\rBon ben, à la prochaine!</language>
	</row>
	<row id="msg_0691_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bah dis donc!\rTu as battu Mortimer de Rosalia!\nC’est... Incroyable!\rJ’étais venu à l’entrée de l’Arène pour\nt’encourager.\rMais bon...\nTous ces gens avec des bougies sur\fla tête... Brrr... Ça m’a fait peur,\fj’ai décampé...\rBon ben, à la prochaine!</language>
	</row>
	<row id="msg_0691_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bah dis donc!\rTu as battu Mortimer de Rosalia!\nC’est... Incroyable!\rJ’étais venu à l’entrée de l’Arène pour\nt’encourager.\rMais bon...\nTous ces gens avec des bougies sur\fla tête... Brrr... Ça m’a fait peur,\fj’ai décampé...\rBon ben, à la prochaine!</language>
	</row>
	<row id="msg_0691_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai entendu parler de toi!\rTu as sauvé un Pokémon au phare,\nnon?\r{STRVAR_1 3, 0, 0}, tu viendras me soigner\nsi je tombe malade?\rBon ben, à la prochaine!</language>
	</row>
	<row id="msg_0691_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai entendu parler de toi!\rTu as sauvé un Pokémon au phare,\nnon?\r{STRVAR_1 3, 0, 0}, tu viendras me soigner\nsi je tombe malade?\rBon ben, à la prochaine!</language>
	</row>
	<row id="msg_0691_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On parle de toi!\rTu as cassé le Repaire de\nla Team Rocket!\rT’es trop balèze!\nComme à la télé!\rMais... C’est quoi la Team Rocket?\rComment ça, je pige que dalle?</language>
	</row>
	<row id="msg_0691_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On parle de toi!\rTu as cassé le Repaire de\nla Team Rocket!\rT’es trop balèze!\nComme à la télé!\rMais... C’est quoi la Team Rocket?\rComment ça, je pige que dalle?</language>
	</row>
	<row id="msg_0691_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On parle de toi!\rTu as sauvé la Tour Radio!\nBravo, graine de star!\rIl fallait juste que je te félicite.\rBon ben, à la prochaine!</language>
	</row>
	<row id="msg_0691_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On parle de toi!\rTu as sauvé la Tour Radio!\nBravo, graine de star!\rIl fallait juste que je te félicite.\rBon ben, à la prochaine!</language>
	</row>
	<row id="msg_0691_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bah dis donc!\nTu as visité l’Antre du Dragon!\rTu as réussi l’épreuve? Allez!\nSois pas timide! Je suis sûr que oui!\rBon ben, à la prochaine!</language>
	</row>
	<row id="msg_0691_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bah dis donc!\nTu as visité l’Antre du Dragon!\rTu as réussi l’épreuve? Allez!\nSois pas timide! Je suis sûr que oui!\rBon ben, à la prochaine!</language>
	</row>
	<row id="msg_0691_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis allé à Bourg Geon hier.\rIl y avait une dame qui te ressemblait,\n{STRVAR_1 3, 0, 0}.\rQuoi? C’était ta maman?\rTu aurais dû me présenter!\nElle doit être fière de toi.\rMême moi, je suis fier de toi!\rBon ben, à la prochaine!</language>
	</row>
	<row id="msg_0691_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis allé à Bourg Geon hier.\rIl y avait une dame qui te ressemblait,\n{STRVAR_1 3, 0, 0}.\rQuoi? C’était ta maman?\rTu aurais dû me présenter!\nElle doit être fière de toi.\rMême moi, je suis fier de toi!\rBon ben, à la prochaine!</language>
	</row>
	<row id="msg_0691_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bah dis donc!\rTu as pris la mer, {STRVAR_1 3, 0, 0}!\nT’étais vraiment classe sur le bateau!\rC’est dur de devoir te laisser, mais...\nje dois y aller!\rBon ben, à la prochaine!</language>
	</row>
	<row id="msg_0691_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bah dis donc!\rTu as pris la mer, {STRVAR_1 3, 0, 0}!\nT’étais vraiment classe sur le bateau!\rC’est dur de devoir te laisser, mais...\nje dois y aller!\rBon ben, à la prochaine!</language>
	</row>
	<row id="msg_0691_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bah dis donc!\nTu as eu le Passe Train!\rQuand tu as pris le bateau, j’ai\ncru que tu partais pour toujours...\rMais vu que tu as le Passe, tu peux\nrevenir!\rQuoi? Tu peux aussi voler?\nComment ça... Voler?\rApprends-moi, s’il te plaît!</language>
	</row>
	<row id="msg_0691_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bah dis donc!\nTu as eu le Passe Train!\rQuand tu as pris le bateau, j’ai\ncru que tu partais pour toujours...\rMais vu que tu as le Passe, tu peux\nrevenir!\rQuoi? Tu peux aussi voler?\nComment ça... Voler?\rApprends-moi, s’il te plaît!</language>
	</row>
	<row id="msg_0691_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bah dis donc!\rTu as réveillé RONFLEX!\rJe te regardais de loin, je n’ai pas\nvu ce que tu as fait.\rTu as joué de la flûte?\nSuper, tu fais même de la magie!\rBon ben, à la prochaine!</language>
	</row>
	<row id="msg_0691_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bah dis donc!\rTu as réveillé RONFLEX!\rJe te regardais de loin, je n’ai pas\nvu ce que tu as fait.\rTu as joué de la flûte?\nSuper, tu fais même de la magie!\rBon ben, à la prochaine!</language>
	</row>
	<row id="msg_0691_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}!\nTu fais des ravages à Kanto!\rÇa doit être trop mortel!\nTu es le meilleur!\rBon ben, à la prochaine!</language>
	</row>
	<row id="msg_0691_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}!\nTu fais des ravages à Kanto!\rÇa doit être trop mortel!\nTu es la meilleure!\rBon ben, à la prochaine!</language>
	</row>
	<row id="msg_0691_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On parle de toi partout, {STRVAR_1 3, 0, 0}!\nJ’en ai le souffle coupé!\rComment as-tu pu arriver à un tel\nniveau?\rVas-y! Tu deviendras le meilleur du\nmonde! Et je serai toujours là pour\fte soutenir!\rBon ben, à la prochaine?</language>
	</row>
	<row id="msg_0691_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On parle de toi partout, {STRVAR_1 3, 0, 0}!\nJ’en ai le souffle coupé!\rComment as-tu pu arriver à un tel\nniveau?\rVas-y! Tu deviendras la meilleure du\nmonde! Et je serai toujours là pour\fte soutenir!\rBon ben, à la prochaine?</language>
	</row>
	<row id="msg_0691_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}!\nJ’ai hâte d’entendre le récit de tes\fnouvelles aventures!</language>
	</row>
	<row id="msg_0691_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}!\nJ’ai hâte d’entendre le récit de tes\fnouvelles aventures!</language>
	</row>
	<row id="msg_0691_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tes aventures m’inspirent...\nJ’te jure!</language>
	</row>
	<row id="msg_0691_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tes aventures m’inspirent...\nJ’te jure!</language>
	</row>
	<row id="msg_0691_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sérieux, {STRVAR_1 3, 0, 0}! A chaque fois\nque je pense à toi, j’en ai les\flarmes aux yeux!</language>
	</row>
	<row id="msg_0691_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sérieux, {STRVAR_1 3, 0, 0}! A chaque fois\nque je pense à toi, j’en ai les\flarmes aux yeux!</language>
	</row>
	<row id="msg_0691_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tes aventures m’inspirent...\nJ’te jure!</language>
	</row>
	<row id="msg_0691_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci d’avoir appelé!\rJ’allais justement faire ton numéro!\nOn est vraiment synchrones!</language>
	</row>
	<row id="msg_0691_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça va?\rTu fais quoi?\rT’es où?\rT’as combien de Badges?\rTu as beaucoup d’argent?\rÇa va ta mère?\rT’as beaucoup de Pokémon?\rIl va faire beau demain?\rJ’ai tant de trucs à te dire!</language>
	</row>
</body>
