<?xml version="1.0"?>
<body language="English">
	<row id="msg_0694_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Conan</language>
	</row>
	<row id="msg_0694_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé! Toi aussi tu veux devenir super\nméga balèze? Alors on est des amis!\rSi je trouve des objets près de l’eau,\nje t’en ferai profiter.\rDonne-moi juste ton numéro. {YESNO 0}</language>
	</row>
	<row id="msg_0694_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je t’appelle si je trouve quelque chose\nde bien.</language>
	</row>
	<row id="msg_0694_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah bon? Je vais tout garder, alors.</language>
	</row>
	<row id="msg_0694_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si je trouve des objets près de l’eau,\nje t’en ferai profiter.\rDonne-moi juste ton numéro. {YESNO 0}</language>
	</row>
	<row id="msg_0694_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voilà pour toi!\rUn cadeau, comme promis!\r</language>
	</row>
	<row id="msg_0694_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais, viens me voir directement au lieu\nde téléphoner!</language>
	</row>
	<row id="msg_0694_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon {STRVAR_1 0, 10, 0} a encore grandi.\rIl était si petit quand je l’ai\nattrapé.\rEt j’ai mis K.O. un {STRVAR_1 0, 11, 0}!\nIl était ENORME!\rPar téléphone, c’est dur à décrire...\rA plus tard.</language>
	</row>
	<row id="msg_0694_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon {STRVAR_1 0, 10, 0} a encore grandi.\rIl était si petit quand je l’ai\nattrapé.\rEt j’ai laissé fuir un {STRVAR_1 0, 11, 0}!\nIl était ENORME!\rPar téléphone, c’est dur à décrire...\rA plus tard.</language>
	</row>
	<row id="msg_0694_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il faut qu’on se batte!\rJe pêche vers la {STRVAR_1 4, 3, 0}.\nViens si tu as le temps.</language>
	</row>
	<row id="msg_0694_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quoi, tu as perdu ton chemin?\nTu ne sais plus où on doit faire\fle combat?\fC’est sur la {STRVAR_1 4, 3, 0}!</language>
	</row>
	<row id="msg_0694_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si j’ai trouvé quelque chose?\nPas encore.\rPatience. Comme à la pêche!</language>
	</row>
	<row id="msg_0694_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai trouvé un truc près de l’eau.\rComme promis, c’est pour toi.\nJ’attends sur la {STRVAR_1 4, 3, 0}.</language>
	</row>
	<row id="msg_0694_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai quelque chose pour toi.\rViens sur la {STRVAR_1 4, 3, 0}.</language>
	</row>
</body>
