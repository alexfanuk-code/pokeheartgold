<?xml version="1.0"?>
<body language="English">
	<row id="msg_0190_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Orme: Touche la Poké Ball pour en\nconnaître le contenu.</language>
	</row>
	<row id="msg_0190_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Orme: Préfères-tu {COLOR 3}GERMIGNON{COLOR 0},\nle Pokémon Plante?</language>
	</row>
	<row id="msg_0190_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Orme: Tu voudrais peut-être\n{COLOR 1}HERICENDRE{COLOR 0}, le Pokémon Feu?</language>
	</row>
	<row id="msg_0190_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Orme: {COLOR 2}KAIMINUS{COLOR 0}, le Pokémon Eau,\nest plus à ton goût?</language>
	</row>
	<row id="msg_0190_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cette Poké Ball contient\nle Pokémon Plante {COLOR 3}GERMIGNON{COLOR 0}.</language>
	</row>
	<row id="msg_0190_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cette Poké Ball contient le Pokémon Feu\n{COLOR 1}HERICENDRE{COLOR 0}.</language>
	</row>
	<row id="msg_0190_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cette Poké Ball contient le Pokémon Eau\n{COLOR 2}KAIMINUS{COLOR 0}.</language>
	</row>
	<row id="msg_0190_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Touchez la Poké Ball de votre choix!</language>
	</row>
	<row id="msg_0190_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Touchez la Poké Ball pour valider. Touchez\nen dehors pour réinitialiser les choix.</language>
	</row>
</body>
