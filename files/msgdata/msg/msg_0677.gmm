<?xml version="1.0"?>
<body language="English">
	<row id="msg_0677_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Carina</language>
	</row>
	<row id="msg_0677_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta force est bien réelle!\nJe voudrais te rencontrer à nouveau.\rC’est en combattant encore et encore\ndes Dresseurs de ton calibre que je\fpourrai m’endurcir moi aussi.\rSi tu veux bien...\nJe pourrais avoir ton numéro? {YESNO 0}</language>
	</row>
	<row id="msg_0677_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A très vite pour un combat, j’espère!</language>
	</row>
	<row id="msg_0677_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dommage...\nPréviens-moi si tu changes d’avis.</language>
	</row>
	<row id="msg_0677_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est en combattant encore et encore\ndes Dresseurs de ton calibre que je\fpourrai m’endurcir moi aussi.\rSi tu veux bien...\nJe pourrais avoir ton numéro? {YESNO 0}</language>
	</row>
	<row id="msg_0677_00005" index="5">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0677_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, tu n’es pas loin, non?\rTu ne voudrais pas venir me voir dans\nce cas?</language>
	</row>
	<row id="msg_0677_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu te souviens de mon {STRVAR_1 0, 10, 0}?\nIl court vraiment très vite!\rC’est grisant de lui monter dessus!\rSalut!</language>
	</row>
	<row id="msg_0677_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, as-tu déjà vu un {STRVAR_1 0, 11, 0}?\rJe viens d’en affronter un...\nIl était vraiment rapide!\fMais ça ne m’a pas empêché de gagner,\fbien sûr.\rSalut!</language>
	</row>
	<row id="msg_0677_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je viens de voir un {STRVAR_1 0, 11, 0}.\nJ’ai voulu l’attraper, mais je n’avais\fplus de Poké Balls.\rComme quoi, il faut toujours vérifier\nson équipement.\rSalut!</language>
	</row>
	<row id="msg_0677_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu ne voudrais pas combattre?\nJe gagnerai cette fois!\rJe t’attends sur la {STRVAR_1 4, 3, 0}.</language>
	</row>
	<row id="msg_0677_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Heu... {STRVAR_1 3, 0, 0}?\nAlors? Tu fais quoi?\fTu as oublié notre rendez-vous?\rJe t’attends sur la {STRVAR_1 4, 3, 0}!</language>
	</row>
	<row id="msg_0677_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Heu... {STRVAR_1 3, 0, 0}?\nAlors? Tu fais quoi?\fTu as oublié notre rendez-vous?\rJe t’attends sur la {STRVAR_1 4, 3, 0}!</language>
	</row>
	<row id="msg_0677_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Faisons un match un de ces jours!</language>
	</row>
</body>
