<?xml version="1.0"?>
<body language="English">
	<row id="msg_0591_T25R0901_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon... Bon...\nJe suis le Spécialiste des Noms.\rVeux-tu que j’examine les surnoms\nque tu as donnés à tes Pokémon? {YESNO 0}</language>
	</row>
	<row id="msg_0591_T25R0901_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon... Bon...\nQuel surnom de Pokémon veux-tu\fque j’examine?</language>
	</row>
	<row id="msg_0591_T25R0901_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ho... Ho... {STRVAR_1 1, 0, 0}...\nCe n’est pas un mauvais surnom...\rMais on peut lui trouver un surnom\nlégèrement meilleur...\rQu’en dis-tu? {YESNO 0}</language>
	</row>
	<row id="msg_0591_T25R0901_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon... Bon...\nQuel va être son nouveau surnom?\r</language>
	</row>
	<row id="msg_0591_T25R0901_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon!\nDorénavant, le surnom de ce Pokémon\fsera {STRVAR_1 1, 0, 0}!\rC’est un nom légèrement mieux...\nTu ne trouves pas?</language>
	</row>
	<row id="msg_0591_T25R0901_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon... Bon... Tu ne veux pas...\nFais comme tu veux.\fReviens me voir si l’envie t’en prend.</language>
	</row>
	<row id="msg_0591_T25R0901_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon!\nDorénavant, le surnom de ce Pokémon\fsera {STRVAR_1 1, 0, 0}!\rComment? Ça ne change pas vraiment?\nCe n’est qu’une impression.\rSon nouveau nom est mieux\nque l’ancien.</language>
	</row>
	<row id="msg_0591_T25R0901_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmmm...\n{STRVAR_1 1, 0, 0}...\rC’est un surnom parfait, fais-moi\nconfiance, je m’y connais.\rPrends soin de {STRVAR_1 1, 0, 0}.</language>
	</row>
	<row id="msg_0591_T25R0901_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais... Mais...\nMais ce n’est qu’un Oeuf.</language>
	</row>
</body>
