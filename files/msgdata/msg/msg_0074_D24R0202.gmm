<?xml version="1.0"?>
<body language="English">
	<row id="msg_0074_D24R0202_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue dans cette salle!\rNous travaillons ici sur des\nreprésentations de Pokémon en\fpierre exhumées dans les ruines.\rOn peut faire pivoter les fragments en\nles effleurant, et les déplacer en les\ftouchant.\rEn les manipulant ainsi, il devrait être\npossible de les rétablir tels qu’ils\fétaient à l’origine...</language>
	</row>
	<row id="msg_0074_D24R0202_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous... Vous avez réussi à restaurer\nle puzzle de pierre...?!\rIncroyable!\nVous avez un don pour l’archéologie!</language>
	</row>
	<row id="msg_0074_D24R0202_00002" index="2">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0074_D24R0202_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il ne se passe rien...</language>
	</row>
</body>
