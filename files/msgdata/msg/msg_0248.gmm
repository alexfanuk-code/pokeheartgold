<body language="English">
	<row id="msg_0248_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ANNUL.</language>
	</row>
	<row id="msg_0248_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">RETOUR</language>
	</row>
	<row id="msg_0248_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ARROSER</language>
	</row>
	<row id="msg_0248_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">PLANTER BAIE</language>
	</row>
	<row id="msg_0248_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">REPANDRE ENGRAIS</language>
	</row>
	<row id="msg_0248_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">CUEILLIR</language>
	</row>
	<row id="msg_0248_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Veuillez toucher un des\npots de votre Plante-Baies.</language>
	</row>
	<row id="msg_0248_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous ne possédez pas de Baie!</language>
	</row>
	<row id="msg_0248_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous ne possédez pas d’engrais!</language>
	</row>
	<row id="msg_0248_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Naviguez en utilisant ←→ ou en\ntouchant l’écran.</language>
	</row>
	<row id="msg_0248_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est un sol meuble et fertile.</language>
	</row>
	<row id="msg_0248_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Du {STRVAR_1 8, 2, 0} a été répandu.</language>
	</row>
	<row id="msg_0248_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une {STRVAR_1 8, 0, 0} a été plantée ici.</language>
	</row>
	<row id="msg_0248_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le plant de {STRVAR_1 8, 0, 0} a\nbourgeonné.</language>
	</row>
	<row id="msg_0248_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce plant de {STRVAR_1 8, 0, 0} a poussé.</language>
	</row>
	<row id="msg_0248_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les fleurs du plant de\n{STRVAR_1 8, 0, 0} ont éclos.</language>
	</row>
	<row id="msg_0248_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un plant de {STRVAR_1 8, 0, 0}!\nNombre de Baies qu’il porte: {STRVAR_1 51, 1, 0}.</language>
	</row>
	<row id="msg_0248_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Du {STRVAR_1 8, 2, 0} a été répandu sur\nle sol meuble.</language>
	</row>
	<row id="msg_0248_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une {STRVAR_1 8, 0, 0} a été plantée dans\nle sol meuble et fertile.</language>
	</row>
	<row id="msg_0248_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et voilà! En pleine forme!</language>
	</row>
	<row id="msg_0248_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous cueillez {STRVAR_1 51, 1, 0} Baies sur\nle plant de {STRVAR_1 8, 0, 0}.</language>
	</row>
	<row id="msg_0248_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous mettez votre cueillette\ndans le Sac. Le sol redevient fertile.</language>
	</row>
	<row id="msg_0248_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Sac est plein!\nVous laissez le plant.</language>
	</row>
