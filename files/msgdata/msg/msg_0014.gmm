	<row id="msg_0014_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Veuillez patienter...\nAppuyez sur le bouton B pour annuler.</language>
	</row>
	<row id="msg_0014_00002" index="2">
		<attribute name="window_context_name">used</attribute>
