<?xml version="1.0"?>
<body language="English">
	<row id="msg_0496_T07R0103_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sur quel Pokémon je vais utiliser\ncette CT...? J’hésite!</language>
	</row>
	<row id="msg_0496_T07R0103_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aaah!!!\nJe l’ai échangé sans lui\fenlever son Améliorator!</language>
	</row>
	<row id="msg_0496_T07R0103_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouais!\nEnfin j’ai un PORYGON!\rComme je ne suis pas un pro du jeu,\nje n’arrivais jamais à accumuler assez\fde Jetons...\r... Hein???\nCe n’est pas un PORYGON que j’ai reçu?!</language>
	</row>
	<row id="msg_0496_T07R0103_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Marché aux CT vend des capacités\nassez rares.</language>
	</row>
	<row id="msg_0496_T07R0103_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Renforcez vos Pokémon!\n2⁴: Marché aux CT</language>
	</row>
</body>
