<?xml version="1.0"?>
<body language="English">
	<row id="msg_0326_R03_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vers le Mont Sélénite.\rUne aire de repos vous attend\nà mi-parcours!</language>
	</row>
	<row id="msg_0326_R03_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je n’ai jamais vu un rocher pareil!\rEst-ce que...\nCe serait une météorite tombée du ciel?</language>
	</row>
	<row id="msg_0326_R03_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un Pokémon a vu sa Vitesse\naugmenter au contact de la météorite.</language>
	</row>
	<row id="msg_0326_R03_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un Pokémon a vu ses capacités\ndéfensives augmenter au contact\fde la météorite.</language>
	</row>
	<row id="msg_0326_R03_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un Pokémon a vu ses capacités\noffensives augmenter au contact\fde la météorite.</language>
	</row>
	<row id="msg_0326_R03_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un Pokémon a vu ses caractéristiques\ns’équilibrer au contact de la météorite.</language>
	</row>
</body>
