<?xml version="1.0"?>
<body language="English">
	<row id="msg_0610_T26R0601_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Qui dit Oliville dit mer!\nEt qui dit mer dit pêche!\rÇa fait 30 ans que je pêche ici!\rEt toi, tu ne voudrais pas essayer\naussi? {YESNO 0}</language>
	</row>
	<row id="msg_0610_T26R0601_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha ha ha! C’est la naissance\nd’un nouveau Pêcheur!</language>
	</row>
	<row id="msg_0610_T26R0601_00002" index="2">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0610_T26R0601_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il n’y a pas qu’à la mer qu’on peut\npêcher.\fEssaye partout où tu vois de l’eau!</language>
	</row>
	<row id="msg_0610_T26R0601_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">M’enfin?\nTu n’aimes pas la pêche?\fJ’peux pas y croire!</language>
	</row>
	<row id="msg_0610_T26R0601_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Alors?\nÇa mord?</language>
	</row>
</body>
