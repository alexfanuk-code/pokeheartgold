<?xml version="1.0"?>
<body language="English">
	<row id="msg_0553_T21R0301_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu veux savoir si t’es un Dresseur\nfort ou mauvais?\rAlors va dans les Arènes de chaque ville\nde Johto et collectionne les Badges!</language>
	</row>
	<row id="msg_0553_T21R0301_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quand je serai grand, je serai\nChampion d’Arène!\rAlors je m’entraîne en affrontant\nles Pokémon de mes amis!</language>
	</row>
</body>
