	<row id="msg_0247_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Notre livreur a plein de cadeaux\npour vous!\rVous pouvez le trouver dans n’importe\nquelle Boutique Pokémon où il vous\fremettra certains de vos cadeaux.\n</language>
	</row>
	<row id="msg_0247_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous avez déjà reçu ce cadeau.\nVous ne pouvez le recevoir qu’une fois.</language>
	</row>
