<?xml version="1.0"?>
<body language="English">
	<row id="msg_0247_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue au Cadeau Mystère!</language>
	</row>
	<row id="msg_0247_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Veuillez choisir le mode de réception de\nvotre cadeau.</language>
	</row>
	<row id="msg_0247_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La communication sans fil DS va\ndémarrer.</language>
	</row>
	<row id="msg_0247_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Recherche d’un cadeau en cours...\nVeuillez patienter.</language>
	</row>
	<row id="msg_0247_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Recevoir ce cadeau?</language>
	</row>
	<row id="msg_0247_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rechercher un cadeau différent?</language>
	</row>
	<row id="msg_0247_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Votre requête a été envoyée.\nVeuillez patienter un instant...</language>
	</row>
	<row id="msg_0247_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Réception du cadeau en cours...\nNe pas éteindre.</language>
	</row>
	<row id="msg_0247_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le cadeau a été obtenu!\rVous pouvez le récupérer dans\nn’importe quelle Boutique Pokémon.</language>
	</row>
	<row id="msg_0247_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous partagez ce cadeau avec une\nautre personne.\rVous pouvez accepter ce cadeau mais\nvous ne pourrez pas le distribuer à vos\famis.\rVoulez-vous accepter ce cadeau?</language>
	</row>
	<row id="msg_0247_00010" index="10">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
