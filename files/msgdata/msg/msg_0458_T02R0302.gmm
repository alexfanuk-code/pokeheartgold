<?xml version="1.0"?>
<body language="English">
	<row id="msg_0458_T02R0302_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue au Hall d’Entraînement!\rVous pouvez y affronter de nombreux\nDresseurs et leurs Pokémon favoris\fune fois par jour.\rVoulez-vous tenter votre chance? {YESNO 0}\n</language>
	</row>
	<row id="msg_0458_T02R0302_00001" index="1">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0458_T02R0302_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tout est en règle!\nVous pouvez commencer immédiatement.\r</language>
	</row>
	<row id="msg_0458_T02R0302_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vois...\nRevenez nous voir!\r</language>
	</row>
	<row id="msg_0458_T02R0302_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Désirez-vous arrêter? {YESNO 0}</language>
	</row>
	<row id="msg_0458_T02R0302_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci d’avoir participé!\r</language>
	</row>
	<row id="msg_0458_T02R0302_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tant mieux!\nBon courage!\r</language>
	</row>
	<row id="msg_0458_T02R0302_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, bonjour!\nPar ici, s’il vous plaît!\r</language>
	</row>
	<row id="msg_0458_T02R0302_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Dresseurs se rassemblent ici pour\ns’entraîner.\rMême les amis qui se sont connectés\navec vous via le Pokéwalker sont là!\rVous pouvez vous battre avec les\nDresseurs une fois par jour.\rEn gagnant, vous remportez des Points\nde Combat, alors bonne chance!\r</language>
	</row>
	<row id="msg_0458_T02R0302_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah! Permettez-moi de modifier votre\nMagnéto VS...\rAlors, là, comme ça...\nÇa, ça va là...\fEt voilà!\rLes Points de Combat s’affichent\nmaintenant sur votre Magnéto VS!\r</language>
	</row>
	<row id="msg_0458_T02R0302_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Magnéto VS de {STRVAR_1 3, 0, 0}\na été amélioré!</language>
	</row>
	<row id="msg_0458_T02R0302_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous pouvez échanger vos Points de\nCombat contre de fabuleux prix à la\fZone de Combat qui se trouve à Johto!\r</language>
	</row>
	<row id="msg_0458_T02R0302_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon! Désirez-vous commencer \nl’entraînement tout de suite? {YESNO 0}</language>
	</row>
	<row id="msg_0458_T02R0302_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Désirez-vous combattre? {YESNO 0}</language>
	</row>
	<row id="msg_0458_T02R0302_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A demain!</language>
	</row>
</body>
