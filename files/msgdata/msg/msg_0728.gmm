	<row id="msg_0728_00081" index="81">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pas le choix: je reconnais ma défaite!</language>
	</row>
	<row id="msg_0728_00082" index="82">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hourra!\nJ’espère que SUICUNE nous regardait!</language>
	</row>
	<row id="msg_0728_00083" index="83">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Enfin, le vent m’emporte sur ses\nailes...</language>
	</row>
	<row id="msg_0728_00084" index="84">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mes ailes sont encore vigoureuses!</language>
	</row>
	<row id="msg_0728_00085" index="85">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Très bien...\nC’est à moi de me poser au sol.</language>
	</row>
	<row id="msg_0728_00086" index="86">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Pokémon de type Insecte résistent\ntoujours jusqu’au dernier!</language>
	</row>
	<row id="msg_0728_00087" index="87">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Courage! Accroche-toi encore un peu!</language>
	</row>
	<row id="msg_0728_00088" index="88">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Argh... C’est fini pour moi...</language>
	</row>
	<row id="msg_0728_00089" index="89">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hein! Quoi? C’est mon dernier?!\nOuais, ben... ça veut rien dire!</language>
	</row>
	<row id="msg_0728_00090" index="90">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non!!! C’est pas possible!!</language>
	</row>
	<row id="msg_0728_00091" index="91">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gloups...</language>
	</row>
	<row id="msg_0728_00092" index="92">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est pas fini!\nJ’y crois encore!</language>
	</row>
	<row id="msg_0728_00093" index="93">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pourtant, je me suis tant entraîné...!</language>
	</row>
	<row id="msg_0728_00094" index="94">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Qu’est ce que ça veut dire?!</language>
	</row>
	<row id="msg_0728_00095" index="95">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’acier trempé ne rouille pas pour si\npeu.</language>
	</row>
	<row id="msg_0728_00096" index="96">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un cœur d’acier se bat jusqu’au bout!</language>
	</row>
	<row id="msg_0728_00097" index="97">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Exceptionnel!</language>
	</row>
	<row id="msg_0728_00098" index="98">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce n’est pas encore fini!!</language>
	</row>
	<row id="msg_0728_00099" index="99">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pas... encore... fini!</language>
	</row>
	<row id="msg_0728_00100" index="100">
		<attribute name="window_context_name">used</attribute>
		<language name="English">... fini...</language>
	</row>
	<row id="msg_0728_00101" index="101">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hum... Tu te débrouilles pas mal.</language>
	</row>
	<row id="msg_0728_00102" index="102">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ploie mais je ne craque pas.\nHors de question d’abandonner!</language>
	</row>
	<row id="msg_0728_00103" index="103">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hummm... J’aurais épuisé toutes mes\nstratégies?</language>
	</row>
	<row id="msg_0728_00104" index="104">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Plus qu’un Pokémon? Bah, le vrai combat\nne commence que maintenant.</language>
	</row>
	<row id="msg_0728_00105" index="105">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non! C’est moi qui DOIS gagner!\nC’est écrit!</language>
	</row>
	<row id="msg_0728_00106" index="106">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Perdu?\rJ’y crois pas!! Il y a sûrement\nune erreur...</language>
	</row>
	<row id="msg_0728_00107" index="107">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Enfin, le vent m’emporte sur ses\nailes...</language>
	</row>
	<row id="msg_0728_00108" index="108">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mes ailes sont encore vigoureuses!</language>
	</row>
	<row id="msg_0728_00109" index="109">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Très bien...\nC’est à moi de me poser au sol.</language>
	</row>
	<row id="msg_0728_00110" index="110">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Pokémon de type Insecte résistent\ntoujours jusqu’au dernier!</language>
	</row>
	<row id="msg_0728_00111" index="111">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Courage! Accroche-toi encore un peu!</language>
	</row>
	<row id="msg_0728_00112" index="112">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Argh... C’est fini pour moi...</language>
	</row>
	<row id="msg_0728_00113" index="113">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hein! Quoi? C’est mon dernier?!\nOuais, ben... ça veut rien dire!</language>
	</row>
	<row id="msg_0728_00114" index="114">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non!!! C’est pas possible!!</language>
	</row>
	<row id="msg_0728_00115" index="115">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gloups...</language>
	</row>
	<row id="msg_0728_00116" index="116">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est pas fini!\nJ’y crois encore!</language>
	</row>
	<row id="msg_0728_00117" index="117">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pourtant, je me suis tant entraîné...!</language>
	</row>
	<row id="msg_0728_00118" index="118">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Qu’est ce que ça veut dire?!</language>
	</row>
	<row id="msg_0728_00119" index="119">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’acier trempé ne rouille pas pour si\npeu.</language>
	</row>
	<row id="msg_0728_00120" index="120">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un cœur d’acier se bat jusqu’au bout!</language>
	</row>
	<row id="msg_0728_00121" index="121">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Exceptionnel!</language>
	</row>
	<row id="msg_0728_00122" index="122">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce n’est pas encore fini!!</language>
	</row>
	<row id="msg_0728_00123" index="123">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pas... encore... fini!</language>
	</row>
	<row id="msg_0728_00124" index="124">
		<attribute name="window_context_name">used</attribute>
		<language name="English">... fini...</language>
	</row>
	<row id="msg_0728_00125" index="125">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hum... Tu te débrouilles pas mal.</language>
	</row>
	<row id="msg_0728_00126" index="126">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ploie mais je ne craque pas.\nHors de question d’abandonner!</language>
	</row>
	<row id="msg_0728_00127" index="127">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hummm... J’aurais épuisé toutes mes\nstratégies?</language>
	</row>
	<row id="msg_0728_00128" index="128">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Plus qu’un Pokémon? Bah, le vrai combat\nne commence que maintenant.</language>
	</row>
	<row id="msg_0728_00129" index="129">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non! C’est moi qui DOIS gagner!\nC’est écrit!</language>
	</row>
	<row id="msg_0728_00130" index="130">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Perdu?\rJ’y crois pas!! Il y a sûrement\nune erreur...</language>
	</row>
	<row id="msg_0728_00131" index="131">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Boum!\rOh oh! Voilà un adversaire de valeur.\nIl ne trébuche même pas quand\fon le bouscule.\rIci, nous visons la perfection des\nPokémon Oiseaux en suivant un\fentraînement spécial du matin au soir.\rViens te battre!!!\r</language>
	</row>
	<row id="msg_0728_00132" index="132">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yaaah!</language>
	</row>
	<row id="msg_0728_00133" index="133">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’habileté d’Albert est bien réelle!\nMême moi, je ne lui arrive pas à la\fcheville.</language>
	</row>
	<row id="msg_0728_00134" index="134">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Surprenantes, ces hauteurs, hein?\rMais il n’y a que comme ça qu’on peut\ncomprendre les Pokémon Oiseaux.\rA moi de voir si tu es digne d’affronter\nAlbert.\r</language>
	</row>
	<row id="msg_0728_00135" index="135">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vraiment?!</language>
	</row>
	<row id="msg_0728_00136" index="136">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un si jeune Dresseur, et pourtant il\nn’a pas le vertige.\fTu nous promets de belles surprises!</language>
	</row>
	<row id="msg_0728_00137" index="137">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lia: Tu veux affronter notre\nChampion? Mais c’est pas possible,\fpas possible du tout, ça!\r</language>
	</row>
	<row id="msg_0728_00138" index="138">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lia: Quelle violence...</language>
	</row>
	<row id="msg_0728_00139" index="139">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lia: Quelle force tu as!</language>
	</row>
	<row id="msg_0728_00140" index="140">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lia: Plus qu’un Pokémon?\nQuel malheur!</language>
	</row>
	<row id="msg_0728_00141" index="141">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Liz: Même si je perds mon temps,\nje serai ton adversaire.\r</language>
	</row>
	<row id="msg_0728_00142" index="142">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Liz: Quelle puissance!</language>
	</row>
	<row id="msg_0728_00143" index="143">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Liz: Sniff! Nos Pokémon Insecte ont\nperdu... Quel dommage!</language>
	</row>
	<row id="msg_0728_00144" index="144">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Liz: Ça doit être dur de n’avoir plus\nqu’un seul Pokémon debout.</language>
	</row>
	<row id="msg_0728_00145" index="145">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Pokémon Insecte évoluent\nrapidement. Ils deviennent forts\fplus vite.\r</language>
	</row>
	<row id="msg_0728_00146" index="146">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Faire évoluer un Pokémon n’est pas\nsuffisant!</language>
	</row>
	<row id="msg_0728_00147" index="147">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour rencontrer le Champion, il faut\nbouger la toile avec les interrupteurs!</language>
	</row>
	<row id="msg_0728_00148" index="148">
		<attribute name="window_context_name">used</attribute>
		<language name="English">T’as pu traverser la toile, comme un\nPokémon Insecte.\rJ’vais pouvoir t’apprendre c’qui fait\nleur charme.\r</language>
	</row>
	<row id="msg_0728_00149" index="149">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu m’as montré à quel point\nt’étais balèze!</language>
	</row>
	<row id="msg_0728_00150" index="150">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On a l’impression de devenir un Pokémon\nInsecte en étant dans cette Arène.</language>
	</row>
	<row id="msg_0728_00151" index="151">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as sauvé tous les RAMOLOSS? T’es\nsuper balèze toi!\rMais mes Pokémon aussi sont balèzes,\ntu vas voir.\r</language>
	</row>
	<row id="msg_0728_00152" index="152">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aarrgggh!</language>
	</row>
	<row id="msg_0728_00153" index="153">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En utilisant les interrupteurs, tu peux\nchanger la trajectoire des nacelles.</language>
	</row>
	<row id="msg_0728_00154" index="154">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu ferais bien de te méfier des filles!\r</language>
	</row>
	<row id="msg_0728_00155" index="155">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zut... C’est moi qui aurais dû me méfier.</language>
	</row>
	<row id="msg_0728_00156" index="156">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chez les Pokémon, il y a les mâles et les\nfemelles.\fLesquels sont les plus forts?...</language>
	</row>
	<row id="msg_0728_00157" index="157">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je préfère les Pokémon mignons plutôt\nque les Pokémon forts.\rMais j’en ai un multifonction, il est\nmignon et fort à la fois!\r</language>
	</row>
	<row id="msg_0728_00158" index="158">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, non, non, non!</language>
	</row>
	<row id="msg_0728_00159" index="159">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je me suis entraînée pour battre\nBlanche, mais j’en suis encore loin\fon dirait. Ça me déprime...\r... presque, mais moi, quand je rate un\ntruc, je réessaye aussitôt.</language>
	</row>
	<row id="msg_0728_00160" index="160">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, tu es un sacré numéro, toi! Et mimi\nen plus! Je t’aime bien, mais tu ne\fpasseras pas comme ça!\r</language>
	</row>
	<row id="msg_0728_00161" index="161">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voyons voir...\nOups, c’est fini?</language>
	</row>
	<row id="msg_0728_00162" index="162">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whaou, tu dois être cool pour me battre\ncomme ça!\fContinue!</language>
	</row>
	<row id="msg_0728_00163" index="163">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fais de ton mieux\nou je t’aurai!\r</language>
	</row>
	<row id="msg_0728_00164" index="164">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Noon! Oh, MIAOUSS,\nje suis désolée!</language>
	</row>
	<row id="msg_0728_00165" index="165">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai pourtant appris à MIAOUSS des\nattaques pour parer chaque type.</language>
	</row>
	<row id="msg_0728_00166" index="166">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais gagner!\r</language>
	</row>
	<row id="msg_0728_00167" index="167">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et bah non, j’ai\nperdu!</language>
	</row>
	<row id="msg_0728_00168" index="168">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Celui qui veut,\neh bah, il peut!</language>
	</row>
	<row id="msg_0728_00169" index="169">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah! Ça te fait peur le sol invisible,\nhein? Tu n’as plus qu’à me battre et je\fte file un conseil!\r</language>
	</row>
	<row id="msg_0728_00170" index="170">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Qu-qu-quoi?</language>
	</row>
	<row id="msg_0728_00171" index="171">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Très bien. Je vais te dire un truc\nsur le sol invisible.\rLe bon chemin est devant nos yeux!</language>
	</row>
	<row id="msg_0728_00172" index="172">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai passé tout le printemps avec mes\nPokémon, et puis aussi l’été et surtout\fl’hiver...\rEt puis le printemps est revenu. Nous\navons passé bien du temps ensemble.\r</language>
	</row>
	<row id="msg_0728_00173" index="173">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai appris à gagner et à perdre.</language>
	</row>
	<row id="msg_0728_00174" index="174">
		<attribute name="window_context_name">used</attribute>
		<language name="English">D’où viennent les Pokémon?</language>
	</row>
	<row id="msg_0728_00175" index="175">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Peux-tu infliger des dégâts à nos\nPokémon?\r</language>
	</row>
	<row id="msg_0728_00176" index="176">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah! Bien joué!</language>
	</row>
	<row id="msg_0728_00177" index="177">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On n’utilise que les Pokémon de type\nSpectre.\rAucune attaque de type Normal ne peut\nles inquiéter!</language>
	</row>
	<row id="msg_0728_00178" index="178">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mes Pokémon et moi sommes liés par\nune grande amitié.\fUne amitié absolument indestructible!\r</language>
	</row>
	<row id="msg_0728_00179" index="179">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est pas vrai!</language>
	</row>
	<row id="msg_0728_00180" index="180">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Toi aussi, tu as une grande complicité\navec ton équipe de Pokémon!</language>
	</row>
	<row id="msg_0728_00181" index="181">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nous autres, les vaillants artistes\nmartiaux, n’avons peur de rien!\r</language>
	</row>
	<row id="msg_0728_00182" index="182">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est choquant!</language>
	</row>
	<row id="msg_0728_00183" index="183">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Pokémon de type Combat ont peur\ndes Pokémon qui ont des pouvoirs Psy...</language>
	</row>
	<row id="msg_0728_00184" index="184">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je n’ai besoin de rien. Même pas des\nmots. Je fais parler mes poings!\r</language>
	</row>
	<row id="msg_0728_00185" index="185">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...</language>
	</row>
	<row id="msg_0728_00186" index="186">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai perdu, rien à redire.</language>
	</row>
	<row id="msg_0728_00187" index="187">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nos poings furieux vont tailler ton\néquipe en pièces!\r</language>
	</row>
	<row id="msg_0728_00188" index="188">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En... en pièces!</language>
	</row>
	<row id="msg_0728_00189" index="189">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est la fierté de mes Pokémon qui est\nen pièces pour le coup...</language>
	</row>
	<row id="msg_0728_00190" index="190">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour atteindre Frédo, notre Champion\nd’Arène, tu dois réfléchir avant\fde te laisser glisser!\r</language>
	</row>
	<row id="msg_0728_00191" index="191">
		<attribute name="window_context_name">used</attribute>
		<language name="English">N’empêche qu’en ski, je suis sûre\nque je te bats!</language>
	</row>
	<row id="msg_0728_00192" index="192">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si tu ne patines pas avec précision, tu\nn’iras pas bien loin dans cette Arène.\fMais c’est aussi ce qui fait son charme.</language>
	</row>
	<row id="msg_0728_00193" index="193">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sors de mon slalom!\r</language>
	</row>
	<row id="msg_0728_00194" index="194">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non! Tu m’as fait déraper!</language>
	</row>
	<row id="msg_0728_00195" index="195">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je n’aurais pas dû frimer...</language>
	</row>
	<row id="msg_0728_00196" index="196">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Alors, on tremble?\nPeur de m’affronter?\r</language>
	</row>
	<row id="msg_0728_00197" index="197">
		<attribute name="window_context_name">used</attribute>
		<language name="English">T’es tellement balèze que ça fait peur!</language>
	</row>
	<row id="msg_0728_00198" index="198">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quand on est vraiment fort, on ne\nl’affiche pas. C’était donc ton cas...</language>
	</row>
	<row id="msg_0728_00199" index="199">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cette Arène a le sol glissant.\nC’est délire, pas vrai?\rMais... Fini de jouer!\r</language>
	</row>
	<row id="msg_0728_00200" index="200">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vois à quel point on est sérieux ici?</language>
	</row>
	<row id="msg_0728_00201" index="201">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cette Arène est d’enfer. J’adore\npatiner avec mes Pokémon!</language>
	</row>
	<row id="msg_0728_00202" index="202">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je connais le secret de la puissance\nde Frédo.\r</language>
	</row>
	<row id="msg_0728_00203" index="203">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK. Je vais te le dire.</language>
	</row>
	<row id="msg_0728_00204" index="204">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Frédo est très fort parce que...\rTous les jours, il fortifie son corps et\nson cœur sur de la glace!</language>
	</row>
	<row id="msg_0728_00205" index="205">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vas voir ce qu’il en coûte de se\nfrotter à un Dracologue débutant!\r</language>
	</row>
	<row id="msg_0728_00206" index="206">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quel dommage!!</language>
	</row>
	<row id="msg_0728_00207" index="207">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu connais le Dracologue Peter...?\nMais non, c’est impossible...</language>
	</row>
	<row id="msg_0728_00208" index="208">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ici, tous les Dresseurs n’utilisent pas\nque des Pokémon de type Dragon.\rMon thème à moi, plus que le type\nDragon, ce sont les Pokémon forts!\r</language>
	</row>
	<row id="msg_0728_00209" index="209">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Evidemment...</language>
	</row>
	<row id="msg_0728_00210" index="210">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mais mes Pokémon vont devenir encore\nplus forts!\rTout le monde peut s’améliorer, les\nDresseurs comme les Pokémon!</language>
	</row>
	<row id="msg_0728_00211" index="211">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mes chances de perdre? Même pas\nune sur mille!\r</language>
	</row>
	<row id="msg_0728_00212" index="212">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne suis plus très bon en maths.</language>
	</row>
	<row id="msg_0728_00213" index="213">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu m’as montré mes défauts.\nMerci pour la leçon...</language>
	</row>
	<row id="msg_0728_00214" index="214">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nous nous entraînons dur avec Sandra.\nImpossible que nous perdions!\r</language>
	</row>
	<row id="msg_0728_00215" index="215">
		<attribute name="window_context_name">used</attribute>
		<language name="English">... Ah!! Non!!</language>
	</row>
	<row id="msg_0728_00216" index="216">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon...\nIl va falloir reprendre l’entraînement.</language>
	</row>
	<row id="msg_0728_00217" index="217">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le type Dragon regroupe des Pokémon\nsacrés, pleins de vie.\rTu ne pourras pas les battre\nsi tu ne te donnes pas à fond.\r</language>
	</row>
	<row id="msg_0728_00218" index="218">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bien joué!</language>
	</row>
	<row id="msg_0728_00219" index="219">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le type Dragon est faible face aux\nattaques des Pokémon de type Dragon.</language>
	</row>
	<row id="msg_0728_00220" index="220">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tout l’attrait des Pokémon Psy... Ne\njamais abandonner, jusqu’à la fin.</language>
	</row>
	<row id="msg_0728_00221" index="221">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tant que je tiens debout, mon potentiel\nest sans limites! Je gagnerai!</language>
	</row>
	<row id="msg_0728_00222" index="222">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est... incroyable...</language>
	</row>
	<row id="msg_0728_00223" index="223">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon ultime Pokémon?\rHa ha ha! Tant mieux, c’est sur lui que\nje comptais depuis le début!</language>
	</row>
	<row id="msg_0728_00224" index="224">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mmmmh...</language>
	</row>
	<row id="msg_0728_00225" index="225">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmmm...\nTu es un honorable adversaire.</language>
	</row>
	<row id="msg_0728_00226" index="226">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sois digne de tous ceux qui sont tombés\navant toi!</language>
	</row>
	<row id="msg_0728_00227" index="227">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est le moment crucial.</language>
	</row>
	<row id="msg_0728_00228" index="228">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moi? Perdre?\nPourquoi?</language>
	</row>
	<row id="msg_0728_00229" index="229">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je ne suis pas encore finie!</language>
	</row>
	<row id="msg_0728_00230" index="230">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jamais personne ne m’a acculée ainsi\ndans mes derniers retranchements.</language>
	</row>
	<row id="msg_0728_00231" index="231">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vraiment, bien joué. \nC’était tout bonnement exceptionnel.</language>
	</row>
	<row id="msg_0728_00232" index="232">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bien! BIEN!\nIl fallait que ça arrive.</language>
	</row>
	<row id="msg_0728_00233" index="233">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je n’abandonne jamais.\nToi non plus, hein?</language>
	</row>
	<row id="msg_0728_00234" index="234">
		<attribute name="window_context_name">used</attribute>
		<language name="English">... C’est fini.\rJe me sens... bizarre...\rJe ne suis pas fâché mais... plutôt\nheureux. Heureux d’être le témoin de la\fnaissance d’un nouveau Maître!</language>
	</row>
	<row id="msg_0728_00235" index="235">
