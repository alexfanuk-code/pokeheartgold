	<row id="msg_0728_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eh! Oh!\nPourquoi tu t’énerves?</language>
	</row>
	<row id="msg_0728_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’le crois pas...</language>
	</row>
	<row id="msg_0728_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">... Pourquoi?\nPourquoi je perds encore?\rJ’ai récupéré les Pokémon les plus\nforts, je retiens pas mes coups...\rAlors pourquoi?</language>
	</row>
	<row id="msg_0728_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voilà de quoi je suis capable!\rJe vais finir d’anéantir la\nTeam Rocket, puis j’irai écraser\fce Peter pour de bon!</language>
	</row>
