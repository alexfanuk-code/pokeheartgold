<?xml version="1.0"?>
<body language="English">
	<row id="msg_0263_P01R0307_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé! Toi, là!\nTu peux chercher mon pote pour moi?\rIl se repose quelque part au lieu de\ntravailler. Quel bon à rien!\rJe ne peux pas bouger d’ici, c’est pour\nça que je te le demande...\r</language>
	</row>
	<row id="msg_0263_P01R0307_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé! Toi, là!\nTu peux chercher mon pote pour moi?\rIl se repose quelque part au lieu de\ntravailler. Quel bon à rien!\rJe ne peux pas bouger d’ici, c’est pour\nça que je te le demande...</language>
	</row>
	<row id="msg_0263_P01R0307_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci toi!\nJe lui ai sonné les cloches,\fil quittera plus son poste maintenant!</language>
	</row>
	<row id="msg_0263_P01R0307_00003" index="3">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0263_P01R0307_00004" index="4">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0263_P01R0307_00005" index="5">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0263_P01R0307_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah! Tu m’as trouvée!\rBon, je devrais retourner voir\nmon grand-père, maintenant!\r</language>
	</row>
</body>
