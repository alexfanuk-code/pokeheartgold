<?xml version="1.0"?>
<body language="English">
	<row id="msg_0059_D17R1101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mortimer: Les Pokémon légendaires ne\nm’ont pas choisi...\rMais ça ne veut pas dire que\nma vie est finie!\rJe vais continuer à m’entraîner jusqu’à\nce que je trouve un nouveau but!\rQu’en penses-tu? Tu veux\nt’entraîner avec moi? {YESNO 0}</language>
	</row>
	<row id="msg_0059_D17R1101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} a enregistré Mortimer\ndans son Pokématos!</language>
	</row>
	<row id="msg_0059_D17R1101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mortimer: Appelle-moi le mardi soir\nsi tu veux te battre contre moi!</language>
	</row>
	<row id="msg_0059_D17R1101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mortimer: Ah bon...\nDommage...</language>
	</row>
	<row id="msg_0059_D17R1101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mortimer: Tu veux t’entraîner\navec moi? {YESNO 0}</language>
	</row>
	<row id="msg_0059_D17R1101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mortimer: Oh!! C’est toi!\rQue dirais-tu de prendre une photo\nensemble, en souvenir? {YESNO 0}</language>
	</row>
	<row id="msg_0059_D17R1101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mortimer: Super! Allez, souris avec moi\nde toutes tes dents!\r</language>
	</row>
	<row id="msg_0059_D17R1101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mortimer: Parfait!\nVoilà une très bonne photo!</language>
	</row>
	<row id="msg_0059_D17R1101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mortimer: Ah bon... Toi aussi,\ntu dois avoir fort à faire...</language>
	</row>
	<row id="msg_0059_D17R1101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Votre Album Photo est plein!\rRevenez après y avoir fait le ménage\ndans votre PC.</language>
	</row>
</body>
