<?xml version="1.0"?>
<body language="English">
	<row id="msg_0745_W40R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quoi? C’est moi le premier!\rJe fais la queue sans dormir depuis\nun moment pour être le premier à\fpouvoir essayer la Zone de Combat.\rC’est pas la mort d’être deuxième,\nalors mets-toi derrière moi!\r</language>
	</row>
	<row id="msg_0745_W40R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zzzzzz... ...\n...\rIl dort debout!\r</language>
	</row>
	<row id="msg_0745_W40R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ron... Pchi...\n...\rIl n’est pas près de se réveiller...</language>
	</row>
	<row id="msg_0745_W40R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est la voie d’accès à la Zone de\nCombat.\fJe serai bien embêté si tu commences\fà faire la queue ici.</language>
	</row>
	<row id="msg_0745_W40R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La Zone de Combat est ouverte!\rJe vous en prie!</language>
	</row>
</body>
