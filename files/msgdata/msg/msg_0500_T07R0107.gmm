<?xml version="1.0"?>
<body language="English">
	<row id="msg_0500_T07R0107_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bonjour, et merci pour votre visite.\nA quel étage voulez-vous aller? {YESNO 0}</language>
	</row>
	<row id="msg_0500_T07R0107_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nous espérons vous revoir bientôt.</language>
	</row>
	<row id="msg_0500_T07R0107_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Certainement.\nNous montons tout de suite.\r</language>
	</row>
	<row id="msg_0500_T07R0107_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Certainement.\nNous descendons tout de suite.\r</language>
	</row>
	<row id="msg_0500_T07R0107_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Euh... Nous sommes déjà à cet étage.</language>
	</row>
	<row id="msg_0500_T07R0107_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rez-de-chaussée: Accueil et entrée.</language>
	</row>
	<row id="msg_0500_T07R0107_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">1¹ étage: Le Marché du Dresseur.</language>
	</row>
	<row id="msg_0500_T07R0107_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">2⁴ étage: Les Capsules Techniques\npour renforcer vos Pokémon.</language>
	</row>
	<row id="msg_0500_T07R0107_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">3⁴ étage: Les Cadeaux du Sage,\npour offrir!</language>
	</row>
	<row id="msg_0500_T07R0107_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">4⁴ étage: La pharmacie, pour\naméliorer vos statistiques.</language>
	</row>
	<row id="msg_0500_T07R0107_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">5⁴ étage: Espace Détente,\npour se reposer sur le toit.\n</language>
	</row>
</body>
