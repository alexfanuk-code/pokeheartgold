<?xml version="1.0"?>
<body language="English">
	<row id="msg_0009_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La sauvegarde a échoué.\n\nVeuillez éteindre la console, enlever\nla carte DS, puis la réinsérer.</language>
	</row>
	<row id="msg_0009_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erreur de sauvegarde.\n\nLa mémoire est endommagée.\nVous pouvez jouer, mais il est\nimpossible de sauvegarder.\n\nVeuillez éteindre la console.\n</language>
	</row>
</body>
