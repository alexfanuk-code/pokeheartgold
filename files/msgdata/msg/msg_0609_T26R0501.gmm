<?xml version="1.0"?>
<body language="English">
	<row id="msg_0609_T26R0501_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il y a 4 îles désertes en allant\nvers Irisia.\rOn y abandonne les enfants qui n’ont\npas été sages!</language>
	</row>
	<row id="msg_0609_T26R0501_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quand je fais des bêtises, papa\nme menace tout de suite...</language>
	</row>
	<row id="msg_0609_T26R0501_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma sœur m’a donné plein de Sceaux.\nJe vais les partager avec toi!\r</language>
	</row>
	<row id="msg_0609_T26R0501_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wouah!\nTu as plein de Sceaux!\rColle-les sur tes Poké Balls!</language>
	</row>
	<row id="msg_0609_T26R0501_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Repasse demain et je t’en donnerai\ndes encore plus mieux!</language>
	</row>
	<row id="msg_0609_T26R0501_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh?\nJe voulais te donner des Sceaux, mais\ftu n’as pas de Boîte pour les ranger!</language>
	</row>
	<row id="msg_0609_T26R0501_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tiens!\nPour toi!\r</language>
	</row>
	<row id="msg_0609_T26R0501_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En voilà encore un autre!\r</language>
	</row>
	<row id="msg_0609_T26R0501_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et encore un!\r</language>
	</row>
	<row id="msg_0609_T26R0501_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il faut les coller sur tes Poké Balls!</language>
	</row>
	<row id="msg_0609_T26R0501_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wouah!\nTu en as déjà plein!</language>
	</row>
	<row id="msg_0609_T26R0501_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’exemplaire du {STRVAR_1 10, 0, 0}\na été rangé dans la Boîte Sceaux!\r</language>
	</row>
</body>
