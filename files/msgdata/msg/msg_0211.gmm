<?xml version="1.0"?>
<body language="English">
	<row id="msg_0211_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cet arbre semble pouvoir être\ncoupé. Utiliser Coupe? {YESNO 0}</language>
	</row>
	<row id="msg_0211_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} utilise Coupe.\r</language>
	</row>
	<row id="msg_0211_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cet arbre semble pouvoir être coupé.</language>
	</row>
	<row id="msg_0211_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce bloc de pierre peut être brisé.\nVoulez-vous utiliser Eclate-Roc? {YESNO 0}</language>
	</row>
	<row id="msg_0211_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est un bloc de pierre solide, mais un\nPokémon peut être apte à le pulvériser.</language>
	</row>
	<row id="msg_0211_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} utilise Eclate-Roc.\r</language>
	</row>
	<row id="msg_0211_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’objet {STRVAR_1 8, 1, 0} se trouve dans\nles décombres!\r</language>
	</row>
	<row id="msg_0211_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est un gros rocher, mais un Pokémon\npeut être apte à le déplacer.\rVoulez-vous utiliser Force? {YESNO 0}</language>
	</row>
	<row id="msg_0211_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} utilise Force.\rLa capacité Force de {STRVAR_1 0, 0, 0}\npermet de déplacer le rocher.</language>
	</row>
	<row id="msg_0211_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est un gros rocher, mais un Pokémon\npeut être apte à le déplacer.</language>
	</row>
	<row id="msg_0211_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Force permet de déplacer le rocher.</language>
	</row>
	<row id="msg_0211_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} utilise Force.\r</language>
	</row>
	<row id="msg_0211_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La capacité Force de {STRVAR_1 0, 0, 0}\npermet de déplacer le rocher.</language>
	</row>
	<row id="msg_0211_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le rocher est tombé.</language>
	</row>
	<row id="msg_0211_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’eau est teintée d’un bleu foncé...\nVoulez-vous utiliser Surf? {YESNO 0}</language>
	</row>
	<row id="msg_0211_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} utilise Surf.\r</language>
	</row>
	<row id="msg_0211_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous ne pouvez pas utiliser Surf s’il y a\nquelqu’un avec vous.</language>
	</row>
	<row id="msg_0211_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un brouillard épais voile le paysage...\rVoulez-vous utiliser\nAnti-Brume? {YESNO 0}</language>
	</row>
	<row id="msg_0211_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} utilise Anti-Brume.\r</language>
	</row>
	<row id="msg_0211_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un brouillard épais voile le paysage...\nUn Pokémon pourrait le dissiper.</language>
	</row>
	<row id="msg_0211_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La paroi est très rocailleuse...\nVoulez-vous utiliser Escalade? {YESNO 0}</language>
	</row>
	<row id="msg_0211_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} utilise Escalade.\r</language>
	</row>
	<row id="msg_0211_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La paroi est très rocailleuse... On\npourrait l’escalader avec une capacité.</language>
	</row>
	<row id="msg_0211_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous ne pouvez pas utiliser Escalade\ns’il y a quelqu’un avec vous.</language>
	</row>
	<row id="msg_0211_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est une grande cascade.\nVoulez-vous utiliser Cascade? {YESNO 0}</language>
	</row>
	<row id="msg_0211_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} utilise Cascade.\r</language>
	</row>
	<row id="msg_0211_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un mur d’eau s’abat dans un vacarme\nassourdissant.</language>
	</row>
	<row id="msg_0211_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous téléporter à {STRVAR_1 4, 0, 0},\noù vous avez pris une pause en dernier?</language>
	</row>
	<row id="msg_0211_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} utilise Flash.\r</language>
	</row>
	<row id="msg_0211_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quel énorme tourbillon!\nVoulez-vous utiliser Siphon? {YESNO 0}</language>
	</row>
	<row id="msg_0211_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} utilise Siphon.\r</language>
	</row>
	<row id="msg_0211_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’eau tourbillonne dans un vacarme\nassourdissant.</language>
	</row>
	<row id="msg_0211_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il y a un arbre secouable.\nVoulez-vous utiliser Coup d’Boule? {YESNO 0}</language>
