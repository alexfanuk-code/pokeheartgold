<?xml version="1.0"?>
<body language="English">
	<row id="msg_0195_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Avant tout, nous allons garder vos\nPokémon pour que vous puissiez\femprunter les nôtres.\rJe vous conseille de bien réfléchir\nlorsque vous choisissez vos Pokémon!\r</language>
	</row>
	<row id="msg_0195_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Veuillez patienter.</language>
	</row>
	<row id="msg_0195_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Entrez, je vous prie.</language>
	</row>
	<row id="msg_0195_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Excellent!\nLaissez-moi soigner vos Pokémon.</language>
	</row>
	<row id="msg_0195_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Prochaine étape, le combat nº {STRVAR_1 53, 0, 0}!\nOn y va?</language>
	</row>
	<row id="msg_0195_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous échanger un Pokémon\navant le combat?</language>
	</row>
	<row id="msg_0195_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous enregistrer la vidéo du\ndernier combat sur le Magnéto VS?</language>
	</row>
	<row id="msg_0195_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La Vidéo de combat de {STRVAR_1 3, 0, 0}\na été sauvegardée.\r</language>
	</row>
	<row id="msg_0195_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une erreur est survenue.\nLa sauvegarde a échoué.\r</language>
	</row>
	<row id="msg_0195_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Effacer la Vidéo de combat précédente\npour enregistrer ce combat?</language>
	</row>
	<row id="msg_0195_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sauvegarde en cours...\nNe pas éteindre.</language>
	</row>
	<row id="msg_0195_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous sauvegarder et faire une\npause?</language>
	</row>
	<row id="msg_0195_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous abandonner le\ndéfi de l’Usine de Combat?</language>
	</row>
	<row id="msg_0195_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Attente d’une réponse de {STRVAR_1 3, 0, 0}.\nVeuillez patienter.</language>
	</row>
	<row id="msg_0195_00014" index="14">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0195_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} a décidé d’abandonner.</language>
	</row>
	<row id="msg_0195_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous venez de remporter votre\nseptième combat d’affilée!\rNous vous offrons ces PCo pour\nrécompenser vos connaissances\favancées en matière de Pokémon!\r</language>
	</row>
	<row id="msg_0195_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} obtient {STRVAR_1 51, 1, 0} PCo!\r</language>
	</row>
	<row id="msg_0195_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous pouvez récupérer vos Pokémon.\r</language>
	</row>
	<row id="msg_0195_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sauvegarde en cours...\nNe pas éteindre.</language>
	</row>
	<row id="msg_0195_00020" index="20">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0195_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai pu obtenir certaines informations\nsur votre prochain combat.\rVous allez affronter {STRVAR_1 0, 1, 0},\n{STRVAR_1 0, 3, 0} et {STRVAR_1 0, 5, 0}.\r</language>
	</row>
	<row id="msg_0195_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai pu obtenir certaines informations\nsur votre prochain combat.\rVous allez affronter {STRVAR_1 0, 1, 0}\net {STRVAR_1 0, 3, 0}.\r</language>
	</row>
	<row id="msg_0195_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai pu obtenir certaines informations\nsur votre prochain combat.\rVous allez d’abord affronter un\n{STRVAR_1 0, 1, 0} utilisant {STRVAR_1 6, 0, 0}.\r</language>
	</row>
	<row id="msg_0195_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai pu obtenir certaines informations\nsur votre prochain combat.\rVous allez d’abord affronter un\nPokémon utilisant {STRVAR_1 6, 0, 0}.\r</language>
	</row>
	<row id="msg_0195_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai pu obtenir certaines informations\nsur votre prochain combat.\rVous risquez de rencontrer un\nPokémon de type {STRVAR_1 15, 0, 0}.\r</language>
	</row>
	<row id="msg_0195_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai pu obtenir certaines informations\nsur votre prochain combat.\rVous pourrez tomber sur un Pokémon\nde n’importe quel type. Prenez garde!\r</language>
	</row>
	<row id="msg_0195_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai pu obtenir certaines informations\nsur votre prochain combat.\rVous allez affronter {STRVAR_1 0, 1, 0},\n{STRVAR_1 0, 2, 0}, {STRVAR_1 0, 3, 0} et\f{STRVAR_1 0, 4, 0}.\r</language>
	</row>
	<row id="msg_0195_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai pu obtenir certaines informations\nsur votre prochain combat.\rVous allez commencer par affronter \n{STRVAR_1 0, 1, 0} et {STRVAR_1 0, 2, 0}.\r</language>
	</row>
	<row id="msg_0195_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai pu obtenir certaines informations\nsur votre prochain combat.\rVous allez d’abord affronter un\nPokémon utilisant {STRVAR_1 6, 0, 0}\fet {STRVAR_1 6, 1, 0}.\r</language>
	</row>
	<row id="msg_0195_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai pu obtenir certaines informations\nsur votre prochain combat.\rVous allez d’abord affronter un\nPokémon utilisant {STRVAR_1 6, 0, 0}.\r</language>
	</row>
	<row id="msg_0195_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">CONTINUER</language>
	</row>
	<row id="msg_0195_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ENREGISTRER</language>
	</row>
	<row id="msg_0195_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FAIRE UNE PAUSE</language>
	</row>
	<row id="msg_0195_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ABANDONNER</language>
	</row>
	<row id="msg_0195_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Félicitations, Dresseur!\rInspiré par vos victoires successives,\nnotre Meneur de Zone a décidé de\fvous affronter en personne.\rLors de votre prochain combat, vous\ndevrez affronter notre Chef d’Usine!\rSerez-vous à la hauteur?\r</language>
	</row>
	<row id="msg_0195_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cardus: Analyse en cours...\rOh, ne fais pas attention à moi.\rJe viens d’activer une de mes inventions\ngéniales, un méta-analyseur composite.\rCe petit bijou me permet de savoir avec\nprécision quels Pokémon tu as avec toi.\rJe crois pouvoir affirmer que tu vas\nutiliser {STRVAR_1 0, 0, 0}, {STRVAR_1 0, 1, 0}\fet {STRVAR_1 0, 2, 0} pour notre combat.\rUn choix intéressant. D’après mes\ncalculs, tu as d’ailleurs {STRVAR_1 51, 3, 0}% de\fchances de remporter la victoire.\rMais ne nous préoccupons pas des\nstatistiques, concentrons-nous plutôt\fsur le combat. C’est parti!\r</language>
	</row>
	<row id="msg_0195_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cardus: Analyse en cours...\rVoyons ce que dit mon méta-analyseur\fcomposite cette fois-ci...\rVoyons voir quels Pokémon tu as choisis\npour ce combat...\rOh! Un choix inattendu...\n{STRVAR_1 0, 0, 0}, {STRVAR_1 0, 1, 0} et\f{STRVAR_1 0, 2, 0}, c’est ça?\rCette combinaison présente des\navantages tactiques indéniables.\rD’après mes calculs, tu as d’ailleurs\n{STRVAR_1 51, 3, 0}% de chances de gagner ce combat.\rMais ne nous préoccupons pas des\nstatistiques, concentrons-nous plutôt\fsur le combat.\rJe n’ai aucune intention de m’incliner\ncette fois!\r</language>
	</row>
	<row id="msg_0195_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cardus: Bien... Les résultats sont sans\nappel. Je m’incline.\rCette défaite me rend perplexe, je vais\ndevoir analyser à nouveau toutes les\fdonnées de notre combat...\rCela dit, je suis content d’avoir eu\nl’occasion de t’affronter.\rAu fait, comment as-tu trouvé les\nPokémon que tu as empruntés?\rEn tant que Chef d’Usine, ton avis\nm’intéresse.\rTu devrais essayer de choisir d’autres\nPokémon la prochaine fois, pour voir.\r</language>
	</row>
	<row id="msg_0195_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cardus: Bien... Une fois de plus, les\nrésultats sont sans appel. Je m’incline.\rCette défaite me rend perplexe, j’avais\npourtant analysé en détail toutes les\fdonnées de notre dernier combat...\rJ’étais pourtant sûr d’avoir tiré\nles bonnes conclusions...\rEnfin bref, j’essaierai de voir cette\nnouvelle défaite comme une occasion de\fparfaire mes connaissances...\rJ’espère que tu continueras à\nemprunter nos Pokémon et qu’on aura\fà nouveau l’occasion de s’affronter!\r</language>
	</row>
</body>
