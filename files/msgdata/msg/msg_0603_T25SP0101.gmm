<?xml version="1.0"?>
<body language="English">
	<row id="msg_0603_T25SP0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ici, vous pouvez échanger\nvos Jetons contre de\ffabuleux prix! {YESNO 0}</language>
	</row>
	<row id="msg_0603_T25SP0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah bon? Revenez quand vous aurez\néconomisé davantage de Jetons!</language>
	</row>
	<row id="msg_0603_T25SP0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous n’avez pas assez de Jetons! {YESNO 0}</language>
	</row>
	<row id="msg_0603_T25SP0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous avez choisi: {STRVAR_1 8, 0, 0},\nc’est bien cela? {YESNO 0}</language>
	</row>
	<row id="msg_0603_T25SP0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et voilà!\r</language>
	</row>
	<row id="msg_0603_T25SP0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, mais votre Sac est plein...\r</language>
	</row>
	<row id="msg_0603_T25SP0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous ne pouvez pas porter\ndavantage de Pokémon...\rRevenez quand vous en aurez\ndéposé quelques-uns.</language>
	</row>
	<row id="msg_0603_T25SP0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous {STRVAR_1 0, 1, 0}? {YESNO 0}</language>
	</row>
	<row id="msg_0603_T25SP0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} obtient un\n{STRVAR_1 0, 1, 0}! {YESNO 0}</language>
	</row>
	<row id="msg_0603_T25SP0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ici, vous pouvez échanger vos\nJetons contre de beaux Pokémon! {YESNO 0}</language>
	</row>
	<row id="msg_0603_T25SP0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous placez votre achat\ndans la Poche {STRVAR_1 18, 1, 0}. {YESNO 0}</language>
	</row>
	<row id="msg_0603_T25SP0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Annuler</language>
	</row>
	<row id="msg_0603_T25SP0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Capsules Techniques</language>
	</row>
	<row id="msg_0603_T25SP0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Objets</language>
	</row>
	<row id="msg_0603_T25SP0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Clonage\n2 000 Jetons</language>
	</row>
	<row id="msg_0603_T25SP0101_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Danse-Lames\n4 000 Jetons</language>
	</row>
	<row id="msg_0603_T25SP0101_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Repos\n6 000 Jetons</language>
	</row>
	<row id="msg_0603_T25SP0101_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lance-Flamme\n10 000 Jetons</language>
	</row>
	<row id="msg_0603_T25SP0101_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Laser Glace\n10 000 Jetons</language>
	</row>
	<row id="msg_0603_T25SP0101_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tonnerre\n10 000 Jetons</language>
	</row>
	<row id="msg_0603_T25SP0101_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mouch. Soie\n1 000 Jetons</language>
	</row>
	<row id="msg_0603_T25SP0101_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Loupe\n1 000 Jetons</language>
	</row>
	<row id="msg_0603_T25SP0101_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lentil. Zoom\n1 000 Jetons</language>
	</row>
	<row id="msg_0603_T25SP0101_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Métronome\n1 000 Jetons</language>
	</row>
	<row id="msg_0603_T25SP0101_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ABRA{CURSOR_X 102}200 Jetons</language>
	</row>
	<row id="msg_0603_T25SP0101_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ABO{CURSOR_X 102}700 Jetons</language>
	</row>
	<row id="msg_0603_T25SP0101_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MINIDRACO{CURSOR_X 90}2 100 Jetons</language>
	</row>
	<row id="msg_0603_T25SP0101_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SABELETTE{CURSOR_X 102}700 Jetons</language>
	</row>
	<row id="msg_0603_T25SP0101_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis M. Jeu!\rQuand je regarde quelqu’un en train\nde jouer devant moi...\rJe fais corps avec lui, et je suis\nemporté dans le tourbillon du jeu!\rToi! T’as une bonne tête!\rEn accumulant des Jetons, tu peux\ndécrocher GRATUITEMENT\fde fabuleux prix!\rÇa te dit? {YESNO 0}</language>
	</row>
	<row id="msg_0603_T25SP0101_00029" index="29">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0603_T25SP0101_00030" index="30">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0603_T25SP0101_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Parfait!\nAlors, voilà ta Boîte Jetons!\r</language>
	</row>
	<row id="msg_0603_T25SP0101_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vas-y, toi aussi, fais-moi\ntourbillonner!\r</language>
	</row>
	<row id="msg_0603_T25SP0101_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lorsque que tu joues, nous\nsommes tous les deux emportés\fpar la frénésie du jeu!</language>
	</row>
	<row id="msg_0603_T25SP0101_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis M. Jeu!\rQuand je regarde quelqu’un en train\nde jouer devant moi...\rJe fais corps avec lui, et je suis\nemporté dans le tourbillon du jeu!\rToi! Dépêche-toi!\rJoue!\nFais-moi tourbillonner!</language>
	</row>
	<row id="msg_0603_T25SP0101_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Toi! Dépêche-toi!\rJoue!\nFais-moi tourbillonner!</language>
	</row>
	<row id="msg_0603_T25SP0101_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’adore voir les gens plongés dans le\njeu! Je ne m’en lasse pas!\r... OUI!\rC’est ça! Accumule des Jetons, et va\nles échanger contre de fabuleux prix\fauprès de ces personnes à côté.</language>
	</row>
	<row id="msg_0603_T25SP0101_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je me disais bien.\nTu veux goûter au jeu, toi aussi?</language>
	</row>
	<row id="msg_0603_T25SP0101_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Impossible de jouer\nsans Boîte Jetons...\r</language>
	</row>
	<row id="msg_0603_T25SP0101_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">M. Jeu: Hé! Toi!\nTu veux jouer, je le sais!\rJe vais te donner une Boîte Jetons,\nalors approche un peu!</language>
	</row>
	<row id="msg_0603_T25SP0101_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">M. Jeu: Joue!\nFais-moi tourbillonner!\r</language>
	</row>
	<row id="msg_0603_T25SP0101_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">M. Jeu: Toi!\nNe reste pas bêtement au bord\fde cette table!\rAssieds-toi en face de moi,\net joue! Pour moi!</language>
	</row>
</body>
