<?xml version="1.0"?>
<body language="English">
	<row id="msg_0597_T25R1006_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dis, tu écoutes la radio?\rQuelle émission?\rMoi, c’est le Mot de Passe de Buena!\rQuand tu entends le mot de passe,\nil faut l’écrire tout de suite!\rDu coup, mon Pokématos\nest plein de gribouillis...</language>
	</row>
	<row id="msg_0597_T25R1006_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Même un membre de la Team Rocket\naime écouter la radio\fsur la terrasse?</language>
	</row>
	<row id="msg_0597_T25R1006_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quand la fatigue frappe, achète une\nboisson au Distributeur!\fTes Pokémon apprécieront aussi!</language>
	</row>
	<row id="msg_0597_T25R1006_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un membre de la Team Rocket...\rAchète une boisson au Distributeur,\nfais une sieste, et prends un\finstant pour réfléchir sur ta vie...</language>
	</row>
	<row id="msg_0597_T25R1006_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Faites une pause pendant vos courses!\n5⁴: Coin tranquille</language>
	</row>
	<row id="msg_0597_T25R1006_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est un Distributeur.\nQuelle boisson vous fait envie? {YESNO 0}</language>
	</row>
	<row id="msg_0597_T25R1006_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Clang!\rUne canette {STRVAR_1 8, 0, 0} vient\nde tomber.\r</language>
	</row>
	<row id="msg_0597_T25R1006_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Clang!\rBonus! Une autre canette\n{STRVAR_1 8, 0, 0} vient de tomber.\r</language>
	</row>
	<row id="msg_0597_T25R1006_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous n’avez pas assez d’argent...</language>
	</row>
	<row id="msg_0597_T25R1006_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous changez d’avis.</language>
	</row>
	<row id="msg_0597_T25R1006_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue au fameux coin de la chance\ndu Centre Commercial de Doublonville!\rPour 300 $, vous pouvez gagner un joli\nquelque chose, différent selon le jour\fde la semaine!\rVoulez-vous essayer? {YESNO 0}</language>
	</row>
	<row id="msg_0597_T25R1006_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Alors c’est à vous!\r...\n...\r</language>
	</row>
	<row id="msg_0597_T25R1006_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wah!\nVous avez tiré le numéro {STRVAR_1 50, 0, 0}!\rPrenez donc ce joli prix!\r</language>
	</row>
	<row id="msg_0597_T25R1006_00013" index="13">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0597_T25R1006_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh...?</language>
	</row>
	<row id="msg_0597_T25R1006_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh...\nVotre Sac est plein...\rJe vous rends votre argent.\r</language>
	</row>
	<row id="msg_0597_T25R1006_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh...\nVous n’avez pas assez d’argent.\rRevenez plus tard!</language>
	</row>
	<row id="msg_0597_T25R1006_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Revenez nous voir!</language>
	</row>
	<row id="msg_0597_T25R1006_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les prix du dimanche:\rPrix 1: CT02\nPrix 2: Luxe Ball\fPrix 3: Baie</language>
	</row>
	<row id="msg_0597_T25R1006_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les prix du lundi:\rPrix 1: CT65\nPrix 2: Faiblo Ball\fPrix 3: Baie</language>
	</row>
	<row id="msg_0597_T25R1006_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les prix du mardi:\rPrix 1: CT91\nPrix 2: Bis Ball\fPrix 3: Baie</language>
	</row>
	<row id="msg_0597_T25R1006_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les prix du mercredi:\rPrix 1: CT57\nPrix 2: Filet Ball\fPrix 3: Baie</language>
	</row>
	<row id="msg_0597_T25R1006_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les prix du jeudi:\rPrix 1: CT60\nPrix 2: Rapide Ball\fPrix 3: Baie</language>
	</row>
	<row id="msg_0597_T25R1006_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les prix du vendredi:\rPrix 1: CT42\nPrix 2: Sombre Ball\fPrix 3: Baie</language>
	</row>
	<row id="msg_0597_T25R1006_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les prix du samedi:\rPrix 1: CT62\nPrix 2: Chrono Ball\fPrix 3: Baie</language>
	</row>
	<row id="msg_0597_T25R1006_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blanche: J’y crois pas!\nOn se croise, ici! Dingue!\rY doit y avoir un truc entre nous,\ngenre mystique...\rOn échange nos phones, hein? {YESNO 0}</language>
	</row>
	<row id="msg_0597_T25R1006_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} a enregistré Blanche\ndans son Pokématos!</language>
	</row>
	<row id="msg_0597_T25R1006_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blanche: J’suis trop open tous les\nsamedis en journée.\rSi t’as rien à faire de ta vie,\nphone-moi!</language>
	</row>
	<row id="msg_0597_T25R1006_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blanche: Tu crains!</language>
	</row>
	<row id="msg_0597_T25R1006_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blanche: Alors, tu veux mon phone,\nhein? {YESNO 0}</language>
	</row>
	<row id="msg_0597_T25R1006_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blanche: On s’fait une photo? {YESNO 0}</language>
	</row>
	<row id="msg_0597_T25R1006_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blanche: Cool!\nAllez, pose-toi là!\r</language>
	</row>
	<row id="msg_0597_T25R1006_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blanche: Elle est trop bonne,\ncette tof!</language>
	</row>
	<row id="msg_0597_T25R1006_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blanche: Bah!</language>
	</row>
	<row id="msg_0597_T25R1006_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Votre Album Photo est plein!\rRevenez après y avoir fait le ménage\ndans votre PC.</language>
	</row>
</body>
