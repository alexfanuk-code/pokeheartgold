<?xml version="1.0"?>
<body language="English">
	<row id="msg_0515_T08PC0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh! Un Pokédex! C’est le\nProfesseur Chen qui te l’a donné?</language>
	</row>
	<row id="msg_0515_T08PC0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quelle surprise, à l’Arène!\nIl n’y a que des filles identiques!</language>
	</row>
	<row id="msg_0515_T08PC0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’suis Jeannine!\nAbracadabra!\r</language>
	</row>
	<row id="msg_0515_T08PC0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vois? Je lui ressemble, non?\r...?\rZut! Je me suis ratée!</language>
	</row>
</body>
