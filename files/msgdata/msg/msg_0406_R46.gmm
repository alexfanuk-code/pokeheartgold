<?xml version="1.0"?>
<body language="English">
	<row id="msg_0406_R46_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Route 46\nDevant: Chemin de Montagne</language>
	</row>
	<row id="msg_0406_R46_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Antre Noir</language>
	</row>
	<row id="msg_0406_R46_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tiens? Un cul-de-sac...\nJe me serais trompé de chemin?\rJe pensais que c’était\nune ligne droite, ici...</language>
	</row>
	<row id="msg_0406_R46_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu ferais bien de passer parfois là\noù tu ne vas jamais.\rTu pourrais peut-être y rencontrer des\nPokémon jamais vus!</language>
	</row>
</body>
