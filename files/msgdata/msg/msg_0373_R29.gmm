<?xml version="1.0"?>
<body language="English">
	<row id="msg_0373_R29_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Célesta: {STRVAR_1 3, 0, 0}!\rTu sais, avec une Poké Ball, tu peux\nattraper des Pokémon sauvages!\rSuis-moi!\r</language>
	</row>
	<row id="msg_0373_R29_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Luth: {STRVAR_1 3, 0, 0}!\rTu sais, avec une Poké Ball, tu peux\nattraper des Pokémon sauvages!\rSuis-moi!\r</language>
	</row>
	<row id="msg_0373_R29_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">... Comme ça!\r...\nHein? Tu n’as pas bien vu?\rBon, je vais le refaire.\nApproche!\r</language>
	</row>
	<row id="msg_0373_R29_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">... Et voilà, comme ça!\rSi tu les affaiblis encore ou que\ntu les endors, ils seront encore plus\ffaciles à attraper!\rMaintenant, à toi! Fais tes propres\nexpériences!\rTiens, prends ça. Bonne chance!\r</language>
	</row>
	<row id="msg_0373_R29_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">... Et voilà, comme ça!\rSi tu les affaiblis encore ou que\ntu les endors, ils seront encore plus\ffaciles à attraper!\rMaintenant, à toi! Fais tes propres\nexpériences!\rTiens, prends ça. Bonne chance!\r</language>
	</row>
	<row id="msg_0373_R29_00005" index="5">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0373_R29_00006" index="6">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0373_R29_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Célesta: Allez, bonne chance!\r</language>
	</row>
	<row id="msg_0373_R29_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Luth: Allez, bonne chance!\r</language>
	</row>
	<row id="msg_0373_R29_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salut!\nComment vont tes Pokémon?\rS’ils sont fatigués ou qu’ils ne peuvent\nplus se battre, évite de marcher\fdans l’herbe!</language>
	</row>
	<row id="msg_0373_R29_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vois ce mur?\rC’est un peu effrayant de sauter de là,\nmais ça permet d’aller au Bourg Geon\fsans marcher dans l’herbe!</language>
	</row>
	<row id="msg_0373_R29_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si tu veux faire une pause, n’oublie pas\nde sauvegarder ta partie.</language>
	</row>
	<row id="msg_0373_R29_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’attends les Pokémon qui\nn’apparaissent que la journée.</language>
	</row>
	<row id="msg_0373_R29_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’attends les Pokémon qui\nn’apparaissent que la nuit.</language>
	</row>
	<row id="msg_0373_R29_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’attends les Pokémon qui\nn’apparaissent que le matin.</language>
	</row>
	<row id="msg_0373_R29_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Route 29\nOuest: Ville Griotte</language>
	</row>
	<row id="msg_0373_R29_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Route 29\nEst: Bourg Geon</language>
	</row>
	<row id="msg_0373_R29_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Célesta: Ah, enfin!\r</language>
	</row>
	<row id="msg_0373_R29_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Luth: Ah, enfin!\r</language>
	</row>
</body>
