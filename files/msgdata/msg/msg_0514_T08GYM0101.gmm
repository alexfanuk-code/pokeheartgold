<?xml version="1.0"?>
<body language="English">
	<row id="msg_0514_T08GYM0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hahaha!\nDommage, mais c’est raté...\rEh non! C’était encore un piège!\rC’est moi la vraie!\nJeannine, de l’Arène de Parmanie!\r</language>
	</row>
	<row id="msg_0514_T08GYM0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeannine: Tu as du talent, toi.\nJe comprends que tu aies réussi à\fvaincre Koga, du Conseil 4...\fC’est-à-dire mon papa!\rHahaha! Que tu es balèze! J’ai perdu\nsur toute la ligne!\rTiens! Prends ce Badge Ame!\r</language>
	</row>
	<row id="msg_0514_T08GYM0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} reçoit le Badge Ame de\nJeannine!</language>
	</row>
	<row id="msg_0514_T08GYM0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeannine: Et tu as tant de talent que\ntu mérites un cadeau en plus!\rC’est Direct Toxik, une attaque\nqui peut aussi empoisonner sa cible!\r</language>
	</row>
	<row id="msg_0514_T08GYM0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeannine: Je dois encore m’entraîner\net m’améliorer.\rJe continuerai jusqu’à ce que je sois\nplus forte que toi et que papa!</language>
	</row>
	<row id="msg_0514_T08GYM0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salut! Future légende!\rRegarde bien autour de toi:\ntous ces sosies de\fJeannine, Champion de l’Arène...\rSauras-tu découvrir qui est la vraie?</language>
	</row>
	<row id="msg_0514_T08GYM0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’était un beau combat,\nDresseur de Johto!</language>
	</row>
	<row id="msg_0514_T08GYM0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu m’as crue!\nHahaha! Débile!\r</language>
	</row>
	<row id="msg_0514_T08GYM0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu penses quoi de mon déguisement?\nTout le monde m’en dit du bien!</language>
	</row>
	<row id="msg_0514_T08GYM0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hahaha!\rJ’te jure, je suis la vraie!\r</language>
	</row>
	<row id="msg_0514_T08GYM0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et oui, je suis un garçon!\nJ’ai bien le droit de me déguiser en\fJeannine si je veux!</language>
	</row>
	<row id="msg_0514_T08GYM0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hahaha!\nJe suis Jeannine, Champion de l’Arène!\r...\nMême pas vrai!\r</language>
	</row>
	<row id="msg_0514_T08GYM0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hahaha!\nJe me suis jamais autant amusée!\r</language>
	</row>
	<row id="msg_0514_T08GYM0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est trop génial de se déguiser en\nquelqu’un qu’on admire comme ça!</language>
	</row>
	<row id="msg_0514_T08GYM0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis Jeannine!\nBravo, tu m’as trouvée!\fEn garde!\r</language>
	</row>
	<row id="msg_0514_T08GYM0101_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon piège a fonctionné!\r</language>
	</row>
	<row id="msg_0514_T08GYM0101_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quand je suis déguisée en elle,\nje me sens plus forte!</language>
	</row>
	<row id="msg_0514_T08GYM0101_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arène de Parmanie</language>
	</row>
	<row id="msg_0514_T08GYM0101_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arène de Parmanie\rChampion: Jeannine\nDresseur estimé:\f{STRVAR_1 3, 0, 0}</language>
	</row>
</body>
