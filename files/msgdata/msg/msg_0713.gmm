<?xml version="1.0"?>
<body language="English">
	<row id="msg_0713_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Matthias</language>
	</row>
	<row id="msg_0713_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Améliorons nos Pokémon et\nretrouvons-nous pour un combat!\rAllez, on s’échange nos numéros? {YESNO 0}</language>
	</row>
	<row id="msg_0713_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK!\nA plus!</language>
	</row>
	<row id="msg_0713_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah! Tu as peur de ne plus gagner\ncontre moi?</language>
	</row>
	<row id="msg_0713_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allez, on s’échange nos numéros\ncette fois? {YESNO 0}</language>
	</row>
	<row id="msg_0713_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On t’entend vachement bien!\nTu ne serais pas juste à côté?</language>
	</row>
	<row id="msg_0713_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon {STRVAR_1 0, 10, 0} me ressemble de\nplus en plus! Il est trop mimi!\rTu sais quoi?\nOn peut battre un {STRVAR_1 0, 11, 0}\ffacilement. On a bien progressé!\rJe devrais aller à l’Arène de\nDoublonville...\rA plus tard!</language>
	</row>
	<row id="msg_0713_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon {STRVAR_1 0, 10, 0} me ressemble de\nplus en plus! Il est trop mimi!\rTu sais quoi?\nJ’ai pas réussi à battre {STRVAR_1 0, 11, 0}.\fÇa s’est vraiment joué à pas\fgrand-chose...\rOn dirait que mes Pokémon n’ont pas\nencore le niveau.\rA plus tard!</language>
	</row>
	<row id="msg_0713_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as dû faire des progrès, non?\rÇa te dirait de me montrer tout ça en\ncombat?\rJ’attends sur la {STRVAR_1 4, 3, 0}.</language>
	</row>
	<row id="msg_0713_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu es où?\rFaisons un match!\nJ’attends sur la {STRVAR_1 4, 3, 0}.</language>
	</row>
	<row id="msg_0713_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô!\rIls font un super tirage au sort au\n5⁴ étage du Centre Commercial\fde Doublonville!\fViens essayer, c’est super!</language>
	</row>
</body>
