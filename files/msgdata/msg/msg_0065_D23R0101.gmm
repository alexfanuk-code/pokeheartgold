<?xml version="1.0"?>
<body language="English">
	<row id="msg_0065_D23R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue à la Tour Radio\nde Doublonville!</language>
	</row>
	<row id="msg_0065_D23R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue à la Tour Radio\nde Doublonville!\r... C’est du moins ce que j’aimerais\nvous dire, mais... Il est temporairement\fimpossible de visiter la tour.</language>
	</row>
	<row id="msg_0065_D23R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ou... Oui! Je fais comme vous avez dit!\nJe dis aux visiteurs\fde rentrer chez eux!</language>
	</row>
	<row id="msg_0065_D23R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous vous mesurer au jeu\ndu moment?\rDonnez 5 bonnes réponses à notre quiz\npour remporter un Coupon Radio!\rGlissez-le dans votre Pokématos pour\nnous écouter où et quand vous voulez!\rVoulez-vous tenter votre chance? {YESNO 0}</language>
	</row>
	<row id="msg_0065_D23R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Première question!\rPeut-on consulter la carte\ndepuis son Pokématos? {YESNO 0}</language>
	</row>
	<row id="msg_0065_D23R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bonne réponse!\nDeuxième question!\rLes Pokémon NIDORINA sont-ils\ntous femelles? {YESNO 0}</language>
	</row>
	<row id="msg_0065_D23R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bonne réponse!\nTroisième question!\rFargas, le fabricant de Poké Balls,\nutilise-t-il des Noigrom? {YESNO 0}</language>
	</row>
	<row id="msg_0065_D23R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Encore une bonne réponse!\nAlors... Quatrième question!\rEst-il impossible d’utiliser une CT\nsur le Pokémon MAGICARPE? {YESNO 0}</language>
	</row>
	<row id="msg_0065_D23R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Excellent!\nEt voici la dernière question!\rL’intervenante de la fameuse émission\ndu Professeur Chen “La Chronique\fPokémon” s’appelle-t-elle Lola? {YESNO 0}</language>
	</row>
	<row id="msg_0065_D23R0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est un sans-faute!\nFélicitations!\fVoici votre Coupon Radio!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} peut maintenant\nécouter la radio sur son Pokématos!</language>
	</row>
	<row id="msg_0065_D23R0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous pouvez maintenant écouter nos\némissions quand vous voulez!</language>
	</row>
	<row id="msg_0065_D23R0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh non! Mauvaise réponse!\nQuel dommage!\fTentez votre chance une nouvelle fois!</language>
	</row>
	<row id="msg_0065_D23R0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh? Très bien!\nRevenez si vous changez d’avis!</language>
	</row>
	<row id="msg_0065_D23R0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blanche: Ouuuuuuuiiii!\nC’est Blanche!\rJ’ai entendu dire qu’ils organisaient un\nquiz et je suis venue tenter ma chance\fmoi aussi!\rMais la vache, il est trop dur leur quiz!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blanche: Wah, tu déchires toi!\nJ’étais allée jusqu’à la troisième\fquestion. J’pensais trop qu’on\futilisait des Noigrom! Trop dur!\rJ’vais m’rentrer à l’Arène...\r</language>
	</row>
	<row id="msg_0065_D23R0101_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ben est un super DJ!\nIl a une voix qui me fait craquer...</language>
	</row>
	<row id="msg_0065_D23R0101_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moi, je suis fan de Lula, de la\nChronique Pokémon!\r...\nMême si je ne connais que sa voix...</language>
	</row>
	<row id="msg_0065_D23R0101_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">T’es qui, toi?\nNous dérange pas!\rOn peut laisser passer personne\nqui soit pas de la Team Rocket!\rCompris?\rSeuls passent ceux qui portent\nl’uniforme noir et tellement\fclasse de la Team Rocket!</language>
	</row>
	<row id="msg_0065_D23R0101_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tiens? Une nouvelle recrue?\nHoho! L’uniforme de la Team Rocket te\fva à merveille! Allez, passe!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eh alors?\nMonte! Vite! Va à ton poste!</language>
	</row>
	<row id="msg_0065_D23R0101_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 1, 0}: Salut Team Rocket!\rPour qui vous vous prenez, bande\nde minables, à vous grouper ainsi\fpour gâcher la vie des honnêtes gens!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 1, 0}: ... Hein?\nC’est toi, {STRVAR_1 3, 0, 0}?\fQu’est-ce que tu fiches ici?\rNe me dis pas... que tu crois que cet\nuniforme te renforce?\rQuelle bêtise!\nEnlève ça tout de suite!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Que... Quoi?! Tu n’étais pas\nune nouvelle recrue?\fAlors en garde!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">T’es trop balèze!\rTu es un danger pour notre plan!\nJe dois prévenir les autres...\r</language>
	</row>
	<row id="msg_0065_D23R0101_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 1, 0}: Je vois, t’avais mis un\ndéguisement pour les infiltrer...\rPfff!\nC’est vraiment une idée de minable!\rBah, si ça t’amuse...\nJe te laisse cet endroit.\rJe dois poursuivre ce Dracologue avec\nsa cape... Peter...\rEt... Quand je l’aurai écrasé...\nPrépare-toi, car ce sera ton tour!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">RC: Réception\n1¹: Ventes\f2⁴: Personnel\f3⁴: Production\f4⁴: Bureau de la Direction\f5⁴: Observatoire</language>
	</row>
	<row id="msg_0065_D23R0101_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et voici la Loterie Pokémon!\nQuels numéros ID ont vos Pokémon?\rEchangez vos Pokémon pour obtenir\ndavantage de numéros ID!</language>
	</row>
	<row id="msg_0065_D23R0101_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue à la Loterie Pokémon!\nMon nom est Felicity, pour vous servir.\rSi le numéro sur le Billet de Loterie\ncorrespond au numéro ID d’un de vos\fPokémon, vous recevrez un beau cadeau.\rVoulez-vous retirer un Billet de\nLoterie? {YESNO 0}</language>
	</row>
	<row id="msg_0065_D23R0101_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous avez déjà retiré un Billet de\nLoterie aujourd’hui. Revenez demain.</language>
	</row>
	<row id="msg_0065_D23R0101_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, je vois.\nNous espérons vous revoir bientôt.</language>
	</row>
	<row id="msg_0065_D23R0101_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Veuillez tirer un Billet de Loterie!\r...\n...\r</language>
	</row>
	<row id="msg_0065_D23R0101_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le numéro du Billet de Loterie est\n{STRVAR_1 54, 0, 0}!\rJe vais voir si ce numéro correspond\nà l’un des numéros ID de vos Pokémon!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Félicitations!\rUn ou plusieurs chiffres du numéro ID\nde {STRVAR_1 1, 0, 0}, qui est dans votre\réquipe, correspondent à ceux\ndu Billet de Loterie!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Félicitations!\rUn ou plusieurs chiffres du numéro ID\nde {STRVAR_1 1, 0, 0}, qui est stocké dans le\fPC, correspondent à ceux du\fBillet de Loterie!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quel dommage!\nAucun des numéros ne correspond...</language>
	</row>
	<row id="msg_0065_D23R0101_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le dernier chiffre correspond, vous\nremportez le quatrième prix!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous obtenez un nouveau Décor à\nutiliser dans la Cabine d’Essayage.</language>
	</row>
	<row id="msg_0065_D23R0101_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les deux derniers chiffres\ncorrespondent, vous remportez le\ftroisième prix!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les trois derniers chiffres\ncorrespondent, vous remportez le\fdeuxième prix!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les quatre derniers chiffres\ncorrespondent, vous remportez le\fpremier prix!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Magnifique, tous les chiffres\ncorrespondent!\rVous avez gagné le gros lot!\nC’est tout simplement incroyable!\r... Ah, oui, votre prix, pardon!\nJe me suis laissée emporter.\rTenez!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh?\nOn dirait que vous n’avez plus de place.\rFaites de la place dans votre Sac et\nrevenez me voir.</language>
	</row>
	<row id="msg_0065_D23R0101_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}?\nOui, je vous attendais.\rNous avons gardé votre prix.\nTenez!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">N’hésitez pas à revenir tenter votre\nchance! A bientôt!</language>
	</row>
	<row id="msg_0065_D23R0101_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue à la Loterie Pokémon.\rDésirez-vous revérifier le numéro\ngagnant du jour? {YESNO 0}</language>
	</row>
</body>
