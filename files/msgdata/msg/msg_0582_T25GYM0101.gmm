<?xml version="1.0"?>
<body language="English">
	<row id="msg_0582_T25GYM0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blanche: Ouais, c’est moi,\nBlanche!\rJe te connais, non? Tu étais à la\nTour Radio?\fT’as vraiment assuré!\rTu t’occupes de Pokémon, hein?\nMoi aussi, j’adore, je les trouve trop\fmimi!\rQuoi? Tu veux t’battre?\nOK, mais j’suis grave forte!\r</language>
	</row>
	<row id="msg_0582_T25GYM0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Non utilisé</language>
	</row>
	<row id="msg_0582_T25GYM0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blanche: Mais euh!\rOUIN!!!\r... NON!\n... T’as pas le droit!</language>
	</row>
	<row id="msg_0582_T25GYM0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blanche: Quoi ENCORE?\rHein?\nLe Badge?\rDésolée, j’avais oublié!\nVoilà, le Badge Plaine.\fC’est ça que tu voulais, hein?!\r</language>
	</row>
	<row id="msg_0582_T25GYM0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} reçoit le Badge Plaine de\nBlanche.</language>
	</row>
	<row id="msg_0582_T25GYM0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blanche: Avec ce Badge, tu peux\nutiliser Force même en dehors des\fcombats.\rEt tiens, prends-ça aussi!\r</language>
	</row>
	<row id="msg_0582_T25GYM0101_00006" index="6">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0582_T25GYM0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blanche: Dedans, y’a Attraction.\nUne capacité Pokémon qui tue tout!\fElle rend les Pokémon irrésistibles!\fÇa me va vachement bien, hein?\rEt puis!\rY viennent juste d’ouvrir un truc pour\nles compétitions à côté du Parc\fNaturel, ça s’appelle Pokéathlon\fje crois.\rVu comme t’es balèze en Pokémon, tu\ndevrais trop y faire un tour!</language>
	</row>
	<row id="msg_0582_T25GYM0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blanche: Ça fait du bien de se taper une\ncrise de nerfs!\rReviens me voir! Ciao!</language>
	</row>
	<row id="msg_0582_T25GYM0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah! Blanche a fait son caprice!\rElle s’arrête au bout d’un moment.\nElle fait toujours ça quand elle perd.\r</language>
	</row>
	<row id="msg_0582_T25GYM0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salut! Futur Maître!\rLes spécialistes des Pokémon de type\nNormal se sont réunis dans cette\fArène.\rPour les affronter, je recommande le\ntype Combat.</language>
	</row>
	<row id="msg_0582_T25GYM0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as gagné? Bravo!\nJ’étais occupé à regarder tous ces\fsuper Dresseurs...</language>
	</row>
	<row id="msg_0582_T25GYM0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arène de Doublonville</language>
	</row>
	<row id="msg_0582_T25GYM0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arène de Doublonville\rChampion: Blanche\nDresseur estimé:\f{STRVAR_1 3, 0, 0}</language>
	</row>
</body>
