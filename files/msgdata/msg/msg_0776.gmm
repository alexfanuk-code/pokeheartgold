	</row>
	<row id="msg_0776_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En attente de participants...\nBouton B: Annuler</language>
	</row>
	<row id="msg_0776_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La partie va bientôt commencer!\nVeuillez patienter...</language>
