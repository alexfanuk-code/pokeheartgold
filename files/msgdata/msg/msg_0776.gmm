	</row>
	<row id="msg_0776_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Début dans {STRVAR_1 51, 0, 0} s.</language>
	</row>
	<row id="msg_0776_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quatre joueurs sont réunis.\nLa partie commence!</language>
	</row>
	<row id="msg_0776_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un des participants s’est désisté.\nVeuillez recommencer la procédure.\r</language>
	</row>
	<row id="msg_0776_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le temps d’attente est écoulé.\nLa partie commence!</language>
	</row>
	<row id="msg_0776_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Personne d’autre ne semble vouloir\nparticiper pour le moment.\rVeuillez recommencer la procédure.\r</language>
	</row>
	<row id="msg_0776_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le service n’est pas disponible. Vous ne\npouvez pas participer pour le moment.\r</language>
	</row>
	<row id="msg_0776_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le temps imparti est écoulé.\rVous ne pouvez plus accéder à\n{STRVAR_3 0, 0, 0}.\r</language>
	</row>
	<row id="msg_0776_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous ne pouvez plus accéder à\n{STRVAR_3 0, 0, 0}.\r</language>
	</row>
	<row id="msg_0776_00023" index="23">
		<attribute name="window_context_name">garbage</attribute>
