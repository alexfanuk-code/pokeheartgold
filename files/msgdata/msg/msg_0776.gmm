<body language="English">
	<row id="msg_0776_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous jouer\nà {STRVAR_3 0, 0, 0}?</language>
	</row>
	<row id="msg_0776_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">PARTICIPER</language>
	</row>
