	<row id="msg_0776_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ANNULER</language>
	</row>
	<row id="msg_0776_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous n’avez pas rejoint le groupe\njouant à {STRVAR_3 0, 0, 0}.\r</language>
	</row>
	<row id="msg_0776_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une partie est en cours. Veuillez\nattendre qu’elle se termine.\r</language>
	</row>
	<row id="msg_0776_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Impossible de jouer à\n{STRVAR_3 0, 0, 0} maintenant.\r</language>
	</row>
	<row id="msg_0776_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Certains préparatifs sont nécessaires.\nVeuillez patienter un moment.\r</language>
	</row>
	<row id="msg_0776_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’un des participants s’est désisté.\rLa partie est annulée.\r</language>
	</row>
	<row id="msg_0776_00009" index="9">
