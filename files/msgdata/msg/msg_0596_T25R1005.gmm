<?xml version="1.0"?>
<body language="English">
	<row id="msg_0596_T25R1005_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue!\rOh! Ton Pokémon...\r</language>
	</row>
	<row id="msg_0596_T25R1005_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il est vraiment attaché à toi!\nCette capacité convient parfaitement\fà votre équipe!\r</language>
	</row>
	<row id="msg_0596_T25R1005_00002" index="2">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0596_T25R1005_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Qu’il est mignon!\rJ’espère que tu lui apprends de bonnes\ncapacités avec les CT!</language>
	</row>
	<row id="msg_0596_T25R1005_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il n’a pas l’air très gentil...\nCette CT lui plairait sans doute!\r</language>
	</row>
	<row id="msg_0596_T25R1005_00005" index="5">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0596_T25R1005_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis sûre qu’il y a une CT adaptée\nà ton Pokémon.</language>
	</row>
	<row id="msg_0596_T25R1005_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Cadeau Mystère.\rBip!\rEt le cadeau arrive!</language>
	</row>
	<row id="msg_0596_T25R1005_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Cadeau Mystère.\rÇa ne marche pas avec\nmon Game Boy...</language>
	</row>
	<row id="msg_0596_T25R1005_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moi, je collectionne les Pokémon!\nTu as un SOPORIFIK?\rTu me l’échanges contre mon\nMACHOC? {YESNO 0}</language>
	</row>
	<row id="msg_0596_T25R1005_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Super! J’ai un SOPORIFIK!\nMerci!</language>
	</row>
	<row id="msg_0596_T25R1005_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hein...?\nMais c’est pas un SOPORIFIK!\fZut, quel dommage...</language>
	</row>
	<row id="msg_0596_T25R1005_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu ne veux pas échanger?\nZut, quel dommage...</language>
	</row>
	<row id="msg_0596_T25R1005_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salut!\nLe MACHOC que je t’ai donné va bien?</language>
	</row>
	<row id="msg_0596_T25R1005_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hein? Mais...\nDepuis quand tu es dans la Team Rocket?</language>
	</row>
	<row id="msg_0596_T25R1005_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le dimanche, une madame vient voir les\nPokémon, et elle donne aussi des CT!</language>
	</row>
	<row id="msg_0596_T25R1005_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Qu’est-ce que la Team Rocket fait ici?</language>
	</row>
	<row id="msg_0596_T25R1005_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu ne peux pas renommer un Pokémon\nque tu as reçu dans un échange.\rCe nom contient toujours les sentiments\ndu Dresseur d’origine.</language>
	</row>
	<row id="msg_0596_T25R1005_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Avec des habits pareils, on va penser\nque tu fais partie de la Team Rocket!\rHein? T’en fais vraiment partie?</language>
	</row>
	<row id="msg_0596_T25R1005_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Pokémon comme on les aime\n4⁴: Le Coin des CT</language>
	</row>
</body>
