<?xml version="1.0"?>
<body language="English">
	<row id="msg_0706_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jacky</language>
	</row>
	<row id="msg_0706_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Notre combat était magnifique!\rJe veux que tu me laisses un petit\nsouvenir!\rTon numéro de téléphone!\rJe ne pourrai pas trop discuter\npendant des heures, mais... {YESNO 0}</language>
	</row>
	<row id="msg_0706_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je dois continuer à m’entraîner!</language>
	</row>
	<row id="msg_0706_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si tu veux mon numéro, viens me voir.</language>
	</row>
	<row id="msg_0706_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je m’entraîne beaucoup\nmais veux-tu mon\fnuméro de téléphone? {YESNO 0}</language>
	</row>
	<row id="msg_0706_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je tiens à te dire merci, {STRVAR_1 3, 0, 0}!\nJe m’entraînais en solitaire...\rMerci d’avoir appelé...\nVoilà pour toi!\r</language>
	</row>
	<row id="msg_0706_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu ne peux plus rien porter!\nJe vais garder ça.\rVide donc ton Sac!</language>
	</row>
	<row id="msg_0706_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Viens me voir directement au lieu de\ntéléphoner!</language>
	</row>
	<row id="msg_0706_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu te balades toujours?\nMoi je m’entraîne.\rOooooaaarrrgh!</language>
	</row>
	<row id="msg_0706_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pardon, mais je m’entraîne!\nOn parlera demain!\rYiiihah!</language>
	</row>
	<row id="msg_0706_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je compte faire une pause pour\ndéjeuner! Viens me voir!</language>
	</row>
	<row id="msg_0706_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je fais une pause sur la Route 45!\nTu viens me dire bonjour?</language>
	</row>
	<row id="msg_0706_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai mangé...\nEt j’ai dormi.\rMaintenant...\nEntraînement!\rYaaaaahaha!</language>
	</row>
</body>
