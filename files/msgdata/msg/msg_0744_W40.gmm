<?xml version="1.0"?>
<body language="English">
	<row id="msg_0744_W40_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il faut s’échauffer avant de se\nbaigner. Tout le monde sait ça!</language>
	</row>
	<row id="msg_0744_W40_00001" index="1">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0744_W40_00002" index="2">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0744_W40_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé! Nage au lieu de monter\nsur ton Pokémon!</language>
	</row>
	<row id="msg_0744_W40_00004" index="4">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0744_W40_00005" index="5">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0744_W40_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vas à Irisia?\rOn s’bat d’abord?</language>
	</row>
	<row id="msg_0744_W40_00007" index="7">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0744_W40_00008" index="8">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0744_W40_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je m’accroche à mes Pokémon marins\nplutôt qu’à une bouée!</language>
	</row>
	<row id="msg_0744_W40_00010" index="10">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0744_W40_00011" index="11">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0744_W40_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On ne la voit pas d’ici, mais Irisia est\nde l’autre côté de la mer.</language>
	</row>
	<row id="msg_0744_W40_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis venue en bateau pour visiter\nOliville.\rLes ports, ça change des grandes\nvilles! J’aime bien cette atmosphère!</language>
	</row>
	<row id="msg_0744_W40_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu sais ce qui se trouve de l’autre côté\nde ce portail?\rLa Zone de Combat!\rPour voyager, j’ai élevé des Pokémon\naux capacités utiles, mais pour la\fZone de Combat, j’aurais peut-être\fdû privilégier des Pokémon aux\fcapacités pugilistiques...</language>
	</row>
	<row id="msg_0744_W40_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé! Vise un peu la vague!\nFaut que j’me la fasse!\r</language>
	</row>
	<row id="msg_0744_W40_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah? T’as pas encore Surf?\rÇa reste entre nous, mais... j’ai reçu\nSurf par le type de Rosalia!\rJe crois qu’il est toujours là-bas, tu\ndevrais aller le voir!\r</language>
	</row>
	<row id="msg_0744_W40_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça reste entre nous, mais... j’ai reçu\nSurf par le type de Rosalia!\rJe crois qu’il est toujours là-bas, tu\ndevrais aller le voir!</language>
	</row>
	<row id="msg_0744_W40_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé!\nVise un peu la vague!\fFaut que j’me la fasse!</language>
	</row>
	<row id="msg_0744_W40_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chenal 40\nSud: Irisia</language>
	</row>
	<row id="msg_0744_W40_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zone de Combat\nDroit devant</language>
	</row>
</body>
