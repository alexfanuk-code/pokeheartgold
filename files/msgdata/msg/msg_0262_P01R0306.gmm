<?xml version="1.0"?>
<body language="English">
	<row id="msg_0262_P01R0306_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah bon, tu joues à cache-cache avec\nelle...\rTant qu’elle est à bord du bateau,\nje ne m’inquiète pas!</language>
	</row>
	<row id="msg_0262_P01R0306_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, c’est toi...\nJe ne l’ai toujours pas trouvée...\rTant qu’elle est à bord du bateau, il\nn’y a pas à s’en faire, mais...\relle est pleine d’énergie, j’ai peur\nqu’elle n’embête quelqu’un...\fAh, je m’inquiète!</language>
	</row>
	<row id="msg_0262_P01R0306_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est moi!\nJe jouais...\fà cache-cache...\fdans le bateau...\favec ce garçon!\r</language>
	</row>
	<row id="msg_0262_P01R0306_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est moi!\nJe jouais...\fà cache-cache...\fdans le bateau...\favec cette fille!\r</language>
	</row>
	<row id="msg_0262_P01R0306_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Euh... Bien, {STRVAR_1 3, 0, 0}...\nMerci de t’être occupé d’elle.\rTiens! Voici un cadeau\nen guise de remerciement!\r</language>
	</row>
	<row id="msg_0262_P01R0306_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Euh... Bien, {STRVAR_1 3, 0, 0}...\nMerci de t’être occupée d’elle.\rTiens! Voici un cadeau\nen guise de remerciement!\r</language>
	</row>
	<row id="msg_0262_P01R0306_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Bateau Express Aquaria est arrivé\nà Carmin sur Mer.</language>
	</row>
	<row id="msg_0262_P01R0306_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nous voyageons autour du monde.</language>
	</row>
	<row id="msg_0262_P01R0306_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je me suis super amusée!</language>
	</row>
</body>
