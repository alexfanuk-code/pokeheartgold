<?xml version="1.0"?>
<body language="English">
	<row id="msg_0412_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité</language>
	</row>
	<row id="msg_0412_00001" index="1">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0412_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Le Centre Pokémon!\nIl y en a toujours un près de chez soi!</language>
	</row>
	<row id="msg_0412_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Boutique Pokémon. On y trouve\ntout, surtout des sourires!</language>
	</row>
	<row id="msg_0412_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Le compagnon de l’aventure,\nc’est le Pokématos bien sûûûûr!\nLe Pokématos de la Sylphe SARL,\npour des voyages qui donnent des ailes!</language>
	</row>
	<row id="msg_0412_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Des regards qui se croisent,\nc’est un combat qui commence! Evitez les\ncombats si vous n’êtes pas un Dresseur!\nC’était un communiqué\nde la Ligue Pokémon.</language>
	</row>
	<row id="msg_0412_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Vous vous retournez, et il est\nlà, derrière vous! Votre fidèle\npartenaire, votre Pokémon!\nC’était un communiqué\nde la Ligue Pokémon.</language>
	</row>
	<row id="msg_0412_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Prenez le temps...\nGoûtez au temps jadis!\nA l’ombre de la Tour CHETIFLOR...\nMauville vous attend!\nOffice du Tourisme de Johto.</language>
	</row>
	<row id="msg_0412_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Venez déchiffrez les mystères\ndu passé aux Ruines d’Alpha!\nOffice du Tourisme de Johto.</language>
	</row>
	<row id="msg_0412_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Au rythme d’une musique\nlancinante, une danse fascinante...\nSuccombez aux charmes de Rosalia!\nOffice du Tourisme de Johto.</language>
	</row>
	<row id="msg_0412_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Un voyage en mer angoissant...\nEt des ténèbres jaillit la lumière!\nLa réconfortante lumière du Phare\nd’Oliville! Laissez-vous guider!\nOffice du Tourisme de Johto.</language>
	</row>
	<row id="msg_0412_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Noiiiiiigruuuuuuume Driiiink!\nCourez, secouez...\nNoiiiiiigruuuuuuume Driiiink!\nTout le monde adore...\nNoiiiiiigruuuuuuume Driiiink!\nAttention: boisson destinée\nEXCLUSIVEMENT aux Pokémon.</language>
	</row>
	<row id="msg_0412_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Un design élégant.\nUne silhouette sportive.\nAvec votre fidèle Pokémon,\nfilez comme le vent...\ngrâce aux Chaussures de Sport!</language>
	</row>
	<row id="msg_0412_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Une rencontre qui change\nvotre vie au Centre Pokémon.\nPuis, une autre, et une autre encore!\nC’est là, en haut de l’escalier...\nLa Salle Union!</language>
	</row>
	<row id="msg_0412_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Une rencontre qui change\nvotre vie au Centre Pokémon.\nPuis, une autre, et une autre encore!\nC’est là, en bas de l’escalator...\nLe Club Wi-Fi!!</language>
	</row>
	<row id="msg_0412_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Le Terminal Mondial, la fierté\nde Doublonville!\nEt votre fenêtre sur le monde!\nConnectez-vous et échangez à la GTS!</language>
	</row>
	<row id="msg_0412_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Le Square Wi-Fi...\nle rendez-vous des amis!\nLe Square Wi-Fi...\nOn y joue, on y rit!\nDites OUIIIIIIII, au Square Wi-Fi!</language>
	</row>
	<row id="msg_0412_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: “Mon Pokémon veut un objet,\nmais je ne l’ai pas! Que faire?”\n“Mais voyons chéri, il sera forcément au\nCentre Commercial de Doublonville!\nEn plus à des prix IMBATTABLES!”</language>
	</row>
	<row id="msg_0412_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Entre deux combats,\nune pause s’impose!\nAh, le Casino de Doublonville!</language>
	</row>
	<row id="msg_0412_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Chers auditeurs...\nLaissez-vous porter sur les ailes du\nrêve par la Radio de Johto!\nNous avons le permis pour vous emmener\njusqu’au paradis!</language>
	</row>
	<row id="msg_0412_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Hé! Toi!\nTu veux tester ton amitié avec tes\nPokémon? Alors, file au Pokéathlon!\n10 épreuves t’y attendent!\nLe Pokéathlon, sponsor de l’amitié!</language>
	</row>
	<row id="msg_0412_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Lalala lalala la la lala la Ohhh!\nAAAAAAA-MITIE!\nCOOOOOOO-OPERATION!\nCOOOOOOON-FIANCE!\nCROIIIIIII-RE EN SOI!\nSE DEEEEEEE-PENSER\nSANS COMPTER! SANS ECHOUER!\n...\n“Crois en tes Pokémon!”, la chanson\nofficielle du Pokéathlon.\nBientôt dans les bacs.\n\n</language>
	</row>
	<row id="msg_0412_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Tu aimes les Pokémon Insecte?\nAlors, tous les mardis, jeudis et samedis,\nfonce au Concours de Capture\nd’insecte!\nTu vas A-DO-RER!\nAllez! Tous au Parc Naturel!</language>
	</row>
	<row id="msg_0412_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Il court il court le Pokémon,\nle Pokémon du Safari!\nIl est passé par ici, je l’attraperai\npar là...\n... Au Parc Safariiiii de M. Baoba!!</language>
	</row>
	<row id="msg_0412_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Ah, les véritables Bonbons\nRage d’Acajou! Je me souviens encore de\nla première fois que je les ai goûtés...\nMaintenant, c’est moi qui les fais\ndécouvrir aux gens que j’aime!\nAh, le goût authentique du Bonbon Rage!</language>
	</row>
	<row id="msg_0412_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Lassé des combats ordinaires?\nVous cherchez le grand frisson?\nVous le trouverez...\nà la Tour de Combat!\nEn solo ou en duo, pour des combats\nd’exception, pensez Tour de Combat!</language>
	</row>
	<row id="msg_0412_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Connaissez-vous vraiment\nla Tour de Combat?\nLes meilleurs Dresseurs du monde entier\nsont réunis pour vous affronter!\nJusqu’où serez-vous capable d’aller?</language>
	</row>
	<row id="msg_0412_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Vos Pokémon méritent de\ndevenir des stars! A eux la célébrité...\nA vous la gloire!\nSur la scène où tous les regards sont\ntournés... la Scène de Combat!</language>
	</row>
	<row id="msg_0412_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Accumulez les Points Castel!\nUtilisez-les avec discernement!\nAu berceau du combat Pokémon,\nle Castel de Combat!</language>
	</row>
	<row id="msg_0412_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: La vie est un jeu!\nLe hasard est capricieux!\nCroyez en vos Pokémon!\nChangez la donne!\nA l’Arcade de Combat!\nRien n’est joué d’avance!</language>
	</row>
	<row id="msg_0412_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Avez-vous une connaissance\nabsolue des Pokémon?\nVenez prouver vos capacités\nà l’Usine de Combat!\nPourquoi ne pas tenter votre chance?\nL’Usine de Combat n’attend que vous!</language>
	</row>
	<row id="msg_0412_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Détente et volupté pour\nune croisière de rêve.\nRalliez Oliville ou Carmin d’une traite\ngrâce au Bateau Express!</language>
	</row>
	<row id="msg_0412_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Qu’il fait bon sous le soleil de\nKanto!\nProfitez de la Piste Cyclable!\nRendez-vous Route 17!</language>
	</row>
	<row id="msg_0412_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: La Ligue Pokémon vous attend!\nSaurez-vous relever le défi?\nTraversez la Route 22!\nC’était un communiqué de\nla Ligue Pokémon.</language>
	</row>
	<row id="msg_0412_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Il ne s’est pas laissé abattre\npar la destruction de son Arène dans une\néruption. Son nom: Auguste!\nRetrouvez la nouvelle Arène de\nCramois’Ile aux Iles Ecume!</language>
	</row>
	<row id="msg_0412_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: Chers auditeurs...\nLaissez-vous bercer sur les ailes du\nrêve par la Radio de Kanto!\nNous avons la permission de vous emmener\njusqu’au paradis!</language>
	</row>
	<row id="msg_0412_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: La Sylphe SARL: des produits\nhigh-tech pour un avenir radieux!\nPour que chaque jour soit plus facile\nà vivre: Sylphe SARL.</language>
	</row>
	<row id="msg_0412_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Publicité: En un clin d’œil,\nde Doublonville à Safrania! \nRapidité et service au top-niveau!\nGoûtez vous aussi au futur avec\nle Train Magnétique!</language>
	</row>
</body>
