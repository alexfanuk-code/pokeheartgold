<?xml version="1.0"?>
<body language="English">
	<row id="msg_0562_T22R0601_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un Pokémon échangé grandit plus vite\nqu’un Pokémon attrapé.\rMais si tu n’as pas assez de Badges,\nil risque de ne pas t’écouter.</language>
	</row>
	<row id="msg_0562_T22R0601_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je collectionne les Pokémon!\nEst-ce que tu as un CHETIFLOR?\rJe te l’échange contre un ONIX! {YESNO 0}</language>
	</row>
	<row id="msg_0562_T22R0601_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hourra! J’ai un CHETIFLOR!\nMerci!</language>
	</row>
	<row id="msg_0562_T22R0601_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hein...?\nMais c’est pas un CHETIFLOR...\fPfff... Dommage...</language>
	</row>
	<row id="msg_0562_T22R0601_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu ne veux pas échanger?\nPfff... Déception...</language>
	</row>
	<row id="msg_0562_T22R0601_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salut! Comment va l’ONIX que je\nt’ai échangé?</language>
	</row>
</body>
