<?xml version="1.0"?>
<body language="English">
	<row id="msg_0493_T07PC0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé! Qu’il est beau, ton Pokématos!\nC’est un nouveau modèle?</language>
	</row>
	<row id="msg_0493_T07PC0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erika utilise des Pokémon de type\nPlante! Reste sur tes gardes!</language>
	</row>
	<row id="msg_0493_T07PC0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Casino était tenu à l’origine par la\nTeam Rocket...\rUne fois la Rocket hors d’état de nuire,\nil a été repris par un vieux richard qui\fadorait le jeu.</language>
	</row>
</body>
