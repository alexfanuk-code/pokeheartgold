<?xml version="1.0"?>
<body language="English">
	<row id="msg_0017_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous avez reçu un message d’un\n₧₦ Ranger.\n\nVous pouvez recevoir un {COLOR 1}Oeuf de\nMANAPHY {COLOR 0}de ce ₧₦ Ranger!\n\nA l’écran suivant, veuillez choisir\n{COLOR 1}Connexion avec un Ranger{COLOR 0}.\nTouchez l’écran pour continuer.</language>
	</row>
	<row id="msg_0017_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un signal de Cadeau Mystère a été\nreçu!\n\nVous pouvez recevoir un Cadeau\nMystère!\n\nA l’écran suivant, choisissez\n{COLOR 1}Cadeau Mystère{COLOR 0}.\nTouchez l’écran pour continuer.</language>
	</row>
	<row id="msg_0017_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous avez reçu un message d’un\n₧₦ Ranger.\n\nCependant, pour communiquer avec\nce ₧₦ Ranger, vous devez\nprogresser dans le jeu afin\nd’obtenir un Pokédex.\nTouchez l’écran pour continuer.</language>
	</row>
	<row id="msg_0017_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un signal de Cadeau Mystère a été\nreçu.\n\nCependant, pour pouvoir obtenir\nun Cadeau Mystère, vous devez\nprogresser dans l’histoire afin\nd’obtenir un Pokédex.\nTouchez l’écran pour continuer.</language>
	</row>
	<row id="msg_0017_00004" index="4">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0017_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{COLOR 1}ATTENTION!\n{COLOR 0}Il y a déjà un fichier de sauvegarde.\nSi vous commencez une nouvelle aventure,\nvous ne pourrez pas la sauvegarder.\nContinuer?</language>
	</row>
	<row id="msg_0017_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Commencer l’aventure</language>
	</row>
	<row id="msg_0017_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Revenir au menu</language>
	</row>
</body>
