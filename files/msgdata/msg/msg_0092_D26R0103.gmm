	<row id="msg_0092_D26R0103_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je reste ici pour voir l’évolution\ndu RAMOLOSS.\rEn observant, j’ai fait une\ndécouverte importante.\rUn RAMOLOSS avec une Roche Royale\nse fait souvent mordre par les KOKIYAS.\rTiens! Prends-en une!</language>
	</row>
	<row id="msg_0092_D26R0103_00001" index="1">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0092_D26R0103_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je serai patient comme un RAMOLOSS,\net j’attendrai leur évolution.</language>
	</row>
