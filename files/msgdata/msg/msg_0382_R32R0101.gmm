<?xml version="1.0"?>
<body language="English">
	<row id="msg_0382_R32R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Par ici la visite des Ruines d’Alpha!\nUn site touristique interactif!\rVenez toucher vous-mêmes les panneaux\nde pierre coulissants!</language>
	</row>
	<row id="msg_0382_R32R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh! Tu t’intéresses aux Ruines d’Alpha?\nTu veux devenir scientifique?</language>
	</row>
	<row id="msg_0382_R32R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les panneaux de pierre sont illustrés!\nEt ils bougent... A quoi ça peut servir?</language>
	</row>
</body>
