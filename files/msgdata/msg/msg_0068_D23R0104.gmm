<?xml version="1.0"?>
<body language="English">
	<row id="msg_0068_D23R0104_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’écoutais la radio en visitant les\nruines, quand soudain j’ai entendu\fune émission que je ne connaissais pas.</language>
	</row>
	<row id="msg_0068_D23R0104_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lula: Mais!!!\nPourquoi tant de haine?\rMIAOUSS, à l’aide!</language>
	</row>
	<row id="msg_0068_D23R0104_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lula: C’est toi, le Dresseur qui m’a\naidée? Alors tiens!\rC’est en remerciement!\r</language>
	</row>
	<row id="msg_0068_D23R0104_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} reçoit de la Poudreclaire\nde la part de Lula!</language>
	</row>
	<row id="msg_0068_D23R0104_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lula: Si tu fais tenir cela à un de\ntes Pokémon, cela augmentera ses\fchances d’éviter les attaques!</language>
	</row>
	<row id="msg_0068_D23R0104_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh non! Ton Sac est plein!</language>
	</row>
	<row id="msg_0068_D23R0104_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lula: Et n’oublie pas d’écouter mon\némission avec le Professeur Chen!</language>
	</row>
	<row id="msg_0068_D23R0104_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MIAOUSS: Miaou...</language>
	</row>
	<row id="msg_0068_D23R0104_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">3⁴: Production</language>
	</row>
	<row id="msg_0068_D23R0104_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">3⁴: Studio 1</language>
	</row>
	<row id="msg_0068_D23R0104_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ben: La Team Rocket... Il leur manque\nquelque chose: de la musique!\rLa musique adoucit les mœurs.\rAucun amateur de musique n’aurait fait\ndes choses pareilles dans cette tour!</language>
	</row>
	<row id="msg_0068_D23R0104_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ben: Tu écoutes notre musique?</language>
	</row>
	<row id="msg_0068_D23R0104_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est le Commandant Lance qui a créé\nce plan... Quel homme...\r</language>
	</row>
	<row id="msg_0068_D23R0104_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Que... Qui es-tu?!\rÇa va chauffer pour toi si tu es là pour\ngêner le Commandant Lan...\fJe veux dire, la Team Rocket!\r</language>
	</row>
	<row id="msg_0068_D23R0104_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’aime la Team Rocket et le\nCommandant Lance!\rLes Pokémon, ça ne sert à rien!</language>
	</row>
</body>
