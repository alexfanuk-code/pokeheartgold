		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça efface la saveur épicée.</language>
	</row>
	<row id="msg_0021_00124" index="124">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça efface la saveur acide.</language>
	</row>
	<row id="msg_0021_00125" index="125">
