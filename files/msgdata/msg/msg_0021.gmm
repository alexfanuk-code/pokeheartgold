	<row id="msg_0021_00128" index="128">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le goût est encore léger...\nIl vaudrait mieux rajouter des\nNoigrumes colorés.</language>
	</row>
	<row id="msg_0021_00129" index="129">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le goût est indéfinissable!\nLes saveurs s’équilibrent.\nImpossible de dire ce que c’est.</language>
	</row>
	<row id="msg_0021_00130" index="130">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le goût est indéfinissable! Les\nsaveurs s’annulent. Impossible\nde dire ce qu’il y a dedans.</language>
	</row>
	<row id="msg_0021_00131" index="131">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça n’a aucun goût!\nIl vaudrait mieux rajouter des\nNoigrumes colorés.</language>
	</row>
