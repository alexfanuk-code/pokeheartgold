	<row id="msg_0021_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Noigrume Rge\nUn Noigrume de couleur rouge.\nIl dégage un puissant arôme.</language>
	</row>
	<row id="msg_0021_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Noigrume Jne\nUn Noigrume de couleur jaune.\nIl dégage un arôme délicat.</language>
	</row>
	<row id="msg_0021_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Noigrume Blu\nUn Noigrume de couleur bleue.\nIl dégage un arôme un peu aigre.</language>
	</row>
	<row id="msg_0021_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Noigrume Ver\nUn Noigrume de couleur verte.\nIl dégage un arôme étonnamment riche.</language>
	</row>
	<row id="msg_0021_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Noigrume Ros\nUn Noigrume de couleur rose.\nIl dégage un arôme sucré.</language>
	</row>
	<row id="msg_0021_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Noigrume Blc\nUn Noigrume de couleur blanche.\nIl ne dégage aucun arôme.</language>
	</row>
	<row id="msg_0021_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Noigrume Noi\nUn Noigrume de couleur noire.\nIl dégage un arôme indéfinissable.</language>
	</row>
	<row id="msg_0021_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Noig. Shaker</language>
	</row>
	<row id="msg_0021_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 8, 0, 0}\nGoût: {STRVAR_1 52, 1, 0}; Onctuosité: {STRVAR_1 52, 2, 0}.\nNombre de Noigrumes ajoutables: {STRVAR_1 50, 3, 0}.</language>
	</row>
	<row id="msg_0021_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">PREPARATION D’UN NOIG. DRINK\nRamassez des Noigrumes et\nmettez-les dans le Shaker!\rUn Noigrume suffit, mais\nrajoutez-en pour améliorer\nle goût et l’effet!\rEnsuite, courez jusqu’à la\nprochaine ville pour secouer!</language>
	</row>
