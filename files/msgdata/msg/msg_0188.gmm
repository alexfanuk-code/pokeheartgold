	<row id="msg_0188_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La connexion Wi-Fi Nintendo n’est\npas accessible pour le moment.\rVeuillez réessayer ultérieurement.\r</language>
	</row>
	<row id="msg_0188_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Soit la connexion Wi-Fi Nintendo connaît\nun trafic trop important, soit le\fservice est interrompu.\rVeuillez réessayer ultérieurement.\r</language>
	</row>
	<row id="msg_0188_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Impossible de se connecter à la\nconnexion Wi-Fi Nintendo.\r</language>
	</row>
	<row id="msg_0188_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erreur de communication. Vous n’êtes\nplus connecté à la connexion Wi-Fi\fNintendo.\r</language>
	</row>
