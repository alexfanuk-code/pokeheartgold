	</row>
	<row id="msg_0188_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sauvegarde en cours...\nNe pas éteindre.</language>
	</row>
	<row id="msg_0188_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} a sauvegardé la partie.</language>
	</row>
	<row id="msg_0188_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erreur de sauvegarde.</language>
	</row>
	<row id="msg_0188_00035" index="35">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
