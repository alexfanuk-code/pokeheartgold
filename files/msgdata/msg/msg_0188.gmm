		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0188_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour confirmer, veuillez saisir votre\ncode Wii une nouvelle fois.\r</language>
	</row>
	<row id="msg_0188_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce code Wii est différent du précédent.\nVeuillez saisir votre code à nouveau.\r</language>
	</row>
	<row id="msg_0188_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mot de passe incorrect.\nVeuillez le saisir à nouveau.\r</language>
	</row>
	<row id="msg_0188_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Votre code Wii:\n{STRVAR_1 53, 0, 0} {STRVAR_1 53, 1, 0} {STRVAR_1 53, 2, 0} {STRVAR_1 53, 3, 0}\r</language>
	</row>
	<row id="msg_0188_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ne pas enregistrer</language>
	</row>
	<row id="msg_0188_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Enregistrer</language>
	</row>
	<row id="msg_0188_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{COLOR 1}Enregistrer un code Wii{COLOR 0}\n\nSi votre code Wii est enregistré, vous\nrecevrez un message Wii chaque fois\nque vous conclurez un échange à la GTS.\n\nPour plus de détails, veuillez\nvous référer au mode d’emploi.\n\nVoulez-vous enregistrer votre\ncode Wii?</language>
	</row>
	<row id="msg_0188_00045" index="45">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
