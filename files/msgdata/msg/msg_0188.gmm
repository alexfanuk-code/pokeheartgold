	<row id="msg_0188_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pouvez-vous vous connecter à la\nconnexion Wi-Fi Nintendo?</language>
	</row>
	<row id="msg_0188_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour enregistrer un code Wii, vous\ndevez avoir accès à la CWF Nintendo.\r</language>
	</row>
	<row id="msg_0188_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le code Wii et les paramètres de la\nconfiguration CWF Nintendo de cette\fNintendo DS vont être sauvegardés.\rSe connecter à la CWF Nintendo?</language>
	</row>
	<row id="msg_0188_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Impossible de se connecter à la\nconnexion Wi-Fi Nintendo.\rVérifiez les paramètres de la\nconnexion.</language>
	</row>
	<row id="msg_0188_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un code d’inscription a été envoyé\nsur votre console Wii.\rVeuillez saisir ce code d’inscription.</language>
	</row>
	<row id="msg_0188_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Se déconnecter de la CWF Nintendo et\nannuler l’enregistrement du code Wii?</language>
	</row>
	<row id="msg_0188_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Déconnexion de la connexion \nWi-Fi Nintendo.</language>
	</row>
	<row id="msg_0188_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous avez été déconnecté de\nla connexion Wi-Fi Nintendo.</language>
	</row>
	<row id="msg_0188_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Veuillez saisir les quatre derniers\nchiffres du code d’inscription\fqui vous a été communiqué par\fmessage Wii.\r</language>
	</row>
	<row id="msg_0188_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Confirmation du code d’inscription.\nVeuillez patienter...</language>
	</row>
	<row id="msg_0188_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Code d’inscription incorrect.\r</language>
	</row>
	<row id="msg_0188_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Votre code Wii est maintenant\nenregistré.\r</language>
	</row>
	<row id="msg_0188_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un mot de passe est requis pour\nconfirmer votre code Wii.\rVeuillez saisir un nombre à quatre\nchiffres et en prendre note.\rCe nombre constituera le mot de passe\nlié à votre code Wii.\r</language>
	</row>
	<row id="msg_0188_00022" index="22">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0188_00023" index="23">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0188_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le mot de passe lié à votre code Wii\nest enregistré.\r</language>
	</row>
	<row id="msg_0188_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous pouvez choisir de recevoir un\nmessage Wii lorsqu’un échange\fest conclu à la GTS.\rVoulez-vous activer la notification\npar message Wii?</language>
	</row>
	<row id="msg_0188_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous avez choisi de recevoir les\nmessages Wii de confirmation.\rQuand vous utiliserez la GTS, tout\néchange sera confirmé par message Wii.\r</language>
	</row>
	<row id="msg_0188_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous avez choisi de ne pas recevoir\nles messages Wii de confirmation.\rQuand vous utiliserez la GTS, les\néchanges ne seront donc pas confirmés\fpar message Wii.\r</language>
	</row>
	<row id="msg_0188_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les paramètres des messages Wii et\nle mot de passe lié à votre code Wii\fseront effacés. Confirmer?</language>
	</row>
	<row id="msg_0188_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les paramètres des messages Wii ont\nété effacés.\r</language>
	</row>
	<row id="msg_0188_00030" index="30">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
