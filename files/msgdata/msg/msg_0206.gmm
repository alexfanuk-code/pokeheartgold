	<row id="msg_0206_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En attente d’une réponse.\nVeuillez patienter...</language>
	</row>
	<row id="msg_0206_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sauvegarde en cours...\nNe pas éteindre.</language>
	</row>
	<row id="msg_0206_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un des Oeufs ne peut être échangé.\nLa séance va être annulée.</language>
