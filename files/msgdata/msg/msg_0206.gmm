<?xml version="1.0"?>
<body language="English">
	<row id="msg_0206_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Veuillez patienter...</language>
	</row>
	<row id="msg_0206_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0}</language>
	</row>
	<row id="msg_0206_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 1, 0} a obtenu l’Oeuf\nde {STRVAR_1 1, 2, 0}!</language>
	</row>
	<row id="msg_0206_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’Oeuf s’est arrêté sur une zone\nbonus! Vous obtenez {STRVAR_1 8, 0, 0}!</language>
	</row>
	<row id="msg_0206_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dommage, le Sac est plein... Vous\nne pouvez pas recevoir la Baie.</language>
	</row>
	<row id="msg_0206_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En attente d’une réponse.\nVeuillez patienter...</language>
	</row>
