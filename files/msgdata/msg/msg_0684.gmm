<?xml version="1.0"?>
<body language="English">
	<row id="msg_0684_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Francis</language>
	</row>
	<row id="msg_0684_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">T’es terrible!\nJe t’aime!\rJe cherche des Pokémon ici\ntous les jours.\rJe trouve aussi des Baies\ndans les herbes.\rSi tu veux, je peux t’en donner.\nTu me donnes ton numéro? {YESNO 0}</language>
	</row>
	<row id="msg_0684_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je t’appelle si je trouve un truc\nsympa. J’adore trouver des trucs!</language>
	</row>
	<row id="msg_0684_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ne sois pas timide si tu veux mon\nnuméro.</language>
	</row>
	<row id="msg_0684_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je trouve des Baies\ndans les herbes parfois.\rSi tu veux, je peux t’en donner.\nTu me donnes ton numéro? {YESNO 0}</language>
	</row>
	<row id="msg_0684_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bonjour toi!\nVoilà ce que j’ai trouvé.\fC’est pour toi!\r</language>
	</row>
	<row id="msg_0684_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Viens me parler directement!</language>
	</row>
	<row id="msg_0684_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tes Pokémon ont progressé?\rLes miens font trop de progrès!\nJ’ai du mal à suivre!\r{STRVAR_1 0, 10, 0} surtout...\nQuelle brute!\rA plus tard!</language>
	</row>
	<row id="msg_0684_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai mis K.O. un {STRVAR_1 0, 11, 0}\nsauvage en un coup.\rJ’ai eu de la peine pour lui...\nPendant au moins deux minutes!\rA plus tard!</language>
	</row>
	<row id="msg_0684_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Au fait! Un {STRVAR_1 0, 11, 0} sauvage\nvient de m’échapper.\rJe sais qu’il n’est pas rare...\nMais ça m’énerve quand ça arrive.\rA plus tard!</language>
	</row>
	<row id="msg_0684_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ça te dit un petit combat? Ça ne se\npassera pas comme la dernière fois!\r{STRVAR_1 4, 3, 0}, c’est mon terrain.\nDis-moi quand tu arrives.</language>
	</row>
	<row id="msg_0684_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On se bat ou bien?\r{STRVAR_1 4, 3, 0}, c’est là où je\ntraîne. Viens vite!</language>
	</row>
	<row id="msg_0684_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hein? Des Baies?\rJ’en ai pas encore.\nJe t’appelle pour te prévenir...\fAttends un peu!</language>
	</row>
	<row id="msg_0684_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai trouvé tout plein de Baies.\nJe peux t’en donner.\rJ’attends sur la {STRVAR_1 4, 3, 0}.</language>
	</row>
	<row id="msg_0684_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu fais quoi?\r{STRVAR_1 4, 3, 0}! Je t’attends!</language>
	</row>
	<row id="msg_0684_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il y a le Concours de Capture au\nParc Naturel aujourd’hui.\fTu y vas, {STRVAR_1 3, 0, 0}?\rMoi j’en sais rien...</language>
	</row>
	<row id="msg_0684_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il y a le Concours de Capture au\nParc Naturel aujourd’hui.\fTu y vas, {STRVAR_1 3, 0, 0}?\rMoi j’en sais rien...</language>
	</row>
</body>
