	<row id="msg_0204_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">RETOUR</language>
	</row>
	<row id="msg_0204_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce groupe?\n{STRVAR_1 3, 0, 0} l’a déjà créé, non?</language>
	</row>
	<row id="msg_0204_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il y a déjà un autre groupe avec\nce nom.</language>
	</row>
