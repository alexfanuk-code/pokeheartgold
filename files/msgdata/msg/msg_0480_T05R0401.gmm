<?xml version="1.0"?>
<body language="English">
	<row id="msg_0480_T05R0401_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bien...\nJe suis le Spécialiste des Noms.\rVeux-tu que j’examine les surnoms\nque tu as donnés à tes Pokémon? {YESNO 0}</language>
	</row>
	<row id="msg_0480_T05R0401_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bien...\nQuel surnom de Pokémon veux-tu\fque j’examine?</language>
	</row>
	<row id="msg_0480_T05R0401_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hoho... {STRVAR_1 1, 0, 0}...\nCe n’est pas un mauvais surnom...\rMais on peut lui trouver un surnom bien\nmeilleur...\rQu’en dis-tu? {YESNO 0}</language>
	</row>
	<row id="msg_0480_T05R0401_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bien...\nQuel va être son nouveau surnom?\r</language>
	</row>
	<row id="msg_0480_T05R0401_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bien!\nDorénavant, le surnom de ce Pokémon\fsera {STRVAR_1 1, 0, 0}!\rC’est un excellent nom!\nTu ne trouves pas?</language>
	</row>
	<row id="msg_0480_T05R0401_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bien...\nFais comme tu veux.\fReviens me voir si l’envie t’en prend.</language>
	</row>
	<row id="msg_0480_T05R0401_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bien!\nDorénavant, le surnom de ce Pokémon\fsera {STRVAR_1 1, 0, 0}!\rComment? Ça ne change pas vraiment?\nCe n’est qu’une impression.\rSon nouveau nom est bien mieux\nque l’ancien.</language>
	</row>
	<row id="msg_0480_T05R0401_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmmm...\n{STRVAR_1 1, 0, 0}...\rC’est un surnom parfait, fais-moi\nconfiance, je m’y connais.\rPrends soin de {STRVAR_1 1, 0, 0}.</language>
	</row>
	<row id="msg_0480_T05R0401_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bien...\nMais ce n’est qu’un Oeuf.</language>
	</row>
</body>
