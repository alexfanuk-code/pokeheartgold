	<row id="msg_0473_T04R0301_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon mari est très heureux, parce qu’il\npeut maintenant vivre avec tous les\fPokémon qu’il a échangés dans sa vie...\rEt moi, je suis très heureuse, parce\nque je peux vivre avec lui...</language>
	</row>
	<row id="msg_0473_T04R0301_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah...\nQuel bonheur...</language>
	</row>
