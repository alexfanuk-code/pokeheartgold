<?xml version="1.0"?>
<body language="English">
	<row id="msg_0629_T30_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Excusez-moi.\rSandra, notre Champion, est dans\nl’Antre du Dragon derrière l’Arène.\rJe ne sais pas quand elle sera\nde retour.</language>
	</row>
	<row id="msg_0629_T30_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sandra, notre Champion, vous attend.\rVous aurez du mal à la battre.</language>
	</row>
	<row id="msg_0629_T30_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous avez battu Sandra?\nIncroyable!\rSeul Peter avait réussi cet exploit!</language>
	</row>
	<row id="msg_0629_T30_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Seuls les Dresseurs confirmés\npeuvent s’entraîner ici.\rPartez.</language>
	</row>
	<row id="msg_0629_T30_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si Sandra le permet, son grand-père,\nl’Ancien, le permettra aussi.\rEntrez.</language>
	</row>
	<row id="msg_0629_T30_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma radio est fichue?\nJe reçois un drôle de signal\fces derniers temps...</language>
	</row>
	<row id="msg_0629_T30_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aahhhh!\nDes voix dans ma tête!\rHum?\nJ’écoute ma radio!</language>
	</row>
	<row id="msg_0629_T30_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fais-tu oublier des capacités à tes\nPokémon?</language>
	</row>
	<row id="msg_0629_T30_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tous les Dracologues sont originaires\nd’Ebènelle.</language>
	</row>
	<row id="msg_0629_T30_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wah!\nTu as traversé la Route de Glace?\rTu dois être un sacré Dresseur!</language>
	</row>
	<row id="msg_0629_T30_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ebènelle\nUn coin de montagne reculé</language>
	</row>
	<row id="msg_0629_T30_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arène d’Ebènelle\rChampion: Sandra\nLa Dompteuse de Dragons</language>
	</row>
	<row id="msg_0629_T30_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Maison des Capacités\rVous pouvez y faire apprendre ou\noublier des capacités à vos Pokémon!</language>
	</row>
	<row id="msg_0629_T30_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Antre du Dragon\nTout droit</language>
	</row>
	<row id="msg_0629_T30_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Conseils aux Dresseurs!\rEn marchant tranquillement dans les\nhautes herbes, les Pokémon sauvages\font moins de chances d’apparaître que\florsqu’on court.\rLorsque les Pokémon de votre équipe ne\nsont plus en état de se battre,\fdirigez-vous d’un pas tranquille vers\fle Centre Pokémon le plus proche!</language>
	</row>
</body>
