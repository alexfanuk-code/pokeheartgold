<?xml version="1.0"?>
<body language="English">
	<row id="msg_0512_T08_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’un des membres actuels du Conseil 4\nétait le Champion d’Arène\fde Parmanie.</language>
	</row>
	<row id="msg_0512_T08_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Champion d’Arène\nest maintenant la fille de Koga,\fqui est parti au Conseil 4!</language>
	</row>
	<row id="msg_0512_T08_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ils disaient que le Parc Safari était\nfermé pour rénovation, mais voilà\fqu’ils l’ont rouvert à Johto!\rC’était l’attraction principale de\nla ville, quel dommage...</language>
	</row>
	<row id="msg_0512_T08_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Parmanie\nLe rose de la passion!</language>
	</row>
	<row id="msg_0512_T08_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arène de Parmanie\rChampion: Jeannine\nMiss je-sais-tout-sur-les-poisons.</language>
	</row>
	<row id="msg_0512_T08_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il y a une affiche...\rLe Parc Safari a cessé son activité.\nLe Parc des Amis a ouvert à la place.</language>
	</row>
	<row id="msg_0512_T08_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Maison du Gérant du Parc des Amis</language>
	</row>
	<row id="msg_0512_T08_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tesson contre Baies!\nTesson contre Baies!\rSalut, salut! J’échange des Tessons\ncontre des Baies!\rSi tu me donnes un Tesson, je te\ndonnerai 3 Baies en échange!\r</language>
	</row>
	<row id="msg_0512_T08_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tesson contre Baies!\nTesson contre Baies!\rSalut, salut! J’échange des Tessons\ncontre des Baies!\rSi tu me donnes un Tesson, je te\ndonnerai un lot de 3 Baies en échange!\rOn fait Tesson contre Baies? {YESNO 0}</language>
	</row>
	<row id="msg_0512_T08_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On continue Tesson contre Baies? {YESNO 0}</language>
	</row>
	<row id="msg_0512_T08_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salut, salut! Reviens faire\nTesson contre Baies quand tu veux!\r</language>
	</row>
	<row id="msg_0512_T08_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si tu me donnes un Tesson Rouge,\nje te donne le lot de Baies E!\r</language>
	</row>
	<row id="msg_0512_T08_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si tu me donnes un Tesson Bleu,\nje te donne le lot de Baies F!\r</language>
	</row>
	<row id="msg_0512_T08_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si tu me donnes un Tesson Jaune,\nje te donne le lot de Baies G!\r</language>
	</row>
	<row id="msg_0512_T08_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si tu me donnes un Tesson Vert,\nje te donne le lot de Baies H!\r</language>
	</row>
	<row id="msg_0512_T08_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu as déjà assez de Baies de ce lot.\nReviens quand tu en auras moins!\r</language>
	</row>
</body>
