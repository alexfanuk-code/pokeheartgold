	<row id="msg_0191_00425" index="425">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Taillade l’ennemi en utilisant ses faux\nou ses griffes comme des ciseaux.</language>
	</row>
	<row id="msg_0191_00426" index="426">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fait surgir des pierres aiguisées sous\nl’ennemi. Taux de critiques élevé.</language>
