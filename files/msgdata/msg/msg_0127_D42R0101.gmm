	</row>
	<row id="msg_0127_D42R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si tu les donnes à un Pokémon, elles\naugmenteront la puissance de ses\fattaques de type Ténèbres.</language>
	</row>
	<row id="msg_0127_D42R0101_00003" index="3">
