<?xml version="1.0"?>
<body language="English">
	<row id="msg_0501_T07R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Que veux-tu?\nJe suis la concierge.\rEnfin, je dis ça, mais ce n’est pas un\ntravail fatigant, c’est très calme ici.\rComme je n’ai pas grand-chose à faire,\nje m’occupe en promenant des Pokémon.\r... Ah, au fait.\rIl y a deux ascenseurs dans cet\nimmeuble. Ne te trompe pas!</language>
	</row>
	<row id="msg_0501_T07R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MIAOUSS: Miaou!</language>
	</row>
	<row id="msg_0501_T07R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MELOFEE: Mélo!\nMéloooo!</language>
	</row>
	<row id="msg_0501_T07R0201_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">NIDORAN♀: Nido!\nNidooo!</language>
	</row>
	<row id="msg_0501_T07R0201_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si vous voulez aller au 2⁴ étage,\nprenez cet ascenseur.</language>
	</row>
</body>
