	<row id="msg_0401_R43_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Conseils aux Dresseurs!\rFaites attention au type de votre\nPokémon.\rToutes les batailles ne peuvent pas\nse gagner uniquement avec un niveau\félevé.\rSachez quels types de Pokémon le vôtre\npeut vaincre facilement, et lesquels\fsont dangereux pour lui.</language>
	</row>
	<row id="msg_0401_R43_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nord: Lac Colère\nSud: Acajou</language>
