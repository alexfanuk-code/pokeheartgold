<?xml version="1.0"?>
<body language="English">
	<row id="msg_0274_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue!\rIci, vous pouvez choisir de retirer un\nPokémon d’une Boîte\rpour le transférer dans le Pokéwalker\net ainsi partir en balade avec lui!\r</language>
	</row>
	<row id="msg_0274_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sélection d’un Pokémon pour\npartir en balade.</language>
	</row>
	<row id="msg_0274_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Réception d’un cadeau ou\nd’un Pokémon en balade.</language>
	</row>
	<row id="msg_0274_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Attention!\rToutes les données du Pokéwalker\nseront effacées.\rAvant d’effacer, veuillez vérifier\nles informations du Pokéwalker.\rLe Pokémon en balade pourra\nrevenir mais toutes les autres données\fdu Pokéwalker seront perdues.\rEffacer les données du Pokéwalker?</language>
	</row>
	<row id="msg_0274_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Effacement des données du\nPokéwalker.</language>
	</row>
	<row id="msg_0274_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Se tourner vers la carte DS\net choisir “CONNEXION”.</language>
	</row>
	<row id="msg_0274_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Communication en cours avec le\nPokéwalker. Veuillez patienter...</language>
	</row>
	<row id="msg_0274_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dans un endroit où le\nPokéwalker peut sonner,\rse tourner vers la carte DS\net presser le bouton 5 sec.</language>
	</row>
	<row id="msg_0274_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Avec le Pokéwalker, emmenez\nun Pokémon en balade.</language>
	</row>
	<row id="msg_0274_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Conserver le nombre de pas?</language>
	</row>
	<row id="msg_0274_00010" index="10">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0274_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Veuillez choisir un Pokémon de\nvos Boîtes PC.\r</language>
	</row>
	<row id="msg_0274_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Veuillez choisir une route\npour la balade.\r</language>
	</row>
	<row id="msg_0274_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sauvegarde en cours...\nNe pas éteindre.</language>
	</row>
	<row id="msg_0274_00014" index="14">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0274_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il faut au moins 5 places dans les\nBoîtes PC pour pouvoir utiliser\fle Pokéwalker.\rVeuillez revenir lorsque vous aurez\nau moins 5 places libres.\r</language>
	</row>
	<row id="msg_0274_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Début de la communication entre\nle Pokéwalker et la Nintendo DS.{PAUSE 90}</language>
	</row>
	<row id="msg_0274_00017" index="17">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0274_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ATTENTION!\rLe Pokémon en balade dans le\nPokéwalker peut revenir, mais\rles autres Pokémon stockés dans\nle Pokéwalker ne pourront plus\fêtre récupérés.\rFaire revenir le Pokémon?</language>
	</row>
	<row id="msg_0274_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Retour du Pokémon\nen balade.</language>
	</row>
	<row id="msg_0274_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Pokémon reçu est retourné\ndans la nature.{PAUSE 120}</language>
	</row>
	<row id="msg_0274_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Partir en balade sur\nla Route {STRVAR_34 19, 0, 0}?</language>
	</row>
	<row id="msg_0274_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue!\rIci, vous pouvez choisir de retirer un\nPokémon d’une Boîte\rpour le transférer dans le Pokéwalker\net ainsi partir en balade avec lui!\rVeuillez revenir lorsque vous aurez\nau moins 1 Pokémon dans vos Boîtes.\r</language>
	</row>
	<row id="msg_0274_00023" index="23">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0274_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 1, 0} a été absorbé dans\nle Pokéwalker!{PAUSE 120}</language>
	</row>
	<row id="msg_0274_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce Pokéwalker est enregistré avec\ncette carte DS.\rVeuillez ne faire revenir des Pokémon\nque vers cette carte DS.\rProfitez bien de la balade avec votre\nPokémon!\r</language>
	</row>
	<row id="msg_0274_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reviens, {STRVAR_1 1, 1, 0}!</language>
	</row>
	<row id="msg_0274_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 1, 0} est là maintenant!{PAUSE 120}</language>
	</row>
	<row id="msg_0274_00028" index="28">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0274_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le cadeau a été obtenu!{PAUSE 120}</language>
	</row>
