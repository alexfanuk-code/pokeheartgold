	<row id="msg_0274_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 1, 0} a bien marché et\nest monté d’un niveau!\r</language>
	</row>
	<row id="msg_0274_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bravo!\rLe Pokéwalker a enregistré un total\nde 9 999 999 pas!\r</language>
	</row>
	<row id="msg_0274_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En guise de récompense, vous\nobtenez une Baie Frista!\rVous mettez la récompense dans le Sac!\r</language>
