	<row id="msg_0274_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 1, 0} a terminé sa balade\nsur la Route {STRVAR_34 19, 2, 0}!\r</language>
	</row>
	<row id="msg_0274_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous avez accumulé {STRVAR_1 54, 3, 0} W\npendant la balade!\r</language>
	</row>
	<row id="msg_0274_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A bientôt pour une nouvelle balade!\r</language>
	</row>
	<row id="msg_0274_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Baladez-vous bien avec votre\nPokémon!\r</language>
	</row>
	<row id="msg_0274_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...\nTiens...?\rLe Pokéwalker réagit aux Watts\naccumulés!\rLe Pokéwalker a découvert une\nnouvelle route!\r</language>
	</row>
	<row id="msg_0274_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous mettez chaque Pokémon récupéré\npendant la balade dans une Boîte.\r</language>
	</row>
	<row id="msg_0274_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous mettez chaque objet récupéré\npendant la balade dans le Sac.\r</language>
	</row>
	<row id="msg_0274_00051" index="51">
