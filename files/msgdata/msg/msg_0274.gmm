		<attribute name="window_context_name">used</attribute>
		<language name="English">Les données du Pokéwalker ont été\nréinitialisées.{PAUSE 120}</language>
	</row>
	<row id="msg_0274_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Pokémon est revenu!{PAUSE 120}</language>
	</row>
