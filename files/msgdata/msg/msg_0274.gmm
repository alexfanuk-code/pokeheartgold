	<row id="msg_0274_00113" index="113">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Forêt Jaune</language>
	</row>
	<row id="msg_0274_00114" index="114">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Evénement</language>
	</row>
	<row id="msg_0274_00115" index="115">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Virée en Ville</language>
	</row>
	<row id="msg_0274_00116" index="116">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chemin Victoire</language>
	</row>
	<row id="msg_0274_00117" index="117">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Plaine Paisible</language>
	</row>
	<row id="msg_0274_00118" index="118">
		<attribute name="window_context_name">used</attribute>
		<language name="English">--------</language>
	</row>
	<row id="msg_0274_00119" index="119">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une plaine idéalement tranquille\npour une balade! On peut y\nrencontrer plein de Pokémon!</language>
	</row>
	<row id="msg_0274_00120" index="120">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une grande forêt encore\nsauvage. De nombreux Pokémon\nvivent dans ses tréfonds.</language>
	</row>
	<row id="msg_0274_00121" index="121">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une route de montagne\nescarpée. La vue depuis le\nsommet est imprenable!</language>
	</row>
	<row id="msg_0274_00122" index="122">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une route très populaire le long\nd’une mer superbe. On y\nrencontre plein de Pokémon Eau.</language>
	</row>
	<row id="msg_0274_00123" index="123">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une zone résidentielle. On peut\ntout de même y rencontrer\ndes Pokémon pendant la balade!</language>
	</row>
	<row id="msg_0274_00124" index="124">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une caverne sombre utilisée\npour tester le courage. Ouvrez\nbien grand les yeux!</language>
	</row>
	<row id="msg_0274_00125" index="125">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un lac d’un bleu profond. On\ndit que des Pokémon rares\nvivent au fond.</language>
	</row>
	<row id="msg_0274_00126" index="126">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Des faubourgs à l’abandon. Les\nPokémon se cachent dans les\nmaisons vides.</language>
	</row>
	<row id="msg_0274_00127" index="127">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une route dans la lointaine\nrégion de Hoenn, qui abrite des\nPokémon introuvables ailleurs.</language>
	</row>
	<row id="msg_0274_00128" index="128">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une plage brûlante de la région\nde Hoenn, qui abrite des Pokémon\nintrouvables ailleurs.</language>
	</row>
	<row id="msg_0274_00129" index="129">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce volcan est toujours en\nactivité. Des Pokémon brûlants\net rares y vivent.</language>
	</row>
	<row id="msg_0274_00130" index="130">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une ville qui vit en harmonie\navec la nature. On y rencontre\ndes Pokémon inhabituels.</language>
	</row>
	<row id="msg_0274_00131" index="131">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une grotte noire comme un four\nqui résonne d’étranges bruits.\nDes Pokémon y vivent peut-être.</language>
	</row>
	<row id="msg_0274_00132" index="132">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une route dans la lointaine\nrégion de Sinnoh. On y rencontre\ndes Pokémon rares.</language>
	</row>
	<row id="msg_0274_00133" index="133">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un pas de travers et c’est la\nchute sur cette route de neige\nescarpée!</language>
	</row>
	<row id="msg_0274_00134" index="134">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une immense forêt encore\nvierge, qui abrite de nombreux\nPokémon.</language>
	</row>
	<row id="msg_0274_00135" index="135">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un lac couvert d’un épais\nbrouillard. Il y règne une\natmosphère de mystère.</language>
	</row>
	<row id="msg_0274_00136" index="136">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une plage balayée par les\nvagues. Quasi-abandonnée, on\ny trouve des Pokémon rares.</language>
	</row>
	<row id="msg_0274_00137" index="137">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un zone touristique prisée,\nnotamment pour les Pokémon\nmignons qu’on y trouve.</language>
	</row>
	<row id="msg_0274_00138" index="138">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une grotte silencieuse où rien\nne semble vivre. Mais ouvrez\nbien les yeux!</language>
	</row>
	<row id="msg_0274_00139" index="139">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un îlot au bout de l’océan.\nOn peut voir des Pokémon nager\ndans les flots transparents.</language>
	</row>
	<row id="msg_0274_00140" index="140">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un sentier de montagne sombre\ncomme la nuit. On a l’impression\nd’être projeté dans le passé.</language>
	</row>
	<row id="msg_0274_00141" index="141">
		<attribute name="window_context_name">used</attribute>
		<language name="English">De nombreux PIKACHU vivent\nheureux dans cette forêt!\nCherchez-les!</language>
	</row>
	<row id="msg_0274_00142" index="142">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une route tranquille.\nAccumulez sans souci des Watts\nà votre rythme!</language>
	</row>
	<row id="msg_0274_00143" index="143">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il y a toutes sortes de Pokémon\nsur cette route. Promenez-vous\net trouvez les tous!</language>
	</row>
	<row id="msg_0274_00144" index="144">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Une route obligatoire pour\ntout futur Maître! Faites\nle plein de Pokémon costauds!</language>
	</row>
	<row id="msg_0274_00145" index="145">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rencontrez des Pokémon qui\névoluent grâce à l’amitié!\nTrouvez un objet indispensable!</language>
	</row>
