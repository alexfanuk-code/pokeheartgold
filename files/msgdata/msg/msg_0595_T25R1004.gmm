<?xml version="1.0"?>
<body language="English">
	<row id="msg_0595_T25R1004_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’aime les Pokémon forts!\nAlors je leur donne plein de Protéine\fpour monter leur attaque!</language>
	</row>
	<row id="msg_0595_T25R1004_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moi, j’suis un dur,\nmais j’aime pas la Team Rocket\fpour autant!</language>
	</row>
	<row id="msg_0595_T25R1004_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le Fer, ça fait monter la Défense\ndes Pokémon!</language>
	</row>
	<row id="msg_0595_T25R1004_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La Team Rocket...\nQu’est-ce que vous faites ici?</language>
	</row>
	<row id="msg_0595_T25R1004_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Certains Pokémon évoluent\nquand ils sont échangés!\rJ’en connais 4: MACHOPEUR, KADABRA,\nSPECTRUM et GRAVALANCH.\fMais il paraît qu’il y en a d’autres...</language>
	</row>
	<row id="msg_0595_T25R1004_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dites, vous de la Team Rocket,\nvous ne volez pas les Pokémon de\fvos coéquipiers... Hein?</language>
	</row>
	<row id="msg_0595_T25R1004_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Améliorez vos Pokémon!\n3⁴: Pharmacie</language>
	</row>
</body>
