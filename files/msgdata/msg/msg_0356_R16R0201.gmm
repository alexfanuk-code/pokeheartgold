<?xml version="1.0"?>
<body language="English">
	<row id="msg_0356_R16R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La Piste Cyclable commence ici.\rSur ta Bicyclette, c’est une descente\nfacile et très reposante.\rCertains préfèrent les gros moyens de\ntransport comme le Train Magnétique\fou le bateau, mais toi, tu préfères\fla Bicyclette, pas vrai?</language>
	</row>
	<row id="msg_0356_R16R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé! Toi, là! Stop!\rLa Piste Cyclable est interdite à ceux\nqui ne sont pas à Bicyclette!\r</language>
	</row>
</body>
