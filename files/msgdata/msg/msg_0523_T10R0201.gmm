<?xml version="1.0"?>
<body language="English">
	<row id="msg_0523_T10R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue à la Ligue Pokémon!\rJe m’appelle Clément.\rJ’ai parcouru le monde pour\ntout connaître sur les\fPokémon de type Psy.\rGrâce à mon expérience, j’ai gagné\nma place au sein du Conseil 4.\rMais je continuerai à m’améliorer!\nJe ne peux pas perdre maintenant!\r</language>
	</row>
	<row id="msg_0523_T10R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Certes, j’ai perdu, mais\nça ne change rien pour moi.\fJe dois continuer à me battre\fpour devenir le meilleur des Dresseurs.\rContinue ta route et découvre\nla véritable force du Conseil 4!\r</language>
	</row>
	<row id="msg_0523_T10R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Certes, j’ai perdu, mais\nça ne change rien pour moi.\fJe dois continuer à me battre\fpour devenir le meilleur des Dresseurs.\rContinue ta route et découvre\nla véritable force du Conseil 4!</language>
	</row>
</body>
