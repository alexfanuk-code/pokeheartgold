<?xml version="1.0"?>
<body language="English">
	<row id="msg_0605_T26FS0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ton Pokémon connaît-il déjà la\ncapacité qui permet aux gens de monter\fsur son dos pour traverser la mer?</language>
	</row>
	<row id="msg_0605_T26FS0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le PAPILUSION que j’ai reçu de\nmon chéri qui est à l’étranger\ftenait une Lettre!\rTu veux savoir ce qui est écrit?\nHé bien...\rC’est un S.E.C.R.E.T.!</language>
	</row>
</body>
