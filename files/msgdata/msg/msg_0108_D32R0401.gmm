<?xml version="1.0"?>
<body language="English">
	<row id="msg_0108_D32R0401_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue à la Scène de Combat!\rJe suis votre guide pour les\nCombats Solo et Duo.\rIls sont conçus pour un seul\nDresseur.\r</language>
	</row>
	<row id="msg_0108_D32R0401_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quel défi souhaitez-vous relever? {YESNO 0}</language>
	</row>
	<row id="msg_0108_D32R0401_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La Scène de Combat propose des\nCombats Solo et des Combats Duo.\rPour les Combats Solo, vous avez droit\nà un Pokémon de niveau 30 minimum.\rPour les Combats Duo, il vous faut\ndeux Pokémon de la même espèce\fet de niveau 30 minimum.\rLa meilleure série de victoires de\nchaque espèce de Pokémon est\fenregistrée.\rAinsi, n’importe quel Pokémon peut\nviser la première place.\rUne fois à l’intérieur, on vous\ndemandera de choisir le type et le\frang des Pokémon à combattre.\rRemportez dix combats à la suite et\nvous gagnerez des Points de Combat.\rSi vous voulez interrompre votre\nprogression, vous devrez sauvegarder.\rSi vous ne le faites pas, nous\ndevrons vous disqualifier.\r</language>
	</row>
	<row id="msg_0108_D32R0401_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue à la Scène de Combat!\rJe serai votre guide pour\nles Combats Multi!\rIls sont conçus pour des équipes\nde deux Dresseurs.\r</language>
	</row>
	<row id="msg_0108_D32R0401_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous relever le défi d’un\nCombat Multi? {YESNO 0}</language>
	</row>
	<row id="msg_0108_D32R0401_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour les Combats Multi, vous pouvez\nfaire équipe avec un ami utilisant un\fPokémon de niveau 30 minimum et\fde la même espèce que le vôtre.\rUne fois à l’intérieur, on vous\ndemandera de choisir le type et le\frang des Pokémon à combattre.\rRemportez dix combats à la suite et\nvous gagnerez des Points de Combat.\rNotez bien qu’à la Scène de Combat,\nles Combats Multi ne peuvent être\finterrompus.\r</language>
	</row>
	<row id="msg_0108_D32R0401_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A une prochaine fois peut-être!</language>
	</row>
	<row id="msg_0108_D32R0401_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quel défi souhaitez-vous relever?\nNiveau 50 ou niveau libre?</language>
	</row>
	<row id="msg_0108_D32R0401_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous devez sauvegarder la partie\navant d’entrer.\fC’est d’accord? {YESNO 0}</language>
	</row>
	<row id="msg_0108_D32R0401_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Par ici, s’il vous plaît!</language>
	</row>
	<row id="msg_0108_D32R0401_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">N’hésitez pas à revenir nous voir.\r</language>
	</row>
	<row id="msg_0108_D32R0401_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Contents de vous revoir!\rVous devez sauvegarder la partie avant\nde reprendre le défi.\rVeuillez patienter.</language>
	</row>
	<row id="msg_0108_D32R0401_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je regrette.\rVous n’avez pas sauvegardé avant\nl’interruption de votre dernier défi.\rPar conséquent, nous sommes\nobligés de vous disqualifier!\r</language>
	</row>
	<row id="msg_0108_D32R0401_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Félicitations!\rPour célébrer votre victoire, nous vous\noffrons cette photo en souvenir!\r</language>
	</row>
	<row id="msg_0108_D32R0401_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} a la Photo d’Or dans son\nMagnéto VS!\r</language>
	</row>
	<row id="msg_0108_D32R0401_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} a la Photo d’Argent dans\nson Magnéto VS!\r</language>
	</row>
	<row id="msg_0108_D32R0401_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">COMBAT SOLO</language>
	</row>
	<row id="msg_0108_D32R0401_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">COMBAT DUO</language>
	</row>
	<row id="msg_0108_D32R0401_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">RELEVER LE DEFI</language>
	</row>
	<row id="msg_0108_D32R0401_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">INFOS</language>
	</row>
	<row id="msg_0108_D32R0401_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ANNULER</language>
	</row>
	<row id="msg_0108_D32R0401_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">NIVEAU 50</language>
	</row>
	<row id="msg_0108_D32R0401_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">NIVEAU LIBRE</language>
	</row>
	<row id="msg_0108_D32R0401_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ANNULER</language>
	</row>
	<row id="msg_0108_D32R0401_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’aimerais bien élever un Pokémon fort,\nmais je n’ai aucune idée duquel!\rEt pour les Dresseurs qui ont ce genre\nde dilemme, l’Usine de Combat est\fl’endroit idéal!</language>
	</row>
	<row id="msg_0108_D32R0401_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oui, c’est bien vrai...\rOn dit que la vie est une suite\nd’enseignements; mais pour ce qui est\fdes Dresseurs qui consacrent leur vie\fau combat, rien n’enseigne mieux que\fcet endroit...</language>
	</row>
	<row id="msg_0108_D32R0401_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Et d’un!\nEt de deux!\rMoi, je n’ai pas de Pokémon, alors\nje m’entraîne d’abord au lancer de\fPoké Ball!</language>
	</row>
	<row id="msg_0108_D32R0401_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mamie! Mamie!\nOn s’échange des Accessoires?\fTiens, c’est pour toi!</language>
	</row>
	<row id="msg_0108_D32R0401_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, c’est gentil, dis donc...\rQuelle chance j’ai d’avoir une petite-\nfille aussi jolie, forte et gentille...</language>
	</row>
	<row id="msg_0108_D32R0401_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu vois, la vieille dame et la petite fille\nlà-bas?\fEh bien la petite est super balèze.\fIl ne faut pas se fier aux apparences...</language>
	</row>
	<row id="msg_0108_D32R0401_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’un de vous deux devra sélectionner\n“MENEUR”.\rL’autre Dresseur devra choisir\n“JOINDRE”. {YESNO 0}</language>
	</row>
	<row id="msg_0108_D32R0401_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La communication sans fil DS va\ndémarrer. {YESNO 0}</language>
	</row>
	<row id="msg_0108_D32R0401_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vos données vont être sauvegardées.\nVeuillez patienter.</language>
	</row>
	<row id="msg_0108_D32R0401_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Veuillez choisir qui vous inscrivez.\r</language>
	</row>
	<row id="msg_0108_D32R0401_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} a déjà une série de\nvictoires consécutives en cours.\rEffacer la série et repartir de zéro\navec {STRVAR_1 0, 1, 0}? {YESNO 0}</language>
	</row>
	<row id="msg_0108_D32R0401_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je regrette!\rVous n’avez aucun Pokémon de niveau 30\nminimum pouvant participer!\r</language>
	</row>
	<row id="msg_0108_D32R0401_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je regrette!\rPour les Combats Duo, il vous faut deux\nPokémon de la même espèce et de niveau\f30 minimum.\r</language>
	</row>
	<row id="msg_0108_D32R0401_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Oeufs ne peuvent pas participer.\r</language>
	</row>
	<row id="msg_0108_D32R0401_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Oeufs et {STRVAR_1 0, 1, 0} ne sont pas\nautorisés à participer.\r</language>
	</row>
	<row id="msg_0108_D32R0401_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les Oeufs, {STRVAR_1 0, 1, 0} et\n{STRVAR_1 0, 2, 0} ne sont pas autorisés à\fparticiper.\r</language>
	</row>
	<row id="msg_0108_D32R0401_00040" index="40">
