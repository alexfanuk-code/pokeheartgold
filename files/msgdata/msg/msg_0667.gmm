	<row id="msg_0667_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allô?\nOh, c’est toi {STRVAR_1 3, 0, 0}?\rDésolé, mais les préparatifs du parc\nvont prendre encore un peu de temps.\fTu peux patienter encore un peu?\rBon ben je te rappelle!</language>
	</row>
