<?xml version="1.0"?>
<body language="English">
	<row id="msg_0331_R05R0202_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu n’as pas à...\rte méfier...\rde moi...\rIl y a plein de gens bizarres\rdans ces souterrains déserts.\rEt ils gênent...\rtout le monde...\rVoilà pourquoi un vieillard enragé...\rest obligé...\rde monter la garde ici...\rIl y a tellement d’écho...\rdans ce souterrain...</language>
	</row>
	<row id="msg_0331_R05R0202_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu n’as pas à...\rte méfier...\rde moi...\rIl y a plein de gens bizarres\rdans ces souterrains déserts.\rEt ils gênent...\rtout le monde...\rAh... Qu’ils m’énervent...\r</language>
	</row>
	<row id="msg_0331_R05R0202_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah!\rC’est un Bonbon Rage!\rDonne!\nDonne-le moi! {YESNO 0}</language>
	</row>
	<row id="msg_0331_R05R0202_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} donne le Bonbon Rage\nau vieillard du souterrain!\r</language>
	</row>
	<row id="msg_0331_R05R0202_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gnom!\rM’énervent, m’énervent, m’énervent!\rMais c’est bon!\rGnom gnom gnom gnom!\rM’énervent, m’énervent, m’énervent!\rGnom gnom gnom gnom!\rM’énervent, m’énervent, m’énervent...\r... Pfiou...\rJe crois que je suis calmé...\nMerci pour le bonbon.\fPrends ça en échange!\r</language>
	</row>
	<row id="msg_0331_R05R0202_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La CT64 contient...\rTic\n    Tac\fTic\f    Tac\fTic\f    Tac\fTic\f    Tac\fTic\f...\f...\r</language>
	</row>
	<row id="msg_0331_R05R0202_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{SIZE 200}BAAAAAAM!!!</language>
	</row>
	<row id="msg_0331_R05R0202_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ces souterrains déserts...\rattirent les gens bizarres...\ret mauvais...\rVoilà pourquoi... C’est moi...\rqui dois monter la garde...\rIl y a tellement d’écho...\rdans ce souterrain...</language>
	</row>
	<row id="msg_0331_R05R0202_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu gardes tout pour toi?!</language>
	</row>
	<row id="msg_0331_R05R0202_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah! Merci!\r... Mais ton Sac est plein...\rVa le vider quelque part et reviens\nme voir...</language>
	</row>
</body>
