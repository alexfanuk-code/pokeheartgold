<?xml version="1.0"?>
<body language="English">
	<row id="msg_0740_W19_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le rocher au milieu de la route\na été dégagé...\fmais il va encore falloir égaliser\fle terrain...</language>
	</row>
	<row id="msg_0740_W19_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les travaux sont enfin finis.\rJe peux enfin aller pêcher!</language>
	</row>
	<row id="msg_0740_W19_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cette route est fermée pour cause\nde travaux.\rPour aller à Cramois’Ile, il faut\nprendre par le sud de Bourg Palette.</language>
	</row>
	<row id="msg_0740_W19_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je dégouline de sueur...\nAllez! A l’eau!</language>
	</row>
	<row id="msg_0740_W19_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chenal 19\nParmanie - Iles Ecume</language>
	</row>
	<row id="msg_0740_W19_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il y a une affiche...\rNagez prudemment si vous vous\ndirigez vers les Iles Ecume.\f          Police de Parmanie</language>
	</row>
</body>
