	<row id="msg_0738_UNION_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} vous invite à\ndessiner quelque chose.\rVoulez-vous vous joindre à cette\npersonne et dessiner? {YESNO 0}</language>
	</row>
	<row id="msg_0738_UNION_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allez, dessinons!</language>
	</row>
	<row id="msg_0738_UNION_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous avez décliné l’offre.</language>
	</row>
	<row id="msg_0738_UNION_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} vous propose un\ncombat.\rAcceptez-vous de combattre? {YESNO 0}</language>
	</row>
	<row id="msg_0738_UNION_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le combat va commencer.</language>
	</row>
	<row id="msg_0738_UNION_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous avez décliné l’offre.</language>
	</row>
	<row id="msg_0738_UNION_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour combattre, il faut deux\nPokémon de N. 30 ou moins.</language>
	</row>
	<row id="msg_0738_UNION_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le combat a été annulé.</language>
	</row>
	<row id="msg_0738_UNION_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} propose de faire un\néchange.\rAcceptez-vous l’offre d’échange? {YESNO 0}</language>
	</row>
	<row id="msg_0738_UNION_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’échange va commencer.</language>
	</row>
	<row id="msg_0738_UNION_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous avez décliné l’offre.</language>
	</row>
	<row id="msg_0738_UNION_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour faire un échange, il faut\navoir au moins deux Pokémon.</language>
	</row>
	<row id="msg_0738_UNION_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} vous propose un échange\nde données.\rAcceptez-vous de faire l’échange\nde données? {YESNO 0}</language>
	</row>
	<row id="msg_0738_UNION_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">L’échange de données va commencer.</language>
	</row>
	<row id="msg_0738_UNION_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous avez décliné l’offre.</language>
	</row>
	<row id="msg_0738_UNION_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} vous invite à jouer à\nOeuf Surprise.\rVoulez-vous participer? {YESNO 0}</language>
	</row>
	<row id="msg_0738_UNION_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est parti pour Oeuf Surprise!</language>
	</row>
	<row id="msg_0738_UNION_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous avez décliné l’offre.</language>
	</row>
	<row id="msg_0738_UNION_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous n’avez pas d’Oeuf.\nVous ne pouvez accepter l’invitation.</language>
	</row>
	<row id="msg_0738_UNION_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 28, 2, 0}{PAUSE 15}\rC’est {STRVAR_1 3, 0, 0}! Tu voulais faire\nquelque chose?</language>
	</row>
	<row id="msg_0738_UNION_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oups! Dommage, j’ai autre\nchose à faire.\fUne autre fois, OK?</language>
	</row>
	<row id="msg_0738_UNION_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu veux faire autre chose?</language>
	</row>
	<row id="msg_0738_UNION_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">... ...\nLe Dresseur est occupé.</language>
	</row>
	<row id="msg_0738_UNION_00041" index="41">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0738_UNION_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">D’accord! Pour te “saluer”,\nvoici ma Carte de Dresseur.</language>
	</row>
	<row id="msg_0738_UNION_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hein? Ma Carte de Dresseur...\nJe l’ai mise où?\rTant pis, la prochaine fois alors!</language>
	</row>
	<row id="msg_0738_UNION_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je montre toujours ma Carte de\nDresseur pour me présenter.</language>
	</row>
	<row id="msg_0738_UNION_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’espère qu’on apprendra à se\nconnaître!</language>
	</row>
	<row id="msg_0738_UNION_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, tu voulais dessiner avec moi?\nD’accord, une seconde.</language>
	</row>
	<row id="msg_0738_UNION_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci d’avoir attendu!\nAllez, dessinons!</language>
	</row>
	<row id="msg_0738_UNION_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK, je ne peux pas, là.\nCe sera pour une prochaine fois.</language>
	</row>
	<row id="msg_0738_UNION_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: On est en train de\ndessiner.\rJe sais! Tu veux dessiner\navec nous, {STRVAR_1 3, 1, 0}? {YESNO 0}</language>
	</row>
	<row id="msg_0738_UNION_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon, OK.\nA la prochaine alors.</language>
	</row>
	<row id="msg_0738_UNION_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK! Dessinons ensemble!</language>
	</row>
	<row id="msg_0738_UNION_00052" index="52">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0738_UNION_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La dernière lettre de ce que tu écris\ndoit être la première de ce que j’écris?</language>
	</row>
	<row id="msg_0738_UNION_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arrête de faire des trucs aussi drôles!\nJ’ai mal au ventre tellement je rigole!</language>
	</row>
	<row id="msg_0738_UNION_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Waouh, pas mal!\nJe vais essayer de t’imiter!</language>
	</row>
	<row id="msg_0738_UNION_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Euh... qu’est-ce que c’est?\nC’est censé me représenter?</language>
	</row>
	<row id="msg_0738_UNION_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un combat, hein?\nTrès bien, juste un instant.</language>
	</row>
	<row id="msg_0738_UNION_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci d’avoir patienté!\nAllez, commençons le combat!</language>
	</row>
	<row id="msg_0738_UNION_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dommage! Mes Pokémon ne sont\npas vraiment en forme.\fJe t’écraserai une prochaine fois.</language>
	</row>
	<row id="msg_0738_UNION_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour combattre, il faut deux\nPokémon de N. 30 ou moins.\r</language>
	</row>
	<row id="msg_0738_UNION_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Waouh!\nT’en as dans le ventre!</language>
	</row>
	<row id="msg_0738_UNION_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">T’as utilisé cette capacité?\nBonne stratégie!</language>
	</row>
	<row id="msg_0738_UNION_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voilà!\nC’est comme ça qu’il faut faire!</language>
	</row>
	<row id="msg_0738_UNION_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh! C’est pas le bon moment\npour utiliser ce Pokémon!</language>
	</row>
	<row id="msg_0738_UNION_00065" index="65">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu veux faire un échange?\nOK, une seconde.</language>
	</row>
	<row id="msg_0738_UNION_00066" index="66">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allez!\nFaisons cet échange!</language>
	</row>
	<row id="msg_0738_UNION_00067" index="67">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Malheureusement, je n’ai aucun Pokémon\nà échanger pour l’instant.\rCe sera pour une prochaine fois.</language>
	</row>
	<row id="msg_0738_UNION_00068" index="68">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cool! \nJe le voulais vraiment, ce Pokémon!</language>
	</row>
	<row id="msg_0738_UNION_00069" index="69">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’ai enfin le Pokémon que je voulais!</language>
	</row>
	<row id="msg_0738_UNION_00070" index="70">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour faire un échange, il faut\navoir au moins deux Pokémon.\r</language>
	</row>
	<row id="msg_0738_UNION_00071" index="71">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si tu as besoin de moi,\nfais-moi signe!</language>
	</row>
	<row id="msg_0738_UNION_00072" index="72">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu veux faire un échange de données?\nOK, une seconde.</language>
	</row>
	<row id="msg_0738_UNION_00073" index="73">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci d’avoir attendu!\nEchangeons nos données.</language>
	</row>
	<row id="msg_0738_UNION_00074" index="74">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dommage, j’ai trop à faire pour\nl’instant.\fMais ce n’est que partie remise, OK?</language>
	</row>
	<row id="msg_0738_UNION_00075" index="75">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: On va faire un échange\nde données.\rJe sais! {STRVAR_1 3, 1, 0}, tu veux\nparticiper à l’échange de données? {YESNO 0}</language>
	</row>
	<row id="msg_0738_UNION_00076" index="76">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bon, OK.\nA la prochaine alors.</language>
	</row>
	<row id="msg_0738_UNION_00077" index="77">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Faisons cet échange de données!</language>
	</row>
	<row id="msg_0738_UNION_00078" index="78">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0738_UNION_00079" index="79">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est sympa de faire des échanges\nde données!</language>
	</row>
	<row id="msg_0738_UNION_00080" index="80">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais faire un échange de données\navec tout le monde!</language>
	</row>
	<row id="msg_0738_UNION_00081" index="81">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les échanges de données, c’est super!</language>
	</row>
	<row id="msg_0738_UNION_00082" index="82">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu devrais faire des échanges de\ndonnées, toi aussi!</language>
	</row>
	<row id="msg_0738_UNION_00083" index="83">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oeuf Surprise? Bien sûr!\nJuste une petite seconde...</language>
	</row>
	<row id="msg_0738_UNION_00084" index="84">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bien, tout est prêt!\nJouons à Oeuf Surprise!</language>
	</row>
	<row id="msg_0738_UNION_00085" index="85">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0738_UNION_00086" index="86">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu dois avoir un Oeuf dans ton\néquipe pour jouer à Oeuf Surprise.\r</language>
	</row>
	<row id="msg_0738_UNION_00087" index="87">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: Nous allons bientôt\ndémarrer Oeuf Surprise.\rDis, {STRVAR_1 3, 1, 0}, ça te dit de\njouer à Oeuf Surprise avec nous?</language>
	</row>
	<row id="msg_0738_UNION_00088" index="88">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah bon, d’accord.\nUne autre fois, alors!</language>
	</row>
	<row id="msg_0738_UNION_00089" index="89">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Super! Pour Oeuf Surprise, plus on est\nde fous, plus on rit!</language>
	</row>
	<row id="msg_0738_UNION_00090" index="90">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0738_UNION_00091" index="91">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0738_UNION_00092" index="92">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ton équipe contient un Oeuf qui ne\npeut être échangé.</language>
	</row>
	<row id="msg_0738_UNION_00093" index="93">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tout le monde adore Oeuf Surprise!\nOn s’amuse toujours beaucoup.</language>
	</row>
	<row id="msg_0738_UNION_00094" index="94">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé!\nStop!</language>
	</row>
	<row id="msg_0738_UNION_00095" index="95">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mon Oeuf est génial!</language>
	</row>
	<row id="msg_0738_UNION_00096" index="96">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Super! J’ai eu exactement l’Oeuf que\nje voulais.</language>
	</row>
	<row id="msg_0738_UNION_00097" index="97">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 28, 2, 0}{PAUSE 15}\rSalut, c’est {STRVAR_1 3, 0, 0}!\nTu veux faire quelque chose?</language>
	</row>
	<row id="msg_0738_UNION_00098" index="98">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oups! Dommage, j’ai autre\nchose à faire.\fUne autre fois, OK?</language>
	</row>
	<row id="msg_0738_UNION_00099" index="99">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu veux faire autre chose?</language>
	</row>
	<row id="msg_0738_UNION_00100" index="100">
		<attribute name="window_context_name">used</attribute>
		<language name="English">... ...\nLe Dresseur est occupé.</language>
	</row>
	<row id="msg_0738_UNION_00101" index="101">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0738_UNION_00102" index="102">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour me présenter, je vais te\nmontrer ma Carte de Dresseur.</language>
	</row>
	<row id="msg_0738_UNION_00103" index="103">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh! Mais où est passée ma\nCarte de Dresseur?\rDésolée! La prochaine fois alors!</language>
	</row>
	<row id="msg_0738_UNION_00104" index="104">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On se montre notre Carte de Dresseur\npour faire connaissance.</language>
	</row>
	<row id="msg_0738_UNION_00105" index="105">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On va bien s’entendre.\nJe le sens!</language>
	</row>
	<row id="msg_0738_UNION_00106" index="106">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu veux dessiner avec moi?\nSuper! Donne-moi juste une seconde...</language>
	</row>
	<row id="msg_0738_UNION_00107" index="107">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu n’as pas trop attendu?\nCommençons!</language>
	</row>
	<row id="msg_0738_UNION_00108" index="108">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, je suis désolée!\nOn dessinera une autre fois!</language>
	</row>
	<row id="msg_0738_UNION_00109" index="109">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: On est en train de\ndessiner.\rJe sais! Tu veux dessiner avec\nnous, {STRVAR_1 3, 1, 0}?</language>
	</row>
	<row id="msg_0738_UNION_00110" index="110">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh...\nA la prochaine alors.</language>
	</row>
	<row id="msg_0738_UNION_00111" index="111">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK! Merci d’avoir attendu!\nMettons-nous au dessin!</language>
	</row>
	<row id="msg_0738_UNION_00112" index="112">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0738_UNION_00113" index="113">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Waouh!\nTu dessines bien!</language>
	</row>
	<row id="msg_0738_UNION_00114" index="114">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha, ha!\nC’est quoi?</language>
	</row>
	<row id="msg_0738_UNION_00115" index="115">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’adore dessiner!\nJe pourrais y passer des heures!</language>
	</row>
	<row id="msg_0738_UNION_00116" index="116">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oups! Je n’arrive pas à rester entre\nles lignes!</language>
	</row>
	<row id="msg_0738_UNION_00117" index="117">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un combat? Bien sûr!\nJuste un instant, je me prépare.</language>
	</row>
	<row id="msg_0738_UNION_00118" index="118">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu n’as pas trop attendu?\nCommençons!</language>
	</row>
	<row id="msg_0738_UNION_00119" index="119">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis désolée, mais mes Pokémon\nne se sentent pas bien.\rBattons-nous une prochaine fois!</language>
	</row>
	<row id="msg_0738_UNION_00120" index="120">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour combattre, il faut deux\nPokémon de N. 30 ou moins.\r</language>
	</row>
	<row id="msg_0738_UNION_00121" index="121">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce Pokémon...\nIl est super bien dressé!</language>
	</row>
	<row id="msg_0738_UNION_00122" index="122">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est ça!\nC’est la bonne capacité!</language>
	</row>
	<row id="msg_0738_UNION_00123" index="123">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Incroyable!\nTu peux te battre comme ça?</language>
	</row>
	<row id="msg_0738_UNION_00124" index="124">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu sais vraiment changer de\nPokémon au bon moment!</language>
	</row>
	<row id="msg_0738_UNION_00125" index="125">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un échange? OK, je me prépare.</language>
	</row>
	<row id="msg_0738_UNION_00126" index="126">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu n’as pas trop attendu?\nCommençons!</language>
	</row>
	<row id="msg_0738_UNION_00127" index="127">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Malheureusement, je n’ai aucun Pokémon\nà échanger pour l’instant.\rCe sera pour une prochaine fois.</language>
	</row>
	<row id="msg_0738_UNION_00128" index="128">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis en train de faire\nun échange.</language>
	</row>
	<row id="msg_0738_UNION_00129" index="129">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’est le Pokémon que je voulais\ntellement!</language>
	</row>
	<row id="msg_0738_UNION_00130" index="130">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour faire un échange, il faut\navoir au moins deux Pokémon.\r</language>
	</row>
	<row id="msg_0738_UNION_00131" index="131">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si tu veux faire un truc, n’hésite\npas à demander.</language>
	</row>
	<row id="msg_0738_UNION_00132" index="132">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu veux faire un échange de données?\nD’accord, juste une seconde!</language>
	</row>
	<row id="msg_0738_UNION_00133" index="133">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Désolée pour l’attente!\nCommençons!</language>
	</row>
	<row id="msg_0738_UNION_00134" index="134">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Désolée! Une autre fois, OK?</language>
	</row>
	<row id="msg_0738_UNION_00135" index="135">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: Nous étions en train de\nfaire un échange de données.\rJe sais! {STRVAR_1 3, 1, 0}, tu veux faire\nl’échange de données avec nous?</language>
	</row>
	<row id="msg_0738_UNION_00136" index="136">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh...\nA la prochaine alors.</language>
	</row>
	<row id="msg_0738_UNION_00137" index="137">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Merci d’avoir attendu!\nCommençons l’échange de données!</language>
	</row>
	<row id="msg_0738_UNION_00138" index="138">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Désolée!\nOn fera ça une autre fois!</language>
	</row>
	<row id="msg_0738_UNION_00139" index="139">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J’adore les échanges de données!</language>
	</row>
	<row id="msg_0738_UNION_00140" index="140">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je vais continuer l’échange de données!</language>
	</row>
	<row id="msg_0738_UNION_00141" index="141">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mélangeons tout!</language>
	</row>
	<row id="msg_0738_UNION_00142" index="142">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je me demande ce qui va se passer.</language>
	</row>
	<row id="msg_0738_UNION_00143" index="143">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oeuf Surprise? Bien sûr!\nJuste une petite seconde...</language>
	</row>
	<row id="msg_0738_UNION_00144" index="144">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bien, tout est prêt!\nJouons à Oeuf Surprise!</language>
	</row>
	<row id="msg_0738_UNION_00145" index="145">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0738_UNION_00146" index="146">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu dois avoir un Oeuf dans ton\néquipe pour jouer à Oeuf Surprise.\r</language>
	</row>
	<row id="msg_0738_UNION_00147" index="147">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: Nous allons bientôt\njouer à Oeuf Surprise.\rDis, {STRVAR_1 3, 1, 0}, ça te dit de\nparticiper?</language>
	</row>
	<row id="msg_0738_UNION_00148" index="148">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah bon, d’accord.\nUne autre fois, alors!</language>
	</row>
	<row id="msg_0738_UNION_00149" index="149">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Super! Pour Oeuf Surprise, plus on est\nde fous, plus on rit!</language>
	</row>
	<row id="msg_0738_UNION_00150" index="150">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0738_UNION_00151" index="151">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0738_UNION_00152" index="152">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ton équipe contient un Oeuf qui ne\npeut être échangé.</language>
	</row>
	<row id="msg_0738_UNION_00153" index="153">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tout le monde adore Oeuf Surprise!\nOn s’amuse toujours beaucoup.</language>
	</row>
	<row id="msg_0738_UNION_00154" index="154">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hein?\nIl a encore bougé!</language>
	</row>
	<row id="msg_0738_UNION_00155" index="155">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je suis déçue, je n’ai pas eu\nl’Oeuf que je voulais...</language>
	</row>
	<row id="msg_0738_UNION_00156" index="156">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si cet Oeuf s’était arrêté au bon\nendroit, j’aurais eu une Baie en plus.</language>
	</row>
	<row id="msg_0738_UNION_00157" index="157">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue dans la Salle Union.\rSi vous avez besoin d’aide,\nn’hésitez pas à venir me voir! {YESNO 0}</language>
	</row>
	<row id="msg_0738_UNION_00158" index="158">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Que puis-je faire pour vous? {YESNO 0}</language>
	</row>
	<row id="msg_0738_UNION_00159" index="159">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sur quel sujet souhaitez-vous\ndes explications? {YESNO 0}</language>
	</row>
	<row id="msg_0738_UNION_00160" index="160">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dans la Salle Union, vous pouvez\ncombattre avec deux Pokémon de votre\fchoix de N. 30 ou moins.\rLorsque vous venez, nous vous\nconseillons d’apporter des Pokémon\frépondant à ce critère.\r</language>
	</row>
	<row id="msg_0738_UNION_00161" index="161">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous pouvez échanger des Pokémon\navec d’autres joueurs.\rC’est un bon moyen d’essayer\nd’obtenir des Pokémon rares!\r</language>
	</row>
	<row id="msg_0738_UNION_00162" index="162">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous pouvez communiquer avec d’autres\njoueurs et échanger vos données.\rQue se passera-t-il si vous échangez\nvos données, me demanderez-vous?\rEssayez, vous verrez bien!\rJusqu’à cinq joueurs peuvent\nparticiper, tentez avec vos amis!\r</language>
	</row>
	<row id="msg_0738_UNION_00163" index="163">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dans Oeuf Surprise, chaque participant\ndépose un Oeuf à échanger.\rLa roue tourne, quel Oeuf allez-vous\nobtenir? Quel Pokémon se cache dans\fl’Oeuf? Rebondissements garantis!\rJusqu’à cinq joueurs peuvent\nparticiper, essayez donc avec vos amis!\r</language>
	</row>
	<row id="msg_0738_UNION_00164" index="164">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous pouvez vous regrouper avec\nd’autres personnes et dessiner.\rVous dessinez tous sur la même feuille\nen même temps.\rEssayez de réaliser des chefs-d’œuvre\navec vos amis!\rCinq personnes peuvent dessiner en\nmême temps!\r</language>
	</row>
	<row id="msg_0738_UNION_00165" index="165">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pour discuter avec d’autres joueurs,\nchoisissez “TCHAT” dans le menu.\rAllez à la rencontre des autres\nDresseurs de la Salle Union!\rPrésentez-vous et parlez de vous.\nVous élargirez votre cercle d’amis!\r</language>
	</row>
	<row id="msg_0738_UNION_00166" index="166">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh!\nQuelqu’un vient d’arriver!\rPourquoi n’iriez vous pas discuter\navec cette personne?\r</language>
	</row>
	<row id="msg_0738_UNION_00167" index="167">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0738_UNION_00168" index="168">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Est-ce qu’on vous prend pour un vrai\nDresseur {STRVAR_1 14, 0, 0}?\rVous me donnez cette impression.\r</language>
	</row>
	<row id="msg_0738_UNION_00169" index="169">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, vous avez raison!\rC’est important de se saluer!\rSi quelqu’un arrive, pensez à\naller le saluer!\r</language>
	</row>
	<row id="msg_0738_UNION_00170" index="170">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tiens!\r{STRVAR_1 28, 0, 0}?\nSuperbe!\fMoi aussi, j’aime bien!\rQuand on rencontre quelqu’un\npour la première fois, il est\fd’usage de se présenter.\rC’est un bon moyen pour faire\nconnaissance!\r</language>
	</row>
	<row id="msg_0738_UNION_00171" index="171">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Un Dresseur {STRVAR_1 28, 0, 0}?\nVraiment?\fEh bien, ce n’est pas rien!\rMalheureusement, je n’ai pas de\nPokémon...\rPar contre, j’aime bien assister\naux combats.\r</language>
	</row>
	<row id="msg_0738_UNION_00172" index="172">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh! Votre {STRVAR_1 28, 0, 0}!\nJ’adorerais l’avoir!\fFaisons un échange!\r...\rJe n’étais pas sérieuse.\rJe n’ai pas de Pokémon, je ne\npeux pas faire d’échange...\r</language>
	</row>
	<row id="msg_0738_UNION_00173" index="173">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 28, 0, 0}?\nJe vous comprends...\rMais ce n’est pas si facile que\nça de faire un échange.\rIl faut trouver quelqu’un qui\nest intéressé par un de vos Pokémon.\r</language>
	</row>
	<row id="msg_0738_UNION_00174" index="174">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue dans la Salle Union!\rJe suis seule dans la salle, mais\nvous pouvez ramener vos amis!\rSi vous avez du temps devant vous,\nvous pouvez discuter avec moi.\rMoi j’ai le temps.\r</language>
	</row>
	<row id="msg_0738_UNION_00175" index="175">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je dessine bien!\r{STRVAR_1 28, 0, 0}, pas de problème!\nPersonne ne m’égale!\r</language>
	</row>
	<row id="msg_0738_UNION_00176" index="176">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, vous partez...\r...\rJe vais me sentir seule ici...\rRevenez vite!\r</language>
	</row>
	<row id="msg_0738_UNION_00177" index="177">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Qu’y a-t-il?\nQuelque chose ne va pas?\rSi vous êtes triste, allez vous\namuser avec vos amis plutôt que\fde rester avec moi.\r</language>
	</row>
	<row id="msg_0738_UNION_00178" index="178">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 28, 0, 0}?\nBonne idée!\rJ’aimerais bien, mais je ne peux\npas. Je suis ici pour travailler...\rOh... {STRVAR_1 28, 0, 0}...\nC’est vraiment dommage...\r</language>
	</row>
	<row id="msg_0738_UNION_00179" index="179">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 28, 0, 0}?\nOh, ça m’intéresse!\rMais je dois rester ici pour\naccueillir les visiteurs...\rAmusez-vous bien!\r</language>
	</row>
	<row id="msg_0738_UNION_00180" index="180">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 28, 0, 0}?\nC’est gentil de me proposer!\rMais je dois rester ici pour\naccueillir les visiteurs.\rJe ne peux vraiment pas.\r</language>
	</row>
	<row id="msg_0738_UNION_00181" index="181">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voilà qui est dit!\rC’est bien de proposer des choses\naux autres, comme {STRVAR_1 28, 0, 0}.\rMais ne soyez pas trop direct, les\nautres ont leur mot à dire aussi.\r</language>
	</row>
	<row id="msg_0738_UNION_00182" index="182">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oui!\nOK!\rRien n’est impossible.\rIl faut rester positif et garder\nla tête haute!\r</language>
	</row>
	<row id="msg_0738_UNION_00183" index="183">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On a tous des choses que l’on\nn’aime pas.\rIl ne faut jamais forcer quelqu’un à\nfaire ce qu’il ne veut pas.\r{STRVAR_1 28, 0, 0}? Moi j’aimerais bien\nen tout cas.\r</language>
	</row>
	<row id="msg_0738_UNION_00184" index="184">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bonne chance! J’espère que vous\nallez faire de beaux combats.\rCe sera sûrement mieux qu’ici\ndans la Salle Union!\r</language>
	</row>
	<row id="msg_0738_UNION_00185" index="185">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous avez envie de discuter?\rVous ne devriez pas perdre votre\ntemps avec moi, vous savez.\rVous devriez plutôt parler avec\nles autres joueurs.\rVous devez leur parler si vous\nvoulez vous faire des amis.\r</language>
	</row>
	<row id="msg_0738_UNION_00186" index="186">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Où vous êtes?\nHum... Devant moi.\rOh!\nPeut-être que ce n’est pas vous?\rVous vous faites passer pour\nquelqu’un d’autre?\rC’est ridicule!\nNe vous moquez pas de moi!\fOh là là!\r</language>
	</row>
	<row id="msg_0738_UNION_00187" index="187">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Echanger {STRVAR_1 28, 0, 0}?\nJ’aimerais bien!\rMais vous vous adressez à la\nmauvaise personne, je ne peux pas\ffaire d’échanges.\r</language>
	</row>
	<row id="msg_0738_UNION_00188" index="188">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Si vous voulez faire un combat\n{STRVAR_1 28, 0, 0}, vous devez vous\faffirmer plus et parler avec les autres.\rAutrement, vous ne ferez jamais de\ncombat {STRVAR_1 28, 0, 0}!\r</language>
	</row>
	<row id="msg_0738_UNION_00189" index="189">
		<attribute name="window_context_name">used</attribute>
		<language name="English">INFOS</language>
	</row>
	<row id="msg_0738_UNION_00190" index="190">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0738_UNION_00191" index="191">
		<attribute name="window_context_name">used</attribute>
		<language name="English">RETOUR</language>
	</row>
	<row id="msg_0738_UNION_00192" index="192">
		<attribute name="window_context_name">used</attribute>
		<language name="English">COMBAT</language>
	</row>
