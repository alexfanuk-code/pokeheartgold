<?xml version="1.0"?>
<body language="English">
	<row id="msg_0111_D35R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Que... Pardon?\rTu entends le vent souffler quelque\npart dans cette pièce?\rC’est... Fyuuu! Fyuuu!\nmoi qui m’entraîne à siffler!\rChangeons de sujet.\nTu veux acheter quelque chose? {YESNO 0}</language>
	</row>
	<row id="msg_0111_D35R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hein?! Vous avez trouvé l’escalier\nsecret? Il était pourtant bien caché...</language>
	</row>
	<row id="msg_0111_D35R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hé hé hé!! L’expérience est un succès!\rLes MAGICARPE ne valent rien, mais\nles LEVIATOR rapportent gros!</language>
	</row>
	<row id="msg_0111_D35R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gueuhhh...\rSes Pokémon de type Dragon étaient...\ntrop forts...</language>
	</row>
	<row id="msg_0111_D35R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Peter: DRACOLOSSE, Ultralaser.\r</language>
	</row>
	<row id="msg_0111_D35R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu en as mis du temps, {STRVAR_1 3, 0, 0}!\rComme je le pensais, cet étrange\nsignal radio vient de là.\r</language>
	</row>
	<row id="msg_0111_D35R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu en as mis du temps, {STRVAR_1 3, 0, 0}!\rComme je le pensais, cet étrange\nsignal radio vient de là.\r</language>
	</row>
	<row id="msg_0111_D35R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les escaliers sont... là!\r</language>
	</row>
	<row id="msg_0111_D35R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Peter: {STRVAR_1 3, 0, 0}, nous ferions mieux\nde nous séparer. Je passe en premier.\r</language>
	</row>
	<row id="msg_0111_D35R0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Peter: {STRVAR_1 3, 0, 0}, nous ferions mieux\nde nous séparer. Je passe en premier.\r</language>
	</row>
	<row id="msg_0111_D35R0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fyuuu! Fyuuu!\rÇa t’intrigue, ce bruit?\nC’est juste mes fausses dents qui sont\fdisjointes, et ça fait comme un sifflet!\rChangeons de sujet. Tu veux quoi?\r</language>
	</row>
	<row id="msg_0111_D35R0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On entend la Radio.\rC’est l’heure de l’équipe d’exploration\nsur l’Antenne Pokémon!</language>
	</row>
	<row id="msg_0111_D35R0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On entend la Radio.\rC’est l’heure du feuilleton\nsur l’Antenne Pokémon!</language>
	</row>
	<row id="msg_0111_D35R0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On entend la Radio.\rC’est l’heure du Mot de Passe de\nBuena sur l’Antenne Pokémon!</language>
	</row>
	<row id="msg_0111_D35R0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La radio diffuse la proclamation de\nrenaissance de la Team Rocket...!</language>
	</row>
	<row id="msg_0111_D35R0101_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On entend un bruit étrange...!</language>
	</row>
</body>
