<?xml version="1.0"?>
<body language="English">
	<row id="msg_0485_T06GYM0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Major Bob: Hey! You!\nTu as du guts pour venir me fight ici!\rJe suis le Number One des Pokémon de\nélectrique! Et j’ai never lost sur le\fchamp de battle!\rJe vais te shock comme\nun soldat ennemy!\r</language>
	</row>
	<row id="msg_0485_T06GYM0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Major Bob: Oh noes!\nYou are fort!\rOK!\nVoilà your Badge Foudre!\r</language>
	</row>
	<row id="msg_0485_T06GYM0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} reçoit le Badge Foudre\ndu Major Bob!</language>
	</row>
	<row id="msg_0485_T06GYM0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Major Bob: That Badge Foudre est\nla reward pour avoir won!\fPrends-en care of it!\rEt puis one more cadeau!\nUne superb CT!\r</language>
	</row>
	<row id="msg_0485_T06GYM0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Major Bob: Elle contient the Onde de\nShooooock!!! Nettoie le champ de\fbataille avec ça!\rExit de cette ville par le north et tu\narriveras à une big city, Safrania!</language>
	</row>
	<row id="msg_0485_T06GYM0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Major Bob: Hey! You!\nTu tiens le coup up?\rExit de cette ville par le north et tu\narriveras à une big city, Safrania!</language>
	</row>
	<row id="msg_0485_T06GYM0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salut! Future légende!\nT’en as de la chance!\rLes pièges de l’Arène étaient en panne,\nmais ils viennent d’être réparés!\rHein? Tu te demandes pourquoi c’est\nune bonne nouvelle?\rEh bien, parce que ça sera un bien\nmeilleur entraînement pour toi!\rAllez, rassemble tes forces et\nfonce vers le Major Bob!</language>
	</row>
	<row id="msg_0485_T06GYM0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’était une rencontre exciting!\nÇa m’a tout retourné.</language>
	</row>
	<row id="msg_0485_T06GYM0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Clang, clong...\nC’est plein de déchets.</language>
	</row>
	<row id="msg_0485_T06GYM0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Clang, clong...\nOh! Il y a un interrupteur au fond\fde la poubelle!\fEt... clic!</language>
	</row>
	<row id="msg_0485_T06GYM0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Clang, clong...\nC’est plein de déchets.\fAh! La barrière électrique est revenue!</language>
	</row>
	<row id="msg_0485_T06GYM0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La première barrière électrique\na disparu!</language>
	</row>
	<row id="msg_0485_T06GYM0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La seconde barrière électrique\na disparu!\rLe chemin est libre jusqu’au Champion!</language>
	</row>
	<row id="msg_0485_T06GYM0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arène de Carmin sur Mer</language>
	</row>
	<row id="msg_0485_T06GYM0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arène de Carmin sur Mer\rChampion: Major Bob\nDresseur estimé:\f{STRVAR_1 3, 0, 0}</language>
	</row>
</body>
