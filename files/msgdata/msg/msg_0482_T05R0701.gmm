<?xml version="1.0"?>
<body language="English">
	<row id="msg_0482_T05R0701_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue!\rTu peux visiter cet étage tant que\ntu le veux.</language>
	</row>
	<row id="msg_0482_T05R0701_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Seul le rez-de-chaussée est visitable.\rDepuis l’attaque de la Tour Radio de\nJohto par un gang criminel, les mesures\fde sécurité ont été renforcées.</language>
	</row>
	<row id="msg_0482_T05R0701_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les gens travaillent dur ici,\nà la Tour Radio.\rIls se donnent à fond pour faire\nde bonnes émissions.</language>
	</row>
	<row id="msg_0482_T05R0701_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, non, non, non!\rMaintenant que la Centrale a cessé de\nfonctionner, nous ne pouvons plus rien\fdiffuser!\rJuste quand on commençait à émettre!\nJe suis ruiné!</language>
	</row>
	<row id="msg_0482_T05R0701_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah! Ne serais-tu pas le jeune\n{STRVAR_1 3, 0, 0}, qui a réparé la Centrale?\rGrâce à toi, j’ai pu conserver\nmon emploi! Je te dois une fière\fchandelle! Tiens, en remerciement!\r</language>
	</row>
	<row id="msg_0482_T05R0701_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah! Ne serais-tu pas la jeune\n{STRVAR_1 3, 0, 0}, qui a réparé la Centrale?\rGrâce à toi, j’ai pu conserver\nmon emploi! Je te dois une fière\fchandelle! Tiens, en remerciement!\r</language>
	</row>
	<row id="msg_0482_T05R0701_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} enfonce le Coupon\nd’Expansion donné par le directeur\fdans son Pokématos.\rLa fonction radio du Pokématos\nest maintenant encore meilleure!</language>
	</row>
	<row id="msg_0482_T05R0701_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Avec ceci, tu peux écouter nos\nnouvelles émissions de radio!\fGahahahaha!</language>
	</row>
	<row id="msg_0482_T05R0701_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salut, bonjour, hello!\nJe suis le super directeur musical!\rHein? Ton Pokématos ne peut hélas pas\ncapter mon émission... Dommage!\rPour m’écouter, tu as besoin d’un\nCoupon d’Expansion!</language>
	</row>
	<row id="msg_0482_T05R0701_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salut, bonjour, hello!\nJe suis le super directeur musical!\rOn diffuse de super mélodies\nà l’antenne! Ecoute-nous!</language>
	</row>
	<row id="msg_0482_T05R0701_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">RC: Réception\n1¹: Produits dérivés\f2⁴: Personnel\f3⁴: Production\f4⁴: Bureau du Directeur</language>
	</row>
	<row id="msg_0482_T05R0701_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Faites remuer vos Pokémon sur un air\ncristallin de Pokéflûte!\rDiffusé uniquement à Kanto!\nRéglez votre radio sur\fle canal tout en haut.</language>
	</row>
</body>
