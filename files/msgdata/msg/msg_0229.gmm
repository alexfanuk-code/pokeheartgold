<?xml version="1.0"?>
<body language="English">
	<row id="msg_0229_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fichier de sauvegarde corrompu.\nLe fichier précédent sera chargé.</language>
	</row>
	<row id="msg_0229_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le fichier de sauvegarde a été effacé\ncar il était corrompu ou endommagé.</language>
	</row>
	<row id="msg_0229_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La Vidéo de combat la plus récente est\ncorrompue.\rLa Vidéo de combat précédemment\nsauvegardée sera chargée à la place.</language>
	</row>
	<row id="msg_0229_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il semble qu’une Vidéo de\ncombat ait été effacée.</language>
	</row>
	<row id="msg_0229_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les données de la Scène de Combat les\nplus récentes sont corrompues.\rLes données précédemment sauvegardées\nseront chargées à la place.</language>
	</row>
	<row id="msg_0229_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Les données de la Scène de Combat ont\nété effacées.</language>
	</row>
</body>
