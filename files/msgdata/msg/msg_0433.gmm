<?xml version="1.0"?>
<body language="English">
	<row id="msg_0433_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue!\rVoulez-vous des Cartes à gratter?\nLe lot de trois coûte {STRVAR_1 50, 0, 0} PCo.\r</language>
	</row>
	<row id="msg_0433_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Voulez-vous acheter des Cartes\nà gratter? {YESNO 0}</language>
	</row>
	<row id="msg_0433_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ACHETER</language>
	</row>
	<row id="msg_0433_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">INFOS</language>
	</row>
	<row id="msg_0433_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ANNULER</language>
	</row>
	<row id="msg_0433_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Revenez quand vous voulez.</language>
	</row>
	<row id="msg_0433_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vous pouvez acheter trois Cartes à\ngratter pour {STRVAR_1 50, 0, 0} PCo.\rDes icônes représentant des Pokémon\nsont dissimulées sur chaque carte.\rVous pouvez gratter trois cases\nsur chaque carte.\rSi vous révélez trois icônes identiques,\nvous remportez un prix, comme une Baie!\r</language>
	</row>
	<row id="msg_0433_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Le lot de trois Cartes à gratter\ncoûte {STRVAR_1 50, 2, 0} PCo. Cela vous convient? {YESNO 0}</language>
	</row>
	<row id="msg_0433_00008" index="8">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0433_00009" index="9">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0433_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Parfait! Veuillez choisir vos trois\nCartes à gratter.\r</language>
	</row>
	<row id="msg_0433_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Félicitations!\rVous avez {STRVAR_1 50, 0, 0} Carte(s) à\ngratter gagnante(s).\r</language>
	</row>
	<row id="msg_0433_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quel dommage! Vous n’avez plus de place\npour votre {STRVAR_1 8, 0, 0}!\r</language>
	</row>
	<row id="msg_0433_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Obtenu {STRVAR_1 8, 0, 0} x {STRVAR_1 50, 1, 0}!</language>
	</row>
	<row id="msg_0433_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pardonnez-moi, mais vous n’avez pas\nassez de PCo. Revenez plus tard.</language>
	</row>
	<row id="msg_0433_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bienvenue!\nVoulez-vous des Cartes à gratter?\rVous pouvez acheter un lot de trois\nCartes à gratter pour {STRVAR_1 50, 0, 0} PCo.\rDes icônes représentant des Pokémon\nsont dissimulées sur chaque carte.\rVous pouvez gratter trois cases\nsur chaque carte.\rSi vous révélez trois icônes identiques,\nvous remportez un prix, comme une Baie!\rSachez qu’une icône METAMORPH peut se\ntransformer en n’importe quel Pokémon!\rBonne chance!\r</language>
	</row>
</body>
