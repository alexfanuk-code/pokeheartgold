	</row>
	<row id="msg_0766_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il est cette heure-là chez toi?\rTu as prévu de rester\nlongtemps?\r</language>
	</row>
	<row id="msg_0766_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il est cette heure-là chez toi?\rTu as encore un peu d’énergie?\r</language>
	</row>
	<row id="msg_0766_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Il est cette heure-là chez toi?\rBien dormi?\r</language>
	</row>
	<row id="msg_0766_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}:\nQuel plaisir de te voir.\r</language>
	</row>
	<row id="msg_0766_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}:\nTiens, {STRVAR_1 3, 1, 0}!\fÇa me fait plaisir de te revoir!\r</language>
	</row>
	<row id="msg_0766_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ce Dresseur est occupé pour\nle moment.\r</language>
	</row>
	<row id="msg_0766_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}:\nA bientôt!\r</language>
	</row>
	<row id="msg_0766_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}:\nOh, au fait...\r</language>
	</row>
	<row id="msg_0766_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Excuse-moi, je ne peux pas te\nparler pour l’instant.\r</language>
	</row>
	<row id="msg_0766_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}:\nTu veux quelque chose?\r</language>
	</row>
	<row id="msg_0766_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}:\nJe peux te parler?\r</language>
	</row>
	<row id="msg_0766_00048" index="48">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0766_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}:\nPas de panique. Rien ne te force à me\frépondre si tu n’en as pas envie.\r</language>
	</row>
	<row id="msg_0766_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}:\nBien...\r</language>
	</row>
	<row id="msg_0766_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}:\nMoi aussi! Pareil!\fC’est génial!\r</language>
	</row>
	<row id="msg_0766_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}:\nMerci d’avoir répondu!\r</language>
	</row>
	<row id="msg_0766_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}:\nPassons à autre chose...\r</language>
	</row>
	<row id="msg_0766_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}:\nTu voulais parler d’autre chose?\r</language>
	</row>
	<row id="msg_0766_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}:\nQuelle est ta couleur préférée?\r</language>
	</row>
